  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 4996,
      "text": "Mereka dikelilingi oleh anak-anak muda yang tetap muda,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4997,
      "text": "dengan membawa gelas, cerek dan gelas besar (piala) berisi minuman yang diambil dari air yang mengalir,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4998,
      "text": "mereka tidak pening karenanya dan tidak pula mabuk,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4999,
      "text": "dan buah-buahan apa pun yang mereka pilih,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5000,
      "text": "dan daging burung apa pun yang mereka inginkan.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5001,
      "text": "dan ada bidadari-bidadari yang bermata indah,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5002,
      "text": "laksana mutiara yang tersimpan baik.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5003,
      "text": "Sebagai balasan atas apa yang mereka kerjakan.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5004,
      "text": "Di sana mereka tidak mendengar percakapan yang sia-sia maupun yang menimbulkan dosa,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5005,
      "text": "tetapi mereka mendengar ucapan salam.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5006,
      "text": "Dan golongan kanan, alangkah mulianya golongan kanan itu.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5007,
      "text": "(Mereka) berada di antara pohon bidara yang tidak berduri,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5008,
      "text": "dan pohon pisang yang bersusun-susun (buahnya),",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5009,
      "text": "dan naungan yang terbentang luas,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5010,
      "text": "dan air yang mengalir terus-menerus,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 31,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5011,
      "text": "dan buah-buahan yang banyak,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 32,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5012,
      "text": "yang tidak berhenti berbuah dan tidak terlarang mengambilnya,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5013,
      "text": "dan kasur-kasur yang tebal lagi empuk.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5014,
      "text": "Kami menciptakan mereka (bidadari-bidadari itu) secara langsung,[828]",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5015,
      "text": "lalu Kami jadikan mereka perawan-perawan,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5016,
      "text": "yang penuh cinta (dan) sebaya umurnya,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5017,
      "text": "untuk golongan kanan,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5018,
      "text": "segolongan besar dari orang-orang yang terdahulu,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 39,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5019,
      "text": "dan segolongan besar pula dari orang yang kemudian.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5020,
      "text": "Dan golongan kiri, alangkah sengsaranya golongan kiri itu.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 41,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5021,
      "text": "(Mereka) dalam siksaan angin yang sangat panas dan air yang mendidih,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5022,
      "text": "dan naungan asap yang hitam,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5023,
      "text": "tidak sejuk dan tidak menyenangkan.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5024,
      "text": "Sesungguhnya mereka sebelum itu (dahulu) hidup bermewah-mewah,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5025,
      "text": "dan mereka terus-menerus mengerjakan dosa yang besar,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 46,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5026,
      "text": "dan mereka berkata, \"Apabila kami sudah mati, menjadi tanah dan tulang-belulang, apakah kami benar-benar akan dibangkitkan kembali?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 47,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5027,
      "text": "Apakah nenek moyang kami yang terdahulu (dibangkitkan pula)?\"",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 48,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5028,
      "text": "Katakanlah, \"(Ya), sesungguhnya orang-orang yang terdahulu dan yang kemudian,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 49,
      "juz": 27,
      "manzil": 7,
      "page": 535,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5029,
      "text": "semuanya pasti akan dikumpulkan pada waktu tertentu, pada hari yang sudah dimaklumi.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
