{
  "page": 496,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 4415,
      "text": "Ḥā Mīm.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4416,
      "text": "Demi Kitab (Al-Qur`an) yang jelas,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4417,
      "text": "Sesungguhnya Kami menurunkannya pada malam yang diberkahi.791) Sungguh, Kamilah yang memberi peringatan.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4418,
      "text": "Pada (malam itu) dijelaskan segala urusan yang penuh hikmah,792)",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4419,
      "text": "(yaitu) urusan dari sisi Kami. Sungguh, Kamilah yang mengutus rasul-rasul,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4420,
      "text": "sebagai rahmat dari Tuhanmu. Sungguh, Dia Maha Mendengar, Maha Mengetahui.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4421,
      "text": "Tuhan (yang memelihara) langit dan bumi serta apa yang ada di antara keduanya; jika kamu orang-orang yang meyakini.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4422,
      "text": "Tidak ada tuhan (yang berhak disembah) selain Dia, Dia yang menghidupkan dan mematikan. (Dialah) Tuhanmu dan Tuhan nenek moyangmu dahulu.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4423,
      "text": "Tetapi mereka dalam keraguan, mereka bermain-main.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4424,
      "text": "Maka tunggulah pada hari ketika langit membawa kabut yang tampak jelas,793)",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4425,
      "text": "yang meliputi manusia. Inilah azab yang pedih.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4426,
      "text": "(Mereka berdoa), \"Ya Tuhan kami, lenyapkanlah azab itu dari kami. Sungguh, kami akan beriman.\"",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4427,
      "text": "Bagaimana mereka dapat menerima peringatan, padahal (sebelumnya pun) seorang Rasul telah datang memberi penjelasan kepada mereka,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4428,
      "text": "kemudian mereka berpaling darinya dan berkata, \"Dia itu orang yang menerima ajaran (dari orang lain) dan orang gila.\"794)",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4429,
      "text": "Sungguh, (kalau) Kami melenyapkan azab itu sedikit saja, tentu kamu akan kembali (ingkar).",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4430,
      "text": "(Ingatlah) pada hari (ketika) Kami menghantam mereka dengan keras.795) Kami pasti memberi balasan.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4431,
      "text": "Dan sungguh, sebelum mereka, Kami benar-benar telah menguji kaum Fir'aun, dan telah datang kepada mereka seorang Rasul yang mulia,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4432,
      "text": "(dengan berkata), \"Serahkanlah kepadaku hamba-hamba Allah (Bani Israil). Sesungguhnya aku adalah utusan (Allah) yang dapat kamu percaya.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 25,
      "manzil": 6,
      "page": 496,
      "ruku": 431,
      "hizbQuarter": 199,
      "sajda": false
    }
  ],
