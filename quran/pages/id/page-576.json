  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5513,
      "text": "Sesungguhnya dia telah memikirkan dan menetapkan (apa yang ditetapkannya),",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5514,
      "text": "maka celakalah dia! Bagaimana dia menetapkan?",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5515,
      "text": "Ssekali lagi, celakalah dia! Bagaimana dia menetapkan?",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5516,
      "text": "Kemudian dia (merenung) memikirkan,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5517,
      "text": "lalu berwajah masam dan cemberut,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5518,
      "text": "kemudian berpaling (dari kebenaran) dan menyombongkan diri,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5519,
      "text": "lalu dia berkata, \"(Al-Qur`an) ini hanyalah sihir yang dipelajari (dari orang-orang dahulu).",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5520,
      "text": "Ini hanyalah perkataan manusia.\"",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5521,
      "text": "Kelak, Aku akan memasukkannya ke dalam (neraka) Saqar,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5522,
      "text": "Dan tahukah kamu apa (neraka) Saqar itu?",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5523,
      "text": "Ia (Saqar itu) tidak meninggalkan dan tidak membiarkan,877)",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5524,
      "text": "yang menghanguskan kulit manusia.",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5525,
      "text": "Di atasnya ada sembilan belas (malaikat penjaga).",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5526,
      "text": "Dan yang Kami jadikan penjaga neraka itu hanya dari malaikat; dan Kami menentukan bilangan mereka itu hanya sebagai cobaan bagi orang-orang kafir, agar orang-orang yang diberi kitab menjadi yakin, agar orang yang beriman bertambah imannya, agar orang-orang yang diberi kitab dan orang-orang mukmin itu tidak ragu-ragu; dan agar orang-orang yang di dalam hatinya ada penyakit dan orang-orang kafir (berkata), \"Apakah yang dikehendaki Allah dengan (bilangan) ini sebagai suatu perumpamaan?\" Demikianlah Allah menyesatkan orang-orang yang Dia kehendaki dan memberi petunjuk kepada orang-orang yang Dia kehendaki. Dan tidak ada yang mengetahui bala tentara Tuhanmu kecuali Dia sendiri. Dan Saqar itu tidak lain hanyalah peringatan bagi manusia.",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 31,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 510,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5527,
      "text": "Tidak!878) Demi bulan,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 32,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5528,
      "text": "dan demi malam ketika telah berlalu,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5529,
      "text": "dan demi subuh apabila mulai terang,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5530,
      "text": "sesungguhnya (Saqar itu) adalah salah satu (bencana) yang sangat besar,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5531,
      "text": "sebagai peringatan bagi manusia,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5532,
      "text": "(yaitu) bagi siapa di antara kamu yang ingin maju atau mundur.879)",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5533,
      "text": "Setiap orang bertanggung jawab atas apa yang telah dilakukannya,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5534,
      "text": "kecuali golongan kanan,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 39,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5535,
      "text": "berada di dalam surga, mereka saling menanyakan,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5536,
      "text": "tentang (keadaan) orang-orang yang berdosa,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 41,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5537,
      "text": "\"Apa yang menyebabkan kamu masuk ke dalam (neraka) Saqar?\"",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5538,
      "text": "Mereka menjawab, \"Dahulu kami tidak termasuk orang-orang yang melaksanakan salat,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5539,
      "text": "dan kami (juga) tidak memberi makan orang miskin,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5540,
      "text": "bahkan kami biasa berbincang (untuk tujuan yang batil), bersama orang-orang yang membicarakannya,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5541,
      "text": "dan kami mendustakan hari pembalasan,",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
      "numberInSurah": 46,
      "juz": 29,
      "manzil": 7,
      "page": 576,
      "ruku": 511,
      "hizbQuarter": 230,
      "sajda": false
    },
    {
      "number": 5542,
      "text": "sampai datang kepada kami kematian.\"",
      "surah": {
        "number": 74,
        "name": "سُورَةُ المُدَّثِّرِ",
        "englishName": "Al-Muddaththir",
        "englishNameTranslation": "The Cloaked One",
        "numberOfAyahs": 56,
        "revelationType": "Meccan"
      },
