  "ayahs": [
    {
      "number": 955,
      "text": "Alif Lām Mīm ṣād.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 8,
      "manzil": 2,
      "page": 151,
      "ruku": 122,
      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 956,
      "text": "(Inilah) Kitab yang diturunkan kepadamu (Muhammad); maka janganlah engkau sesak dada karenanya, agar engkau memberi peringatan dengan (Kitab) itu dan menjadi pelajaran bagi orang yang beriman.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 8,
      "manzil": 2,
      "page": 151,
      "ruku": 122,
      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 957,
      "text": "Ikutilah apa yang diturunkan kepadamu dari Tuhanmu, dan janganlah kamu ikuti selain Dia sebagai pemimpin. Sedikit sekali kamu mengambil pelajaran.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 8,
      "manzil": 2,
      "page": 151,
      "ruku": 122,
      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 958,
      "text": "Betapa banyak negeri yang telah Kami binasakan, siksaan Kami datang (menimpa penduduk)nya pada malam hari, atau pada saat mereka beristirahat pada siang hari.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 8,
      "manzil": 2,
      "page": 151,
      "ruku": 122,
      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 959,
      "text": "Maka ketika siksaan Kami datang menimpa mereka, keluhan mereka tidak lain hanya mengucap, \"Sesungguhnya kami adalah orang-orang yang zalim.\"",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 8,
      "manzil": 2,
      "page": 151,
      "ruku": 122,
      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 960,
      "text": "Maka pasti akan Kami tanyakan kepada umat yang telah mendapat seruan (dari Rasul-rasul) dan Kami akan tanyai (pula) para rasul,",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 8,
      "manzil": 2,
      "page": 151,
      "ruku": 122,
      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 961,
      "text": "dan pasti akan Kami beritakan kepada mereka dengan ilmu (Kami) dan Kami tidak jauh (dari mereka).",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 8,
      "manzil": 2,
      "page": 151,
      "ruku": 122,
      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 962,
      "text": "Timbangan pada hari itu (menjadi ukuran) kebenaran. Maka barang siapa berat timbangan (kebaikan) nya, mereka itulah orang yang beruntung,",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 8,
      "manzil": 2,
      "page": 151,
      "ruku": 122,
      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 963,
      "text": "dan barang siapa ringan timbangan (kebaikan)nya, maka mereka itulah orang yang telah merugikan dirinya sendiri, karena mereka mengingkari ayat-ayat Kami.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 8,
      "manzil": 2,
      "page": 151,
      "ruku": 122,
      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 964,
      "text": "Dan sungguh, Kami telah menempatkan kamu di bumi dan di sana Kami sediakan (sumber) penghidupan untukmu. (Tetapi) sedikit sekali kamu yang bersyukur.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 8,
      "manzil": 2,
      "page": 151,
      "ruku": 122,
      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 965,
      "text": "Dan sungguh, Kami telah menciptakan kamu, kemudian membentuk (tubuh)mu, kemudian Kami berfirman kepada para malaikat. \"Bersujudlah kamu kepada Adam,\" maka mereka pun sujud kecuali Iblis. Ia (Iblis) tidak termasuk mereka yang bersujud.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
