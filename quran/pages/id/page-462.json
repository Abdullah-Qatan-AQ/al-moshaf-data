      "hizbQuarter": 185,
      "sajda": false
    },
    {
      "number": 4097,
      "text": "Katakanlah (Muhammad), \"Wahai kaumku! Berbuatlah menurut kedudukanmu, aku pun berbuat (demikian). Kelak kamu akan mengetahui,",
      "surah": {
        "number": 39,
        "name": "سُورَةُ الزُّمَرِ",
        "englishName": "Az-Zumar",
        "englishNameTranslation": "The Groups",
        "numberOfAyahs": 75,
        "revelationType": "Meccan"
      },
