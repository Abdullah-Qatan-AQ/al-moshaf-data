      "juz": 24,
      "manzil": 6,
      "page": 462,
      "ruku": 399,
      "hizbQuarter": 185,
      "sajda": false
    },
    {
      "number": 4093,
      "text": "agar Allah menghapus perbuatan mereka yang paling buruk yang pernah mereka lakukan dan memberi pahala kepada mereka dengan yang lebih baik daripada apa yang mereka kerjakan.",
      "surah": {
        "number": 39,
        "name": "سُورَةُ الزُّمَرِ",
        "englishName": "Az-Zumar",
        "englishNameTranslation": "The Groups",
        "numberOfAyahs": 75,
