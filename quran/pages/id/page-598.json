  "ayahs": [
    {
      "number": 6126,
      "text": "Sesungguhnya Kami telah menurunkannya (Al-Qur`an) pada malam qadar.[919]",
      "surah": {
        "number": 97,
        "name": "سُورَةُ القَدۡرِ",
        "englishName": "Al-Qadr",
        "englishNameTranslation": "The Power, Fate",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 539,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6127,
      "text": "Dan tahukah kamu apakah malam kemuliaan itu?",
      "surah": {
        "number": 97,
        "name": "سُورَةُ القَدۡرِ",
        "englishName": "Al-Qadr",
        "englishNameTranslation": "The Power, Fate",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 539,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6128,
      "text": "Malam kemuliaan itu lebih baik daripada seribu bulan.",
      "surah": {
        "number": 97,
        "name": "سُورَةُ القَدۡرِ",
        "englishName": "Al-Qadr",
        "englishNameTranslation": "The Power, Fate",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 539,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6129,
      "text": "Pada malam itu turun para malaikat dan Ruh (Jibril) dengan izin Tuhannya untuk mengatur semua urusan.",
      "surah": {
        "number": 97,
        "name": "سُورَةُ القَدۡرِ",
        "englishName": "Al-Qadr",
        "englishNameTranslation": "The Power, Fate",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 539,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6130,
      "text": "Sejahteralah (malam itu) sampai terbit fajar.",
      "surah": {
        "number": 97,
        "name": "سُورَةُ القَدۡرِ",
        "englishName": "Al-Qadr",
        "englishNameTranslation": "The Power, Fate",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 539,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6131,
      "text": "Orang-orang yang kafir dari golongan Ahli Kitab dan orang-orang musyrik tidak akan meninggalkan (agama mereka) sampai datang kepada mereka bukti yang nyata,",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 540,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6132,
      "text": "(yaitu) seorang Rasul dari Allah (Muhammad) yang membacakan lembaran-lembaran yang suci (Al-Qur`an),",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 540,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6133,
      "text": "di dalamnya terdapat (isi) kitab-kitab yang lurus (benar).[920]",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 540,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6134,
      "text": "Dan tidaklah terpecah belah orang-orang Ahli Kitab melainkan setelah datang kepada mereka bukti yang nyata.",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 540,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6135,
      "text": "Padahal mereka hanya diperintah menyembah Allah dengan ikhlas menaati-Nya semata-mata karena (menjalankan) agama, dan juga agar melaksanakan salat dan menunaikan zakat; dan yang demikian itulah agama yang lurus (benar).[921]",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 540,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6136,
      "text": "Sungguh, orang-orang yang kafir dari golongan Ahli Kitab dan orang-orang musyrik (akan masuk) ke neraka Jahanam; mereka kekal di dalamnya selama-lamanya. Mereka itu adalah sejahat-jahat makhluk.",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 540,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6137,
      "text": "Sungguh, orang-orang yang beriman dan mengerjakan kebajikan, mereka itulah sebaik-baik makhluk.",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
