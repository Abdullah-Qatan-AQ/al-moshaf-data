  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 4829,
      "text": "dan sesungguhnya Dialah yang menciptakan pasangan laki-laki dan perempuan,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4830,
      "text": "dari mani, apabila dipancarkan,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 46,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4831,
      "text": "dan sesungguhnya Dialah yang menetapkan penciptaan yang lain (kebangkitan setelah mati),",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 47,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4832,
      "text": "dan sesungguhnya Dialah yang memberikan kekayaan dan kecukupan.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 48,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4833,
      "text": "dan sesungguhnya Dialah Tuhan (yang memiliki) bintang Syi'rā,818)",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 49,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4834,
      "text": "dan sesungguhnya Dialah yang telah membinasakan kaum 'Ād dahulu kala,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 50,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4835,
      "text": "dan kaum Samud, tidak seorang pun yang ditinggalkan-Nya (hidup),",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 51,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4836,
      "text": "dan (juga) kaum Nuh sebelum itu. Sungguh, mereka adalah orang-orang yang paling zalim dan paling durhaka.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 52,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4837,
      "text": "Dan prahara angin telah meruntuhkan (negeri kaum Luṭ),",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 53,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4838,
      "text": "lalu menimbuni negeri itu (sebagai azab) dengan (puing-puing) yang menimpanya.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 54,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4839,
      "text": "Maka terhadap nikmat Tuhanmu yang manakah yang masih kamu ragukan?",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 55,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4840,
      "text": "Ini (Muhammad) salah seorang pemberi peringatan di antara para pemberi peringatan yang telah terdahulu.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 56,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4841,
      "text": "Yang dekat (hari Kiamat) telah makin mendekat.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 57,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4842,
      "text": "Tidak ada yang akan dapat mengungkapkan (terjadinya hari itu) selain Allah.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 58,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4843,
      "text": "Maka apakah kamu merasa heran terhadap pemberitaan ini?",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4844,
      "text": "dan kamu tertawakan dan tidak menangis,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 60,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4845,
      "text": "sedang kamu lengah (darinya).",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 61,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4846,
      "text": "Maka bersujudlah kepada Allah dan sembahlah (Dia)!",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 62,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 462,
      "hizbQuarter": 211,
      "sajda": {
        "id": 13,
        "recommended": false,
        "obligatory": true
      }
    },
    {
      "number": 4847,
      "text": "Saat (hari Kiamat) semakin dekat, bulan pun terbelah.",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 463,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4848,
      "text": "Dan jika mereka (orang-orang musyrikin) melihat suatu tanda (mukjizat), mereka berpaling dan berkata, \"(Ini adalah) sihir yang terus menerus.\"",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 463,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4849,
      "text": "Dan mereka mendustakan (Muhammad) dan mengikuti nafsu mereka, padahal setiap urusan telah ada ketetapannya.",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 463,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4850,
      "text": "Dan sungguh, telah datang kepada mereka beberapa kisah yang di dalamnya terdapat ancaman (terhadap kekafiran),",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 463,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4851,
      "text": "(itulah) suatu hikmah yang sempurna, tetapi peringatan-peringatan itu tidak berguna (bagi mereka),",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 463,
      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4852,
      "text": "maka berpalinglah engkau (Muhammad) dari mereka pada hari (ketika) penyeru (malaikat) mengajak (mereka) kepada sesuatu yang tidak menyenangkan (hari pembalasan),",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 27,
      "manzil": 7,
      "page": 528,
      "ruku": 463,
      "hizbQuarter": 211,
      "sajda": false
    }
  ],
