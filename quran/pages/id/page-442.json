  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 3733,
      "text": "Dan setelah dia (meninggal), Kami tidak menurunkan suatu pasukan pun dari langit kepada kaumnya, dan Kami tidak perlu menurunkannya.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 382,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3734,
      "text": "Tidak ada siksaan terhadap mereka melainkan dengan satu teriakan saja; maka seketika itu mereka mati.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 382,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3735,
      "text": "Alangkah besar penyesalan terhadap hamba-hamba itu, setiap datang seorang rasul kepada mereka, mereka selalu memperolok-olokkannya.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 382,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3736,
      "text": "Tidakkah mereka mengetahui berapa banyak umat-umat sebelum mereka yang telah Kami binasakan. Orang-orang (yang telah Kami binasakan) itu tidak ada yang kembali kepada mereka.[720]",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 31,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 382,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3737,
      "text": "Dan setiap (umat), semuanya akan dihadapkan kepada Kami.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 32,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 382,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3738,
      "text": "Dan suatu tanda (kebesaran Allah) bagi mereka adalah bumi yang mati (tandus). Kami hidupkan bumi itu dan Kami keluarkan darinya biji-bijian, maka dari (biji-bijian) itu mereka makan.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 383,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3739,
      "text": "Dan Kami jadikan padanya di bumi itu kebun-kebun kurma dan anggur dan Kami pancarkan padanya beberapa mata air,",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 383,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3740,
      "text": "agar mereka dapat makan dari buahnya, dan dari hasil usaha tangan mereka. Maka mengapa mereka tidak bersyukur?",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 383,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3741,
      "text": "Mahasuci (Allah) yang telah menciptakan semuanya berpasang-pasangan, baik dari apa yang ditumbuhkan oleh bumi dan dari diri mereka sendiri, maupun dari apa yang tidak mereka ketahui.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 383,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3742,
      "text": "Dan suatu tanda (kebesaran Allah) bagi mereka adalah malam; Kami tanggalkan siang dari (malam) itu, maka seketika itu mereka (berada dalam) kegelapan,",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 383,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3743,
      "text": "dan matahari berjalan di tempat peredarannya. Demikianlah ketetapan (Allah) Yang Mahaperkasa, Maha Mengetahui.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 383,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3744,
      "text": "Dan telah Kami tetapkan tempat peredaran bagi bulan, sehingga (setelah ia sampai ke tempat peredaran yang terakhir) kembalilah ia seperti bentuk tandan yang tua.[721]",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 39,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 383,
      "hizbQuarter": 177,
      "sajda": false
    },
    {
      "number": 3745,
      "text": "Tidaklah mungkin bagi matahari mengejar bulan dan malam pun tidak dapat mendahului siang. Masing-masing beredar pada garis edarnya.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 23,
      "manzil": 5,
      "page": 442,
      "ruku": 383,
      "hizbQuarter": 177,
      "sajda": false
    }
  ],
