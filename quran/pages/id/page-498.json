  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 4454,
      "text": "Sungguh, hari keputusan (hari Kiamat) adalah waktu yang dijanjikan bagi mereka semuanya,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 432,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4455,
      "text": "(yaitu) pada hari (ketika) seorang teman sama sekali tidak dapat memberi manfaat kepada teman lainnya, dan mereka tidak akan mendapat pertolongan,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 41,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 432,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4456,
      "text": "kecuali orang yang diberi rahmat oleh Allah. Sungguh, Dia Mahaperkasa, Maha Penyayang.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 432,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4457,
      "text": "Sungguh pohon zaqqūm itu,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4458,
      "text": "makanan bagi orang yang banyak dosa.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4459,
      "text": "Seperti cairan tembaga yang mendidih di dalam perut,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4460,
      "text": "seperti mendidihnya air yang sangat panas.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 46,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4461,
      "text": "\"Peganglah dia, kemudian seretlah dia sampai ke tengah-tengah neraka,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 47,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4462,
      "text": "kemudian tuangkanlah di atas kepalanya azab (dari) air yang sangat panas.\"",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 48,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4463,
      "text": "\"Rasakanlah, sesungguhnya engkau benar-benar orang yang perkasa lagi mulia (di tengah kaummu).\"",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 49,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4464,
      "text": "Sungguh, inilah azab yang dahulu kamu ragukan.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 50,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4465,
      "text": "Sungguh, orang-orang yang bertakwa berada dalam tempat yang aman,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 51,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4466,
      "text": "(yaitu) di dalam taman-taman dan mata air-mata air;",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 52,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4467,
      "text": "mereka memakai sutera yang halus dan sutera yang tebal, (duduk) berhadapan.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 53,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4468,
      "text": "Demikianlah, kemudian Kami berikan kepada mereka pasangan bidadari yang bermata indah.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 54,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4469,
      "text": "Di dalamnya mereka dapat meminta segala macam buah-buahan dengan aman dan tenteram.[799]",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 55,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4470,
      "text": "Mereka tidak akan merasakan mati di dalamnya, selain kematian pertama (di dunia). Allah melindungi mereka dari azab neraka.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 56,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4471,
      "text": "Itu merupakan karunia dari Tuhanmu. Demikian itulah kemenangan yang agung.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 57,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4472,
      "text": "Sungguh, Kami mudahkan Al-Qur`an itu dengan bahasamu agar mereka mendapat pelajaran.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 58,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4473,
      "text": "Maka tunggulah; sungguh, mereka itu (juga sedang) menunggu.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    }
  ],
