      "sajda": false
    },
    {
      "number": 2652,
      "text": "Dan orang-orang kafir dan yang mendustakan ayat-ayat Kami, mereka akan merasakan azab yang menghinakan.",
      "surah": {
        "number": 22,
        "name": "سُورَةُ الحَجِّ",
        "englishName": "Al-Hajj",
        "englishNameTranslation": "The Pilgrimage",
        "numberOfAyahs": 78,
