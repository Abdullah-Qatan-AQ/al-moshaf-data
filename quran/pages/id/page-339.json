      "hizbQuarter": 136,
      "sajda": false
    },
    {
      "number": 2656,
      "text": "Demikianlah karena Allah (kuasa) memasukkan malam ke dalam siang dan memasukkan siang ke dalam malam, dan sungguh, Allah Maha mendengar, Maha Melihat.",
      "surah": {
        "number": 22,
        "name": "سُورَةُ الحَجِّ",
        "englishName": "Al-Hajj",
        "englishNameTranslation": "The Pilgrimage",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 61,
      "juz": 17,
      "manzil": 4,
      "page": 339,
      "ruku": 292,
      "hizbQuarter": 136,
      "sajda": false
    },
    {
      "number": 2657,
      "text": "Demikianlah (kebesaran Allah) karena Allah, Dialah (Tuhan) Yang Hak. Dan apa saja yang mereka seru selain Dia, itulah yang batil. Dan sungguh Allah, Dialah Yang Mahatinggi, Mahabesar.",
      "surah": {
        "number": 22,
        "name": "سُورَةُ الحَجِّ",
        "englishName": "Al-Hajj",
