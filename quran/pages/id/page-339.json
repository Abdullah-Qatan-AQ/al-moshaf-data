      "hizbQuarter": 136,
      "sajda": false
    },
    {
      "number": 2658,
      "text": "Tidakkah engkau memperhatikan bahwa Allah menurunkan air (hujan) dari langit, sehingga bumi menjadi hijau? Sungguh, Allah Mahahalus, Maha Mengetahui.",
      "surah": {
        "number": 22,
        "name": "سُورَةُ الحَجِّ",
        "englishName": "Al-Hajj",
        "englishNameTranslation": "The Pilgrimage",
