{
  "page": 451,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 3915,
      "text": "Tetapi mereka mendustakannya (Ilyas), maka sungguh, mereka akan diseret (ke neraka),",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 127,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3916,
      "text": "kecuali hamba-hamba Allah yang disucikan (dari dosa).",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 128,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3917,
      "text": "Dan Kami abadikan untuk Ilyas (pujian) di kalangan orang-orang yang datang kemudian,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 129,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3918,
      "text": "\"Selamat sejahtera bagi Ilyas.\"",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 130,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3919,
      "text": "Demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 131,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3920,
      "text": "Sungguh, dia termasuk hamba-hamba Kami yang beriman.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 132,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3921,
      "text": "Dan sungguh, Luṭ benar-benar termasuk salah seorang rasul.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 133,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3922,
      "text": "(Ingatlah) ketika Kami telah menyelamatkan dia dan pengikutnya semua,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 134,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3923,
      "text": "kecuali seorang perempuan tua (istrinya) bersama-sama orang yang tinggal (di kota).",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 135,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3924,
      "text": "Kemudian Kami binasakan orang-orang yang lain.736)",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 136,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3925,
      "text": "Dan sesungguhnya kamu (penduduk Mekkah) benar-benar akan melalui (bekas-bekas) mereka pada waktu pagi,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 137,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3926,
      "text": "dan pada waktu malam. Maka mengapa kamu tidak mengerti?",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 138,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3927,
      "text": "Dan sungguh, Yunus benar-benar termasuk salah seorang rasul,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 139,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3928,
      "text": "(ingatlah) ketika dia lari,737) ke kapal yang penuh muatan,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 140,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3929,
      "text": "kemudian dia ikut diundi,738) ternyata dia termasuk orang-orang yang kalah (dalam undian).",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 141,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3930,
      "text": "Maka dia ditelan oleh ikan besar dalam keadaan tercela.739)",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 142,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3931,
      "text": "Maka sekiranya dia tidak termasuk orang yang banyak berzikir (bertasbih) kepada Allah,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 143,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3932,
      "text": "niscaya dia akan tetap tinggal di perut (ikan itu) sampai Hari Berbangkit.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 144,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3933,
      "text": "Kemudian Kami lemparkan dia ke daratan yang tandus, sedang dia dalam keadaan sakit.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 145,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 181,
      "sajda": false
    },
    {
      "number": 3934,
      "text": "Kemudian untuk dia Kami tumbuhkan sebatang pohon dari jenis labu.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 146,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 181,
      "sajda": false
    },
    {
      "number": 3935,
      "text": "Dan Kami utus dia kepada seratus ribu (orang) atau lebih,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 147,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 181,
      "sajda": false
    },
    {
      "number": 3936,
      "text": "sehingga mereka beriman, karena itu Kami anugerahkan kenikmatan hidup kepada mereka hingga waktu tertentu.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 148,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 181,
      "sajda": false
    },
    {
      "number": 3937,
      "text": "Maka tanyakanlah (Muhammad) kepada mereka (orang-orang kafir Mekkah), \"Apakah anak-anak perempuan itu untuk Tuhanmu sedangkan untuk mereka anak laki-laki?740)",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 149,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 181,
      "sajda": false
    },
    {
      "number": 3938,
      "text": "Atau apakah Kami menciptakan malaikat-malaikat berupa perempuan sedangkan mereka menyaksikan(nya)?",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 150,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 181,
      "sajda": false
    },
    {
      "number": 3939,
      "text": "Ingatlah, sesungguhnya di antara kebohongannya mereka benar-benar mengatakan,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 151,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 181,
      "sajda": false
    },
    {
      "number": 3940,
      "text": "\"Allah mempunyai anak.\" Dan sungguh, mereka benar-benar pendusta.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 152,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 181,
      "sajda": false
    },
    {
      "number": 3941,
      "text": "Apakah Dia (Allah) memilih anak-anak perempuan daripada anak-anak laki-laki?",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 153,
      "juz": 23,
      "manzil": 6,
      "page": 451,
      "ruku": 390,
      "hizbQuarter": 181,
      "sajda": false
    }
  ],
