{
  "page": 584,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5728,
      "text": "Ketika Tuhan memanggilnya (Musa) di lembah suci yaitu Lembah Tuwa;",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5729,
      "text": "pergilah engkau kepada Fir'aun! Sesungguhnya dia telah melampaui batas,",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5730,
      "text": "Maka katakanlah (kepada Fir'aun), \"Adakah keinginanmu untuk membersihkan diri (dari kesesatan),",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5731,
      "text": "dan engkau akan kubimbing ke jalan Tuhanmu agar engkau takut kepada-Nya?\"",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5732,
      "text": "Lalu (Musa) memperlihatkan kepadanya mukjizat yang besar.",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5733,
      "text": "Tetapi dia (Fir'aun) mendustakan dan mendurhakai.",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5734,
      "text": "Kemudian dia berpaling seraya berusaha menantang (Musa).",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5735,
      "text": "Kemudian dia mengumpulkan (pembesar-pembesarnya) lalu berseru (memanggil kaumnya).",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5736,
      "text": "(Seraya) berkata, \"Akulah tuhanmu yang paling tinggi.\"",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5737,
      "text": "Maka Allah menghukumnya dengan azab di akhirat dan siksaan di dunia.",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5738,
      "text": "Sungguh, pada yang demikian itu terdapat pelajaran bagi orang yang takut (kepada Allah).",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5739,
      "text": "Apakah penciptaan kamu yang lebih hebat ataukah langit yang telah dibangun-Nya?",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5740,
      "text": "Dia telah meninggikan bangunannya lalu menyempurnakannya,",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5741,
      "text": "dan Dia menjadikan malamnya (gelap gulita), dan menjadikan siangnya (terang benderang).",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5742,
      "text": "Dan setelah itu bumi Dia hamparkan.",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5743,
      "text": "Darinya Dia pancarkan mata air, dan (ditumbuhkan) tumbuh-tumbuhannya.",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 31,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5744,
      "text": "Dan gunung-gunung Dia pancangkan dengan kokoh.",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 32,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5745,
      "text": "(Semua itu) untuk kesenanganmu dan untuk hewan-hewan ternakmu.",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5746,
      "text": "Maka apabila malapetaka besar (hari Kiamat) telah datang,",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5747,
      "text": "yaitu pada hari (ketika) manusia teringat akan apa yang telah dikerjakannya,",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5748,
      "text": "dan neraka diperlihatkan dengan jelas kepada setiap orang yang melihat.",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5749,
      "text": "Maka adapun orang yang melampaui batas,",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5750,
      "text": "dan lebih mengutamakan kehidupan dunia,",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5751,
      "text": "maka sungguh, nerakalah tempat tinggalnya.",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 39,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5752,
      "text": "Dan adapun orang-orang yang takut kepada kebesaran Tuhannya dan menahan diri dari (keinginan) hawa nafsunya,",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5753,
      "text": "maka sungguh, surgalah tempat tinggal-(nya).",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 41,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5754,
      "text": "Mereka (orang-orang kafir) bertanya kepadamu (Muhammad) tentang hari Kiamat, \"Kapankah terjadinya?\"",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5755,
      "text": "Untuk apa engkau perlu menyebutkannya (waktunya)?",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5756,
      "text": "Kepada Tuhanmulah (dikembalikan) kesudahannya (ketentuan waktunya).",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5757,
      "text": "Engkau (Muhammad) hanyalah pemberi peringatan bagi siapa yang takut kepadanya (hari Kiamat).",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5758,
      "text": "Pada hari ketika mereka melihat hari Kiamat itu (karena suasananya hebat), mereka merasa seakan-akan hanya (sebentar saja) tinggal (di dunia) pada waktu sore atau pagi hari.",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 46,
      "juz": 30,
      "manzil": 7,
      "page": 584,
      "ruku": 521,
      "hizbQuarter": 233,
      "sajda": false
    }
  ],
  "language": "id"
}
