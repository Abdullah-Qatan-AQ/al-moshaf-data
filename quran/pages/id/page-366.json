      },
      "numberInSurah": 73,
      "juz": 19,
      "manzil": 4,
      "page": 366,
      "ruku": 315,
      "hizbQuarter": 146,
      "sajda": false
    },
    {
      "number": 2929,
      "text": "Dan orang-orang yang berkata, \"Ya Tuhan kami, anugerahkanlah kepada kami pasangan kami dan keturunan kami sebagai penyenang hati (kami), dan jadikanlah kami pemimpin bagi orang-orang yang bertakwa.\"",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
        "englishName": "Al-Furqaan",
        "englishNameTranslation": "The Criterion",
        "numberOfAyahs": 77,
