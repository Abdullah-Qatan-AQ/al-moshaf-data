      "hizbQuarter": 146,
      "sajda": false
    },
    {
      "number": 2930,
      "text": "Mereka itu akan diberi balasan dengan tempat yang tinggi (dalam surga) atas kesabaran mereka, dan di sana mereka akan disambut dengan penghormatan dan salam,",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
