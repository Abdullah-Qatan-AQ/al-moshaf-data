      },
      "numberInSurah": 199,
      "juz": 9,
      "manzil": 2,
      "page": 176,
      "ruku": 145,
      "hizbQuarter": 70,
      "sajda": false
    },
    {
      "number": 1154,
      "text": "Dan jika setan datang menggodamu, maka berlindunglah kepada Allah354) Sungguh, Dia Maha Mendengar, Maha Mengetahui.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
