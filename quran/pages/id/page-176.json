      "sajda": false
    },
    {
      "number": 1159,
      "text": "Dan ingatlah Tuhanmu dalam hatimu dengan rendah hati dan rasa takut, dan dengan tidak mengeraskan suara, pada waktu pagi dan petang, dan janganlah kamu termasuk orang-orang yang lengah.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
