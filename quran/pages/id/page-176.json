      },
      "numberInSurah": 198,
      "juz": 9,
      "manzil": 2,
      "page": 176,
      "ruku": 145,
      "hizbQuarter": 70,
      "sajda": false
    },
    {
      "number": 1153,
      "text": "Jadilah pemaaf dan suruhlah orang mengerjakan yang makruf, serta jangan pedulikan orang-orang yang bodoh.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
