      "hizbQuarter": 70,
      "sajda": false
    },
    {
      "number": 1158,
      "text": "Dan apabila dibacakan Al-Qur`an, maka dengarkanlah dan diamlah, agar kamu mendapat rahmat.\"355)",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
