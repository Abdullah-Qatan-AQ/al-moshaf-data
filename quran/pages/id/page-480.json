      "hizbQuarter": 192,
      "sajda": false
    },
    {
      "number": 4250,
      "text": "Sebagai penghormatan (bagimu) dari (Allah) Yang Maha Pengampun, Maha Penyayang.",
      "surah": {
        "number": 41,
        "name": "سُورَةُ فُصِّلَتۡ",
        "englishName": "Fussilat",
        "englishNameTranslation": "Explained in detail",
