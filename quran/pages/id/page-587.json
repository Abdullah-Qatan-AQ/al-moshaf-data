{
  "page": 587,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5830,
      "text": "Apabila langit terbelah,",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5831,
      "text": "dan apabila bintang-bintang jatuh berserakan,",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5832,
      "text": "dan apabila lautan dijadikan meluap,",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5833,
      "text": "dan apabila kuburan-kuburan dibongkar,",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5834,
      "text": "(maka) setiap jiwa akan mengetahui apa yang telah dikerjakan dan yang dilalaikan(nya).",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5835,
      "text": "Wahai manusia! Apakah yang telah memperdayakan kamu (berbuat durhaka) terhadap Tuhanmu Yang Maha Pengasih.",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5836,
      "text": "Yang telah menciptakanmu lalu menyempurnakan kejadianmu dan menjadikan (susunan tubuh)mu seimbang,",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5837,
      "text": "dalam bentuk apa saja yang dikehendaki, Dia menyusun tubuhmu.",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5838,
      "text": "Sekali-kali jangan begitu! Bahkan kamu mendustakan hari pembalasan.",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5839,
      "text": "Dan sesungguhnya bagi kamu ada (malaikat-malaikat) yang mengawasi (pekerjaanmu),",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5840,
      "text": "yang mulia (di sisi Allah) dan yang mencatat (perbuatanmu),",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5841,
      "text": "mereka mengetahui apa yang kamu kerjakan.",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5842,
      "text": "Sesungguhnya orang-orang yang berbakti benar-benar berada dalam (surga yang penuh) kenikmatan,",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5843,
      "text": "dan sesungguhnya orang-orang yang durhaka benar-benar berada dalam neraka.",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5844,
      "text": "Mereka masuk ke dalamnya pada hari pembalasan.",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5845,
      "text": "Dan mereka tidak mungkin keluar dari neraka itu.",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5846,
      "text": "Dan tahukah kamu apakah hari pembalasan itu?",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5847,
      "text": "Sekali lagi, tahukah kamu apakah hari pembalasan itu?",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5848,
      "text": "(Yaitu) pada hari (ketika) seseorang sama sekali tidak berdaya (menolong) orang lain. Dan segala urusan pada hari itu dalam kekuasaan Allah.",
      "surah": {
        "number": 82,
        "name": "سُورَةُ الانفِطَارِ",
        "englishName": "Al-Infitaar",
        "englishNameTranslation": "The Cleaving",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 524,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5849,
      "text": "Celakalah bagi orang-orang yang curang (dalam menakar dan menimbang)!",
      "surah": {
        "number": 83,
        "name": "سُورَةُ المُطَفِّفِينَ",
        "englishName": "Al-Mutaffifin",
        "englishNameTranslation": "Defrauding",
        "numberOfAyahs": 36,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5850,
      "text": "(yaitu) orang-orang yang apabila menerima takaran dari orang lain mereka minta dicukupkan,",
      "surah": {
        "number": 83,
        "name": "سُورَةُ المُطَفِّفِينَ",
        "englishName": "Al-Mutaffifin",
        "englishNameTranslation": "Defrauding",
        "numberOfAyahs": 36,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5851,
      "text": "dan apabila mereka menakar atau menimbang (untuk orang lain), mereka mengurangi.",
      "surah": {
        "number": 83,
        "name": "سُورَةُ المُطَفِّفِينَ",
        "englishName": "Al-Mutaffifin",
        "englishNameTranslation": "Defrauding",
        "numberOfAyahs": 36,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5852,
      "text": "Tidakkah mereka itu mengira, bahwa sesungguhnya mereka akan dibangkitkan,",
      "surah": {
        "number": 83,
        "name": "سُورَةُ المُطَفِّفِينَ",
        "englishName": "Al-Mutaffifin",
        "englishNameTranslation": "Defrauding",
        "numberOfAyahs": 36,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5853,
      "text": "pada suatu hari yang besar,",
      "surah": {
        "number": 83,
        "name": "سُورَةُ المُطَفِّفِينَ",
        "englishName": "Al-Mutaffifin",
        "englishNameTranslation": "Defrauding",
        "numberOfAyahs": 36,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 587,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5854,
      "text": "(yaitu) pada hari (ketika) semua orang bangkit menghadap Tuhan seluruh alam.",
      "surah": {
        "number": 83,
        "name": "سُورَةُ المُطَفِّفِينَ",
        "englishName": "Al-Mutaffifin",
        "englishNameTranslation": "Defrauding",
        "numberOfAyahs": 36,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 587,
