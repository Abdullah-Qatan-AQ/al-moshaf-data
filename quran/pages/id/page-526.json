{
  "page": 526,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 4785,
      "text": "Demi bintang ketika terbenam,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4786,
      "text": "kawanmu (Muhammad) tidak sesat dan tidak (pula) keliru,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4787,
      "text": "dan tidaklah yang diucapkannya itu (Al-Qur`an) menurut keinginannya.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4788,
      "text": "Tidak lain (Al-Qur`an itu) adalah wahyu yang diwahyukan (kepadanya),",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4789,
      "text": "yang diajarkan kepadanya oleh (Jibril) yang sangat kuat,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4790,
      "text": "yang mempunyai keteguhan; maka (Jibril itu) menampakkan diri dengan rupa yang asli (rupa yang bagus dan perkasa)",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4791,
      "text": "Sedang dia berada di ufuk yang tinggi.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4792,
      "text": "Kemudian dia mendekat (pada Muhammad), lalu bertambah dekat,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4793,
      "text": "sehingga jaraknya (sekitar) dua busur panah atau lebih dekat (lagi).",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4794,
      "text": "Lalu disampaikannya wahyu kepada hamba-Nya (Muhammad) apa yang telah diwahyukan Allah.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4795,
      "text": "Hatinya tidak mendustakan apa yang telah dilihatnya.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4796,
      "text": "Maka apakah kamu (musyrikin Mekkah) hendak membantahnya tentang apa yang dilihatnya itu?",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4797,
      "text": "Dan sungguh, dia (Muhammad) telah melihatnya (dalam rupanya yang asli) pada waktu yang lain,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4798,
      "text": "(yaitu) di Sidratilmuntahā,817)",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4799,
      "text": "di dekatnya ada surga tempat tinggal,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4800,
      "text": "(Muhammad melihat Jibril) ketika Sidratilmuntahā diliputi oleh sesuatu yang meliputinya,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4801,
      "text": "penglihatannya (Muhammad) tidak menyimpang dari yang dilihatnya itu dan tidak (pula) melampauinya.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4802,
      "text": "Sungguh, dia telah melihat sebagian tanda-tanda (kebesaran) Tuhannya yang paling besar.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4803,
      "text": "Maka apakah patut kamu (orang-orang musyrik) menganggap (berhala) Al-Lāta dan Al-'Uzzā,",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4804,
      "text": "dan Manāt, yang ketiga yang paling kemudian (sebagai anak perempuan Allah).",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4805,
      "text": "Apakah (pantas) untuk kamu yang laki-laki dan untuk-Nya yang perempuan?",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4806,
      "text": "Yang demikian itu tentulah suatu pembagian yang timpang.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4807,
      "text": "Itu tidak lain hanyalah nama-nama yang kamu dan nenek moyangmu mengada-adakannya; Allah tidak menurunkan suatu keterangan apa pun untuk (menyembah)nya. Mereka hanya mengikuti dugaan, dan apa yang diingini oleh keinginannya. Padahal sungguh, telah datang petunjuk dari Tuhan mereka.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4808,
      "text": "Atau apakah manusia akan mendapat segala yang dicita-citakannya?",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4809,
      "text": "(Tidak!) Maka milik Allah lah kehidupan akhirat dan kehidupan dunia.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 460,
      "hizbQuarter": 210,
      "sajda": false
    },
    {
      "number": 4810,
      "text": "Dan betapa banyak malaikat di langit, syafaat (pertolongan) mereka sedikit pun tidak berguna kecuali apabila Allah telah mengizinkan (dan hanya) bagi siapa yang Dia kehendaki dan Dia ridai.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 27,
      "manzil": 7,
      "page": 526,
      "ruku": 461,
      "hizbQuarter": 211,
      "sajda": false
    }
  ],
  "language": "id"
}
