  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 1854,
      "text": "Ketika mereka masuk ke tempatnya, lalu mereka mengucapkan, \"Salām.\" Dia (Ibrahim) berkata, \"Kami benar-benar merasa takut kepadamu.\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 52,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1855,
      "text": "(Mereka) berkata, \"Janganlah engkau merasa takut, sesungguhnya kami memberi kabar gembira kepadamu dengan (kelahiran seorang) anak laki-laki (yang akan menjadi) orang yang pandai (Ishak).\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 53,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1856,
      "text": "Dia (Ibrahim) berkata, \"Benarkah kamu memberi kabar gembira kepadaku padahal usiaku telah lanjut, lalu (dengan cara) bagaimana kamu memberi (kabar gembira) tersebut?\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 54,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1857,
      "text": "(Mereka) menjawab, \"Kami menyampaikan kabar gembira kepadamu dengan benar, maka janganlah engkau termasuk orang yang berputus asa!\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 55,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1858,
      "text": "Dia (Ibrahim) berkata, \"Tidak ada yang berputus asa dari rahmat Tuhannya, kecuali orang yang sesat.\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 56,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1859,
      "text": "Dia (Ibrahim) berkata, \"Apakah perkara pentingmu, wahai para utusan?\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 57,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1860,
      "text": "(Mereka) menjawab, \"Sesungguhnya kami diutus kepada kaum yang berdosa,",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 58,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1861,
      "text": "kecuali para pengikut Luṭ. Sesungguhnya kami pasti menyelamatkan mereka semuanya,",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1862,
      "text": "kecuali istrinya, kami telah menentukan, bahwa dia termasuk orang yang tertinggal (bersama orang kafir lainnya).\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 60,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1863,
      "text": "Maka ketika utusan itu datang kepada para pengikut Luṭ,",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 61,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1864,
      "text": "dia (Luṭ) berkata, \"Sesungguhnya kamu orang yang tidak kami kenal.\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 62,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1865,
      "text": "(Para utusan) menjawab, \"Sebenarnya kami ini datang kepadamu membawa azab yang selalu mereka dustakan.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 63,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1866,
      "text": "Dan kami datang kepadamu membawa kebenaran, dan sungguh, kami orang yang benar.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 64,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1867,
      "text": "Maka pergilah kamu pada akhir malam beserta keluargamu, dan ikutilah mereka dari belakang! Jangan ada di antara kamu yang menoleh ke belakang dan teruskanlah perjalanan ke tempat yang diperintahkan kepadamu.\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 65,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1868,
      "text": "Dan telah Kami tetapkan kepadanya (Luṭ) keputusan itu, bahwa akhirnya mereka akan ditumpas habis pada waktu subuh.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 66,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1869,
      "text": "Dan datanglah penduduk kota itu[437] (ke rumah Luṭ) dengan gembira (karena kedatangan tamu itu).",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 67,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1870,
      "text": "Dia (Luṭ) berkata, \"Sesungguhnya mereka adalah tamuku; maka jangan kamu mempermalukan aku,",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 68,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1871,
      "text": "dan bertakwalah kepada Allah dan janganlah kamu membuat aku terhina!\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 69,
      "juz": 14,
      "manzil": 3,
      "page": 265,
      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1872,
      "text": "(Mereka) berkata, \"Bukankah kami telah melarangmu dari (melindungi) manusia?\"[438]",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
