  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 6073,
      "text": "yang hanya dimasuki oleh orang yang paling celaka,",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6074,
      "text": "yang mendustakan (kebenaran) dan berpaling (dari iman).",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6075,
      "text": "Dan akan dijauhkan darinya (neraka) orang yang paling bertakwa,",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6076,
      "text": "yang menginfakkan hartanya (di jalan Allah) untuk membersihkan (dirinya),",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6077,
      "text": "dan tidak ada seorang pun memberikan suatu nikmat padanya yang harus dibalasnya,",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6078,
      "text": "tetapi (dia memberikan itu semata-mata) karena mencari keridaan Tuhannya Yang Mahatinggi.",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6079,
      "text": "Dan niscaya kelak dia akan mendapat kesenangan (yang sempurna).",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6080,
      "text": "Demi waktu duha (ketika matahari naik sepenggalan).",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6081,
      "text": "Dan demi malam apabila telah sunyi.",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6082,
      "text": "Tuhanmu tidak meninggalkan engkau (Muhammad) dan tidak (pula) membencimu.[910]",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6083,
      "text": "Dan sungguh, yang kemudian itu lebih baik bagimu daripada yang permulaan.[911]",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6084,
      "text": "Dan sungguh, kelak Tuhanmu pasti memberikan karunia-Nya kepadamu, sehingga engkau menjadi puas.",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6085,
      "text": "Bukankah Dia mendapatimu sebagai seorang yatim, lalu Dia melindungi(mu).",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6086,
      "text": "Dan Dia mendapatimu sebagai seorang yang bingung,[912] lalu Dia memberikan petunjuk.",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6087,
      "text": "Dan Dia mendapatimu sebagai seorang yang kekurangan, lalu Dia memberikan kecukupan.",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6088,
      "text": "Maka terhadap anak yatim janganlah engkau berlaku sewenang-wenang.",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6089,
      "text": "Dan terhadap orang yang meminta-minta, janganlah engkau menghardik(nya).",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6090,
      "text": "Dan terhadap nikmat Tuhanmu, hendaklah engkau nyatakan (dengan bersyukur).",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6091,
      "text": "Bukankah kami telah melapangkan dadamu (Muhammad)?",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6092,
      "text": "Dan kami pun telah menurunkan beban darimu,[913]",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6093,
      "text": "yang memberatkan punggungmu,",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6094,
      "text": "dan kami tinggikan sebutan (nama)mu[914] bagimu.",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6095,
      "text": "Maka sesungguhnya bersama kesulitan ada kemudahan,",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6096,
      "text": "sesungguhnya bersama kesulitan ada kemudahan.",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6097,
      "text": "Maka apabila engkau telah selesai (dari suatu urusan), tetaplah bekerja keras (untuk urusan yang lain),[915]",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6098,
      "text": "dan hanya kepada Tuhanmulah engkau berharap.",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
