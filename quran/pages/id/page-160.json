  "ayahs": [
    {
      "number": 1028,
      "text": "Dan ingatlah ketika Dia menjadikan kamu khalifah-khalifah setelah kaum 'Ad dan menempatkan kamu di bumi. Di tempat yang datar kamu dirikan istana-istana dan di bukit-bukit kamu pahat menjadi rumah-rumah. Maka ingatlah nikmat-nikmat Allah dan janganlah kamu membuat kerusakan di bumi.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 74,
