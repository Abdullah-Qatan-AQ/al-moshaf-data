  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 2972,
      "text": "agar kita mengikuti para penyihir itu, jika mereka yang menang.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2973,
      "text": "Maka ketika para penyihir datang, mereka berkata kepada Fir'aun, \"Apakah kami benar-benar akan mendapat imbalan yang besar jika kami yang menang?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 41,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2974,
      "text": "Dia (Fir'aun) menjawab, \"Ya, dan bahkan kamu pasti akan mendapat kedudukan yang dekat (dariku).\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2975,
      "text": "Dia (Musa) berkata kepada mereka, \"Lemparkanlah apa yang hendak kamu lemparkan.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2976,
      "text": "Lalu mereka melemparkan tali-temali dan tongkat-tongkat mereka seraya berkata, \"Demi kemuliaan Fir'aun, pasti kamilah yang akan menang.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2977,
      "text": "Kemudian Musa melemparkan tongkatnya, maka tiba-tiba ia menelan benda-benda palsu yang mereka ada-adakan itu.[586]",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2978,
      "text": "Maka menyungkurlah para penyihir itu, bersujud.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 46,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2979,
      "text": "Mereka berkata, \"Kami beriman kepada Tuhan seluruh alam,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 47,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2980,
      "text": "(yaitu) Tuhannya Musa dan Harun.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 48,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2981,
      "text": "Dia (Fir'aun) berkata, \"Mengapa kamu beriman kepada Musa sebelum aku memberi izin kepadamu? Sesungguhnya dia pemimpinmu yang mengajarkan sihir kepadamu. Nanti kamu pasti akan tahu (akibat perbuatanmu). Pasti akan kupotong tangan dan kakimu bersilang, dan sungguh akan aku menyalib kamu semuanya.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 49,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2982,
      "text": "Mereka berkata, \"Tidak ada yang kami takutkan, karena kami akan kembali kepada Tuhan kami.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 50,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2983,
      "text": "Sesungguhnya kami sangat menginginkan sekiranya Tuhan kami akan mengampuni kesalahan kami, karena menjadi orang yang pertama-tama beriman.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 51,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2984,
      "text": "Dan Kami wahyukan (perintahkan) kepada Musa, \"Pergilah pada malam hari dengan membawa hamba-hamba-Ku (Bani Israil), sebab pasti kamu akan dikejar.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 52,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 318,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2985,
      "text": "Kemudian Fir'aun mengirimkan orang ke kota-kota untuk mengumpulkan (bala tentaranya).",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 53,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2986,
      "text": "(Fir'aun berkata), \"Sesungguhnya mereka (Bani Israil) hanya sekelompok kecil,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 54,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2987,
      "text": "dan sesungguhnya mereka telah berbuat hal-hal yang menimbulkan amarah kita,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 55,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2988,
      "text": "dan sesungguhnya kita semua tanpa kecuali harus selalu waspada.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 56,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2989,
      "text": "Kemudian, Kami keluarkan mereka (Fir'aun dan kaumnya) dari taman-taman dan mata air,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 57,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2990,
      "text": "dan (dari) harta kekayaan dan kedudukan yang mulia,[587]",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 58,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2991,
      "text": "Demikianlah, dan Kami anugerahkan semuanya (itu) kepada Bani Israil.[588]",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 19,
      "manzil": 5,
      "page": 369,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2992,
      "text": "Lalu (Fir'aun dan bala tentaranya) dapat menyusul mereka pada waktu matahari terbit.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 60,
      "juz": 19,
      "manzil": 5,
