  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 1803,
      "text": "Alif Lām Rā`. (Surah) ini adalah (sebagian dari) ayat-ayat Kitab (yang sempurna) yaitu (ayat-ayat) Al-Qur`an yang memberi penjelasan.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1804,
      "text": "Orang kafir itu kadang-kadang (nanti di akhirat) menginginkan sekiranya mereka dahulu (di dunia) menjadi orang muslim.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1805,
      "text": "Biarkanlah mereka (di dunia ini) makan dan bersenang-senang dan dilalaikan oleh angan-angan (kosong) mereka, kelak mereka akan mengetahui (akibat perbuatannya).",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1806,
      "text": "Dan Kami tidak membinasakan suatu negeri, melainkan sudah ada ketentuan yang di tetapkan baginya.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1807,
      "text": "Tidak ada suatu umat pun yang dapat mendahului ajalnya, dan tidak (pula) dapat meminta penundaan(nya).",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1808,
      "text": "Dan mereka berkata, \"Wahai orang yang kepadanya diturunkan Al-Qur`an, sesungguhnya engkau (Muhammad) benar-benar orang yang gila.431)",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1809,
      "text": "Mengapa engkau tidak mendatangkan malaikat kepada kami, jika engkau termasuk orang yang benar?\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1810,
      "text": "Kami tidak menurunkan malaikat melainkan dengan kebenaran (untuk membawa azab) dan mereka ketika itu tidak diberi penangguhan.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1811,
      "text": "Sesungguhnya Kamilah yang menurunkan Al-Qur`an, dan pasti Kami (pula) yang memeliharanya.432)",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1812,
      "text": "Dan sungguh, Kami telah mengutus (beberapa rasul) sebelum engkau (Muhammad) kepada umat-umat terdahulu.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1813,
      "text": "Dan setiap kali seorang rasul datang kepada mereka, mereka selalu memperolok-olokannya.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1814,
      "text": "Demikianlah, Kami memasukkannya (olok-olok itu) ke dalam hati orang yang berdosa,",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1815,
      "text": "mereka tidak beriman kepadanya (Al-Qur`an) padahal telah berlalu sunnatullah433) terhadap orang-orang terdahulu.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1816,
      "text": "Dan kalau Kami bukakan kepada mereka salah satu pintu langit, lalu mereka terus menerus naik ke atasnya,",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 14,
      "manzil": 3,
      "page": 262,
      "ruku": 218,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1817,
      "text": "tentulah mereka berkata, \"Sesungguhnya pandangan kamilah yang dikaburkan, bahkan kami adalah orang yang terkena sihir.\"",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 14,
      "manzil": 3,
      "page": 262,
