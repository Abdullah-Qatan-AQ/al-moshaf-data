{
  "page": 597,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 6099,
      "text": "Demi (buah) Tin dan (buah) Zaitun.916)",
      "surah": {
        "number": 95,
        "name": "سُورَةُ التِّينِ",
        "englishName": "At-Tin",
        "englishNameTranslation": "The Fig",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6100,
      "text": "Demi gunung Sinai. 917)",
      "surah": {
        "number": 95,
        "name": "سُورَةُ التِّينِ",
        "englishName": "At-Tin",
        "englishNameTranslation": "The Fig",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6101,
      "text": "Dan demi negeri (Mekkah) yang aman ini.",
      "surah": {
        "number": 95,
        "name": "سُورَةُ التِّينِ",
        "englishName": "At-Tin",
        "englishNameTranslation": "The Fig",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6102,
      "text": "Sungguh, Kami telah menciptakan manusia dalam bentuk yang sebaik-baiknya,",
      "surah": {
        "number": 95,
        "name": "سُورَةُ التِّينِ",
        "englishName": "At-Tin",
        "englishNameTranslation": "The Fig",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6103,
      "text": "kemudian Kami kembalikan dia ke tempat yang serendah-rendahnya,",
      "surah": {
        "number": 95,
        "name": "سُورَةُ التِّينِ",
        "englishName": "At-Tin",
        "englishNameTranslation": "The Fig",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6104,
      "text": "kecuali orang-orang yang beriman dan mengerjakan kebajikan; maka mereka akan mendapat pahala yang tidak ada putus-putusnya.",
      "surah": {
        "number": 95,
        "name": "سُورَةُ التِّينِ",
        "englishName": "At-Tin",
        "englishNameTranslation": "The Fig",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6105,
      "text": "Maka apa yang menyebabkan (mereka) mendustakanmu (tentang) hari pembalasan setelah (adanya keterangan-keterangan) itu?",
      "surah": {
        "number": 95,
        "name": "سُورَةُ التِّينِ",
        "englishName": "At-Tin",
        "englishNameTranslation": "The Fig",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6106,
      "text": "Bukankah Allah Hakim yang paling adil?",
      "surah": {
        "number": 95,
        "name": "سُورَةُ التِّينِ",
        "englishName": "At-Tin",
        "englishNameTranslation": "The Fig",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 537,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6107,
      "text": "Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan.",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6108,
      "text": "Dia telah menciptakan manusia dari segumpal darah.",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6109,
      "text": "Bacalah, dan Tuhanmulah Yang Mahamulia.",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6110,
      "text": "Yang mengajar (manusia) dengan pena.",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6111,
      "text": "Dia mengajarkan manusia apa yang tidak diketahuinya.",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6112,
      "text": "Sekali-sekali tidak! Sungguh, manusia itu benar-benar melampaui batas,",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6113,
      "text": "apabila melihat dirinya serba cukup.",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6114,
      "text": "Sungguh, hanya kepada Tuhanmulah tempat kembali(mu).",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6115,
      "text": "Bagaimana pendapatmu tentang orang yang melarang,",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6116,
      "text": "seorang hamba ketika dia melaksanakan salat?918)",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6117,
      "text": "Bagaimana pendapatmu jika dia (yang dilarang salat itu) berada di atas kebenaran (petunjuk),",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6118,
      "text": "atau dia menyuruh bertakwa (kepada Allah)?",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6119,
      "text": "Bagaimana pendapatmu jika dia (yang melarang) itu mendustakan dan berpaling?",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6120,
      "text": "Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6121,
      "text": "Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian) niscaya Kami tarik ubun-ubunnya (ke dalam neraka),",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6122,
      "text": "(yaitu) ubun-ubun orang yang mendustakan dan durhaka.",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6123,
      "text": "Maka biarlah dia memanggil golongannya (untuk menolongnya).",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6124,
      "text": "Kelak Kami akan memanggil Malaikat Zabaniyah (penyiksa orang-orang yang berdosa).",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6125,
      "text": "Sekali-kali tidak! Janganlah kamu patuh kepadanya; dan sujudlah serta dekatkanlah (dirimu kepada Allah).",
      "surah": {
        "number": 96,
        "name": "سُورَةُ العَلَقِ",
        "englishName": "Al-Alaq",
        "englishNameTranslation": "The Clot",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 597,
      "ruku": 538,
      "hizbQuarter": 239,
      "sajda": {
