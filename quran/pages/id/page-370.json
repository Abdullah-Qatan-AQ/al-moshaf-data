  "ayahs": [
    {
      "number": 2993,
      "text": "Maka ketika kedua golongan itu saling melihat, berkatalah pengikut-pengikut Musa, \"Kita benar-benar akan tersusul.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 61,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2994,
      "text": "Dia (Musa) menjawab, \"Sekali-kali tidak akan (tersusul); sesungguhnya Tuhanku bersamaku, Dia akan memberi petunjuk kepadaku.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 62,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2995,
      "text": "Lalu Kami wahyukan kepada Musa, \"Pukullah laut itu dengan tongkatmu.\" Maka terbelahlah lautan itu, dan setiap belahan seperti gunung yang besar.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 63,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2996,
      "text": "Dan di sanalah Kami dekatkan golongan yang lain.589)",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 64,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2997,
      "text": "Dan Kami selamatkan Musa dan orang-orang yang bersamanya.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 65,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2998,
      "text": "Kemudian Kami tenggelamkan golongan yang lain.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 66,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2999,
      "text": "Sungguh, pada yang demikian itu terdapat suatu tanda (kekuasaan Allah), tetapi kebanyakan mereka tidak beriman.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 67,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3000,
      "text": "Dan sesungguhnya Tuhanmu Dialah Yang Mahaperkasa, Maha Penyayang.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 68,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3001,
      "text": "Dan bacakanlah kepada mereka kisah Ibrahim.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 69,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3002,
      "text": "Ketika dia (Ibrahim) berkata kepada ayahnya dan kaumnya, \"Apakah yang kamu sembah?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 70,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3003,
      "text": "Mereka menjawab, \"Kami menyembah berhala-berhala dan kami senantiasa tekun menyembahnya.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 71,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3004,
      "text": "Dia (Ibrahim) berkata, \"Apakah mereka mendengarmu ketika kamu berdoa (kepadanya)?",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 72,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3005,
      "text": "Atau (dapatkah) mereka memberi manfaat atau mencelakakan kamu?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 73,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3006,
      "text": "Mereka menjawab, \"Tidak, tetapi kami dapati nenek moyang kami berbuat begitu.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 74,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3007,
      "text": "Dia (Ibrahim) berkata, \"Apakah kamu memperhatikan apa yang kamu sembah,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 75,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3008,
      "text": "kamu dan nenek moyang kamu yang terdahulu?",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 76,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3009,
      "text": "Sesungguhnya mereka (apa yang kamu sembah) itu musuhku, lain halnya Tuhan seluruh alam,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 77,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3010,
      "text": "(yaitu) Yang telah menciptakan aku, maka Dia yang memberi petunjuk kepadaku,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 78,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3011,
      "text": "dan Yang memberi makan dan minum kepadaku,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 79,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3012,
      "text": "dan apabila aku sakit, Dialah yang menyembuhkan aku,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 80,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3013,
      "text": "dan Yang akan mematikanku, kemudian akan menghidupkanku (kembali),",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 81,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3014,
      "text": "dan Yang sangat ku inginkan akan mengampuni kesalahanku pada hari Kiamat.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 82,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3015,
      "text": "(Ibrahim berdoa), \"Ya Tuhanku, berikanlah kepadaku ilmu dan masukkanlah aku ke dalam golongan orang-orang yang saleh,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
