  "ayahs": [
    {
      "number": 3393,
      "text": "Dan mereka meminta kepadamu agar segera diturunkan azab. Kalau bukan karena waktunya yang telah ditetapkan,[629] niscaya datang azab kepada mereka, dan (azab itu) pasti akan datang kepada mereka dengan tiba-tiba, sedang mereka tidak menyadarinya.",
      "surah": {
        "number": 29,
        "name": "سُورَةُ العَنكَبُوتِ",
        "englishName": "Al-Ankaboot",
        "englishNameTranslation": "The Spider",
        "numberOfAyahs": 69,
        "revelationType": "Meccan"
      },
      "numberInSurah": 53,
      "juz": 21,
      "manzil": 5,
      "page": 403,
