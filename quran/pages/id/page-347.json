  "ayahs": [
    {
      "number": 2748,
      "text": "Dan sekiranya mereka Kami kasihani, dan Kami lenyapkan malapetaka yang menimpa mereka,554) pasti mereka akan terus menerus terombang-ambing dalam kesesatan mereka.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 75,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 298,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2749,
      "text": "Dan sungguh Kami telah menimpakan siksaan kepada mereka,555) tetapi mereka tidak mau tunduk kepada Tuhannya, dan (juga) tidak merendahkan diri.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 76,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 298,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2750,
      "text": "Sehingga apabila Kami bukakan untuk mereka pintu azab yang sangat keras, seketika itu mereka menjadi putus asa.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 77,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 298,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2751,
      "text": "Dan Dialah yang telah menciptakan bagimu pendengaran, penglihatan dan hati nurani, tetapi sedikit sekali kamu yang bersyukur.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 78,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2752,
      "text": "Dan Dialah yang menciptakan dan mengembangbiakkan kamu di bumi dan kepada-Nyalah kamu akan dikumpulkan.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 79,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2753,
      "text": "Dan Dialah yang menghidupkan dan mematikan, dan Dialah yang (mengatur) pergantian malam dan siang. Tidakkah kamu mengerti?",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 80,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2754,
      "text": "Bahkan mereka mengucapkan perkataan yang serupa dengan apa yang diucapkan oleh orang-orang terdahulu.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 81,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2755,
      "text": "Mereka berkata, \"Apakah betul, apabila kami telah mati dan telah menjadi tanah dan tulang belulang, kami benar-benar akan dibangkitkan kembali?",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 82,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2756,
      "text": "Sungguh, yang demikian ini sudah dijanjikan kepada kami dan kepada nenek moyang kami dahulu,556) ini hanyalah dongeng orang-orang terdahulu!\"",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 83,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2757,
      "text": "Katakanlah (Muhammad), \"Milik siapakah bumi, dan semua yang ada di dalamnya, jika kamu mengetahui?\"",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 84,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2758,
      "text": "Mereka akan menjawab, \"Milik Allah.\" Katakanlah, \"Maka apakah kamu tidak ingat?\"",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 85,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2759,
      "text": "Katakanlah, \"Siapakah Tuhan yang memiliki langit yang tujuh dan yang memiliki Arasy yang agung?\"",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 86,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2760,
      "text": "Mereka akan menjawab, \"(Milik) Allah.\" Katakanlah, \"Maka mengapa kamu tidak bertakwa?\"",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 87,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2761,
      "text": "Katakanlah, \"Siapakah yang di tangan-Nya berada kekuasaan segala sesuatu. Dia melindungi, dan tidak ada yang dapat dilindungi (dari azab-Nya), jika kamu mengetahui?\"",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 88,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    },
    {
      "number": 2762,
      "text": "Mereka akan menjawab, \"(Milik) Allah.\" Katakanlah, \"(Kalau demikian), maka bagaimana kamu sampai tertipu?\"",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 89,
      "juz": 18,
      "manzil": 4,
      "page": 347,
      "ruku": 299,
      "hizbQuarter": 139,
      "sajda": false
    }
  ],
