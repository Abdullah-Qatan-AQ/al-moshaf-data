  "ayahs": [
    {
      "number": 3182,
      "text": "Sungguh, aku mendapati ada seorang perempuan[596] yang memerintah mereka, dan dia dianugerahi segala sesuatu serta memiliki singgasana yang besar.",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 328,
      "hizbQuarter": 151,
      "sajda": false
    },
    {
      "number": 3183,
      "text": "Aku (burung Hudhud) mendapatinya dan kaumnya menyembah matahari, bukan kepada Allah; dan setan telah menjadikan tampak indah bagi mereka perbuatan-perbuatan (buruk) mereka, sehingga menghalangi mereka dari jalan (Allah), maka mereka tidak mendapat petunjuk.",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 328,
      "hizbQuarter": 151,
      "sajda": false
    },
    {
      "number": 3184,
      "text": "Mereka (juga) tidak menyembah Allah yang mengeluarkan apa yang terpendam di langit dan di bumi[597] dan yang mengetahui apa yang kamu sembunyikan dan yang kamu tampakkan.",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 328,
      "hizbQuarter": 151,
      "sajda": false
    },
    {
      "number": 3185,
      "text": "Allah, tidak ada tuhan melainkan Dia, Tuhan Yang mempunyai Arasy yang agung.\"",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 328,
      "hizbQuarter": 151,
      "sajda": {
        "id": 9,
        "recommended": true,
        "obligatory": false
      }
    },
    {
      "number": 3186,
      "text": "Dia (Sulaiman) berkata, \"Akan kami lihat, apa kamu benar, atau termasuk yang berdusta.",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 328,
      "hizbQuarter": 152,
      "sajda": false
    },
    {
      "number": 3187,
      "text": "Pergilah dengan (membawa) suratku ini, lalu jatuhkanlah kepada mereka, kemudian berpalinglah dari mereka, lalu perhatikanlah apa yang mereka bicarakan.\"",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 328,
      "hizbQuarter": 152,
      "sajda": false
    },
    {
      "number": 3188,
      "text": "Dia (Balqis) berkata, \"Wahai para pembesar! Sesungguhnya telah disampaikan kepadaku sepucuk surat yang mulia.\"",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 328,
      "hizbQuarter": 152,
      "sajda": false
    },
    {
      "number": 3189,
      "text": "Sesungguhnya (surat) itu dari Sulaiman yang isinya, \"Dengan nama Allah Yang Maha Pengasih, Maha Penyayang.",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 328,
      "hizbQuarter": 152,
      "sajda": false
    },
    {
      "number": 3190,
      "text": "Janganlah engkau berlaku sombong terhadapku dan datanglah kepadaku sebagai orang-orang yang berserah diri.\"",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 31,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 328,
      "hizbQuarter": 152,
      "sajda": false
    },
    {
      "number": 3191,
      "text": "Dia (Balqis) berkata, \"Wahai para pembesar! Berilah aku pertimbangan dalam perkaraku (ini). Aku tidak pernah memutuskan suatu perkara sebelum kamu hadir dalam majelis(ku).\"",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 32,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 329,
      "hizbQuarter": 152,
      "sajda": false
    },
    {
      "number": 3192,
      "text": "Mereka menjawab, \"Kita memiliki kekuatan dan keberanian yang luar biasa (untuk berperang), tetapi keputusan berada di tanganmu; maka pertimbangankanlah apa yang akan engkau perintahkan.\"",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 329,
      "hizbQuarter": 152,
      "sajda": false
    },
    {
      "number": 3193,
      "text": "Dia (Balqis) berkata, \"Sesungguhnya raja-raja apabila menaklukkan suatu negeri, mereka tentu membinasakannya, dan menjadikan penduduknya yang mulia jadi hina; dan demikian yang akan mereka perbuat.",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 329,
      "hizbQuarter": 152,
      "sajda": false
    },
    {
      "number": 3194,
      "text": "Dan sungguh, aku akan mengirim utusan kepada mereka dengan (membawa) hadiah, dan (aku) akan menunggu apa yang akan dibawa kembali oleh para utusan itu.\"",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
