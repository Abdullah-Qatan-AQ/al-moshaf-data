  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 4896,
      "text": "Dan perintah Kami hanyalah (dengan) satu perkataan seperti kejapan mata.",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 50,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4897,
      "text": "Dan sungguh, telah Kami binasakan orang yang serupa dengan kamu (kekafirannya). Maka adakah orang yang mau mengambil pelajaran?",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 51,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4898,
      "text": "Dan segala sesuatu yang telah mereka perbuat tercatat dalam buku-buku catatan.",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 52,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4899,
      "text": "Dan segala (sesuatu) yang kecil maupun yang besar (semuanya) tertulis.",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 53,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4900,
      "text": "Sungguh, orang-orang yang bertakwa berada di taman-taman dan sungai-sungai,",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 54,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4901,
      "text": "di tempat yang disenangi di sisi Tuhan Yang Mahakuasa.",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 55,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4902,
      "text": "(Allah) Yang Maha Pengasih,",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 1,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4903,
      "text": "Yang telah mengajarkan Al-Qur`an.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 2,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4904,
      "text": "Dia menciptakan manusia,",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 3,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4905,
      "text": "mengajarnya pandai berbicara.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 4,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4906,
      "text": "Matahari dan bulan beredar menurut perhitungan,",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 5,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4907,
      "text": "Bintang dan pepohonan, keduanya tunduk (kepada-Nya).",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 6,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4908,
      "text": "Dan langit telah ditinggikan-Nya dan Dia ciptakan keseimbangan,",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 7,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4909,
      "text": "agar kamu jangan merusak keseimbangan itu.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 8,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4910,
      "text": "Dan tegakkanlah keseimbangan itu dengan adil dan janganlah kamu mengurangi keseimbangan itu.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 9,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4911,
      "text": "Dan bumi telah dibentangkan-Nya untuk makhluk(-Nya).",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 10,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4912,
      "text": "Di dalamnya ada buah-buahan dan pohon kurma yang mempunyai kelopak mayang,",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 11,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4913,
      "text": "dan biji-bijian yang berkulit dan bunga-bunga yang harum baunya.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 12,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4914,
      "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 13,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4915,
      "text": "Dia menciptakan manusia dari tanah kering seperti tembikar.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 14,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4916,
      "text": "Dan Dia menciptakan jin dari nyala api tanpa asap.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 15,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
