      "sajda": false
    },
    {
      "number": 168,
      "text": "Sungguh, orang-orang yang kafir dan mati dalam keadaan kafir, mereka itu mendapat laknat Allah, para malaikat dan manusia seluruhnya,",
      "surah": {
        "number": 2,
