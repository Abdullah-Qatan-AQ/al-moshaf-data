  "ayahs": [
    {
      "number": 3139,
      "text": "niscaya tidak berguna bagi mereka kenikmatan yang mereka rasakan.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 207,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3140,
      "text": "Dan Kami tidak membinasakan suatu negeri, kecuali setelah ada orang-orang yang memberi peringatan kepadanya;",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 208,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3141,
      "text": "untuk (menjadi) peringatan. Dan Kami tidak berlaku zalim.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 209,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3142,
      "text": "Dan (Al-Qur`an) itu tidaklah dibawa turun oleh setan-setan.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 210,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3143,
      "text": "Dan tidaklah pantas bagi mereka (Al-Qur`an itu), dan mereka pun tidak akan sanggup.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 211,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3144,
      "text": "Sesungguhnya untuk mendengarkannya pun mereka dijauhkan.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 212,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3145,
      "text": "Maka janganlah kamu menyeru (menyembah) tuhan selain Allah, nanti kamu termasuk orang-orang yang di azab.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 213,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3146,
      "text": "Dan berilah peringatan kepada kerabat-kerabatmu (Muhammad) yang terdekat,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 214,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3147,
      "text": "dan rendahkanlah dirimu terhadap orang-orang yang beriman yang mengikutimu.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 215,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3148,
      "text": "Kemudian jika mereka mendurhakaimu maka katakanlah (Muhammad), \"Sesungguhnya aku tidak bertanggung jawab terhadap apa yang kamu kerjakan.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 216,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3149,
      "text": "Dan bertawakallah kepada (Allah) Yang Mahaperkasa, Maha penyayang,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 217,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3150,
      "text": "Yang melihat engkau ketika engkau berdiri (untuk salat),",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 218,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3151,
      "text": "dan (melihat) perubahan gerakan badanmu di antara orang-orang yang sujud.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 219,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3152,
      "text": "Sungguh, Dia Maha Mendengar, Maha Mengetahui.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 220,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3153,
      "text": "Maukah Aku beritakan kepadamu, kepada siapa setan-setan itu turun?",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 221,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3154,
      "text": "Mereka (setan) turun kepada setiap pendusta yang banyak berdosa,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 222,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3155,
      "text": "mereka menyampaikan hasil pendengaran mereka, sedangkan kebanyakan mereka orang-orang pendusta.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 223,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3156,
      "text": "Dan penyair-penyair itu diikuti oleh orang-orang yang sesat.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 224,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3157,
      "text": "Tidakkah engkau melihat bahwa mereka mengembara di setiap lembah,[591]",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 225,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3158,
      "text": "dan bahwa mereka mengatakan apa yang mereka sendiri tidak mengerjakan(nya)?",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 226,
      "juz": 19,
      "manzil": 5,
      "page": 376,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3159,
      "text": "kecuali orang-orang (penyair-penyair) yang beriman dan berbuat kebajikan dan banyak mengingat Allah dan mendapat kemenangan setelah terzalimi (karena menjawab puisi-puisi orang-orang kafir). Dan orang-orang yang zalim kelak akan tahu ke tempat mana mereka akan kembali.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
