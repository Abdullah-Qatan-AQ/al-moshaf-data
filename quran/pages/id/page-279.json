      "sajda": false
    },
    {
      "number": 2009,
      "text": "Mereka itulah orang yang hati, pendengaran dan penglihatannya telah dikunci oleh Allah. Mereka itulah orang yang lalai.",
      "surah": {
        "number": 16,
