      "hizbQuarter": 111,
      "sajda": false
    },
    {
      "number": 2008,
      "text": "Yang demikian itu disebabkan karena mereka lebih mencintai kehidupan dunia daripada akhirat, dan Allah tidak memberi petunjuk kepada kaum yang kafir.",
      "surah": {
