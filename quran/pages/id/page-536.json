{
  "page": 536,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5030,
      "text": "Kemudian sesungguhnya kamu, wahai orang-orang yang sesat lagi mendustakan!",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 51,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5031,
      "text": "pasti akan memakan pohon zaqqum,[829]",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 52,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5032,
      "text": "Maka akan penuh perutmu dengannya.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 53,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5033,
      "text": "Setelah itu kamu akan memimun air yang sangat panas.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 54,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5034,
      "text": "Maka kamu minum seperti unta (yang sangat haus) minum.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 55,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5035,
      "text": "Itulah hidangan untuk mereka pada hari pembalasan.\"",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 56,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5036,
      "text": "Kami telah menciptakan kamu, mengapa kamu tidak membenarkan (hari berbangkit)?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 57,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5037,
      "text": "Maka adakah kamu perhatikan, tentang (benih manusia) yang kamu pancarkan.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 58,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5038,
      "text": "Kamukah yang menciptakannya, ataukah Kami penciptanya?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5039,
      "text": "Kami telah menentukan kematian masing-masing kamu dan Kami tidak lemah,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 60,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5040,
      "text": "untuk menggantikan kamu dengan orang-orang yang seperti kamu (di dunia) dan membangkitkan kamu kelak (di akhirat) dalam keadaan yang tidak kamu ketahui.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 61,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5041,
      "text": "Dan sungguh, kamu telah tahu penciptaan yang pertama, mengapa kamu tidak mengambil pelajaran?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 62,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5042,
      "text": "Pernahkah kamu perhatikan benih yang kamu tanam?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 63,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5043,
      "text": "Kamukah yang menumbuhkannya ataukah Kami yang menumbuhkan?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 64,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5044,
      "text": "Sekiranya Kami kehendaki, niscaya Kami hancurkan sampai lumat; maka kamu akan heran tercengang,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 65,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5045,
      "text": "(sambil berkata), \"Sungguh, kami benar-benar menderita kerugian,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 66,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5046,
      "text": "bahkan kami tidak mendapat hasil apa pun.\"",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 67,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5047,
      "text": "Pernahkah kamu memperhatikan air yang kamu minum?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 68,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5048,
      "text": "Kamukah yang menurunkannya dari awan ataukah Kami yang menurunkan?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 69,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5049,
      "text": "Sekiranya Kami menghendaki, niscaya Kami menjadikannya asin, mengapa kamu tidak bersyukur?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 70,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5050,
      "text": "Maka pernahkah kamu memperhatikan tentang api yang kamu nyalakan (dengan kayu)?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 71,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5051,
      "text": "Kamukah yang menumbuhkan kayu itu ataukah Kami yang menumbuhkan?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 72,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5052,
      "text": "Kami menjadikannya (api itu) untuk peringatan dan bahan yang berguna bagi musafir.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 73,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5053,
      "text": "Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahabesar.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 74,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 470,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 5054,
      "text": "Lalu Aku bersumpah dengan tempat beredarnya bintang-bintang.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 75,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5055,
      "text": "Dan sesungguhnya itu benar-benar sumpah yang besar sekiranya kamu mengetahui,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 76,
      "juz": 27,
      "manzil": 7,
      "page": 536,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    }
  ],
