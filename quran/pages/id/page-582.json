{
  "page": 582,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5673,
      "text": "Tentang apakah mereka saling bertanya-tanya?",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5674,
      "text": "Tentang berita yang besar (hari berbangkit),",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5675,
      "text": "yang dalam hal itu mereka berselisih.",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5676,
      "text": "Tidak![892] Kelak mereka akan mengetahui,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5677,
      "text": "sekali lagi tidak! Kelak mereka akan mengetahui.",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5678,
      "text": "Bukankah Kami telah menjadikan bumi sebagai hamparan,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5679,
      "text": "dan gunung-gunung sebagai pasak?",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5680,
      "text": "Dan Kami menciptakan kamu berpasang-pasangan,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5681,
      "text": "dan Kami menjadikan tidurmu untuk istirahat,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5682,
      "text": "dan Kami menjadikan malam sebagai pakaian,[893]",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5683,
      "text": "dan Kami menjadikan siang untuk mencari penghidupan,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5684,
      "text": "dan Kami membangun di atas kamu tujuh (lapis langit) yang kokoh,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5685,
      "text": "dan Kami menjadikan pelita yang terang-benderang (matahari),",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5686,
      "text": "dan Kami turunkan dari awan, air hujan yang tercurah dengan lebatnya,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5687,
      "text": "untuk Kami tumbuhkan dengan air itu biji-bijian dan tanam-tanaman,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5688,
      "text": "dan kebun-kebun yang rindang.",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5689,
      "text": "Sungguh, hari keputusan adalah suatu waktu yang telah ditetapkan,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5690,
      "text": "(yaitu) pada hari (ketika) sangkakala ditiup, lalu kamu datang berbondong-bondong,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5691,
      "text": "dan langit pun dibukalah, maka terdapatlah beberapa pintu,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5692,
      "text": "dan gunung-gunungpun dijalankan sehingga menjadi fatamorgana.",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5693,
      "text": "Sungguh, (neraka) Jahanam itu (sebagai) tempat mengintai (bagi penjaga yang mengawasi isi neraka),",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5694,
      "text": "menjadi tempat kembali bagi orang-orang yang melampaui batas.",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5695,
      "text": "Mereka tinggal di sana dalam masa yang lama,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5696,
      "text": "mereka tidak merasakan kesejukan di dalamnya dan tidak (pula mendapat) minuman,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5697,
      "text": "selain air yang mendidih dan nanah,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5698,
      "text": "sebagai pembalasan yang setimpal.",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5699,
      "text": "Sesungguhnya dahulu mereka tidak pernah mengharapkan perhitungan,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5700,
      "text": "dan mereka benar-benar mendustakan ayat-ayat Kami.",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5701,
      "text": "Dan segala sesuatu telah Kami catat dalam suatu Kitab (buku catatan amalan manusia).",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5702,
      "text": "Maka karena itu rasakanlah! Maka tidak ada yang akan Kami tambahkan kepadamu selain azab.",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 30,
      "manzil": 7,
      "page": 582,
      "ruku": 518,
      "hizbQuarter": 233,
      "sajda": false
    }
  ],
