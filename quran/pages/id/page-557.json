  "ayahs": [
    {
      "number": 5209,
      "text": "Dan orang-orang yang kafir dan mendustakan ayat-ayat Kami, mereka itulah penghuni neraka, mereka kekal di dalamnya. Dan itulah seburuk-buruk tempat kembali.",
      "surah": {
        "number": 64,
        "name": "سُورَةُ التَّغَابُنِ",
        "englishName": "At-Taghaabun",
        "englishNameTranslation": "Mutual Disillusion",
        "numberOfAyahs": 18,
        "revelationType": "Medinan"
      },
      "numberInSurah": 10,
      "juz": 28,
      "manzil": 7,
      "page": 557,
