    {
      "number": 4192,
      "text": "Sesungguhnya hari Kiamat pasti akan datang, tidak ada keraguan tentangnya, akan tetapi kebanyakan manusia tidak beriman.",
      "surah": {
        "number": 40,
        "name": "سُورَةُ غَافِرٍ",
        "englishName": "Ghafir",
        "englishNameTranslation": "The Forgiver",
        "numberOfAyahs": 85,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 24,
      "manzil": 6,
      "page": 474,
