      "page": 458,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4055,
      "text": "Sungguh, Aku akan memenuhi neraka Jahanam dengan kamu dan dengan orang-orang yang mengikutimu di antara mereka semuanya.\"",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
