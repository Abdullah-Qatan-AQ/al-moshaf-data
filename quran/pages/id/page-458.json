  "ayahs": [
    {
      "number": 4054,
      "text": "(Allah) berfirman, \"Maka yang benar (adalah sumpahku), dan hanya kebenaran itulah yang Aku katakan.",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
