      "hizbQuarter": 145,
      "sajda": false
    },
    {
      "number": 2901,
      "text": "kemudian Kami menariknya (bayang-bayang itu) kepada Kami[580] sedikit demi sedikit.",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
        "englishName": "Al-Furqaan",
        "englishNameTranslation": "The Criterion",
        "numberOfAyahs": 77,
        "revelationType": "Meccan"
      },
      "numberInSurah": 46,
      "juz": 19,
