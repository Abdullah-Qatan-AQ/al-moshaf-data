      "sajda": false
    },
    {
      "number": 2900,
      "text": "Tidakkah engkau memperhatikan (penciptaan) Tuhanmu, bagaimana Dia memanjangkan (dan memendekkan) bayang-bayang; dan sekiranya Dia menghendaki, niscaya Dia menjadikannya (bayang-bayang itu) tetap, kemudian Kami jadikan matahari sebagai petunjuk,",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
        "englishName": "Al-Furqaan",
        "englishNameTranslation": "The Criterion",
        "numberOfAyahs": 77,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 19,
      "manzil": 4,
      "page": 364,
