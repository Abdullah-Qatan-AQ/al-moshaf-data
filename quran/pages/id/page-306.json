  "ayahs": [
    {
      "number": 2262,
      "text": "\"Wahai Yahya! Ambillah (pelajarilah)501) Kitab (Taurat) itu dengan sungguh-sungguh.\" Dan Kami berikan hikmah kepadanya (Yahya)502) selagi dia masih kanak-kanak,",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 264,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2263,
      "text": "dan (Kami jadikan) rasa kasih sayang (kepada sesama) dari Kami dan bersih (dari dosa). Dan dia adalah seorang yang bertakwa,",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 264,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2264,
      "text": "dan sangat berbakti kepada kedua orang tuanya, dan dia bukan orang yang sombong (bukan pula) orang yang durhaka.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 264,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2265,
      "text": "Dan kesejahteraan bagi dirinya pada hari lahirnya, pada hari wafatnya, dan pada hari dia dibangkitkan hidup kembali.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 264,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2266,
      "text": "Dan ceritakanlah (Muhammad) kisah Maryam di dalam Kitab (Alquran), (yaitu) ketika dia mengasingkan diri dari keluarganya ke suatu tempat di sebelah timur (Baitul-maqdis),",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 265,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2267,
      "text": "lalu dia memasang tabir (yang melindunginya) dari mereka; lalu Kami mengutus roh Kami (Jibril) kepadanya, maka dia menampakan diri di hadapannya dalam bentuk manusia yang sempurna.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 265,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2268,
      "text": "Dia (Maryam) berkata, \"Sungguh, aku berlindung kepada Tuhan Yang Maha Pengasih terhadapmu, jika engkau orang yang bertakwa.\"",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 265,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2269,
      "text": "Dia (Jibril) berkata, \"Sesungguhnya aku hanyalah utusan Tuhanmu, untuk menyampaikan anugerah kepadamu berupa seorang anak laki-laki yang suci.\"",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 265,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2270,
      "text": "Dia (Maryam) berkata, \"Bagaimana mungkin aku mempunyai anak laki-laki, padahal tidak pernah ada orang (laki-laki) yang menyentuhku dan aku bukan seorang pezina!\"",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 265,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2271,
      "text": "Dia (Jibril) berkata, \"Demikanlah.\" Tuhanmu berfirman, \"Hal itu mudah bagi-Ku, dan agar Kami menjadikannya suatu tanda (kebesaran Allah) bagi manusia dan sebagai rahmat dari Kami; dan hal itu adalah suatu urusan yang (sudah) diputuskan.\"",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 265,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2272,
      "text": "Maka dia (Maryam) mengandung, lalu dia mengasingkan diri dengan kandungannya itu ke tempat yang jauh.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 265,
      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2273,
      "text": "Kemudian rasa sakit akan melahirkan memaksanya (bersandar) pada pangkal pohon kurma, dia (Maryam) berkata, \"Wahai, alangkah (baiknya) aku mati sebelum ini, dan aku menjadi seorang yang tidak diperhatikan dan dilupakan.\"",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 265,
      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2274,
      "text": "Maka dia (Jibril) berseru kepadanya dari tempat yang rendah, \"Janganlah engkau bersedih hati, sesungguhnya Tuhanmu telah menjadikan anak sungai di bawahmu.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 265,
      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2275,
      "text": "Dan goyanglah pangkal pohon kurma itu ke arahmu, niscaya (pohon) itu akan menggugurkan buah kurma yang masak kepadamu.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 16,
      "manzil": 4,
      "page": 306,
      "ruku": 265,
      "hizbQuarter": 123,
      "sajda": false
    }
  ],
