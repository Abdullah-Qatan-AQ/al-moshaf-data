{
  "page": 371,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 3016,
      "text": "dan jadikanlah aku buah tutur yang baik bagi orang-orang (yang datang) kemudian,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 84,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3017,
      "text": "dan jadikanlah aku termasuk orang yang mewarisi surga yang penuh kenikmatan,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 85,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3018,
      "text": "dan ampunilah ayahku, sesungguhnya dia termasuk orang yang sesat,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 86,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3019,
      "text": "dan janganlah Engkau hinakan aku pada hari mereka dibangkitkan,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 87,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3020,
      "text": "(yaitu) pada hari (ketika) harta dan anak-anak tidak berguna,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 88,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3021,
      "text": "kecuali orang-orang yang menghadap Allah dengan hati yang bersih,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 89,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3022,
      "text": "dan surga didekatkan kepada orang-orang yang bertakwa,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 90,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3023,
      "text": "dan neraka Jahim diperlihatkan dengan jelas kepada orang-orang yang sesat,\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 91,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3024,
      "text": "dan dikatakan kepada mereka, \"Di mana berhala-berhala yang dahulu kamu sembah,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 92,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3025,
      "text": "selain Allah? Dapatkah mereka menolong kamu atau menolong diri mereka sendiri?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 93,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3026,
      "text": "Maka mereka (sesembahan itu) dijungkirkan ke dalam neraka bersama orang-orang yang sesat,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 94,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3027,
      "text": "dan bala tentara Iblis semuanya.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 95,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3028,
      "text": "Mereka berkata sambil bertengkar di dalamnya (neraka),",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 96,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3029,
      "text": "\"Demi Allah, sesungguhnya kita dahulu (di dunia) dalam kesesatan yang nyata,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 97,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3030,
      "text": "karena kita mempersamakan kamu (berhala-berhala) dengan Tuhan seluruh alam.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 98,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3031,
      "text": "Dan tidak ada yang menyesatkan kita kecuali orang-orang yang berdosa.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 99,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3032,
      "text": "Maka (sekarang) kita tidak mempunyai seorang pun pemberi syafaat (penolong),",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 100,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3033,
      "text": "dan tidak pula mempunyai teman yang akrab.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 101,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3034,
      "text": "Maka seandainya kita dapat kembali (ke dunia) niscaya kita menjadi orang-orang yang beriman.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 102,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3035,
      "text": "Sungguh, pada yang demikian itu terdapat tanda (kekuasaan Allah), tetapi kebanyakan mereka tidak beriman.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 103,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3036,
      "text": "Dan sungguh, Tuhanmu benar-benar Dialah Mahaperkasa, Maha Penyayang.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 104,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3037,
      "text": "Kaum Nuh telah mendustakan para rasul.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 105,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 321,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3038,
      "text": "Ketika saudara mereka (Nuh) berkata kepada mereka, \"Mengapa kamu tidak bertakwa?",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 106,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 321,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3039,
      "text": "Sesungguhnya aku ini seorang rasul kepercayaan (yang diutus) kepadamu,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 107,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 321,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3040,
      "text": "maka bertakwalah kamu kepada Allah dan taatlah kepadaku.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 108,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 321,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3041,
      "text": "Dan aku tidak meminta imbalan kepadamu atas ajakan ini; imbalanku hanyalah dari Tuhan seluruh alam,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 109,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 321,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3042,
      "text": "maka bertakwalah kamu kepada Allah dan taatlah kepadaku.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 110,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 321,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3043,
      "text": "Mereka berkata, \"Apakah kami harus beriman kepadamu, padahal pengikut-pengikutmu orang-orang yang hina?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 111,
      "juz": 19,
      "manzil": 5,
      "page": 371,
      "ruku": 321,
      "hizbQuarter": 149,
      "sajda": false
    }
  ],
