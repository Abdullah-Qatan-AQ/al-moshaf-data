      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6154,
      "text": "dan sesungguhnya cintanya kepada harta benar-benar berlebihan.",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
