  "ayahs": [
    {
      "number": 6138,
      "text": "Balasan mereka di sisi Tuhan mereka ialah surga 'Adn yang mengalir di bawahnya sungai-sungai; mereka kekal di dalamnya selama-lamanya. Allah rida terhadap mereka dan mereka pun rida kepada-Nya. Yang demikian itu adalah (balasan) bagi orang yang takut kepada Tuhannya.",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 540,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6139,
      "text": "Apabila bumi diguncangkan dengan guncangan yang dahsyat,",
      "surah": {
        "number": 99,
        "name": "سُورَةُ الزَّلۡزَلَةِ",
        "englishName": "Az-Zalzala",
        "englishNameTranslation": "The Earthquake",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 541,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6140,
      "text": "dan bumi telah mengeluarkan beban-beban berat (yang dikandung)nya,",
      "surah": {
        "number": 99,
        "name": "سُورَةُ الزَّلۡزَلَةِ",
        "englishName": "Az-Zalzala",
        "englishNameTranslation": "The Earthquake",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 541,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6141,
      "text": "dan manusia bertanya, \"Apa yang terjadi pada bumi ini?\"",
      "surah": {
        "number": 99,
        "name": "سُورَةُ الزَّلۡزَلَةِ",
        "englishName": "Az-Zalzala",
        "englishNameTranslation": "The Earthquake",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 541,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6142,
      "text": "Pada hari itu bumi menyampaikan beritanya,",
      "surah": {
        "number": 99,
        "name": "سُورَةُ الزَّلۡزَلَةِ",
        "englishName": "Az-Zalzala",
        "englishNameTranslation": "The Earthquake",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 541,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6143,
      "text": "karena sesungguhnya Tuhanmu telah memerintahkan (yang sedemikian itu) padanya.",
      "surah": {
        "number": 99,
        "name": "سُورَةُ الزَّلۡزَلَةِ",
        "englishName": "Az-Zalzala",
        "englishNameTranslation": "The Earthquake",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 541,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6144,
      "text": "Pada hari itu manusia keluar dari kuburnya dalam keadaan berkelompok-kelompok,922) untuk diperlihatkan kepada mereka (balasan) semua amal perbuatannya.",
      "surah": {
        "number": 99,
        "name": "سُورَةُ الزَّلۡزَلَةِ",
        "englishName": "Az-Zalzala",
        "englishNameTranslation": "The Earthquake",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 541,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6145,
      "text": "Maka barangsiapa mengerjakan kebaikan seberat zarah, niscaya dia akan melihat (balasan)nya.",
      "surah": {
        "number": 99,
        "name": "سُورَةُ الزَّلۡزَلَةِ",
        "englishName": "Az-Zalzala",
        "englishNameTranslation": "The Earthquake",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 541,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6146,
      "text": "Dan barangsiapa mengerjakan kejahatan seberat zarah, niscaya dia akan melihat (balasan)nya.",
      "surah": {
        "number": 99,
        "name": "سُورَةُ الزَّلۡزَلَةِ",
        "englishName": "Az-Zalzala",
        "englishNameTranslation": "The Earthquake",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 541,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6147,
      "text": "Demi kuda perang yang berlari kencang terengah-engah,",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6148,
      "text": "dan kuda yang memercikkan bunga api (dengan pukulan kuku kakinya),",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6149,
      "text": "dan kuda yang menyerang (dengan tiba-tiba) pada waktu pagi,",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6150,
      "text": "sehingga menerbangkan debu,",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6151,
      "text": "lalu menyerbu ke tengah-tengah kumpulan musuh,",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
