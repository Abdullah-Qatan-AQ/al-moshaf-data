      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6155,
      "text": "Maka tidakkah dia mengetahui apabila apa yang di dalam kubur dikeluarkan,",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
