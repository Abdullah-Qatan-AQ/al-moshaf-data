      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6152,
      "text": "sungguh, manusia itu sangat ingkar, (tidak bersyukur) kepada Tuhannya,",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6153,
      "text": "dan sesungguhnya dia (manusia) menyaksikan (mengakui) keingkarannya,",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
