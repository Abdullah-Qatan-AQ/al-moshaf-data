{
  "page": 568,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5358,
      "text": "Maka pada hari ini di sini tidak ada seorang teman pun baginya.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5359,
      "text": "Dan tidak ada makanan (baginya) kecuali dari darah dan nanah.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5360,
      "text": "Tidak ada yang memakannya kecuali orang-orang yang berdosa.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 500,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5361,
      "text": "Maka Aku bersumpah demi apa yang kamu lihat,",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5362,
      "text": "dan demi apa yang tidak kamu lihat.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 39,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5363,
      "text": "Sesungguhnya ia (Al-Qur`an) benar-benar wahyu (yang diturunkan kepada) Rasul yang mulia,",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5364,
      "text": "dan ia (Al-Qur`an) bukanlah perkataan seorang penyair. Sedikit sekali kamu yang beriman kepadanya.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 41,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5365,
      "text": "Dan bukan pula perkataan tukang tenung. Sedikit sekali kamu yang mengambil pelajaran darinya.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5366,
      "text": "Ia (Al-Qur`an) adalah wahyu yang diturunkan dari Tuhan seluruh alam.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5367,
      "text": "Dan sekiranya dia (Muhammad) mengada-adakan sebagian perkataan atas (nama) Kami,",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5368,
      "text": "pasti Kami pegang dia pada tangan kanannya.862)",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5369,
      "text": "Kemudian Kami potong pembuluh jantungnya.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 46,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5370,
      "text": "Maka tidak seorang pun dari kamu yang dapat menghalangi (Kami untuk menghukumnya).",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 47,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5371,
      "text": "Dan sungguh, Al-Qur`an itu pelajaran bagi orang-orang yang bertakwa.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 48,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5372,
      "text": "Dan sungguh, Kami mengetahui bahwa di antara kamu ada orang yang mendustakan.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 49,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5373,
      "text": "Dan sungguh, Al-Qur`an itu akan menimbulkan penyesalan bagi orang-orang kafir (di akhirat).",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 50,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5374,
      "text": "Dan sungguh, Al-Qur`an itu kebenaran yang meyakinkan.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 51,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5375,
      "text": "Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahaagung.",
      "surah": {
        "number": 69,
        "name": "سُورَةُ الحَاقَّةِ",
        "englishName": "Al-Haaqqa",
        "englishNameTranslation": "The Reality",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 52,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 501,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5376,
      "text": "Seseorang bertanya tentang azab yang pasti terjadi,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5377,
      "text": "Bagi orang-orang kafir, yang tidak seorang pun dapat menolaknya,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5378,
      "text": "(Azab) dari Allah, yang memiliki tempat-tempat naik.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5379,
      "text": "Para malaikat dan Jibril naik (menghadap) kepada Tuhan, dalam sehari setara dengan lima puluh ribu tahun.863)",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5380,
      "text": "Maka bersabarlah engkau (Muhammad) dengan kesabaran yang baik.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5381,
      "text": "Mereka memandang (azab) itu jauh (mustahil).",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5382,
      "text": "Sedang Kami memandangnya dekat (pasti terjadi).",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5383,
      "text": "(Ingatlah) pada hari ketika langit menjadi bagaikan cairan tembaga,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5384,
      "text": "dan gunung-gunung bagaikan bulu (yang beterbangan),",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5385,
      "text": "dan tidak ada seorang teman karib pun menanyakan temannya,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 29,
      "manzil": 7,
      "page": 568,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    }
  ],
