  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5759,
      "text": "Dia (Muhammad) berwajah masam dan berpaling,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5760,
      "text": "karena seorang buta telah datang kepadanya (Abdullah bin Ummi Maktum).",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5761,
      "text": "Dan tahukah engkau (Muhammad) barangkali dia ingin menyucikan dirinya (dari dosa),",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5762,
      "text": "atau dia (ingin) mendapatkan pengajaran, yang memberi manfaat kepadanya?",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5763,
      "text": "Adapun orang yang merasa dirinya serba cukup (pembesar-pembesar Quraisy),",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5764,
      "text": "maka engkau (Muhammad) memberi perhatian kepadanya,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5765,
      "text": "padahal tidak ada (cela) atasmu kalau dia tidak menyucikan diri (beriman).",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5766,
      "text": "Dan adapun orang yang datang kepadamu dengan bersegera (untuk mendapatkan pengajaran),",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5767,
      "text": "sedang dia takut (kepada Allah),",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5768,
      "text": "engkau (Muhammad) malah mengabaikannya.",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5769,
      "text": "Sekali-kali jangan (begitu)! Sungguh, (ajaran-ajaran Allah) itu suatu peringatan,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5770,
      "text": "maka barangsiapa menghendaki, tentulah dia akan memperhatikannya,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5771,
      "text": "di dalam kitab-kitab yang dimuliakan (di sisi Allah),",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5772,
      "text": "yang ditinggikan (dan) disucikan,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5773,
      "text": "di tangan para utusan (malaikat),",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5774,
      "text": "yang mulia lagi berbakti.",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5775,
      "text": "Celakalah manusia! Alangkah kufurnya dia!",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5776,
      "text": "Dari apakah Dia (Allah) menciptakannya?",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5777,
      "text": "Dari setetes mani, Dia menciptakannya lalu menentukannya.897)",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5778,
      "text": "Kemudian jalannya Dia mudahkan,898)",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5779,
      "text": "kemudian Dia mematikannya lalu menguburkannya,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5780,
      "text": "kemudian jika Dia menghendaki, Dia membangkitkannya kembali.",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5781,
      "text": "Sekali-kali jangan (begitu)! Dia (manusia) itu belum melaksanakan apa yang Dia (Allah) perintahkan kepadanya.",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5782,
      "text": "Maka hendaklah manusia itu memperhatikan makanannya,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5783,
      "text": "Kamilah yang telah mencurahkan air melimpah (dari langit),",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5784,
      "text": "kemudian Kami belah bumi dengan sebaik-baiknya,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5785,
      "text": "lalu di sana Kami tumbuhkan biji-bijian,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5786,
      "text": "dan anggur dan sayur-sayuran,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
