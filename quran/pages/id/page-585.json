      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5789,
      "text": "dan buah-buahan serta rerumputan.",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 31,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5790,
      "text": "(Semua itu) untuk kesenanganmu dan untuk hewan-hewan ternakmu.",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 32,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5791,
      "text": "Maka apabila datang suara yang memekakkan (tiupan sangkakala yang kedua),",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5792,
      "text": "pada hari itu manusia lari dari saudaranya,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5793,
      "text": "dan dari ibu dan bapaknya,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5794,
      "text": "dan dari istri dan anak-anaknya.",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5795,
      "text": "Setiap orang dari mereka pada hari itu mempunyai urusan yang menyibukkannya.",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5796,
      "text": "Pada hari itu ada wajah-wajah yang berseri-seri,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5797,
      "text": "tertawa dan gembira ria,",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 39,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5798,
      "text": "dan pada hari itu ada (pula) wajah-wajah yang tertutup debu (suram),",
      "surah": {
