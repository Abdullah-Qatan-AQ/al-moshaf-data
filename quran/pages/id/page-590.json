{
  "page": 590,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5910,
      "text": "Demi langit yang mempunyai gugusan bintang,",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5911,
      "text": "dan demi hari yang dijanjikan.",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5912,
      "text": "Demi yang menyaksikan dan yang disaksikan.",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5913,
      "text": "Binasalah orang-orang yang membuat parit (yaitu para pembesar Najran di Yaman),",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5914,
      "text": "yang berapi (yang mempunyai) kayu bakar,",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5915,
      "text": "ketika mereka duduk di sekitarnya,",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5916,
      "text": "sedang mereka menyaksikan apa yang mereka perbuat terhadap orang-orang mukmin.",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5917,
      "text": "Dan mereka menyiksa orang-orang mukmin itu hanya karena (orang-orang mukmin itu) beriman kepada Allah Yang Mahaperkasa, Maha Terpuji,",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5918,
      "text": "yang memiliki kerajaan langit dan bumi. Dan Allah Maha Menyaksikan segala sesuatu.",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5919,
      "text": "Sungguh, orang-orang yang mendatangkan cobaan (bencana, membunuh, menyiksa) kepada orang-orang mukmin laki-laki dan perempuan lalu mereka tidak bertobat, maka mereka akan mendapat azab Jahanam dan mereka akan mendapat azab (neraka) yang membakar.",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5920,
      "text": "Sungguh, orang-orang yang beriman dan mengerjakan kebajikan, mereka akan mendapat surga yang mengalir di bawahnya sungai-sungai, itulah kemenangan yang agung.",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5921,
      "text": "Sungguh, azab Tuhanmu sangat keras.",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5922,
      "text": "Sungguh, Dialah yang memulai penciptaan (makhluk) dan yang menghidupkannya (kembali).",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5923,
      "text": "Dan Dialah Yang Maha Pengampun, Maha Pengasih,",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5924,
      "text": "Yang memiliki Arasy, lagi Mahamulia,",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5925,
      "text": "Mahakuasa berbuat apa yang Dia kehendaki.",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5926,
      "text": "Sudahkah sampai kepadamu berita tentang bala tentara (penentang),",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5927,
      "text": "(yaitu) Fir'aun dan Samud?",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5928,
      "text": "Memang orang-orang kafir (selalu) mendustakan,",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5929,
      "text": "padahal Allah mengepung dari belakang mereka (sehingga tidak dapat lolos).",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5930,
      "text": "Bahkan (yang didustakan itu) ialah Al-Qur`an yang mulia,",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5931,
      "text": "yang (tersimpan) dalam (tempat) yang terjaga (Lauḥ Maḥfūẓ).",
      "surah": {
        "number": 85,
        "name": "سُورَةُ البُرُوجِ",
        "englishName": "Al-Burooj",
        "englishNameTranslation": "The Constellations",
        "numberOfAyahs": 22,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 590,
      "ruku": 527,
      "hizbQuarter": 236,
      "sajda": false
    }
  ],
