      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4741,
      "text": "demi lautan yang penuh gelombang,",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 27,
      "manzil": 7,
      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4742,
      "text": "sungguh, azab Tuhanmu pasti terjadi,",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 27,
      "manzil": 7,
      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4743,
      "text": "tidak sesuatu pun yang dapat menolaknya,",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 27,
      "manzil": 7,
      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4744,
      "text": "pada hari (ketika) langit berguncang sekeras-kerasnya,",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 27,
      "manzil": 7,
      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4745,
      "text": "dan gunung berjalan (berpindah-pindah).",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 27,
      "manzil": 7,
      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4746,
      "text": "Maka celakalah pada hari itu orang-orang yang mendustakan.",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 27,
      "manzil": 7,
      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4747,
      "text": "Orang-orang yang bermain-main dalam kebatilan (perbuatan dosa).",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 27,
      "manzil": 7,
      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4748,
      "text": "Pada hari (ketika) itu mereka di dorong ke neraka Jahanam dengan sekuat-kuatnya.",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 27,
      "manzil": 7,
      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4749,
      "text": "(Dikatakan kepada mereka), \"Inilah neraka yang dahulu kamu mendustakannya.\"",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
