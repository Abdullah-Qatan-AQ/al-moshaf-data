  "ayahs": [
    {
      "number": 4506,
      "text": "Dan nyatalah bagi mereka keburukan-keburukan yang mereka kerjakan, dan berlakulah (azab) terhadap mereka yang dahulu mereka perolok-olokkan.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 25,
      "manzil": 6,
      "page": 502,
      "ruku": 437,
      "hizbQuarter": 200,
      "sajda": false
    },
    {
      "number": 4507,
      "text": "Dan kepada mereka dikatakan, \"Pada hari ini Kami melupakan kamu sebagaimana kamu telah melupakan pertemuan (dengan) harimu ini; dan tempat kembalimu ialah neraka, dan sekali-kali tidak akan ada penolong bagimu.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 25,
      "manzil": 6,
      "page": 502,
      "ruku": 437,
      "hizbQuarter": 200,
      "sajda": false
    },
    {
      "number": 4508,
      "text": "Yang demikian itu karena sesungguhnya kamu telah menjadikan ayat-ayat Allah sebagai olok-olokkan, dan kamu telah ditipu oleh kehidupan dunia.\" Maka pada hari ini mereka tidak dikeluarkan dari neraka dan tidak pula mereka diberi kesempatan untuk bertobat.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 25,
      "manzil": 6,
      "page": 502,
      "ruku": 437,
      "hizbQuarter": 200,
      "sajda": false
    },
    {
      "number": 4509,
      "text": "Segala puji hanya bagi Allah, Tuhan (pemilik) langit dan bumi, Tuhan seluruh alam.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 25,
      "manzil": 6,
      "page": 502,
      "ruku": 437,
      "hizbQuarter": 200,
      "sajda": false
    },
    {
      "number": 4510,
      "text": "Dan hanya bagi-Nya segala keagungan di langit dan di bumi, dan Dialah Yang Mahaperkasa, Mahabijaksana.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 25,
      "manzil": 6,
      "page": 502,
      "ruku": 437,
      "hizbQuarter": 200,
      "sajda": false
    },
    {
      "number": 4511,
      "text": "Ḥā Mīm.",
      "surah": {
        "number": 46,
        "name": "سُورَةُ الأَحۡقَافِ",
        "englishName": "Al-Ahqaf",
        "englishNameTranslation": "The Dunes",
        "numberOfAyahs": 35,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 26,
      "manzil": 6,
      "page": 502,
      "ruku": 438,
      "hizbQuarter": 201,
      "sajda": false
    },
    {
      "number": 4512,
      "text": "Kitab ini diturunkan dari Allah Yang Mahaperkasa, Mahabijaksana.",
      "surah": {
        "number": 46,
        "name": "سُورَةُ الأَحۡقَافِ",
        "englishName": "Al-Ahqaf",
        "englishNameTranslation": "The Dunes",
        "numberOfAyahs": 35,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 26,
      "manzil": 6,
      "page": 502,
      "ruku": 438,
      "hizbQuarter": 201,
      "sajda": false
    },
    {
      "number": 4513,
      "text": "Kami tidak menciptakan langit dan bumi serta apa yang ada di antara keduanya melainkan dengan (tujuan) yang benar dan dalam waktu yang ditentukan. Namun orang-orang yang kafir berpaling dari peringatan yang diberikan kepada mereka.",
      "surah": {
        "number": 46,
        "name": "سُورَةُ الأَحۡقَافِ",
        "englishName": "Al-Ahqaf",
        "englishNameTranslation": "The Dunes",
        "numberOfAyahs": 35,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 26,
      "manzil": 6,
      "page": 502,
      "ruku": 438,
      "hizbQuarter": 201,
      "sajda": false
    },
    {
      "number": 4514,
      "text": "Katakanlah (Muhammad), \"Terangkanlah (kepadaku) tentang apa yang kamu sembah selain Allah; perlihatkan kepadaku apa yang telah mereka ciptakan dari bumi, atau adakah peran serta mereka dalam (penciptaan) langit? Bawalah kepadaku kitab sebelum (Al-Qur`an) ini atau peninggalan pengetahuan (orang-orang dahulu), jika kamu orang yang benar.\"",
      "surah": {
        "number": 46,
        "name": "سُورَةُ الأَحۡقَافِ",
        "englishName": "Al-Ahqaf",
        "englishNameTranslation": "The Dunes",
        "numberOfAyahs": 35,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 26,
      "manzil": 6,
      "page": 502,
      "ruku": 438,
      "hizbQuarter": 201,
      "sajda": false
    },
    {
      "number": 4515,
      "text": "Dan siapakah yang lebih sesat daripada orang-orang yang menyembah selain Allah, (sembahan) yang tidak dapat memperkenankan (doa)nya sampai hari Kiamat dan mereka lalai dari (memperhatikan) doa mereka?",
      "surah": {
        "number": 46,
        "name": "سُورَةُ الأَحۡقَافِ",
