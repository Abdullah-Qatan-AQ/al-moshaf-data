      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2568,
      "text": "Dan (ingatlah kisah) Ismail, Idris dan Zulkifli. Mereka semua termasuk orang-orang yang sabar,",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
