      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2572,
      "text": "Dan (ingatlah kisah) Zakaria, ketika dia berdoa kepada Tuhannya, \"Ya Tuhanku, janganlah Engkau biarkan aku hidup seorang diri (tanpa keturunan) dan Engkaulah ahli waris yang terbaik.537)",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
