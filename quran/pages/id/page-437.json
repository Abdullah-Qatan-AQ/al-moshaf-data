  "ayahs": [
    {
      "number": 3679,
      "text": "Dan tidaklah sama orang yang buta dengan orang yang melihat,",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 378,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3680,
      "text": "dan tidak (pula) sama gelap gulita dengan cahaya,",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 378,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3681,
      "text": "dan tidak (pula) sama yang teduh dengan yang panas,",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 378,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3682,
      "text": "dan tidak (pula) sama orang yang hidup dengan orang yang mati. Sungguh, Allah memberikan pendengaran kepada siapa yang Dia kehendaki dan engkau (Muhammad) tidak akan sanggup menjadikan orang yang di dalam kubur dapat mendengar.[710]",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 378,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3683,
      "text": "Engkau tidak lain hanyalah seorang pemberi peringatan.",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 378,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3684,
      "text": "Sungguh, Kami mengutus engkau dengan membawa kebenaran[711] sebagai pembawa berita gembira dan sebagai pemberi peringatan. Dan tidak ada satu pun umat melainkan di sana telah datang seorang pemberi peringatan.",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 378,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3685,
      "text": "Dan jika mereka mendustakanmu, maka sungguh, orang-orang yang sebelum mereka pun telah mendustakan (rasul-rasul); ketika rasul-rasulnya datang dengan membawa keterangan yang nyata (mukjizat), zubur, dan kitab yang memberi penjelasan yang sempurna.[712]",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 378,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3686,
      "text": "Kemudian Aku azab orang-orang yang kafir; maka (lihatlah) bagaimana akibat kemurkaan-Ku.",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 378,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3687,
      "text": "Tidakkah engkau melihat bahwa Allah menurunkan air dari langit lalu dengan air itu Kami hasilkan buah-buahan yang beraneka macam jenisnya. Dan di antara gunung-gunung itu ada garis-garis putih dan merah yang beraneka macam warnanya dan ada (pula) yang hitam pekat.",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 379,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3688,
      "text": "Dan demikian (pula) di antara manusia, makhluk bergerak yang bernyawa dan hewan-hewan ternak ada yang bermacam-macam warnanya (dan jenisnya). Di antara hamba-hamba Allah yang takut kepada-Nya, hanyalah para ulama.[713] Sungguh, Allah Mahaperkasa, Maha Pengampun.",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 379,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3689,
      "text": "Sesungguhnya orang-orang yang selalu membaca Kitab Allah (Al-Qur`an) dan melak­sana­kan salat dan menginfakkan sebagian rezeki yang Kami anugerahkan kepadanya dengan diam-diam dan terang-terangan, mereka itu mengharapkan perdagangan yang tidak akan rugi,",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 379,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3690,
      "text": "agar Allah menyempurnakan pahalanya kepada mereka dan menambah karunia-Nya. Sungguh, Allah Maha Pengampun, Maha Mensyukuri.[714]",
      "surah": {
        "number": 35,
