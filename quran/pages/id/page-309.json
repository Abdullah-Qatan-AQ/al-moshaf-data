  "ayahs": [
    {
      "number": 2302,
      "text": "Dan Kami telah memanggilnya dari sebelah kanan gunung (Sinai) dan Kami dekatkan dia untuk bercakap-cakap.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 52,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2303,
      "text": "Dan Kami telah menganugerahkan sebagian rahmat Kami kepadanya, yaitu (bahwa) saudaranya, Harun, menjadi seorang nabi.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 53,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2304,
      "text": "Dan ceritakanlah (Muhammad) kisah Ismail di dalam Kitab (Al-Qur`an). Dia benar-benar seorang yang benar janjinya, seorang rasul dan nabi.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 54,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2305,
      "text": "Dan dia menyuruh keluarganya[505] untuk (melaksanakan) salat dan (menunaikan) zakat, dan dia seorang yang diridai di sisi Tuhannya.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 55,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2306,
      "text": "Dan ceritakanlah (Muhammad), kisah Idris di dalam Kitab (Al-Qur`an). Sesungguhnya dia seorang yang sangat mencintai kebenaran dan seorang nabi,",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 56,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2307,
      "text": "dan Kami telah mengangkatnya ke martabat yang tinggi.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 57,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2308,
      "text": "Mereka itulah orang yang telah diberi nikmat oleh Allah, yaitu dari (golongan) para nabi dari keturunan Adam, dan dari orang yang Kami bawa (dalam kapal) bersama Nuh, dan dari keturunan Ibrahim dan Israil (Yakub) dan dari orang yang telah Kami beri petunjuk dan telah Kami pilih. Apabila dibacakan ayat-ayat Allah Yang Maha Pengasih kepada mereka, maka mereka tunduk sujud dan menangis.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 58,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 123,
      "sajda": {
        "id": 5,
        "recommended": true,
        "obligatory": false
      }
    },
    {
      "number": 2309,
      "text": "Kemudian datanglah setelah mereka, pengganti yang mengabaikan salat dan memperturutkan nafsunya, maka mereka kelak akan tersesat,",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 124,
      "sajda": false
    },
    {
      "number": 2310,
      "text": "kecuali orang yang bertobat, beriman dan mengerjakan kebajikan, maka mereka itu akan masuk surga dan tidak dizalimi (dirugikan) sedikit pun,",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 60,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 124,
      "sajda": false
    },
    {
      "number": 2311,
      "text": "yaitu surga Aden yang telah dijanjikan oleh Tuhan Yang Maha Pengasih kepada hamba-Nya, sekalipun (surga itu) tidak tampak. Sungguh, (janji Allah) itu pasti ditepati.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 61,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 124,
      "sajda": false
    },
    {
      "number": 2312,
      "text": "Di dalamnya mereka tidak mendengar perkataan yang tidak berguna, kecuali (ucapan) salam. Dan di dalamnya bagi mereka ada rezeki pagi dan petang.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 62,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 124,
      "sajda": false
    },
    {
      "number": 2313,
      "text": "Itulah surga yang akan Kami wariskan kepada hamba-hamba Kami yang selalu bertakwa.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 63,
      "juz": 16,
      "manzil": 4,
      "page": 309,
      "ruku": 267,
      "hizbQuarter": 124,
      "sajda": false
    },
    {
      "number": 2314,
      "text": "Dan tidaklah kami (Jibril) turun kecuali atas perintah Tuhanmu. Milik-Nya segala yang ada dihadapan kita, yang ada di belakang kita dan segala yang ada di antara keduanya, dan Tuhanmu tidak lupa.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 64,
      "juz": 16,
      "manzil": 4,
