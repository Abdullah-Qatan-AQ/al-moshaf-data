  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 2494,
      "text": "Dan berapa banyaknya (penduduk) negeri yang zalim telah Kami binasakan, dan Kami jadikan generasi yang lain setelah mereka itu (sebagai penggantinya).",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2495,
      "text": "Maka ketika mereka merasakan azab Kami, tiba-tiba mereka melarikan diri dari (negerinya) itu.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2496,
      "text": "Janganlah kamu lari tergesa-gesa; kembalilah kamu kepada kesenangan hidupmu dan tempat-tempat kediamanmu (yang baik), agar kamu dapat ditanya.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2497,
      "text": "Mereka berkata, \"Betapa celaka kami, sungguh, kami orang-orang yang zalim.\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2498,
      "text": "Maka demikianlah keluhan mereka berkepanjangan, sehingga mereka Kami jadikan sebagai tanaman yang telah dituai, yang tidak dapat hidup lagi.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2499,
      "text": "Dan Kami tidak menciptakan langit dan bumi dan segala apa yang ada di antara keduanya dengan main-main.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2500,
      "text": "Seandainya Kami hendak membuat suatu permainan (istri dan anak), tentulah Kami membuatnya dari sisi Kami,530) jika Kami benar-benar menghendaki berbuat demikian.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2501,
      "text": "Sebenarnya Kami melemparkan yang hak (kebenaran) kepada yang batil (tidak benar) lalu yang hak itu menghancurkannya, maka seketika itu (yang batil) lenyap. Dan celaka kamu karena kamu menyifati (Allah dengan sifat-sifat yang tidak pantas bagi-Nya).531)",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2502,
      "text": "Dan milik-Nya siapa yang di langit dan di bumi. Dan (malaikat-malaikat) yang di sisi-Nya, tidak mempunyai rasa angkuh untuk menyembah-Nya dan tidak (pula) merasa letih.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2503,
      "text": "Mereka (malaikat-malaikat) bertasbih tidak henti-hentinya malam dan siang.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2504,
      "text": "Apakah mereka mengambil tuhan-tuhan dari bumi, yang dapat menghidupkan (orang-orang yang mati)?",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2505,
      "text": "Seandainya pada keduanya (di langit dan di bumi) ada tuhan-tuhan selain Allah, tentu keduanya telah binasa. Mahasuci Allah yang memiliki Arasy, dari apa yang mereka sifatkan.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2506,
      "text": "Dia (Allah) tidak ditanya tentang apa yang dikerjakan, tetapi merekalah yang akan ditanya.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    },
    {
      "number": 2507,
      "text": "Atau apakah mereka mengambil tuhan-tuhan selain Dia? Katakanlah (Muhammad), \"Kemukakanlah alasan-alasanmu! (Al-Qur`an) ini adalah peringatan bagi orang yang bersamaku, dan peringatan bagi orang sebelumku.\" Tetapi kebanyakan mereka tidak mengetahui yang hak (kebenaran), karena itu mereka berpaling.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 17,
      "manzil": 4,
      "page": 323,
      "ruku": 279,
      "hizbQuarter": 129,
      "sajda": false
    }
  ],
