      "sajda": false
    },
    {
      "number": 417,
      "text": "(Ingatlah), ketika engkau (Muhammad) mengatakan kepada orang-orang beriman, \"Apakah tidak cukup bagimu bahwa Allah membantu kamu dengan tiga ribu malaikat yang diturunkan (dari langit)?\"",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
