      "hizbQuarter": 26,
      "sajda": false
    },
    {
      "number": 423,
      "text": "Wahai orang-orang yang beriman! Janganlah kamu memakan riba dengan berlipat ganda [144] dan bertakwalah kepada Allah agar kamu beruntung.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
