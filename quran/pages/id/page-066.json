      "hizbQuarter": 26,
      "sajda": false
    },
    {
      "number": 421,
      "text": "Itu bukan menjadi urusanmu (Muhammad)[143] apakah Allah menerima tobat mereka, atau mengazabnya, karena sesungguhnya mereka orang-orang zalim.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
        "numberOfAyahs": 200,
        "revelationType": "Medinan"
      },
      "numberInSurah": 128,
      "juz": 4,
      "manzil": 1,
      "page": 66,
      "ruku": 54,
      "hizbQuarter": 26,
      "sajda": false
    },
    {
      "number": 422,
      "text": "Dan milik Allahlah apa yang ada di langit dan apa yang ada di bumi. Dia mengampuni siapa yang Dia kehendaki, dan mengazab siapa yang Dia kehendaki. Dan Allah Maha Pengampun, Maha Penyayang.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
