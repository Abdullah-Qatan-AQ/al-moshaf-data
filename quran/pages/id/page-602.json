  "ayahs": [
    {
      "number": 6194,
      "text": "Karena kebiasaan orang-orang Quraisy,",
      "surah": {
        "number": 106,
        "name": "سُورَةُ قُرَيۡشٍ",
        "englishName": "Quraish",
        "englishNameTranslation": "Quraysh",
        "numberOfAyahs": 4,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 548,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6195,
      "text": "(yaitu) kebiasaan mereka bepergian pada musim dingin dan musim panas.[926]",
      "surah": {
        "number": 106,
        "name": "سُورَةُ قُرَيۡشٍ",
        "englishName": "Quraish",
        "englishNameTranslation": "Quraysh",
        "numberOfAyahs": 4,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 548,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6196,
      "text": "Maka hendaklah mereka menyembah Tuhan (pemilik) rumah ini (Ka'bah),",
      "surah": {
        "number": 106,
        "name": "سُورَةُ قُرَيۡشٍ",
        "englishName": "Quraish",
        "englishNameTranslation": "Quraysh",
        "numberOfAyahs": 4,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 548,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6197,
      "text": "yang telah memberi makanan kepada mereka untuk menghilangkan lapar dan mengamankan mereka dari rasa ketakutan.",
      "surah": {
        "number": 106,
        "name": "سُورَةُ قُرَيۡشٍ",
        "englishName": "Quraish",
        "englishNameTranslation": "Quraysh",
        "numberOfAyahs": 4,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 548,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6198,
      "text": "Tahukah kamu (orang) yang mendustakan agama?",
      "surah": {
        "number": 107,
        "name": "سُورَةُ المَاعُونِ",
        "englishName": "Al-Maa'un",
        "englishNameTranslation": "Almsgiving",
        "numberOfAyahs": 7,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6199,
      "text": "Maka itulah orang yang menghardik anak yatim,",
      "surah": {
        "number": 107,
        "name": "سُورَةُ المَاعُونِ",
        "englishName": "Al-Maa'un",
        "englishNameTranslation": "Almsgiving",
        "numberOfAyahs": 7,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6200,
      "text": "dan tidak mengajak memberi makan orang miskin.",
      "surah": {
        "number": 107,
        "name": "سُورَةُ المَاعُونِ",
        "englishName": "Al-Maa'un",
        "englishNameTranslation": "Almsgiving",
        "numberOfAyahs": 7,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6201,
      "text": "Maka celakalah orang yang salat,",
      "surah": {
        "number": 107,
        "name": "سُورَةُ المَاعُونِ",
        "englishName": "Al-Maa'un",
        "englishNameTranslation": "Almsgiving",
        "numberOfAyahs": 7,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6202,
      "text": "(yaitu) orang-orang yang lalai terhadap salatnya,[927]",
      "surah": {
        "number": 107,
        "name": "سُورَةُ المَاعُونِ",
        "englishName": "Al-Maa'un",
        "englishNameTranslation": "Almsgiving",
        "numberOfAyahs": 7,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6203,
      "text": "yang berbuat riya,[928]",
      "surah": {
        "number": 107,
        "name": "سُورَةُ المَاعُونِ",
        "englishName": "Al-Maa'un",
        "englishNameTranslation": "Almsgiving",
        "numberOfAyahs": 7,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6204,
      "text": "dan enggan (memberikan) bantuan.[929]",
      "surah": {
        "number": 107,
        "name": "سُورَةُ المَاعُونِ",
        "englishName": "Al-Maa'un",
        "englishNameTranslation": "Almsgiving",
        "numberOfAyahs": 7,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 549,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6205,
      "text": "Sungguh, Kami telah memberimu (Muhammad) nikmat yang banyak.",
      "surah": {
        "number": 108,
        "name": "سُورَةُ الكَوۡثَرِ",
        "englishName": "Al-Kawthar",
        "englishNameTranslation": "Abundance",
        "numberOfAyahs": 3,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 550,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6206,
      "text": "Maka laksanakanlah salat karena Tuhanmu, dan berkurbanlah (sebagai ibadah dan mendekatkan diri kepada Allah).",
      "surah": {
        "number": 108,
        "name": "سُورَةُ الكَوۡثَرِ",
        "englishName": "Al-Kawthar",
        "englishNameTranslation": "Abundance",
        "numberOfAyahs": 3,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 602,
      "ruku": 550,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6207,
      "text": "Sungguh, orang-orang yang membencimu dialah yang terputus (dari rahmat Allah).",
      "surah": {
        "number": 108,
        "name": "سُورَةُ الكَوۡثَرِ",
