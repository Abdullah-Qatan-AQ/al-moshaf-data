{
  "page": 374,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 3092,
      "text": "Kaum Luṭ telah mendustakan para rasul,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 160,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3093,
      "text": "ketika saudara mereka Luṭ berkata kepada mereka, \"Mengapa kamu tidak bertakwa?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 161,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3094,
      "text": "Sungguh, aku ini seorang rasul kepercayaan (yang diutus) kepadamu,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 162,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3095,
      "text": "maka bertakwalah kepada Allah dan taatlah kepadaku.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 163,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3096,
      "text": "Dan aku tidak meminta imbalan kepadamu atas ajakan ini; imbalanku hanyalah dari Tuhan seluruh alam.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 164,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3097,
      "text": "Mengapa kamu mendatangi kaum laki-laki dari manusia (berbuat homoseks),",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 165,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3098,
      "text": "dan kamu tinggalkan (perempuan) yang diciptakan Tuhan untuk menjadi istri-istri kamu? Kamu (memang) orang-orang yang melampaui batas.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 166,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3099,
      "text": "Mereka menjawab, \"Wahai Luṭ! Jika engkau tidak berhenti, tentu engkau termasuk orang-orang yang terusir.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 167,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3100,
      "text": "Dia (Luṭ) berkata, \"Aku sungguh benci kepada perbuatanmu.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 168,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3101,
      "text": "(Luṭ berdoa), \"Ya Tuhanku, selamatkanlah aku dan keluargaku dari (akibat) perbuatan yang mereka kerjakan.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 169,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3102,
      "text": "Lalu Kami selamatkan dia bersama keluarganya semua,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 170,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3103,
      "text": "kecuali seorang perempuan tua (istrinya), yang termasuk dalam golongan yang ditinggal.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 171,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3104,
      "text": "Kemudian Kami binasakan yang lain.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 172,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3105,
      "text": "Dan Kami hujani mereka (dengan hujan batu), maka betapa buruk hujan yang menimpa orang-orang yang telah diberi peringatan itu.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 173,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3106,
      "text": "Sungguh, pada yang demikian itu terdapat tanda (kekuasaan Allah), tetapi kebanyakan mereka tidak beriman.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 174,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3107,
      "text": "Dan sungguh, Tuhanmu, Dialah Yang Mahaperkasa, Maha Penyayang.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 175,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 324,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3108,
      "text": "Penduduk Aikah590) telah mendustakan para rasul;",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 176,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 325,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3109,
      "text": "Ketika Syu'aib berkata kepada mereka, \"Mengapa kamu tidak bertakwa?",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 177,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 325,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3110,
      "text": "Sungguh, aku adalah rasul kepercayaan (yang diutus) kepadamu,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 178,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 325,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3111,
      "text": "maka bertakwalah kepada Allah dan taatlah kepadaku;",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 179,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 325,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3112,
      "text": "dan aku tidak meminta imbalan kepadamu atas ajakan ini; imbalanku hanyalah dari Tuhan seluruh alam.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 180,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 325,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3113,
      "text": "Sempurnakanlah takaran dan janganlah kamu merugikan orang lain;",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 181,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 325,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3114,
      "text": "dan timbanglah dengan timbangan yang benar.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 182,
      "juz": 19,
      "manzil": 5,
      "page": 374,
      "ruku": 325,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3115,
      "text": "Dan janganlah kamu merugikan manusia dengan mengurangi hak-haknya dan janganlah membuat kerusakan di bumi;",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
