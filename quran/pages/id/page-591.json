{
  "page": 591,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5932,
      "text": "Demi langit dan yang datang pada malam hari.",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5933,
      "text": "Dan tahukah kamu apakah yang datang pada malam hari itu?",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5934,
      "text": "(Yaitu) bintang yang bersinar tajam,",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5935,
      "text": "setiap orang pasti ada penjaganya.",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5936,
      "text": "Maka hendaklah manusia memperhatikan dari apa dia diciptakan.",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5937,
      "text": "Dia diciptakan dari air (mani) yang terpancar,",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5938,
      "text": "yang keluar dari antara tulang punggung (sulbi) dan tulang dada.",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5939,
      "text": "Sungguh, Allah benar-benar kuasa untuk mengembalikannya (hidup setelah mati).",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5940,
      "text": "Pada hari ditampakkan segala rahasia,",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5941,
      "text": "maka manusia tidak lagi mempunyai suatu kekuatan dan tidak (pula) ada penolong.",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5942,
      "text": "Demi langit yang mengandung hujan,905)",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5943,
      "text": "dan bumi yang mempunyai tumbuh-tumbuhan,",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5944,
      "text": "sungguh, (Al-Qur`an) itu benar-benar firman pemisah (antara yang hak dan yang batil),",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5945,
      "text": "dan (Al-Qur`an) itu bukanlah senda gurauan.",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5946,
      "text": "Sungguh, mereka (orang kafir) merencanakan tipu daya yang jahat,",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5947,
      "text": "dan Aku pun membuat rencana (tipu daya) yang jitu.",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5948,
      "text": "Karena itu berilah penangguhan kepada orang-orang kafir. Berilah mereka kesempatan untuk sementara waktu.",
      "surah": {
        "number": 86,
        "name": "سُورَةُ الطَّارِقِ",
        "englishName": "At-Taariq",
        "englishNameTranslation": "The Morning Star",
        "numberOfAyahs": 17,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 528,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5949,
      "text": "Sucikanlah nama Tuhanmu Yang Mahatinggi,",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5950,
      "text": "yang menciptakan, lalu menyempurnakan (penciptaan-Nya),",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5951,
      "text": "yang menentukan kadar (masing-masing) dan memberi petunjuk,",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5952,
      "text": "dan Yang menumbuhkan rerumputan,",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5953,
      "text": "lalu dijadikan-Nya (rumput-rumput) itu kering kehitam-hitaman.",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5954,
      "text": "Kami akan membacakan (Al-Qur`an) kepadamu (Muhammad) sehingga engkau tidak akan lupa,",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5955,
      "text": "kecuali jika Allah menghendaki. Sungguh, Dia mengetahui yang terang dan yang tersembunyi.",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5956,
      "text": "Dan Kami akan memudahkan bagimu ke jalan kemudahan (mencapai kebahagian dunia dan akhirat),",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5957,
      "text": "oleh sebab itu berikanlah peringatan, karena peringatan itu bermanfaat,",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5958,
      "text": "orang yang takut (kepada Allah) akan mendapat pelajaran,",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5959,
      "text": "dan orang yang celaka (kafir) akan menjauhinya,",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5960,
      "text": "(yaitu) orang yang akan memasuki api yang besar (neraka),",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5961,
      "text": "selanjutnya dia di sana tidak mati dan tidak (pula) hidup.",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5962,
      "text": "Sungguh beruntung orang yang menyucikan diri (dengan beriman),",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5963,
      "text": "dan mengingat nama Tuhannya, lalu dia salat.",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
        "englishNameTranslation": "The Most High",
        "numberOfAyahs": 19,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 591,
      "ruku": 529,
      "hizbQuarter": 237,
      "sajda": false
    }
  ],
  "language": "id"
}
