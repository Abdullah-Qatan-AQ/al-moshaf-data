      "sajda": false
    },
    {
      "number": 969,
      "text": "(Allah) berfirman, \"Benar, kamu termasuk yang diberi penangguhan waktu.\"",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
