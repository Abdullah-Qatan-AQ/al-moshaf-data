      "hizbQuarter": 61,
      "sajda": false
    },
    {
      "number": 968,
      "text": "(Iblis) menjawab, \"Berilah aku penangguhan waktu, sampai hari mereka dibangkitkan.\"",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
