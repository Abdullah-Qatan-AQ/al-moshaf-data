  "ayahs": [
    {
      "number": 3705,
      "text": "Dan sekiranya Allah menghukum manusia disebabkan apa yang telah mereka perbuat, niscaya Dia tidak akan menyisakan satu pun makhluk bergerak yang bernyawa di bumi ini, tetapi Dia menangguhkan (hukuman)-nya, sampai waktu yang sudah ditentukan. Nanti apabila ajal mereka tiba, maka Allah Maha Melihat (keadaan) hamba-hamba-Nya.",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 380,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3706,
      "text": "Yā Sīn",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3707,
      "text": "Demi Al-Qur`an yang penuh hikmah,",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3708,
      "text": "sungguh, engkau (Muhammad) adalah salah seorang dari rasul-rasul,",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3709,
      "text": "(yang berada) di atas jalan yang lurus,",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3710,
      "text": "(sebagai wahyu) yang diturunkan oleh (Allah) Yang Mahaperkasa, Maha Penyayang,",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3711,
      "text": "agar engkau memberi peringatan kepada suatu kaum yang nenek moyangnya belum pernah diberi peringatan, karena itu mereka lalai.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3712,
      "text": "Sungguh, pasti berlaku perkataan (hukuman) terhadap kebanyakan mereka, karena mereka tidak beriman.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3713,
      "text": "Sungguh, Kami telah memasang belenggu di leher mereka, lalu tangan mereka (diangkat) ke dagu, karena itu mereka tertengadah.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3714,
      "text": "Dan Kami jadikan di hadapan mereka sekat (dinding) dan di belakang mereka juga sekat, dan Kami tutup (mata) mereka sehingga mereka tidak dapat melihat.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3715,
      "text": "Dan sama saja bagi mereka, apakah engkau memberi peringatan kepada mereka atau engkau tidak memberi peringatan kepada mereka, mereka tidak akan beriman juga.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3716,
      "text": "Sesungguhnya engkau hanya memberi peringatan kepada orang-orang yang mau mengikuti peringatan717) dan yang takut kepada Tuhan Yang Maha Pengasih, walaupun mereka tidak melihat-Nya. Maka berilah mereka kabar gembira dengan ampunan dan pahala yang mulia.",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 22,
      "manzil": 5,
      "page": 440,
      "ruku": 381,
      "hizbQuarter": 176,
      "sajda": false
    },
    {
      "number": 3717,
      "text": "Sungguh, Kamilah yang menghidupkan orang-orang yang mati, dan Kamilah yang mencatat apa yang telah mereka kerjakan dan bekas-bekas yang mereka (tinggalkan). Dan segala sesuatu Kami kumpulkan dalam Kitab yang jelas (Lauḥ Maḥfūẓ).",
      "surah": {
        "number": 36,
        "name": "سُورَةُ يسٓ",
        "englishName": "Yaseen",
        "englishNameTranslation": "Yaseen",
        "numberOfAyahs": 83,
        "revelationType": "Meccan"
      },
