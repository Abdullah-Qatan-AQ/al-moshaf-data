{
  "page": 586,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5801,
      "text": "Apabila matahari digulung,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5802,
      "text": "dan apabila bintang-bintang berjatuhan,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5803,
      "text": "dan apabila gunung-gunung dihancurkan,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5804,
      "text": "dan apabila unta-unta yang bunting ditinggalkan (tidak terurus),",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5805,
      "text": "dan apabila binatang-binatang liar dikumpulkan,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5806,
      "text": "dan apabila lautan dipanaskan,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5807,
      "text": "dan apabila roh-roh dipertemukan (dengan tubuh),",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5808,
      "text": "dan apabila bayi-bayi perempuan yang dikubur hidup-hidup ditanya,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5809,
      "text": "karena dosa apa dia dibunuh?",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5810,
      "text": "Dan apabila lembaran-lembaran (catatan amal) telah dibuka lebar-lebar,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5811,
      "text": "dan apabila langit dilenyapkan,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5812,
      "text": "dan apabila neraka Jahim dinyalakan,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5813,
      "text": "dan apabila surga didekatkan,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5814,
      "text": "setiap jiwa akan mengetahui apa yang telah dikerjakannya.",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5815,
      "text": "Aku bersumpah demi bintang-bintang,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5816,
      "text": "yang beredar dan terbenam,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5817,
      "text": "demi malam apabila telah larut,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5818,
      "text": "dan demi subuh apabila telah menyinsing,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5819,
      "text": "sesungguhnya (Al-Qur`an) itu benar-benar firman (Allah yang dibawa oleh) utusan yang mulia (Jibril),",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5820,
      "text": "yang memiliki kekuatan, memiliki kedudukan tinggi di sisi (Allah) yang memiliki Arasy,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5821,
      "text": "yang di sana (di alam malaikat) ditaati dan dipercaya.",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5822,
      "text": "Dan temanmu (Muhammad) itu bukanlah orang gila.",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5823,
      "text": "Dan sungguh, dia (Muhammad) telah melihatnya (Jibril) di ufuk yang terang.",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5824,
      "text": "Dan Dia (Muhammad) bukanlah seorang yang kikir (enggan) untuk menerangkan yang gaib.",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5825,
      "text": "Dan (Al-Qur`an) itu bukanlah perkataan setan yang terkutuk,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5826,
      "text": "maka ke manakah kamu akan pergi?[899]",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5827,
      "text": "(Al-Qur`an) itu tidak lain adalah peringatan bagi seluruh alam,",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5828,
      "text": "(yaitu) bagi siapa di antara kamu yang menghendaki menempuh jalan yang lurus.",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    },
    {
      "number": 5829,
      "text": "Dan kamu tidak dapat menghendaki (menempuh jalan itu) kecuali apabila dikehendaki Allah, Tuhan seluruh alam.",
      "surah": {
        "number": 81,
        "name": "سُورَةُ التَّكۡوِيرِ",
        "englishName": "At-Takwir",
        "englishNameTranslation": "The Overthrowing",
        "numberOfAyahs": 29,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 30,
      "manzil": 7,
      "page": 586,
      "ruku": 523,
      "hizbQuarter": 234,
      "sajda": false
    }
  ],
