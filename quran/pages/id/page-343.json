      "juz": 18,
      "manzil": 4,
      "page": 343,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2693,
      "text": "dan (Kami tumbuhkan) pohon (zaitun) yang tumbuh dari gunung Sinai, yang menghasilkan minyak, dan bahan pembangkit selera bagi orang-orang yang makan.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 18,
      "manzil": 4,
      "page": 343,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2694,
      "text": "Dan sungguh pada hewan-hewan ternak terdapat suatu pelajaran bagimu. Kami memberi minum kamu dari (air susu) yang ada dalam perutnya, dan padanya juga terdapat banyak manfaat untukmu, dan sebagian darinya kamu makan.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 18,
      "manzil": 4,
      "page": 343,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2695,
      "text": "Di atasnya (hewan-hewan ternak) dan di atas kapal-kapal kamu diangkut.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
