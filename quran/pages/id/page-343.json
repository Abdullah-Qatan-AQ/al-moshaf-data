      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2699,
      "text": "Dia (Nuh) berdoa, \"Ya Tuhanku, tolonglah aku, karena mereka mendustakan aku.\"",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
