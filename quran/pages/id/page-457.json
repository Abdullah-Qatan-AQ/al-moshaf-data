  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 4032,
      "text": "Dan (orang-orang durhaka) berkata, \"Mengapa kami tidak melihat orang-orang yang dahulu (di dunia) kami anggap sebagai orang-orang yang jahat (hina).",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 62,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 394,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4033,
      "text": "Dahulu kami menjadikan mereka olok-olokan, ataukah karena penglihatan kami yang tidak melihat mereka?\"",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 63,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 394,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4034,
      "text": "Sungguh, yang demikian benar-benar terjadi, (yaitu) pertengkaran di antara penghuni neraka.",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 64,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 394,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4035,
      "text": "Katakanlah (Muhammad), \"Sesungguhnya aku hanya seorang pemberi peringatan, tidak ada tuhan selain Allah Yang Maha Esa, Mahaperkasa,",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 65,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4036,
      "text": "(yaitu) Tuhan langit dan bumi serta apa yang ada di antara keduanya, Yang Mahaperkasa, Maha Pengampun.\"",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 66,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4037,
      "text": "Katakanlah, \"Itu (Al-Qur`an) adalah berita besar,",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 67,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4038,
      "text": "yang kamu berpaling darinya.",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 68,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4039,
      "text": "Aku tidak mempunyai pengetahuan sedikit pun tentang al-malaul a'lā (malaikat) ketika mereka berbantah-bantahan.",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 69,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4040,
      "text": "Yang diwahyukan kepadaku, bahwa aku hanyalah seorang pemberi peringatan yang nyata.\"",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 70,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4041,
      "text": "(Ingatlah) ketika Tuhanmu berfirman kepada malaikat, \"Sesungguhnya Aku akan menciptakan manusia dari tanah.",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 71,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4042,
      "text": "Kemudian apabila telah Aku sempurnakan kejadiannya dan Aku tiupkan roh (ciptaan)-Ku kepadanya; maka tunduklah kamu dengan bersujud kepadanya.\"",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 72,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4043,
      "text": "Lalu para malaikat itu bersujud semuanya,",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 73,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4044,
      "text": "kecuali iblis; ia menyombongkan diri dan ia termasuk golongan yang kafir.",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 74,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4045,
      "text": "(Allah) berfirman, \"Wahai iblis, apakah yang menghalangi kamu sujud kepada yang telah Aku ciptakan dengan kedua tangan-Ku. Apakah kamu menyombongkan diri atau kamu (merasa) termasuk golongan yang (lebih) tinggi?\"",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 75,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4046,
      "text": "(Iblis) berkata, \"Aku lebih baik darinya, karena Engkau ciptakan aku dari api, sedangkan dia Engkau ciptakan dari tanah.\"",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 76,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4047,
      "text": "(Allah) berfirman, \"Kalau begitu keluarlah kamu dari surga! Sesungguhnya kamu adalah makhluk yang terkutuk.",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 77,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4048,
      "text": "Dan sungguh, kutukan-Ku tetap atasmu sampai hari pembalasan.\"",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 78,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4049,
      "text": "(Iblis) berkata, \"Ya Tuhanku, tangguhkanlah aku sampai pada hari mereka dibangkitkan.\"",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 79,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4050,
      "text": "(Allah) berfirman, \"Maka sesungguhnya kamu termasuk golongan yang diberi penangguhan,",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 80,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4051,
      "text": "sampai pada hari yang telah ditentukan waktunya (hari Kiamat).\"",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 81,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4052,
      "text": "(Iblis) menjawab, \"Demi kemuliaan-Mu, pasti aku akan menyesatkan mereka semuanya,",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 82,
      "juz": 23,
      "manzil": 6,
      "page": 457,
      "ruku": 395,
      "hizbQuarter": 183,
      "sajda": false
    },
    {
      "number": 4053,
      "text": "kecuali hamba-hamba-Mu yang terpilih di antara mereka.\"755)",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 83,
      "juz": 23,
      "manzil": 6,
