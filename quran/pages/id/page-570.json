  "ayahs": [
    {
      "number": 5415,
      "text": "Maka Aku bersumpah demi Tuhan yang mengatur tempat-tempat terbit dan terbenamnya (matahari, bulan dan bintang), sungguh, Kami pasti mampu,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 503,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5416,
      "text": "untuk mengganti (mereka) dengan kaum yang lebih baik dari mereka, dan Kami tidak dapat dikalahkan.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 41,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 503,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5417,
      "text": "Maka biarkanlah mereka tenggelam dan bermain-main (dalam kesesatan) sampai mereka menjumpai hari yang diancamkan kepada mereka,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 503,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5418,
      "text": "(yaitu) pada hari ketika mereka keluar dari kubur dengan cepat seakan-akan mereka pergi dengan segera kepada berhala-berhala (sewaktu di dunia),",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 503,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5419,
      "text": "pandangan mereka tertunduk ke bawah diliputi kehinaan. Itulah hari yang diancamkan kepada mereka.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 503,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5420,
      "text": "Sesungguhnya Kami telah mengutus Nuh kepada kaumnya (dengan perintah), \"Berilah kaummu peringatan sebelum datang kepadanya azab yang pedih.\"",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5421,
      "text": "Dia (Nuh) berkata, \"Wahai kaumku! Sesungguhnya aku ini seorang pemberi peringatan yang menjelaskan kepada kamu,",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5422,
      "text": "(yaitu) sembahlah Allah, bertakwalah kepada-Nya dan taatlah kepadaku,",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5423,
      "text": "niscaya Dia mengampuni sebagian dosa-dosamu dan menangguhkan kamu (memanjangkan umurmu) sampai pada batas waktu yang ditentukan. Sungguh, ketetapan Allah itu apabila telah datang tidak dapat ditunda, seandainya kamu mengetahui.\"",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5424,
      "text": "Dia (Nuh) berkata, \"Ya Tuhanku, sesungguhnya aku telah menyeru kaumku siang dan malam,",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5425,
      "text": "tetapi seruanku itu tidak menambah (iman) mereka, justru mereka lari (dari kebenaran).",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5426,
      "text": "Dan sesungguhnya aku setiap kali menyeru mereka (untuk beriman) agar Engkau mengampuni mereka, mereka memasukkan anak jarinya ke telinganya dan menutupkan bajunya (ke wajahnya) dan mereka tetap (mengingkari) dan sangat menyombongkan diri.",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5427,
      "text": "Lalu sesungguhnya aku menyeru mereka dengan cara terang-terangan.[868]",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5428,
      "text": "Kemudian aku menyeru mereka secara terbuka dan dengan diam-diam,[869]",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 29,
      "manzil": 7,
      "page": 570,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5429,
      "text": "maka aku berkata (kepada mereka), \"Mohonlah ampunan kepada Tuhanmu, Sungguh, Dia Maha Pengampun,",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
