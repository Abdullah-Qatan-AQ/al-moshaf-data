{
  "page": 368,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 2952,
      "text": "Dia (Musa) berkata, \"Aku telah melakukannya, dan ketika itu aku termasuk orang yang khilaf.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2953,
      "text": "Lalu aku lari darimu karena aku takut kepadamu, kemudian Tuhanku menganugerahkan ilmu kepadaku serta Dia menjadikan aku salah seorang di antara rasul-rasul.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2954,
      "text": "Dan itulah kebaikan yang telah engkau berikan kepadaku, (sementara) itu engkau telah memperbudak Bani Israil.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2955,
      "text": "Fir'aun bertanya, \"Siapa Tuhan seluruh alam itu?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2956,
      "text": "Dia (Musa) menjawab, \"Tuhan Pencipta langit dan bumi dan apa yang ada di antara keduanya (itulah Tuhanmu), jika kamu mempercayai-Nya.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2957,
      "text": "Dia (Fir'aun) berkata kepada orang-orang di sekelilingnya, \"Apakah kamu tidak mendengar (apa yang dikatakannya)?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2958,
      "text": "Dia (Musa) berkata, \"(Dia) Tuhanmu dan dan juga Tuhan nenek moyangmu terdahulu.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2959,
      "text": "Dia (Fir'aun) berkata, \"Sungguh, Rasulmu yang diutus kepada kamu benar-benar orang gila.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2960,
      "text": "Dia (Musa) berkata, \"(Dialah) Tuhan (yang menguasai) timur dan barat dan apa yang ada di antara keduanya; jika kamu mengerti.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2961,
      "text": "Dia (Fir'aun) berkata, \"Sungguh, jika engkau menyembah Tuhan selain aku, pasti aku masukkan engkau ke dalam penjara.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2962,
      "text": "Dia (Musa) berkata, \"Apakah (engkau akan melakukan itu) sekalipun aku tunjukkan kepadamu suatu (bukti) yang nyata?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2963,
      "text": "Dia (Fir'aun) berkata, \"Tunjukkan sesuatu (bukti yang nyata) itu, jika engkau termasuk orang yang benar!\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 31,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2964,
      "text": "Maka dia (Musa) melemparkan tongkatnya, tiba-tiba tongkat itu menjadi ular besar yang nyata.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 32,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2965,
      "text": "Dan dia mengeluarkan tangannya (dari dalam bajunya), tiba-tiba tangan itu menjadi putih (bercahaya) bagi orang-orang yang melihatnya.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2966,
      "text": "Dia (Fir'aun) berkata kepada para pemuka di sekelilingnya, \"Sesungguhnya dia (Musa) ini pasti seorang penyihir yang pandai.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2967,
      "text": "Dia hendak mengusir kamu dari negerimu dengan sihirnya; karena itu apakah yang kamu sarankan?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2968,
      "text": "Mereka menjawab, \"Tahanlah (untuk sementara) dia dan saudaranya, dan utuslah ke seluruh negeri orang-orang yang akan mengumpulkan (penyihir),",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2969,
      "text": "niscaya mereka akan mendatangkan semua penyihir yang pandai kepadamu.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2970,
      "text": "Lalu dikumpulkanlah para penyihir pada waktu (yang ditetapkan) di hari yang telah ditentukan,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2971,
      "text": "dan diumumkan kepada orang banyak, \"Berkumpullah kamu semua,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 39,
      "juz": 19,
      "manzil": 5,
      "page": 368,
      "ruku": 318,
      "hizbQuarter": 147,
      "sajda": false
    }
  ],
