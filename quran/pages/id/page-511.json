      "hizbQuarter": 204,
      "sajda": false
    },
    {
      "number": 4585,
      "text": "Agar Allah memberikan ampunan kepadamu (Muhammad) atas dosamu yang lalu dan yang akan datang, serta menyempurnakan nikmat-Nya atasmu dan menunjukimu ke jalan yang lurus,",
      "surah": {
        "number": 48,
        "name": "سُورَةُ الفَتۡحِ",
        "englishName": "Al-Fath",
        "englishNameTranslation": "The Victory",
        "numberOfAyahs": 29,
        "revelationType": "Medinan"
      },
      "numberInSurah": 2,
      "juz": 26,
      "manzil": 6,
      "page": 511,
      "ruku": 446,
      "hizbQuarter": 204,
      "sajda": false
    },
    {
      "number": 4586,
      "text": "dan agar Allah menolongmu dengan pertolongan yang kuat (banyak).",
      "surah": {
        "number": 48,
        "name": "سُورَةُ الفَتۡحِ",
        "englishName": "Al-Fath",
        "englishNameTranslation": "The Victory",
        "numberOfAyahs": 29,
