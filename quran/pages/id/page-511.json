  "ayahs": [
    {
      "number": 4584,
      "text": "Sungguh, Kami telah memberikan kepadamu kemenangan yang nyata.",
      "surah": {
        "number": 48,
        "name": "سُورَةُ الفَتۡحِ",
        "englishName": "Al-Fath",
        "englishNameTranslation": "The Victory",
