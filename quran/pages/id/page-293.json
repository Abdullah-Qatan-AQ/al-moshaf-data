      "page": 293,
      "ruku": 251,
      "hizbQuarter": 117,
      "sajda": false
    },
    {
      "number": 2137,
      "text": "dan mereka berkata, \"Mahasuci Tuhan kami; sungguh, janji Tuhan kami pasti dipenuhi.\"",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
