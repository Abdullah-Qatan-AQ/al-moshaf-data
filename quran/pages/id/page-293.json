      "hizbQuarter": 117,
      "sajda": false
    },
    {
      "number": 2141,
      "text": "Segala puji bagi Allah yang telah menurunkan Kitab (Al-Qur`an) kepada hamba-Nya dan Dia tidak menjadikannya bengkok;484)",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
