      "hizbQuarter": 117,
      "sajda": false
    },
    {
      "number": 2140,
      "text": "Dan katakanlah, \"Segala puji bagi Allah yang tidak mempunyai anak dan tidak (pula) mempunyai sekutu dalam kerajaan-Nya dan Dia tidak memerlukan penolong dari kehinaan, dan agungkanlah Dia seagung-agungnya.",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
        "numberOfAyahs": 111,
