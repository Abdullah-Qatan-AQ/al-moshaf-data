      "hizbQuarter": 23,
      "sajda": false
    },
    {
      "number": 351,
      "text": "Demikianlah Kami bacakan kepadamu (Muhammad) sebagian ayat-ayat dan peringatan yang penuh hikmah.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
