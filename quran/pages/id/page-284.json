      "hizbQuarter": 114,
      "sajda": false
    },
    {
      "number": 2054,
      "text": "Tuhanmu lebih mengetahui apa yang ada dalam hatimu; jika kamu orang yang baik, maka sungguh, Dia Maha Pengampun kepada orang yang bertobat.",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
        "numberOfAyahs": 111,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 15,
