      "sajda": false
    },
    {
      "number": 1798,
      "text": "(Yaitu) pada hari (ketika) bumi diganti dengan bumi yang lain dan (demikian pula) langit, dan mereka (manusia) berkumpul (di padang Mahsyar) menghadap Allah Yang Maha Esa, Mahaperkasa.",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
