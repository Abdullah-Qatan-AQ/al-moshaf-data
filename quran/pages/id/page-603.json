  "ayahs": [
    {
      "number": 6208,
      "text": "Katakanlah (Muhammad), \"Wahai orang-orang kafir!",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
        "englishNameTranslation": "The Disbelievers",
        "numberOfAyahs": 6,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 551,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6209,
      "text": "Aku tidak akan menyembah apa yang kamu sembah,",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
        "englishNameTranslation": "The Disbelievers",
        "numberOfAyahs": 6,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 551,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6210,
      "text": "dan kamu bukan penyembah apa yang aku sembah,",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
        "englishNameTranslation": "The Disbelievers",
        "numberOfAyahs": 6,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 551,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6211,
      "text": "dan aku tidak pernah menjadi penyembah apa yang kamu sembah,",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
        "englishNameTranslation": "The Disbelievers",
        "numberOfAyahs": 6,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 551,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6212,
      "text": "dan kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah.",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
        "englishNameTranslation": "The Disbelievers",
        "numberOfAyahs": 6,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 551,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6213,
      "text": "Untukmu agamamu, dan untukku agamaku.\"",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
        "englishNameTranslation": "The Disbelievers",
        "numberOfAyahs": 6,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 551,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6214,
      "text": "Apabila telah datang pertolongan Allah dan kemenangan,",
      "surah": {
        "number": 110,
        "name": "سُورَةُ النَّصۡرِ",
        "englishName": "An-Nasr",
        "englishNameTranslation": "Divine Support",
        "numberOfAyahs": 3,
        "revelationType": "Medinan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 552,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6215,
      "text": "dan engkau melihat manusia berbondong-bondong masuk agama Allah.",
      "surah": {
        "number": 110,
        "name": "سُورَةُ النَّصۡرِ",
        "englishName": "An-Nasr",
        "englishNameTranslation": "Divine Support",
        "numberOfAyahs": 3,
        "revelationType": "Medinan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 552,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6216,
      "text": "Maka bertasbihlah dengan memuji Tuhanmu dan mohonlah ampunan kepada-Nya. Sungguh, Dia Maha Penerima tobat.",
      "surah": {
        "number": 110,
        "name": "سُورَةُ النَّصۡرِ",
        "englishName": "An-Nasr",
        "englishNameTranslation": "Divine Support",
        "numberOfAyahs": 3,
        "revelationType": "Medinan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 552,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6217,
      "text": "Binasalah kedua tangan Abu Lahab dan benar-benar binasa dia![930]",
      "surah": {
        "number": 111,
        "name": "سُورَةُ المَسَدِ",
        "englishName": "Al-Masad",
        "englishNameTranslation": "The Palm Fibre",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 553,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6218,
      "text": "Tidaklah berguna baginya hartanya dan apa yang dia usahakan.",
      "surah": {
        "number": 111,
        "name": "سُورَةُ المَسَدِ",
        "englishName": "Al-Masad",
        "englishNameTranslation": "The Palm Fibre",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 553,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6219,
      "text": "Kelak dia akan masuk ke dalam api yang bergejolak (neraka).",
      "surah": {
        "number": 111,
        "name": "سُورَةُ المَسَدِ",
        "englishName": "Al-Masad",
        "englishNameTranslation": "The Palm Fibre",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 553,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6220,
      "text": "Dan (begitu pula) istrinya, pembawa kayu bakar (penyebar fitnah).",
      "surah": {
        "number": 111,
        "name": "سُورَةُ المَسَدِ",
        "englishName": "Al-Masad",
        "englishNameTranslation": "The Palm Fibre",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 553,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6221,
      "text": "Di lehernya ada tali dari sabut yang dipintal.",
      "surah": {
        "number": 111,
        "name": "سُورَةُ المَسَدِ",
