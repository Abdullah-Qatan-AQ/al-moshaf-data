  "ayahs": [
    {
      "number": 1443,
      "text": "Dan Fir'aun berkata (kepada pemuka kaumnya), \"Datangkanlah kepadaku semua penyihir yang ulung!\"",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 79,
      "juz": 11,
      "manzil": 3,
      "page": 218,
      "ruku": 179,
      "hizbQuarter": 87,
      "sajda": false
    },
    {
      "number": 1444,
      "text": "Maka ketika para penyihir itu datang, Musa berkata kepada mereka, \"Lemparkanlah apa yang hendak kamu lemparkan!\"",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 80,
      "juz": 11,
      "manzil": 3,
      "page": 218,
      "ruku": 179,
      "hizbQuarter": 87,
      "sajda": false
    },
    {
      "number": 1445,
      "text": "Setelah mereka melemparkan, Musa berkata, \"Apa yang kamu lakukan, itulah sihir, sesungguhnya Allah akan menampakkan kepalsuan sihir. Sungguh, Allah tidak akan membiarkan terus berlangsungnya pekerjaan orang yang berbuat kerusakan.",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 81,
      "juz": 11,
      "manzil": 3,
      "page": 218,
      "ruku": 179,
      "hizbQuarter": 87,
      "sajda": false
    },
    {
      "number": 1446,
      "text": "Dan Allah akan mengokohkan yang benar dengan ketetapan-Nya, walaupun orang-orang yang berbuat dosa tidak menyukainya.",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 82,
      "juz": 11,
      "manzil": 3,
      "page": 218,
      "ruku": 179,
      "hizbQuarter": 87,
      "sajda": false
    },
    {
      "number": 1447,
      "text": "Maka tidak ada yang beriman kepada Musa, selain keturunan dari kaumnya dalam keadaan takut bahwa Fir'aun dan para pemuka (kaum)nya akan menyiksa mereka. Dan Sungguh, Fir'aun itu benar-benar telah berbuat sewenang-wenang di bumi, dan benar-benar termasuk orang yang melampaui batas.",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 83,
      "juz": 11,
      "manzil": 3,
      "page": 218,
      "ruku": 180,
      "hizbQuarter": 87,
      "sajda": false
    },
    {
      "number": 1448,
      "text": "Dan Musa berkata, \"Wahai kaumku! Apabila kamu beriman kepada Allah, maka bertawakallah kepada-Nya, jika kamu benar-benar orang muslim (berserah diri).\"",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 84,
      "juz": 11,
      "manzil": 3,
      "page": 218,
      "ruku": 180,
      "hizbQuarter": 87,
      "sajda": false
    },
    {
      "number": 1449,
      "text": "Lalu mereka berkata, \"Kepada Allahlah kami bertawakal. Ya Tuhan kami, janganlah Engkau jadikan kami (sasaran) fitnah bagi kaum yang zalim,",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 85,
      "juz": 11,
      "manzil": 3,
      "page": 218,
      "ruku": 180,
      "hizbQuarter": 87,
      "sajda": false
    },
    {
      "number": 1450,
      "text": "dan selamatkanlah kami dengan rahmat-Mu dari orang-orang kafir.\"",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 86,
      "juz": 11,
      "manzil": 3,
      "page": 218,
      "ruku": 180,
      "hizbQuarter": 87,
      "sajda": false
    },
    {
      "number": 1451,
      "text": "Dan Kami wahyukan kepada Musa dan saudaranya, \"Ambillah beberapa rumah di Mesir untuk (tempat tinggal) kaummu dan jadikanlah rumah-rumahmu itu tempat ibadah dan laksanakanlah salat serta gembirakanlah orang-orang mukmin.\"",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 87,
      "juz": 11,
      "manzil": 3,
      "page": 218,
      "ruku": 180,
      "hizbQuarter": 87,
      "sajda": false
    },
    {
      "number": 1452,
      "text": "Dan Musa berkata, \"Ya Tuhan kami, Engkau telah memberi kepada Fir'aun dan para pemuka kaumnya perhiasan dan harta kekayaan dalam kehidupan dunia. Ya Tuhan kami, (akibatnya) mereka menyesatkan (manusia) dari jalan-Mu. Ya Tuhan, binasakanlah harta mereka, dan kuncilah hati mereka, sehingga mereka tidak beriman sampai mereka melihat azab yang pedih.\"",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
