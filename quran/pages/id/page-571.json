  "ayahs": [
    {
      "number": 5430,
      "text": "niscaya Dia akan menurunkan hujan yang lebat dari langit kepadamu,",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5431,
      "text": "dan Dia memperbanyak harta dan anak-anakmu, dan mengadakan kebun-kebun untukmu dan mengadakan sungai-sungai untukmu.\"",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5432,
      "text": "Mengapa kamu tidak takut akan kebesaran Allah?",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5433,
      "text": "Dan sungguh, Dia telah menciptakan kamu dalam beberapa fase (kejadian).870)",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5434,
      "text": "Tidakkah kamu memperhatikan bagaimana Allah telah menciptakan tujuh langit berlapis-lapis?",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5435,
      "text": "Dan di sana Dia menciptakan bulan yang bercahaya dan menjadikan matahari sebagai pelita (yang cemerlang)?",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5436,
      "text": "Dan Allah menumbuhkan kamu dari tanah, tumbuh (berangsur-angsur),",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5437,
      "text": "kemudian Dia akan mengembalikan kamu ke dalamnya (tanah) dan mengeluarkan kamu (pada hari Kiamat) dengan pasti.",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5438,
      "text": "Dan Allah menjadikan bumi untukmu sebagai hamparan,",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5439,
      "text": "agar kamu dapat pergi kian kemari di jalan-jalan yang luas.",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5440,
      "text": "Nuh berkata, \"Ya Tuhanku, sesungguhnya mereka durhaka kepadaku, dan mereka mengikuti orang-orang yang harta dan anak-anaknya hanya menambah kerugian baginya,",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 505,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5441,
      "text": "dan mereka melakukan tipu daya yang sangat besar.\"",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 505,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5442,
      "text": "Dan mereka berkata, \"Jangan sekali-kali kamu meninggalkan (penyembahan) tuhan-tuhan kamu dan jangan pula sekali-kali kamu meninggalkan (penyembahan) Wadd, dan jangan pula Suwā', Yagūṡ, Ya'ūq dan Nasr.\"871)",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 505,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5443,
      "text": "Dan sungguh, mereka telah menyesatkan orang banyak; dan janganlah Engkau tambahkan bagi orang-orang yang zalim itu selain kesesatan.",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 505,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5444,
      "text": "Disebabkan kesalahan-kesalahan mereka, mereka ditenggelamkan lalu dimasukkan ke neraka, maka mereka tidak mendapat penolong selain Allah.",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 505,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5445,
      "text": "Dan Nuh berkata, \"Ya Tuhanku, janganlah Engkau biarkan seorang pun di antara orang-orang kafir itu tinggal di atas bumi.",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 505,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5446,
      "text": "Sesungguhnya jika Engkau biarkan mereka tinggal, niscaya mereka akan menyesatkan hamba-hamba-Mu, dan mereka hanya akan melahirkan anak-anak yang jahat dan tidak tahu bersyukur.",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 505,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5447,
      "text": "Ya Tuhanku, ampunilah aku, ibu bapakku, dan siapa pun yang memasuki rumahku dengan beriman dan semua orang yang beriman laki-laki dan perempuan. Dan janganlah Engkau tambahkan bagi orang-orang yang zalim itu selain kehancuran.\"",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 29,
      "manzil": 7,
      "page": 571,
      "ruku": 505,
      "hizbQuarter": 228,
      "sajda": false
    }
  ],
  "language": "id"
}
