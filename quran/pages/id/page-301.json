  "ayahs": [
    {
      "number": 2202,
      "text": "Maka ketika mereka telah melewati (tempat itu), Musa berkata kepada pembantunya, \"Bawalah ke mari makanan kita; sungguh kita telah merasa letih karena perjalanan kita ini.\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 62,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 260,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2203,
      "text": "Dia (pembantunya) menjawab, \"Tahukah engkau ketika kita mencari tempat berlindung di batu tadi, maka aku lupa (menceritakan tentang) ikan itu dan tidak ada yang membuat aku lupa untuk mengingatnya kecuali setan, dan (ikan) itu mengambil jalannya ke laut dengan cara yang aneh sekali.\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 63,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 260,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2204,
      "text": "Dia (Musa) berkata, \"Itulah (tempat) yang kita cari.\" Lalu keduanya kembali, mengikuti jejak mereka semula,",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 64,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 260,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2205,
      "text": "lalu mereka berdua bertemu dengan seorang hamba di antara hamba-hamba Kami, yang telah Kami berikan rahmat kepadanya dari sisi Kami, dan yang telah Kami ajarkan ilmu kepadanya dari sisi Kami.[495]",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 65,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 260,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2206,
      "text": "Musa berkata kepadanya, \"Bolehkah aku mengikutimu agar engkau mengajarkan kepadaku (ilmu yang benar) yang telah diajarkan kepadamu (untuk menjadi) petunjuk?\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 66,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 260,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2207,
      "text": "Dia menjawab, \"Sungguh, engkau tidak akan sanggup sabar bersamaku.",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 67,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 260,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2208,
      "text": "Dan bagaimana engkau akan dapat bersabar atas sesuatu, sedang engkau belum mempunyai pengetahuan yang cukup tentang hal itu?\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 68,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 260,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2209,
      "text": "Dia (Musa) berkata, \"Insya Allah, engkau akan dapati aku orang yang sabar, dan aku tidak akan menentangmu dalam urusan apa pun.\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 69,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 260,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2210,
      "text": "Dia berkata, \"Jika engkau mengikutiku, maka janganlah engkau menanyakan kepadaku tentang sesuatu apa pun, sampai aku menerangkannya kepadamu.\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 70,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 260,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2211,
      "text": "Maka berjalanlah keduanya, hingga ketika keduanya menaiki perahu lalu dia melubanginya. Dia (Musa) berkata, \"Mengapa engkau melubangi perahu itu, apakah untuk menenggelamkan penumpangnya?\" Sungguh, engkau telah berbuat suatu kesalahan yang besar.",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 71,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 261,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2212,
      "text": "Dia berkata, \"Bukankah sudah kukatakan, bahwa engkau tidak akan mampu sabar bersamaku?\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 72,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 261,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2213,
      "text": "Dia (Musa) berkata, \"Janganlah engkau menghukumku karena kelupaanku dan janganlah engkau membebaniku dengan suatu kesulitan dalam urusanku.\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 73,
      "juz": 15,
      "manzil": 4,
      "page": 301,
      "ruku": 261,
      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2214,
      "text": "Maka berjalanlah keduanya; hingga ketika keduanya berjumpa dengan seorang anak muda, maka dia membunuhnya. Dia (Musa) berkata, \"Mengapa engkau bunuh jiwa yang bersih, bukan karena dia membunuh orang lain? Sungguh, engkau telah melakukan sesuatu yang sangat mungkar.\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
