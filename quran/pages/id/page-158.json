    {
      "number": 1013,
      "text": "Sungguh, Kami benar-benar telah mengutus Nuh kepada kaumnya, lalu dia berkata, \"Wahai kaumku! Sembahlah Allah! Tidak ada Tuhan (sembahan) bagimu selain Dia. Sesungguhnya aku takut kamu akan ditimpa azab pada hari yang dahsyat (Kiamat).",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 8,
