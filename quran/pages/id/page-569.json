  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5386,
      "text": "sedang mereka saling melihat. Pada hari itu, orang yang berdosa ingin sekiranya dia dapat menebus (dirinya) dari azab dengan anak-anaknya,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5387,
      "text": "dan istrinya juga saudaranya,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5388,
      "text": "dan keluarga yang melindunginya (di dunia),",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5389,
      "text": "dan orang-orang di bumi seluruhnya, kemudian mengharapkan (tebusan) itu dapat menyelamatkannya.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5390,
      "text": "Sama sekali tidak! Sungguh, neraka itu api yang bergejolak,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5391,
      "text": "yang mengelupaskan kulit kepala.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5392,
      "text": "Yang memanggil orang yang membelakangi dan yang berpaling (dari agama),",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5393,
      "text": "dan orang yang mengumpulkan (harta benda) lalu menyimpannya.[864]",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 227,
      "sajda": false
    },
    {
      "number": 5394,
      "text": "Sungguh, manusia diciptakan bersifat suka mengeluh.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5395,
      "text": "Apabila dia ditimpa kesusahan dia berkeluh kesah,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5396,
      "text": "dan apabila mendapat kebaikan (harta) dia jadi kikir,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5397,
      "text": "kecuali orang-orang yang melaksanakan salat,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5398,
      "text": "mereka yang tetap setia melaksanakan salatnya,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5399,
      "text": "dan orang-orang yang dalam hartanya disiapkan bagian tertentu,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5400,
      "text": "bagi orang (miskin) yang meminta dan yang tidak meminta,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5401,
      "text": "dan orang-orang yang mempercayai hari pembalasan,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5402,
      "text": "dan orang-orang yang takut terhadap azab Tuhannya,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5403,
      "text": "sesungguhnya terhadap azab Tuhan mereka, tidak ada seseorang yang merasa aman (dari kedatangannya),",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5404,
      "text": "dan orang-orang yang memelihara kemaluannya,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5405,
      "text": "kecuali terhadap istri-istri mereka atau hamba sahaya yang mereka miliki[865] maka sesungguhnya mereka tidak tercela.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5406,
      "text": "Maka barangsiapa mencari di luar itu (seperti zina, homoseks, dan lesbian), mereka itulah orang-orang yang melampaui batas.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 31,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5407,
      "text": "Dan orang-orang yang memelihara amanat dan janjinya,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 32,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5408,
      "text": "dan orang-orang yang berpegang teguh pada kesaksiannya,",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5409,
      "text": "dan orang-orang yang memelihara salatnya.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5410,
      "text": "Mereka itu dimuliakan di dalam surga.",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 502,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5411,
      "text": "Maka mengapa orang-orang kafir itu datang bergegas ke hadapanmu (Muhammad),",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 503,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5412,
      "text": "dari kanan dan dari kiri dengan berkelompok-kelompok?[866]",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 503,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5413,
      "text": "Apakah setiap orang dari orang-orang kafir itu ingin masuk surga yang penuh kenikmatan?",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 29,
      "manzil": 7,
      "page": 569,
      "ruku": 503,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5414,
      "text": "tidak mungkin! Sesungguhnya Kami menciptakan mereka dari apa yang mereka ketahui.[867]",
      "surah": {
        "number": 70,
        "name": "سُورَةُ المَعَارِجِ",
        "englishName": "Al-Ma'aarij",
        "englishNameTranslation": "The Ascending Stairways",
        "numberOfAyahs": 44,
        "revelationType": "Meccan"
      },
