      "sajda": false
    },
    {
      "number": 53,
      "text": "(yaitu) mereka yang yakin, bahwa mereka akan menemui Tuhannya, dan bahwa mereka akan kembali kepada-Nya.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
