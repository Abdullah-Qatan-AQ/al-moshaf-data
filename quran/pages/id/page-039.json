  "ayahs": [
    {
      "number": 245,
      "text": "Peliharalah semua salat dan salat wusṭa.[91] Dan laksanakanlah (salat) karena Allah dengan khusyuk.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
