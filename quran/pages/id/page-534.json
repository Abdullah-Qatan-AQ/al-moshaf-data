      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4977,
      "text": "Mereka bersandar pada bantal-bantal yang hijau dan permadani-permadani yang indah.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
