      "sajda": false
    },
    {
      "number": 4973,
      "text": "Bidadari-bidadari yang dipelihara di dalam kemah-kemah.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
