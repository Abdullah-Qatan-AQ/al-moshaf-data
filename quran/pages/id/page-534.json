      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4971,
      "text": "Di dalam surga-surga itu ada bidadari-bidadari yang baik-baik dan jelita.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
