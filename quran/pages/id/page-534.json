      "page": 534,
      "ruku": 468,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4979,
      "text": "Mahasuci nama Tuhanmu Pemilik Keagungan dan Kemuliaan.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 78,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 468,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4980,
      "text": "Apabila terjadi hari Kiamat.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4981,
      "text": "Terjadinya tidak dapat didustakan (disangkal).",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4982,
      "text": "(Kejadian itu) merendahkan (satu golongan) dan meninggikan (golongan yang lain).",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4983,
      "text": "Apabila bumi diguncangkan sedahsyat-dahsyatnya,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4984,
      "text": "dan gunung-gunung dihancur luluhkan sehancur-hancurnya,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4985,
      "text": "maka jadilah ia debu yang berterbangan,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4986,
      "text": "dan kamu menjadi tiga golongan,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4987,
      "text": "yaitu golongan kanan,[825] alangkah mulianya golongan kanan itu,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4988,
      "text": "dan golongan kiri,[826] alangkah sengsaranya golongan kiri itu,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4989,
      "text": "dan orang-orang yang paling dahulu (beriman), merekalah yang paling dahulu (masuk surga).",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4990,
      "text": "mereka itulah orang yang dekat (kepada Allah),",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4991,
      "text": "Berada dalam surga kenikmatan,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4992,
      "text": "segolongan besar dari orang-orang yang terdahulu,[827]",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4993,
      "text": "dan segolongan kecil dari orang-orang yang kemudian.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4994,
      "text": "Mereka berada di atas dipan-dipan yang bertahtakan emas dan permata,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 27,
      "manzil": 7,
      "page": 534,
      "ruku": 469,
      "hizbQuarter": 214,
      "sajda": false
    },
    {
      "number": 4995,
      "text": "mereka bersandar di atasnya berhadap-hadapan.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
