      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4975,
      "text": "Mereka sebelumnya tidak pernah disentuh oleh manusia maupun oleh jin.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
