      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4978,
      "text": "Maka nikmat Tuhanmu yang manakah yang kamu dustakan?",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
