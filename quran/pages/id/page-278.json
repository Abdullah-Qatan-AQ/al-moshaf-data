      "sajda": false
    },
    {
      "number": 1999,
      "text": "Maka apabila engkau (Muhammad) hendak membaca Al-Qur`an, mohonlah perlindungan kepada Allah dari setan yang terkutuk.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
