  "ayahs": [
    {
      "number": 3504,
      "text": "Alif Lām Mīm",
      "surah": {
        "number": 32,
        "name": "سُورَةُ السَّجۡدَةِ",
        "englishName": "As-Sajda",
        "englishNameTranslation": "The Prostration",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 21,
      "manzil": 5,
      "page": 415,
      "ruku": 358,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3505,
      "text": "Turunnya Al-Qur`an itu tidak ada keraguan padanya, (yaitu) dari Tuhan seluruh alam.",
      "surah": {
        "number": 32,
        "name": "سُورَةُ السَّجۡدَةِ",
        "englishName": "As-Sajda",
        "englishNameTranslation": "The Prostration",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 21,
      "manzil": 5,
      "page": 415,
      "ruku": 358,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3506,
      "text": "Tetapi mengapa mereka (orang kafir) mengatakan, \"Dia (Muhammad) telah mengada-adakannya.\" Tidak, Al-Qur`an itu kebenaran (yang datang) dari Tuhanmu, agar engkau memberi peringatan kepada kaum yang belum pernah didatangi orang yang memberi peringatan sebelum engkau; agar mereka mendapat petunjuk.",
      "surah": {
        "number": 32,
        "name": "سُورَةُ السَّجۡدَةِ",
        "englishName": "As-Sajda",
        "englishNameTranslation": "The Prostration",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 21,
      "manzil": 5,
      "page": 415,
      "ruku": 358,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3507,
      "text": "Allah yang menciptakan langit dan bumi dan apa yang ada di antara keduanya dalam enam masa, kemudian Dia bersemayam di atas Arasy.654) Bagimu tidak ada seorang pun penolong maupun pemberi syafaat655) selain Dia. Maka apakah kamu tidak memperhatikan?",
      "surah": {
        "number": 32,
        "name": "سُورَةُ السَّجۡدَةِ",
        "englishName": "As-Sajda",
        "englishNameTranslation": "The Prostration",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 21,
      "manzil": 5,
      "page": 415,
      "ruku": 358,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3508,
      "text": "Dia mengatur segala urusan dari langit ke bumi, kemudian (urusan) itu naik kepada-Nya656) dalam satu hari yang kadarnya (lamanya) adalah seribu tahun menurut perhitunganmu.",
      "surah": {
        "number": 32,
        "name": "سُورَةُ السَّجۡدَةِ",
        "englishName": "As-Sajda",
        "englishNameTranslation": "The Prostration",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 21,
      "manzil": 5,
      "page": 415,
      "ruku": 358,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3509,
      "text": "Yang demikian itu, ialah Tuhan yang mengetahui yang gaib dan yang nyata, Yang Mahaperkasa, Maha Penyayang,",
      "surah": {
        "number": 32,
        "name": "سُورَةُ السَّجۡدَةِ",
        "englishName": "As-Sajda",
        "englishNameTranslation": "The Prostration",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 21,
      "manzil": 5,
      "page": 415,
      "ruku": 358,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3510,
      "text": "Yang memperindah segala sesuatu yang Dia ciptakan dan yang memulai penciptaan manusia dari tanah,",
      "surah": {
        "number": 32,
        "name": "سُورَةُ السَّجۡدَةِ",
        "englishName": "As-Sajda",
        "englishNameTranslation": "The Prostration",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 21,
      "manzil": 5,
      "page": 415,
      "ruku": 358,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3511,
      "text": "kemudian Dia menjadikan keturunannya dari saripati air yang hina (air mani).",
      "surah": {
        "number": 32,
        "name": "سُورَةُ السَّجۡدَةِ",
        "englishName": "As-Sajda",
        "englishNameTranslation": "The Prostration",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 21,
      "manzil": 5,
      "page": 415,
      "ruku": 358,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3512,
      "text": "Kemudian Dia menyempurnakannya dan meniupkan roh (ciptaan)-Nya ke dalam (tubuh)nya dan Dia menjadikan pendengaran, penglihatan dan hati bagimu, (tetapi) sedikit sekali dari kamu yang bersyukur.",
      "surah": {
        "number": 32,
        "name": "سُورَةُ السَّجۡدَةِ",
        "englishName": "As-Sajda",
        "englishNameTranslation": "The Prostration",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 21,
      "manzil": 5,
      "page": 415,
      "ruku": 358,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3513,
      "text": "Dan mereka berkata, \"Apakah apabila kami telah lenyap (hancur) di dalam tanah, kami akan berada dalam ciptaan yang baru?\"657) Bahkan mereka mengingkari pertemuan dengan Tuhannya.",
      "surah": {
        "number": 32,
        "name": "سُورَةُ السَّجۡدَةِ",
        "englishName": "As-Sajda",
        "englishNameTranslation": "The Prostration",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 21,
      "manzil": 5,
      "page": 415,
      "ruku": 358,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3514,
      "text": "Katakanlah, \"Malaikat maut yang diserahi untuk (mencabut nyawa) mu akan mematikan kamu, kemudian kepada Tuhanmu, kamu akan dikembalikan.\"",
      "surah": {
