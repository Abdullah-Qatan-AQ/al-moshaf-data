      "ruku": 250,
      "hizbQuarter": 116,
      "sajda": false
    },
    {
      "number": 2124,
      "text": "Katakanlah (Muhammad), \"Sekiranya di bumi ada para malaikat, yang berjalan-jalan dengan tenang, niscaya Kami turunkan kepada mereka malaikat dari langit untuk menjadi rasul.\"",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
