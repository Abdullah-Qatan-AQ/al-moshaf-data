  "ayahs": [
    {
      "number": 1818,
      "text": "Dan sungguh, Kami telah menciptakan gugusan bintang di langit dan menjadikannya terlihat indah bagi orang yang memandang(nya),",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 219,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1819,
      "text": "dan Kami menjaganya dari setiap (gangguan) setan yang terkutuk,",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 219,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1820,
      "text": "kecuali (setan) yang mencuri-curi (berita) yang dapat didengar (dari malaikat) lalu dikejar oleh semburan api yang terang.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 219,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1821,
      "text": "Dan Kami telah menghamparkan bumi dan Kami pancangkan padanya gunung-gunung serta Kami tumbuhkan di sana segala sesuatu menurut ukuran.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 219,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1822,
      "text": "Dan Kami telah menjadikan padanya sumber-sumber kehidupan untuk keperluanmu, dan (Kami ciptakan pula) makhluk-makhluk yang bukan kamu pemberi rezekinya.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 219,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1823,
      "text": "Dan tidak ada sesuatu pun, melainkan pada sisi Kamilah khazanahnya;[434] Kami tidak menurunkannya melainkan dengan ukuran tertentu.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 219,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1824,
      "text": "Dan Kami telah meniupkan angin untuk mengawinkan[435] dan Kami turunkan hujan dari langit, lalu Kami beri kamu minum dengan (air) itu, dan bukanlah kamu yang menyimpannya.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 219,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1825,
      "text": "Dan sungguh, Kamilah yang menghidupkan dan mematikan dan Kami (pulalah) yang mewarisi.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 219,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1826,
      "text": "Dan sungguh, Kami mengetahui orang yang terdahulu sebelum kamu dan Kami mengetahui pula orang yang terkemudian.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 219,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1827,
      "text": "Dan sesungguhnya Tuhanmu, Dialah yang akan mengumpulkan mereka. Sungguh, Dia Mahabijaksana, Maha Mengetahui.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 219,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1828,
      "text": "Dan sungguh, Kami telah menciptakan manusia (Adam) dari tanah liat kering dari lumpur hitam yang diberi bentuk.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 220,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1829,
      "text": "Dan Kami telah menciptakan jin sebelum (Adam) dari api yang sangat panas.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 220,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1830,
      "text": "Dan (ingatlah), ketika Tuhanmu berfirman kepada para malaikat, \"Sungguh, Aku akan menciptakan seorang manusia dari tanah liat kering dari lumpur hitam yang diberi bentuk.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 220,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1831,
      "text": "Maka apabila Aku telah menyempurnakan (kejadian)nya, dan Aku telah meniupkan roh (ciptaan)-Ku ke dalamnya, maka tunduklah kamu kepadanya dengan bersujud.[436]",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 220,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1832,
      "text": "Maka bersujudlah para malaikat itu semuanya bersama-sama,",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 14,
      "manzil": 3,
      "page": 263,
      "ruku": 220,
      "hizbQuarter": 105,
      "sajda": false
    },
    {
      "number": 1833,
      "text": "kecuali Iblis. Ia enggan ikut bersama-sama para (malaikat) yang sujud itu.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
