      "hizbQuarter": 95,
      "sajda": false
    },
    {
      "number": 1607,
      "text": "Mereka berkata, \"Wahai ayah kami! Mengapa engkau tidak mempercayai kami terkait Yusuf, padahal sesungguhnya kami semua menginginkan kebaikan baginya.",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 12,
      "manzil": 3,
      "page": 236,
      "ruku": 194,
      "hizbQuarter": 95,
      "sajda": false
    },
    {
      "number": 1608,
      "text": "Biarkanlah dia pergi bersama kami besok pagi, agar dia bersenang-senang dan bermain-main, dan kami pasti menjaganya.\"",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
