      "hizbQuarter": 95,
      "sajda": false
    },
    {
      "number": 1604,
      "text": "Ketika mereka berkata, \"Sesungguhnya Yusuf dan saudaranya (Bunyamin) lebih dicintai ayah daripada kita, padahal kita adalah satu golongan (yang kuat). Sungguh, ayah kita dalam kekeliruan yang nyata,",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 12,
      "manzil": 3,
      "page": 236,
      "ruku": 194,
      "hizbQuarter": 95,
      "sajda": false
    },
    {
      "number": 1605,
      "text": "bunuhlah Yusuf atau buanglah dia ke suatu tempat agar perhatian ayah tercurah kepadamu, dan setelah itu kamu menjadi orang yang baik.\"",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
