      "hizbQuarter": 95,
      "sajda": false
    },
    {
      "number": 1606,
      "text": "Seorang di antara mereka berkata, \"Janganlah kamu membunuh Yusuf, tetapi jebloskan saja dia ke dasar sumur agar dia dipungut oleh sebagian musafir, jika kamu hendak berbuat.\"",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
