    {
      "number": 3404,
      "text": "Dan kehidupan dunia ini hanya senda gurau dan permainan. Dan sesungguhnya negeri akhirat itulah kehidupan yang sebenarnya, sekiranya mereka mengetahui.",
      "surah": {
        "number": 29,
        "name": "سُورَةُ العَنكَبُوتِ",
        "englishName": "Al-Ankaboot",
        "englishNameTranslation": "The Spider",
        "numberOfAyahs": 69,
        "revelationType": "Meccan"
      },
      "numberInSurah": 64,
      "juz": 21,
      "manzil": 5,
