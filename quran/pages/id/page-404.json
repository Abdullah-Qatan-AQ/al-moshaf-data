      "hizbQuarter": 162,
      "sajda": false
    },
    {
      "number": 3412,
      "text": "di negeri yang terdekat[633] dan mereka setelah kekalahannya itu akan menang,[634]",
      "surah": {
        "number": 30,
        "name": "سُورَةُ الرُّومِ",
        "englishName": "Ar-Room",
