{
  "page": 593,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5994,
      "text": "Demi fajar,",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5995,
      "text": "demi malam yang sepuluh,[906]",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5996,
      "text": "demi yang genap dan yang ganjil,",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5997,
      "text": "demi malam apabila berlalu.",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5998,
      "text": "Adakah pada yang demikian itu terdapat sumpah (yang dapat diterima) bagi orang-orang yang berakal?",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5999,
      "text": "Tidakkah engkau (Muhammad) memperhatikan bagaimana Tuhanmu berbuat terhadap (kaum) 'Ād?",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6000,
      "text": "(yaitu) penduduk Iram (ibukota kaum 'Ād) yang mempunyai bangunan-bangunan yang tinggi,",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6001,
      "text": "yang belum pernah dibangun (suatu kota) seperti itu, di negeri-negeri lain,",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6002,
      "text": "dan (terhadap) kaum Samud yang memotong batu-batu besar di lembah,[907]",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6003,
      "text": "dan (terhadap) Fir'aun yang mempunyai pasak-pasak (bangunan yang besar),",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6004,
      "text": "yang berbuat sewenang-wenang dalam negeri,",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6005,
      "text": "lalu mereka banyak berbuat kerusakan dalam negeri itu,",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6006,
      "text": "karena itu Tuhanmu menimpakan cemeti azab kepada mereka,",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6007,
      "text": "sungguh, Tuhanmu benar-benar mengawasi.",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6008,
      "text": "Adapun manusia, apabila Tuhan mengujinya lalu memuliakannya dan memberinya kesenangan, maka dia berkata, \"Tuhanku telah memuliakanku.\"",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6009,
      "text": "Namun apabila Tuhan mengujinya lalu membatasi rezekinya, maka dia berkata, \"Tuhanku telah menghinaku.\"[908]",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6010,
      "text": "Sekali-kali tidak! Bahkan kamu tidak memuliakan anak yatim,[909]",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6011,
      "text": "dan kamu tidak saling mengajak memberi makan orang miskin,",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6012,
      "text": "sedangkan kamu memakan harta warisan dengan cara mencampurbaurkan (yang halal dan yang haram),",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6013,
      "text": "dan kamu mencintai harta dengan kecintaan yang berlebihan.",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6014,
      "text": "Sekali-kali tidak! Apabila bumi diguncangkan berturut-turut (berbenturan),",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6015,
      "text": "dan datanglah Tuhanmu; dan malaikat berbaris-baris,",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 6016,
      "text": "dan pada hari itu diperlihatkan neraka Jahanam; pada hari itu sadarlah manusia, tetapi tidak berguna lagi baginya kesadaran itu.",
      "surah": {
        "number": 89,
        "name": "سُورَةُ الفَجۡرِ",
        "englishName": "Al-Fajr",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 30,
      "manzil": 7,
      "page": 593,
      "ruku": 531,
      "hizbQuarter": 237,
      "sajda": false
    }
  ],
