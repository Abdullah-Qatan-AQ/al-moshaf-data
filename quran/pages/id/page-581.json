      "page": 581,
      "ruku": 517,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5670,
      "text": "Dan apabila dikatakan kepada mereka, \"Rukuklah,\" mereka tidak mau rukuk.891)",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 48,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 517,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5671,
      "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)!",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
