  "ayahs": [
    {
      "number": 5642,
      "text": "Bukankah Kami menciptakan kamu dari air yang hina (mani),",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5643,
      "text": "kemudian Kami letakkan ia dalam tempat yang kokoh (rahim),",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5644,
      "text": "sampai waktu yang ditentukan,",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5645,
      "text": "lalu Kami tentukan (bentuknya), maka (Kamilah) sebaik-baik yang menentukan.",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5646,
      "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5647,
      "text": "Bukankah Kami jadikan bumi untuk (tempat) berkumpul,",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5648,
      "text": "bagi yang masih hidup dan yang sudah mati?889)",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5649,
      "text": "Dan Kami jadikan padanya gunung-gunung yang tinggi, dan Kami beri minum kamu dengan air tawar?",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5650,
      "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5651,
      "text": "(Akan dikatakan), \"Pergilah kamu guna mendapatkan apa (azab) yang dahulu kamu dustakan.",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5652,
      "text": "Pergilah kamu mendapatkan naungan (asap api neraka) yang mempunyai tiga cabang,890)",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5653,
      "text": "yang tidak melindungi dan tidak pula menolak nyala api neraka.\"",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 31,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5654,
      "text": "Sungguh, (neraka) itu menyemburkan bunga api (sebesar dan setinggi) istana,",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 32,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5655,
      "text": "seakan-akan iring-iringan unta yang kuning.",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5656,
      "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5657,
      "text": "Inilah hari, saat mereka tidak dapat berbicara,",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5658,
      "text": "dan tidak diizinkan kepada mereka mengemukakan alasan agar mereka dimaafkan.",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5659,
      "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5660,
      "text": "Inilah hari keputusan; (pada hari ini) Kami kumpulkan kamu dan orang-orang yang terdahulu.",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5661,
      "text": "Maka jika kamu punya tipu daya, maka lakukanlah (tipu daya) itu terhadap-Ku.",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 39,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5662,
      "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5663,
      "text": "Sungguh, orang-orang yang bertakwa berada dalam naungan (pepohonan surga yang teduh) dan (di sekitar) mata air,",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 41,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 517,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5664,
      "text": "dan buah-buahan yang mereka sukai.",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 517,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5665,
      "text": "(Katakan kepada mereka), \"Makan dan minumlah dengan rasa nikmat sebagai balasan dari apa yang telah kamu kerjakan.\"",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 517,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5666,
      "text": "Sungguh, demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik.",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 517,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5667,
      "text": "Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran).",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 517,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5668,
      "text": "(Katakan kepada orang-orang kafir), \"Makan dan bersenang-senanglah kamu (di dunia) sebentar, sesungguhnya kamu orang-orang durhaka!\"",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
