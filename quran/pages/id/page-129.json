      "hizbQuarter": 51,
      "sajda": false
    },
    {
      "number": 800,
      "text": "Katakanlah (Muhammad), \"Jelajahilah bumi, kemudian perhatikanlah bagaimana kesudahan orang-orang yang mendustakan itu!\"",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
