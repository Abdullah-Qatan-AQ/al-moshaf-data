      "hizbQuarter": 52,
      "sajda": false
    },
    {
      "number": 805,
      "text": "Barang siapa yang azab dijauhkan dari dirinya pada hari itu, maka sungguh, Allah telah memberikan rahmat kepadanya. Dan itulah kemenangan yang nyata.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 7,
      "manzil": 2,
      "page": 129,
      "ruku": 103,
      "hizbQuarter": 52,
      "sajda": false
    },
    {
      "number": 806,
      "text": "Dan jika Allah menimpakan suatu bencana kepadamu, tidak ada yang dapat menghilangkannya selain Dia. Dan jika Dia mendatangkan kebaikan kepadamu, maka Dia Maha Kuasa atas segala sesuatu.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 7,
