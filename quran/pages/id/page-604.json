      "manzil": 7,
      "page": 604,
      "ruku": 556,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6233,
      "text": "sembahan manusia,",
      "surah": {
        "number": 114,
        "name": "سُورَةُ النَّاسِ",
        "englishName": "An-Naas",
        "englishNameTranslation": "Mankind",
        "numberOfAyahs": 6,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
