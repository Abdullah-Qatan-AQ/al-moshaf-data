      "text": "dari kejahatan (bisikan) setan yang bersembunyi,",
      "surah": {
        "number": 114,
        "name": "سُورَةُ النَّاسِ",
        "englishName": "An-Naas",
        "englishNameTranslation": "Mankind",
        "numberOfAyahs": 6,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
