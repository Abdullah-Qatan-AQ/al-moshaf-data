  "ayahs": [
    {
      "number": 6222,
      "text": "Katakanlah (Muhammad), \"Dialah Allah, Yang Maha Esa.",
      "surah": {
        "number": 112,
        "name": "سُورَةُ الإِخۡلَاصِ",
        "englishName": "Al-Ikhlaas",
        "englishNameTranslation": "Sincerity",
        "numberOfAyahs": 4,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 604,
      "ruku": 554,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6223,
      "text": "Allah tempat meminta segala sesuatu.",
      "surah": {
        "number": 112,
        "name": "سُورَةُ الإِخۡلَاصِ",
        "englishName": "Al-Ikhlaas",
        "englishNameTranslation": "Sincerity",
        "numberOfAyahs": 4,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 604,
      "ruku": 554,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6224,
      "text": "(Allah) tidak beranak dan tidak pula diperanakkan.",
      "surah": {
        "number": 112,
        "name": "سُورَةُ الإِخۡلَاصِ",
        "englishName": "Al-Ikhlaas",
        "englishNameTranslation": "Sincerity",
        "numberOfAyahs": 4,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 604,
      "ruku": 554,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6225,
      "text": "Dan tidak ada sesuatu yang setara dengan Dia.\"",
      "surah": {
        "number": 112,
        "name": "سُورَةُ الإِخۡلَاصِ",
        "englishName": "Al-Ikhlaas",
        "englishNameTranslation": "Sincerity",
        "numberOfAyahs": 4,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 604,
      "ruku": 554,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6226,
      "text": "Katakanlah, \"Aku berlindung kepada Tuhan yang menguasai subuh (fajar),",
      "surah": {
        "number": 113,
        "name": "سُورَةُ الفَلَقِ",
        "englishName": "Al-Falaq",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 604,
      "ruku": 555,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6227,
      "text": "dari kejahatan (makhluk yang) Dia ciptakan,",
      "surah": {
        "number": 113,
        "name": "سُورَةُ الفَلَقِ",
        "englishName": "Al-Falaq",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 604,
      "ruku": 555,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6228,
      "text": "dan dari kejahatan malam apabila telah gelap gulita,",
      "surah": {
        "number": 113,
        "name": "سُورَةُ الفَلَقِ",
        "englishName": "Al-Falaq",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 604,
      "ruku": 555,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6229,
      "text": "dan dari kejahatan (perempuan-perempuan) penyihir yang meniup pada buhul-buhul (talinya),",
      "surah": {
        "number": 113,
        "name": "سُورَةُ الفَلَقِ",
        "englishName": "Al-Falaq",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 604,
      "ruku": 555,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6230,
      "text": "dan dari kejahatan orang yang dengki apabila dia dengki.\"",
      "surah": {
        "number": 113,
        "name": "سُورَةُ الفَلَقِ",
        "englishName": "Al-Falaq",
        "englishNameTranslation": "The Dawn",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 604,
      "ruku": 555,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6231,
      "text": "Katakanlah, \"Aku berlindung kepada Tuhannya manusia,",
      "surah": {
        "number": 114,
        "name": "سُورَةُ النَّاسِ",
        "englishName": "An-Naas",
