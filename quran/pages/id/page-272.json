      "hizbQuarter": 109,
      "sajda": false
    },
    {
      "number": 1954,
      "text": "Dan segala nikmat yang ada padamu (datangnya) dari Allah, kemudian apabila kamu ditimpa kesengsaraan, maka kepada-Nyalah kamu meminta pertolongan.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
