      "hizbQuarter": 109,
      "sajda": false
    },
    {
      "number": 1953,
      "text": "Dan milik-Nya segala apa yang ada di langit dan di bumi, dan kepada-Nyalah (ibadah dan) ketaatan selama-lamanya. Mengapa kamu takut kepada selain Allah?",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
