      "hizbQuarter": 108,
      "sajda": false
    },
    {
      "number": 1946,
      "text": "Maka apakah orang yang membuat tipu daya yang jahat itu merasa aman (dari bencana) dibenamkannya bumi oleh Allah bersama mereka, atau (terhadap) datangnya siksa kepada mereka dari arah yang tidak mereka sadari,",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 14,
