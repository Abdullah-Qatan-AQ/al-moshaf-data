      "hizbQuarter": 108,
      "sajda": false
    },
    {
      "number": 1948,
      "text": "atau Allah mengazab mereka dengan berangsur-angsur (sampai binasa).[456] Maka sungguh, Tuhanmu Maha Pengasih, Maha Penyayang.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
