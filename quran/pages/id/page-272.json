      "page": 272,
      "ruku": 229,
      "hizbQuarter": 108,
      "sajda": false
    },
    {
      "number": 1951,
      "text": "Mereka takut kepada Tuhan yang (berkuasa) di atas mereka dan melaksanakan apa yang diperintahkan (kepada mereka).",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
