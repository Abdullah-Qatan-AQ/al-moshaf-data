  "ayahs": [
    {
      "number": 4474,
      "text": "Ḥā Mīm.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4475,
      "text": "Kitab (ini) diturunkan dari Allah Yang Mahaperkasa, Mahabijaksana.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4476,
      "text": "Sungguh, pada langit dan bumi benar-benar terdapat tanda-tanda (kebesaran Allah) bagi orang-orang mukmin.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4477,
      "text": "Dan pada penciptaan dirimu dan pada makhluk bergerak yang bernyawa yang bertebaran (di bumi) terdapat tanda-tanda (kebesaran Allah) untuk kaum yang meyakini,",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4478,
      "text": "dan pada pergantian malam dan siang, dan hujan yang diturunkan Allah dari langit, lalu dengan (air hujan) itu dihidupkan-Nya bumi setelah mati (kering); dan pada perkisaran angin terdapat pula tanda-tanda (kebesaran Allah) bagi kaum yang mengerti.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4479,
      "text": "Itulah ayat-ayat Allah yang Kami bacakan kepadamu dengan sebenarnya; maka dengan perkataan mana lagi mereka akan beriman setelah Allah dan ayat-ayat-Nya.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4480,
      "text": "Celakalah bagi setiap orang yang banyak berdusta lagi banyak berdosa,",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4481,
      "text": "(yaitu) orang yang mendengar ayat-ayat Allah ketika dibacakan kepadanya, namun dia tetap menyombongkan diri seakan-akan dia tidak mendengarnya. Maka peringatkanlah dia dengan azab yang pedih.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4482,
      "text": "Dan apabila dia mengetahui sedikit tentang ayat-ayat Kami, maka (ayat-ayat itu) dijadikan olok-olok. Merekalah yang akan menerima azab yang menghinakan.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4483,
      "text": "Di hadapan mereka neraka Jahanam, dan tidak akan berguna bagi mereka sedikit pun apa yang telah mereka kerjakan, dan tidak pula (bermanfaat) apa yang mereka jadikan sebagai pelindung-pelindung (mereka) selain Allah. Dan mereka akan mendapat azab yang besar.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4484,
      "text": "Ini (Al-Qur`an) adalah petunjuk. Dan orang-orang yang mengingkari ayat-ayat Tuhannya, mereka akan mendapat azab berupa siksaan yang sangat pedih.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 434,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4485,
      "text": "Allah lah yang menundukkan laut untukmu agar kapal-kapal dapat berlayar di atasnya dengan perintah-Nya, dan agar kamu dapat mencari sebagian karunia-Nya, dan agar kamu bersyukur.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 435,
      "hizbQuarter": 200,
      "sajda": false
    },
    {
      "number": 4486,
      "text": "Dan Dia menundukkan apa yang ada di langit dan apa yang ada di bumi untukmu semuanya (sebagai rahmat) dari-Nya. Sungguh, dalam hal yang demikian itu benar-benar terdapat tanda-tanda (kebesaran Allah) bagi orang-orang yang berpikir.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 25,
      "manzil": 6,
      "page": 499,
      "ruku": 435,
      "hizbQuarter": 200,
      "sajda": false
    }
  ],
  "language": "id"
}
