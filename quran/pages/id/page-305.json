  "ayahs": [
    {
      "number": 2251,
      "text": "Kāf Hā Yā` 'Aīn Ṣād.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
