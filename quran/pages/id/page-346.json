  "ayahs": [
    {
      "number": 2733,
      "text": "dan mereka yang memberikan apa yang mereka berikan (sedekah) dengan hati penuh rasa takut (karena mereka tahu) bahwa sesungguhnya mereka akan kembali kepada Tuhannya,",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 60,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2734,
      "text": "mereka itu bersegera dalam kebaikan-kebaikan, dan merekalah orang-orang yang lebih dahulu memperolehnya.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 61,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2735,
      "text": "Dan Kami tidak membebani seseorang melainkan menurut kesanggupannya, dan pada Kami ada suatu catatan yang menuturkan dengan sebenarnya, dan mereka tidak dizalimi (dirugikan).",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 62,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2736,
      "text": "Tetapi, hati mereka (orang-orang kafir) itu dalam kesesatan dari (memahami Al-Qur`an) ini, dan mereka mempunyai (kebiasaan banyak mengerjakan) perbuatan-perbuatan lain (buruk) yang terus mereka kerjakan.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 63,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2737,
      "text": "Sehingga apabila Kami timpakan siksaan kepada orang-orang yang hidup bermewah-mewah di antara mereka, seketika itu mereka berteriak-teriak meminta tolong.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 64,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2738,
      "text": "Janganlah kamu berteriak-teriak meminta tolong pada hari ini! Sungguh, kamu tidak akan mendapat pertolongan dari Kami.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 65,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2739,
      "text": "Sungguh ayat-ayat-Ku (Al-Qur`an) selalu dibacakan kepada kamu, tetapi kamu selalu berpaling ke belakang,",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 66,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2740,
      "text": "dengan menyombongkan diri dan mengucapkan perkataan-perkataan keji terhadapnya (Al-Qur`an) pada waktu kamu bercakap-cakap pada malam hari.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 67,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2741,
      "text": "Maka tidaklah mereka menghayati firman (Allah), atau adakah telah datang kepada mereka apa yang tidak pernah datang kepada nenek moyang mereka dahulu?",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 68,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2742,
      "text": "Ataukah mereka tidak mengenal Rasul mereka (Muhammad), karena itu mereka mengingkarinya?",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 69,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2743,
      "text": "Atau mereka berkata, \"Orang itu (Muhammad) gila.\" Padahal, dia telah datang membawa kebenaran kepada mereka, tetapi kebanyakan mereka membenci kebenaran.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 70,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2744,
      "text": "Dan seandainya kebenaran itu menuruti keinginan mereka, pasti binasalah langit dan bumi, dan semua yang ada di dalamnya. Bahkan Kami telah memberikan peringatan kepada mereka, tetapi mereka berpaling dari peringatan itu.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 71,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2745,
      "text": "Atau engkau (Muhammad) meminta imbalan kepada mereka? Sedangkan imbalan dari Tuhanmu lebih baik, karena Dia pemberi rezeki yang terbaik.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 72,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2746,
      "text": "Dan sungguh engkau pasti telah menyeru mereka kepada jalan yang lurus.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 73,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2747,
      "text": "Dan sungguh orang-orang yang tidak beriman kepada akhirat benar-benar telah menyimpang jauh dari jalan (yang lurus).",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 74,
      "juz": 18,
      "manzil": 4,
      "page": 346,
      "ruku": 298,
      "hizbQuarter": 138,
      "sajda": false
    }
  ],
