  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5597,
      "text": "(yaitu) mata air (dalam surga) yang di minum oleh hamba-hamba Allah, dan mereka dapat memancarkannya dengan sebaik-baiknya.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 6,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5598,
      "text": "Mereka memenuhi nazar884) dan takut akan suatu hari yang azabnya merata di mana-mana.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 7,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5599,
      "text": "Dan mereka memberikan makanan yang disukainya kepada orang miskin, anak yatim dan orang yang ditawan,",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 8,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5600,
      "text": "(sambil berkata), \"Sesungguhnya kami memberi makanan kepadamu hanyalah karena mengharapkan keridaan Allah, kami tidak mengharap balasan dan terima kasih dari kamu.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 9,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5601,
      "text": "Sungguh, kami takut akan (azab) Tuhan pada hari (ketika) orang-orang berwajah masam penuh kesulitan.\"",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 10,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5602,
      "text": "Maka Allah melindungi mereka dari kesusahan hari itu, dan memberikan kepada mereka keceriaan dan kegembiraan.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 11,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5603,
      "text": "Dan Dia memberi balasan kepada mereka karena kesabarannya (berupa) surga dan (pakaian) sutera.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 12,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5604,
      "text": "Di sana mereka duduk bersandar di atas dipan, di sana mereka tidak melihat (merasakan teriknya) matahari dan tidak pula dingin yang berlebihan.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 13,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5605,
      "text": "Dan naungan (pepohonan)nya dekat di atas mereka dan dimudahkan semudah-mudahnya untuk memetik (buah)nya.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 14,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5606,
      "text": "Dan kepada mereka diedarkan bejana-bejana dari perak dan piala-piala yang bening laksana kristal,",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 15,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5607,
      "text": "kristal yang jernih terbuat dari perak, mereka tentukan ukurannya yang sesuai (dengan kehendak mereka).",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 16,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5608,
      "text": "Dan di sana mereka diberi segelas minuman bercampur jahe.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 17,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5609,
      "text": "(Yang didatangkan dari) suatu mata air (di surga) yang dinamakan Salsabīl.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 18,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5610,
      "text": "Dan mereka dikelilingi oleh para pemuda-pemuda yang tetap muda. Apabila kamu melihatnya, akan kamu kira mereka mutiara yang bertaburan.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 19,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5611,
      "text": "Dan apabila engkau melihat (keadaan) di sana (surga), niscaya engkau akan melihat berbagai macam kenikmatan dan kerajaan yang besar.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 20,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5612,
      "text": "Mereka berpakaian sutera halus yang hijau dan sutera tebal dan memakai gelang terbuat dari perak, dan Tuhan memberikan kepada mereka minuman yang bersih (dan suci).",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 21,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5613,
      "text": "Inilah balasan untukmu, dan segala usahamu diterima dan diakui (Allah).",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 22,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 514,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5614,
      "text": "Sesungguhnya Kamilah yang menurunkan Al-Qur`an kepadamu (Muhammad) secara berangsur-angsur.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 23,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 515,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5615,
      "text": "Maka bersabarlah untuk (melaksanakan) ketetapan Tuhanmu, dan janganlah engkau ikuti orang yang berdosa dan orang yang kafir di antara mereka.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 24,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 515,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5616,
      "text": "Dan sebutlah nama Tuhanmu pada (waktu) pagi dan petang.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 25,
      "juz": 29,
      "manzil": 7,
      "page": 579,
      "ruku": 515,
      "hizbQuarter": 232,
      "sajda": false
    }
  ],
