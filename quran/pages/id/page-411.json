  "ayahs": [
    {
      "number": 3470,
      "text": "Alif Lām Mīm.",
      "surah": {
        "number": 31,
        "name": "سُورَةُ لُقۡمَانَ",
        "englishName": "Luqman",
        "englishNameTranslation": "Luqman",
