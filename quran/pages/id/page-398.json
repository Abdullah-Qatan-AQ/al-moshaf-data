      "hizbQuarter": 159,
      "sajda": false
    },
    {
      "number": 3360,
      "text": "Katakanlah, \"Berjalanlah di bumi, maka perhatikanlah bagaimana (Allah) memulai penciptaan (makhluk), kemudian Allah menjadikan kejadian yang akhir.620) Sungguh, Allah Mahakuasa atas segala sesuatu.",
      "surah": {
        "number": 29,
        "name": "سُورَةُ العَنكَبُوتِ",
        "englishName": "Al-Ankaboot",
        "englishNameTranslation": "The Spider",
