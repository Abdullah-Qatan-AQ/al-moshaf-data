      "hizbQuarter": 159,
      "sajda": false
    },
    {
      "number": 3359,
      "text": "Dan apakah mereka tidak memperhatikan bagaimana Allah memulai penciptaan (makhluk), kemudian Dia mengulanginya (kembali). Sungguh, yang demikian itu mudah bagi Allah.",
      "surah": {
        "number": 29,
