  "ayahs": [
    {
      "number": 2224,
      "text": "Sungguh, Kami telah memberi kedudukan kepadanya di bumi, dan Kami telah memberikan jalan kepadanya (untuk mencapai) segala sesuatu,",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 84,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2225,
      "text": "maka dia pun menempuh suatu jalan.",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 85,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2226,
      "text": "Hingga ketika dia telah sampai di tempat matahari terbenam,[496] dia melihatnya (matahari) terbenam di dalam laut yang berlumpur hitam, dan di sana ditemukannya suatu kaum (tidak beragama). Kami berfirman, \"Wahai Zulkarnain! Engkau boleh menghukum atau berbuat kebaikan (mengajak beriman) kepada mereka.\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 86,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2227,
      "text": "Dia (Zulkarnain) berkata, \"Barangsiapa berbuat zalim, Kami akan menghukumnya, lalu dia akan dikembalikan kepada Tuhannya, kemudian Tuhan mengazabnya dengan azab yang sangat keras.",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 87,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2228,
      "text": "Adapun orang yang beriman dan mengerjakan kebajikan, maka dia mendapat (pahala) yang terbaik sebagai balasan, dan akan kami sampaikan kepadanya perintah kami yang mudah-mudah.\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 88,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2229,
      "text": "Kemudian dia menempuh suatu jalan (yang lain).",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 89,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2230,
      "text": "Hingga ketika dia sampai di tempat terbit matahari (sebelah Timur) didapatinya (matahari) bersinar di atas suatu kaum yang tidak Kami buatkan suatu pelindung bagi mereka dari (cahaya matahari)[497] itu.",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 90,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2231,
      "text": "Demikianlah, dan sesungguhnya Kami mengetahui segala sesuatu yang ada padanya (Zulkarnain).",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 91,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2232,
      "text": "Kemudian dia menempuh suatu jalan (yang lain lagi).",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 92,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2233,
      "text": "Hingga ketika dia sampai di antara dua gunung, didapatinya di belakang (kedua gunung itu) suatu kaum yang hampir tidak memahami pembicaraan.[498]",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 93,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2234,
      "text": "Mereka berkata, \"Wahai Zulkarnain! Sungguh, Ya`jūj dan Ma`jūj[499] itu (makhluk yang) berbuat kerusakan di bumi, maka bolehkah kami membayarmu imbalan agar engkau membuatkan dinding penghalang antara kami dan mereka?\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 94,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2235,
      "text": "Dia (Zulkarnain) berkata, \"Apa yang telah dianugerahkan Tuhan kepadaku lebih baik (daripada imbalanmu), maka bantulah aku dengan kekuatan, agar aku dapat membuatkan dinding penghalang antara kamu dan mereka.",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 95,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2236,
      "text": "Berilah aku potongan-potongan besi!\" Hingga ketika (potongan) besi itu telah (terpasang) sama rata dengan kedua (puncak) gunung itu, dia (Zulkarnain) berkata, \"Tiuplah (api itu)!\" Ketika (besi) itu sudah menjadi (merah seperti) api, dia pun berkata, \"Berilah aku tembaga (yang mendidih) agar kutuangkan ke atasnya (besi panas itu).\"",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 96,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2237,
      "text": "Maka mereka (Ya`jūj dan Ma`jūj) tidak dapat mendakinya dan tidak dapat (pula) melubanginya.",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 97,
      "juz": 16,
      "manzil": 4,
      "page": 303,
      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    }
  ],
