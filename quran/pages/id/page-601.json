      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6178,
      "text": "Sungguh, manusia berada dalam kerugian,",
      "surah": {
        "number": 103,
        "name": "سُورَةُ العَصۡرِ",
        "englishName": "Al-Asr",
        "englishNameTranslation": "The Declining Day, Epoch",
        "numberOfAyahs": 3,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 545,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6179,
      "text": "kecuali orang-orang yang beriman dan mengerjakan kebajikan serta saling menasihati untuk kebenaran dan saling menasihati untuk kesabaran.",
      "surah": {
        "number": 103,
        "name": "سُورَةُ العَصۡرِ",
        "englishName": "Al-Asr",
        "englishNameTranslation": "The Declining Day, Epoch",
        "numberOfAyahs": 3,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 545,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6180,
      "text": "Celakalah bagi setiap pengumpat dan pencela,",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6181,
      "text": "yang mengumpulkan harta dan menghitung-hitungnya,[924]",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6182,
      "text": "dia (manusia) mengira bahwa hartanya itu dapat mengekalkannya.",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6183,
      "text": "Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Ḥuṭamah.",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6184,
      "text": "Dan tahukah kamu apakah (neraka) Ḥuṭamah itu?",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6185,
      "text": "(Yaitu) api (azab) Allah yang dinyalakan,",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6186,
      "text": "yang (membakar) sampai ke hati.",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6187,
      "text": "Sungguh, api itu ditutup rapat atas (diri) mereka,",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6188,
      "text": "(sedang mereka itu) diikat pada tiang-tiang yang panjang.",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6189,
      "text": "Tidakkah engkau (Muhammad) perhatikan bagaimana Tuhanmu telah bertindak terhadap pasukan bergajah?[925]",
      "surah": {
        "number": 105,
        "name": "سُورَةُ الفِيلِ",
        "englishName": "Al-Fil",
        "englishNameTranslation": "The Elephant",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 547,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6190,
      "text": "Bukankah Dia telah menjadikan tipu daya mereka itu sia-sia?",
      "surah": {
        "number": 105,
        "name": "سُورَةُ الفِيلِ",
        "englishName": "Al-Fil",
        "englishNameTranslation": "The Elephant",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 547,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6191,
      "text": "Dan Dia mengirimkan kepada mereka burung yang berbondong-bondong,",
      "surah": {
        "number": 105,
        "name": "سُورَةُ الفِيلِ",
        "englishName": "Al-Fil",
        "englishNameTranslation": "The Elephant",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 601,
      "ruku": 547,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6192,
      "text": "yang melempari mereka dengan batu dari tanah liat yang dibakar,",
      "surah": {
        "number": 105,
        "name": "سُورَةُ الفِيلِ",
        "englishName": "Al-Fil",
        "englishNameTranslation": "The Elephant",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
