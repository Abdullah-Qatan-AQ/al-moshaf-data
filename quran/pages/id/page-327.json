  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 2541,
      "text": "Maka dia (Ibrahim) menghancurkan (berhala-berhala itu) berkeping-keping, kecuali yang terbesar (induknya); agar mereka kembali (untuk bertanya) kepadanya.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 58,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2542,
      "text": "Mereka berkata, \"Siapakah yang melakukan (perbuatan) ini terhadap tuhan-tuhan kami? Sungguh, dia termasuk orang yang zalim.\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2543,
      "text": "Mereka (yang lain) berkata, \"Kami mendengar ada seorang pemuda yang mencela (berhala-berhala ini), namanya Ibrahim.\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 60,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2544,
      "text": "Mereka berkata, \"(Kalau demikian) bawalah dia dengan diperlihatkan kepada orang banyak, agar mereka menyaksikan.\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 61,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2545,
      "text": "Mereka bertanya, \"Apakah engkau yang melakukan (perbuatan) ini terhadap tuhan-tuhan kami, wahai Ibrahim?\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 62,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2546,
      "text": "Dia (Ibrahim) menjawab, \"Sebenarnya (patung) besar itu yang melakukannya, maka tanyakanlah kepada mereka, jika mereka dapat berbicara.\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 63,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2547,
      "text": "Maka mereka kembali pada kesadaran mereka dan berkata, \"Sesungguhnya kamulah yang menzalimi (diri sendiri).\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 64,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2548,
      "text": "Kemudian mereka menundukkan kepala (lalu berkata), \"Engkau (Ibrahim) pasti tahu bahwa (berhala-berhala) itu tidak dapat berbicara.\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 65,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2549,
      "text": "Dia (Ibrahim) berkata, \"Mengapa kamu menyembah selain Allah, sesuatu yang tidak dapat memberi manfaat sedikit pun, dan tidak (pula) mendatangkan mudarat kepada kamu?",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 66,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2550,
      "text": "Celakalah kamu dan apa yang kamu sembah selain Allah! Tidakkah kamu mengerti?\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 67,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2551,
      "text": "Mereka berkata, \"Bakarlah dia dan bantulah tuhan-tuhan kamu, jika kamu benar-benar hendak berbuat.\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 68,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2552,
      "text": "Kami (Allah) berfirman, \"Wahai api! Jadilah kamu dingin, dan penyelamat bagi Ibrahim.\"",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 69,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2553,
      "text": "Dan mereka hendak berbuat jahat terhadap Ibrahim, maka Kami menjadikan mereka itu orang-orang yang paling rugi.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 70,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2554,
      "text": "Dan Kami selamatkan dia (Ibrahim) dan Luṭ ke suatu negeri yang telah Kami berkahi untuk seluruh alam.[533]",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 71,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2555,
      "text": "Dan Kami menganugerahkan kepadanya (Ibrahim) Ishak dan Yakub sebagai suatu anugerah. Dan masing-masing Kami jadikan orang yang saleh.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 72,
      "juz": 17,
      "manzil": 4,
      "page": 327,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    }
  ],
