{
  "page": 578,
  "lang": "ar",
  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5571,
      "text": "Tidak! Bahkan Kamu mencintai kehidupan dunia,",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5572,
      "text": "dan mengabaikan (kehidupan) akhirat.",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5573,
      "text": "Wajah-wajah (orang mukmin) pada hari itu berseri-seri.",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5574,
      "text": "Memandang Tuhannya.",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5575,
      "text": "Dan wajah-wajah (orang kafir) pada hari itu muram,",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5576,
      "text": "mereka yakin bahwa akan ditimpakan kepadanya malapetaka yang sangat dahsyat.",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5577,
      "text": "Tidak! Apabila (nyawa) telah sampai ke kerongkongan,",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5578,
      "text": "dan dikatakan (kepadanya), \"Siapa yang dapat menyembuhkan?\"",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5579,
      "text": "dan dia yakin bahwa itulah waktu perpisahan (dengan dunia),",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5580,
      "text": "dan bertaut betis (kiri) dengan betis (kanan),[881]",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5581,
      "text": "kepada Tuhanmu lah pada hari itu kamu dihalau.",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 30,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 512,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5582,
      "text": "Karena dia (dahulu) tidak mau membenarkan (Al-Qur`an dan Rasul) dan tidak mau melaksanakan salat,",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 31,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5583,
      "text": "tetapi justru dia mendustakan (Rasul) dan berpaling (dari kebenaran),",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 32,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5584,
      "text": "kemudian dia pergi kepada keluarganya dengan sombong.",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 33,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5585,
      "text": "Celakalah kamu! Maka celakalah!",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5586,
      "text": "Sekali lagi, celakalah kamu (manusia)! Maka celakalah!",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5587,
      "text": "Apakah manusia mengira, dia akan dibiarkan begitu saja (tanpa pertanggung-jawaban)?",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5588,
      "text": "Bukankah dia mulanya hanya setetes mani yang ditumpahkan (ke dalam rahim),",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5589,
      "text": "kemudian (mani itu) menjadi sesuatu yang melekat, lalu Allah menciptakannya dan menyempurnakannya,",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5590,
      "text": "lalu Dia menjadikan darinya sepasang laki-laki dan perempuan.",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 39,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5591,
      "text": "Bukankah (Allah yang berbuat) demikian berkuasa (pula) menghidupkan orang mati?",
      "surah": {
        "number": 75,
        "name": "سُورَةُ القِيَامَةِ",
        "englishName": "Al-Qiyaama",
        "englishNameTranslation": "The Resurrection",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 513,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5592,
      "text": "Bukankah pernah datang kepada manusia waktu dari masa, yang ketika itu belum merupakan sesuatu yang dapat disebut?",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 1,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5593,
      "text": "Sungguh, Kami telah menciptakan manusia dari setetes mani yang bercampur[882] yang Kami hendak mengujinya (dengan perintah dan larangan), karena itu Kami jadikan dia mendengar dan melihat.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 2,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5594,
      "text": "Sungguh, Kami telah menunjukkan kepadanya jalan yang lurus; ada yang bersyukur dan ada pula yang kufur.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 3,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5595,
      "text": "Sungguh, Kami telah menyediakan bagi orang-orang kafir rantai, belenggu dan neraka yang menyala-nyala.",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 4,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    },
    {
      "number": 5596,
      "text": "Sungguh, orang-orang yang berbuat kebajikan akan minum dari gelas (berisi minuman) yang campurannya adalah air kafur,[883]",
      "surah": {
        "number": 76,
        "name": "سُورَةُ الإِنسَانِ",
        "englishName": "Al-Insaan",
        "englishNameTranslation": "Man",
        "numberOfAyahs": 31,
        "revelationType": "Medinan"
      },
      "numberInSurah": 5,
      "juz": 29,
      "manzil": 7,
      "page": 578,
      "ruku": 514,
      "hizbQuarter": 231,
      "sajda": false
    }
  ],
