  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5883,
      "text": "mereka (duduk) di atas dipan-dipan melepas pandangan.",
      "surah": {
        "number": 83,
        "name": "سُورَةُ المُطَفِّفِينَ",
        "englishName": "Al-Mutaffifin",
        "englishNameTranslation": "Defrauding",
        "numberOfAyahs": 36,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5884,
      "text": "Apakah orang-orang kafir itu diberi balasan (hukuman) terhadap apa yang telah mereka perbuat?",
      "surah": {
        "number": 83,
        "name": "سُورَةُ المُطَفِّفِينَ",
        "englishName": "Al-Mutaffifin",
        "englishNameTranslation": "Defrauding",
        "numberOfAyahs": 36,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 525,
      "hizbQuarter": 235,
      "sajda": false
    },
    {
      "number": 5885,
      "text": "Apabila langit terbelah,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5886,
      "text": "dan patuh kepada Tuhannya, dan sudah semestinya patuh,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5887,
      "text": "dan apabila bumi diratakan,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5888,
      "text": "dan memuntahkan apa yang ada di dalamnya dan menjadi kosong,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5889,
      "text": "dan patuh kepada Tuhannya, dan sudah semestinya patuh.",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5890,
      "text": "Wahai manusia! Sesungguhnya kamu telah bekerja keras menuju Tuhanmu, maka kamu akan menemui-Nya.903)",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5891,
      "text": "Maka adapun orang yang catatanya diberikan dari sebelah kanannya,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5892,
      "text": "maka dia akan diperiksa dengan pemeriksaan yang mudah,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5893,
      "text": "dan dia akan kembali kepada keluarganya (yang sama-sama beriman) dengan gembira.",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5894,
      "text": "Dan adapun orang yang catatannya diberikan dari arah belakang,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5895,
      "text": "maka dia akan berteriak, \"Celakalah aku!\"",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5896,
      "text": "Dan dia akan masuk ke dalam api yang menyala-nyala (neraka).",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5897,
      "text": "Sungguh, dia dahulu (di dunia) bergembira di kalangan keluarganya (yang sama-sama kafir).",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5898,
      "text": "Sesungguhnya dia mengira bahwa dia tidak akan kembali (kepada Tuhannya).",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5899,
      "text": "Tidak demikian, sesungguhnya Tuhannya selalu melihatnya.",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5900,
      "text": "Maka Aku bersumpah demi cahaya merah pada waktu senja,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5901,
      "text": "demi malam dan apa yang diselubunginya,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5902,
      "text": "demi bulan apabila jadi purnama,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5903,
      "text": "sungguh, akan kamu jalani tingkat demi tingkat (dalam kehidupan).904)",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5904,
      "text": "Maka mengapa mereka tidak mau beriman?",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5905,
      "text": "Dan apabila Al-Qur`an dibacakan kepada mereka, mereka tidak (mau) bersujud,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": {
        "id": 14,
        "recommended": true,
        "obligatory": false
      }
    },
    {
      "number": 5906,
      "text": "bahkan orang-orang kafir itu mendustakan-(nya).",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5907,
      "text": "Dan Allah lebih mengetahui apa yang mereka sembunyikan (dalam hati mereka).",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5908,
      "text": "Maka sampaikanlah kepada mereka (ancaman) azab yang pedih,",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 30,
      "manzil": 7,
      "page": 589,
      "ruku": 526,
      "hizbQuarter": 236,
      "sajda": false
    },
    {
      "number": 5909,
      "text": "kecuali orang-orang yang beriman dan mengerjakan kebajikan, mereka akan mendapat pahala yang tidak putus-putusnya.",
      "surah": {
        "number": 84,
        "name": "سُورَةُ الانشِقَاقِ",
        "englishName": "Al-Inshiqaaq",
        "englishNameTranslation": "The Splitting Open",
        "numberOfAyahs": 25,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 30,
      "manzil": 7,
