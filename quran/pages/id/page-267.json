  "ayahs": [
    {
      "number": 1893,
      "text": "(Yaitu) orang-orang447) yang telah menjadikan Al-Qur`an itu terbagi-bagi.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 91,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1894,
      "text": "Maka demi Tuhanmu, Kami pasti akan menanyai mereka semua,",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 92,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1895,
      "text": "tentang apa yang telah mereka kerjakan dahulu.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 93,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1896,
      "text": "Maka sampaikanlah (Muhammad) secara terang-terangan segala apa yang diperintahkan (kepadamu) dan berpalinglah dari orang yang musyrik.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 94,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1897,
      "text": "Sesungguhnya Kami memelihara engkau (Muhammad) dari (kejahatan) orang yang memperolok-olokkan (engkau),",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 95,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1898,
      "text": "(yaitu) orang yang menganggap adanya tuhan selain Allah; mereka kelak akan mengetahui (akibatnya).",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 96,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1899,
      "text": "Dan sungguh, Kami mengetahui bahwa dadamu menjadi sempit disebabkan apa yang mereka ucapkan,",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 97,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1900,
      "text": "maka bertasbihlah dengan memuji Tuhanmu dan jadilah engkau di antara orang yang bersujud (salat),",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 98,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1901,
      "text": "dan sembahlah Tuhanmu sampai yakin (ajal) datang kepadamu.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 99,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1902,
      "text": "Ketetapan Allah448) pasti datang, maka janganlah kamu meminta agar dipercepat (datang)nya. Mahasuci Allah dan Mahatinggi Dia dari apa yang mereka persekutukan.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 224,
      "hizbQuarter": 107,
      "sajda": false
    },
    {
      "number": 1903,
      "text": "Dia menurunkan para malaikat membawa wahyu dengan perintah-Nya kepada siapa yang Dia kehendaki di antara hamba-hamba-Nya, (dengan berfirman) yaitu, \"Peringatkanlah (hamba-hamba-Ku), bahwa tidak ada tuhan selain Aku, maka hendaklah kamu bertakwa kepada-Ku.\"",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 224,
      "hizbQuarter": 107,
      "sajda": false
    },
    {
      "number": 1904,
      "text": "Dia menciptakan langit dan bumi dengan kebenaran. Mahatinggi Allah dari apa yang mereka persekutukan.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 224,
      "hizbQuarter": 107,
      "sajda": false
    },
    {
      "number": 1905,
      "text": "Dia telah menciptakan manusia dari mani, ternyata dia menjadi pembantah yang nyata.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 224,
      "hizbQuarter": 107,
      "sajda": false
    },
    {
      "number": 1906,
      "text": "Dan hewan ternak telah diciptakan-Nya untuk kamu, padanya ada (bulu) yang menghangatkan dan berbagai manfaat, dan sebagiannya kamu makan.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 224,
      "hizbQuarter": 107,
      "sajda": false
    },
    {
      "number": 1907,
      "text": "Dan kamu memperoleh keindahan padanya, ketika kamu membawanya kembali ke kandang dan ketika kamu melepaskannya (ke tempat penggembalaan).",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 224,
      "hizbQuarter": 107,
      "sajda": false
    }
  ],
