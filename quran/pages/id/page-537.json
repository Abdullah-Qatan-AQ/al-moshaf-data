  "edition": "quran-uthmani",
  "ayahs": [
    {
      "number": 5056,
      "text": "dan (ini) sesungguhnya Al-Qur`an yang sangat mulia,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 77,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5057,
      "text": "dalam Kitab yang terpelihara (Lauḥ Maḥfūẓ),",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 78,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5058,
      "text": "tidak ada yang menyentuhnya selain hamba-hamba yang disucikan.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 79,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5059,
      "text": "Diturunkan dari Tuhan seluruh alam.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 80,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5060,
      "text": "Apakah kamu menganggap remeh berita ini (Al-Qur`an)?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 81,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5061,
      "text": "dan kamu menjadikan rezeki yang kamu terima (dari Allah) justru untuk mendustakan(-Nya).",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 82,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5062,
      "text": "Maka kalau begitu mengapa (tidak mencegah) ketika (nyawa) telah sampai di kerongkongan,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 83,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5063,
      "text": "dan kamu ketika itu melihat,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 84,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5064,
      "text": "dan Kami lebih dekat kepadanya daripada kamu, tetapi kamu tidak melihat,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 85,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5065,
      "text": "maka mengapa jika kamu memang tidak dikuasai (oleh Allah),",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 86,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5066,
      "text": "kamu tidak mengembalikannya (nyawa itu) jika kamu orang yang benar?",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 87,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5067,
      "text": "Jika dia (orang yang mati) itu termasuk yang didekatkan (kepada Allah),",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 88,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5068,
      "text": "maka dia memperoleh ketenteraman dan rezeki serta surga (yang penuh) kenikmatan.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 89,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5069,
      "text": "Dan jika dia termasuk golongan kanan,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 90,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5070,
      "text": "maka, \"Salam bagimu (wahai) dari golongan kanan!\" (sambut malaikat).",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 91,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5071,
      "text": "Namun jika dia termasuk golongan yang mendustakan dan sesat,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 92,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5072,
      "text": "maka dia disambut siraman air yang mendidih,",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 93,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5073,
      "text": "dan dibakar di dalam neraka.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 94,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5074,
      "text": "Sungguh, inilah keyakinan yang benar.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 95,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5075,
      "text": "Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahabesar.",
      "surah": {
        "number": 56,
        "name": "سُورَةُ الوَاقِعَةِ",
        "englishName": "Al-Waaqia",
        "englishNameTranslation": "The Inevitable",
        "numberOfAyahs": 96,
        "revelationType": "Meccan"
      },
      "numberInSurah": 96,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 471,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5076,
      "text": "Apa yang di langit dan di bumi bertasbih kepada Allah. Dialah Yang Mahaperkasa, Mahabijaksana.",
      "surah": {
        "number": 57,
        "name": "سُورَةُ الحَدِيدِ",
        "englishName": "Al-Hadid",
        "englishNameTranslation": "The Iron",
        "numberOfAyahs": 29,
        "revelationType": "Medinan"
      },
      "numberInSurah": 1,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 472,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5077,
      "text": "Milik-Nyalah kerajaan langit dan bumi, Dia menghidupkan dan mematikan, dan Dia Mahakuasa atas segala sesuatu.",
      "surah": {
        "number": 57,
        "name": "سُورَةُ الحَدِيدِ",
        "englishName": "Al-Hadid",
        "englishNameTranslation": "The Iron",
        "numberOfAyahs": 29,
        "revelationType": "Medinan"
      },
      "numberInSurah": 2,
      "juz": 27,
      "manzil": 7,
      "page": 537,
      "ruku": 472,
      "hizbQuarter": 215,
      "sajda": false
    },
    {
      "number": 5078,
      "text": "Dialah Yang Awal, Yang Akhir, Yang Zahir dan Yang Batin;830) dan Dia Maha Mengetahui segala sesuatu.",
      "surah": {
        "number": 57,
        "name": "سُورَةُ الحَدِيدِ",
        "englishName": "Al-Hadid",
        "englishNameTranslation": "The Iron",
        "numberOfAyahs": 29,
