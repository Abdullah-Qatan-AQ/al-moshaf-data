      "hizbQuarter": 112,
      "sajda": false
    },
    {
      "number": 2024,
      "text": "Kemudian Kami wahyukan kepadamu (Muhammad), \"Ikutilah agama Ibrahim yang lurus, dan dia bukanlah termasuk orang yang musyrik.\"",
      "surah": {
        "number": 16,
