    },
    {
      "number": 2023,
      "text": "Dan Kami berikan kepadanya kebaikan di dunia, dan sesungguhnya di akhirat dia termasuk orang yang saleh.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
