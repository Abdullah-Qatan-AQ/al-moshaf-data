      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2558,
      "text": "dan Kami masukkan dia ke dalam rahmat Kami; sesungguhnya dia termasuk golongan orang yang saleh.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
