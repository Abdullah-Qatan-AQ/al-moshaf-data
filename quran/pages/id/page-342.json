  "ayahs": [
    {
      "number": 2674,
      "text": "Sungguh beruntung orang-orang yang beriman,",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2675,
      "text": "(yaitu) orang yang khusyuk dalam salatnya,",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2676,
      "text": "dan orang yang menjauhkan diri dari (perbuatan dan perkataan) yang tidak berguna,",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2677,
      "text": "dan orang yang menunaikan zakat,",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2678,
      "text": "dan orang yang memelihara kemaluannya,",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2679,
      "text": "kecuali terhadap istri-istri mereka atau hamba sahaya yang mereka miliki;[550]maka sesungguhnya mereka tidak tercela.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2680,
      "text": "Tetapi barang siapa mencari di balik itu (zina, dan sebagainya), maka mereka itulah orang-orang yang melampaui batas.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2681,
      "text": "Dan (sungguh beruntung) orang yang memelihara amanat-amanat dan janjinya,",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2682,
      "text": "serta orang yang memelihara salatnya.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2683,
      "text": "Mereka itulah orang yang akan mewarisi,",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 10,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2684,
      "text": "(yakni) yang akan mewarisi (surga) Firdaus. Mereka kekal di dalamnya.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2685,
      "text": "Dan sungguh, Kami telah menciptakan manusia dari saripati (berasal) dari tanah.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 12,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2686,
      "text": "Kemudian Kami menjadikannya air mani (yang disimpan) dalam tempat yang kokoh (rahim).",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 13,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2687,
      "text": "Kemudian, air mani itu Kami jadikan sesuatu yang melekat, lalu sesuatu yang melekat itu Kami jadikan segumpal daging, dan segumpal daging itu lalu Kami jadikan tulang belulang, lalu tulang belulang itu Kami bungkus dengan daging. Kemudian, Kami menjadikannya makhluk yang (berbentuk) lain. Mahasuci Allah, Pencipta yang paling baik.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 14,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2688,
      "text": "Kemudian setelah itu, sungguh kamu pasti mati.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 15,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2689,
      "text": "Kemudian, sungguh kamu akan dibangkitkan (dari kuburmu) pada hari Kiamat.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 18,
      "manzil": 4,
      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2690,
      "text": "Dan sungguh, kami telah menciptakan tujuh (lapis) langit di atas kamu, dan Kami tidaklah lengah terhadap ciptaan (Kami).",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
