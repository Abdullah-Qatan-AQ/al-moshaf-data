  "ayahs": [
    {
      "number": 4666,
      "text": "Dan betapa banyak umat yang telah Kami binasakan sebelum mereka, (padahal) mereka lebih hebat kekuatannya daripada mereka (umat yang belakangan) ini. Mereka pernah menjelajah di beberapa negeri. Adakah tempat pelarian (dari kebinasaan bagi mereka)?",
      "surah": {
        "number": 50,
        "name": "سُورَةُ قٓ",
        "englishName": "Qaaf",
        "englishNameTranslation": "The letter Qaaf",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 454,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4667,
      "text": "Sungguh, pada yang demikian itu pasti terdapat peringatan bagi orang-orang yang mempunyai hati atau yang menggunakan pendengarannya, sedang dia menyaksikannya.",
      "surah": {
        "number": 50,
        "name": "سُورَةُ قٓ",
        "englishName": "Qaaf",
        "englishNameTranslation": "The letter Qaaf",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 37,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 454,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4668,
      "text": "Dan sungguh, Kami telah menciptakan langit dan bumi dan apa yang ada di antara keduanya dalam enam masa, dan Kami tidak merasa letih sedikit pun.",
      "surah": {
        "number": 50,
        "name": "سُورَةُ قٓ",
        "englishName": "Qaaf",
        "englishNameTranslation": "The letter Qaaf",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 454,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4669,
      "text": "Maka bersabarlah engkau (Muhammad) terhadap apa yang mereka katakan, dan bertasbihlah dengan memuji Tuhanmu sebelum matahari terbit dan sebelum terbenam.",
      "surah": {
        "number": 50,
        "name": "سُورَةُ قٓ",
        "englishName": "Qaaf",
        "englishNameTranslation": "The letter Qaaf",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 39,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 454,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4670,
      "text": "Dan bertasbihlah kepada-Nya pada malam hari dan setiap selesai salat.",
      "surah": {
        "number": 50,
        "name": "سُورَةُ قٓ",
        "englishName": "Qaaf",
        "englishNameTranslation": "The letter Qaaf",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 40,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 454,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4671,
      "text": "Dan dengarkanlah (seruan) pada hari (ketika) penyeru (malaikat) menyeru dari tempat yang dekat.",
      "surah": {
        "number": 50,
        "name": "سُورَةُ قٓ",
        "englishName": "Qaaf",
        "englishNameTranslation": "The letter Qaaf",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 41,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 454,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4672,
      "text": "(Yaitu) pada hari (ketika) mereka mendengar suara dahsyat dengan sebenarnya. Itulah hari keluar (dari kubur).",
      "surah": {
        "number": 50,
        "name": "سُورَةُ قٓ",
        "englishName": "Qaaf",
        "englishNameTranslation": "The letter Qaaf",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 454,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4673,
      "text": "Sungguh, Kami yang menghidupkan dan mematikan, dan kepada Kami tempat kembali (semua makhluk).",
      "surah": {
        "number": 50,
        "name": "سُورَةُ قٓ",
        "englishName": "Qaaf",
        "englishNameTranslation": "The letter Qaaf",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 454,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4674,
      "text": "(Yaitu) pada hari (ketika) bumi terbelah, mereka keluar dengan cepat. Yang demikian itu adalah pengumpulan yang mudah bagi Kami.",
      "surah": {
        "number": 50,
        "name": "سُورَةُ قٓ",
        "englishName": "Qaaf",
        "englishNameTranslation": "The letter Qaaf",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 454,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4675,
      "text": "Kami lebih mengetahui tentang apa yang mereka katakan, dan engkau (Muhammad) bukanlah seorang pemaksa terhadap mereka. Maka berilah peringatan dengan Alquran kepada siapa pun yang takut kepada ancaman-Ku.",
      "surah": {
        "number": 50,
        "name": "سُورَةُ قٓ",
        "englishName": "Qaaf",
        "englishNameTranslation": "The letter Qaaf",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 45,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 454,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4676,
      "text": "Demi (angin) yang menerbangkan debu,",
      "surah": {
        "number": 51,
        "name": "سُورَةُ الذَّارِيَاتِ",
        "englishName": "Adh-Dhaariyat",
        "englishNameTranslation": "The Winnowing Winds",
        "numberOfAyahs": 60,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 455,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4677,
      "text": "dan awan yang mengandung (hujan),",
      "surah": {
        "number": 51,
        "name": "سُورَةُ الذَّارِيَاتِ",
        "englishName": "Adh-Dhaariyat",
        "englishNameTranslation": "The Winnowing Winds",
        "numberOfAyahs": 60,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 455,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4678,
      "text": "dan (kapal-kapal) yang berlayar dengan mudah,",
      "surah": {
        "number": 51,
        "name": "سُورَةُ الذَّارِيَاتِ",
        "englishName": "Adh-Dhaariyat",
        "englishNameTranslation": "The Winnowing Winds",
        "numberOfAyahs": 60,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 455,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4679,
      "text": "dan (malaikat-malaikat) yang membagi-bagi urusan,",
      "surah": {
        "number": 51,
        "name": "سُورَةُ الذَّارِيَاتِ",
        "englishName": "Adh-Dhaariyat",
        "englishNameTranslation": "The Winnowing Winds",
        "numberOfAyahs": 60,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 455,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4680,
      "text": "sungguh, apa yang dijanjikan kepadamu pasti benar,",
      "surah": {
        "number": 51,
        "name": "سُورَةُ الذَّارِيَاتِ",
        "englishName": "Adh-Dhaariyat",
        "englishNameTranslation": "The Winnowing Winds",
        "numberOfAyahs": 60,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 26,
      "manzil": 7,
      "page": 520,
      "ruku": 455,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4681,
      "text": "dan sungguh, (hari) pembalasan pasti terjadi.",
      "surah": {
