  "ayahs": [
    {
      "number": 3891,
      "text": "Maka ketika keduanya telah berserah diri dan dia (Ibrahim) membaringkan anaknya atas pelipisnya, (untuk melaksanakan perintah Allah).",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 103,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3892,
      "text": "Lalu Kami panggil dia, \"Wahai Ibrahim!",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 104,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3893,
      "text": "Sungguh, engkau telah membenarkan mimpi itu.\"[733] Sungguh, demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 105,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3894,
      "text": "Sesungguhnya ini benar-benar suatu ujian yang nyata.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 106,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3895,
      "text": "Dan Kami tebus anak itu dengan seekor sembelihan yang besar.[734]",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 107,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3896,
      "text": "Dan Kami abadikan untuk Ibrahim (pujian) di kalangan orang-orang yang datang kemudian,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 108,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3897,
      "text": "\"Selamat sejahtera bagi Ibrahim.\"",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 109,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3898,
      "text": "Demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 110,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3899,
      "text": "Sungguh, dia termasuk hamba-hamba Kami yang beriman.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 111,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3900,
      "text": "Dan Kami beri dia kabar gembira dengan (kelahiran) Ishak seorang nabi yang termasuk orang-orang yang saleh.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 112,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3901,
      "text": "Dan Kami limpahkan keberkahan kepadanya dan kepada Ishak. Dan di antara keturunan keduanya ada yang berbuat baik dan ada (pula) yang terang-terangan berbuat zalim terhadap dirinya sendiri.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 113,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3902,
      "text": "Dan sungguh, Kami telah melimpahkan nikmat kepada Musa dan Harun.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 114,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3903,
      "text": "Dan Kami selamatkan keduanya dan kaumnya dari bencana yang besar.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 115,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3904,
      "text": "Dan Kami tolong mereka, sehingga jadilah mereka orang-orang yang menang.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 116,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3905,
      "text": "Dan Kami berikan kepada keduanya Kitab yang sangat jelas.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 117,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3906,
      "text": "Dan Kami tunjukkan keduanya jalan yang lurus.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 118,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3907,
      "text": "Dan Kami abadikan untuk keduanya (pujian) di kalangan orang-orang yang datang kemudian,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 119,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3908,
      "text": "\"Selamat sejahtera bagi Musa dan Harun.\"",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 120,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3909,
      "text": "Demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 121,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3910,
      "text": "Sungguh, keduanya termasuk hamba-hamba Kami yang beriman.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 122,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3911,
      "text": "Dan sungguh, Ilyas benar-benar termasuk salah seorang rasul.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 123,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3912,
      "text": "(Ingatlah) ketika dia berkata kepada kaumnya, \"Mengapa kamu tidak bertakwa?",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 124,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3913,
      "text": "Patutkah kamu menyembah Ba'l [735] dan kamu tinggalkan (Allah) sebaik-baik Pencipta,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 125,
      "juz": 23,
      "manzil": 6,
      "page": 450,
      "ruku": 389,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3914,
      "text": "(yaitu) Allah Tuhanmu dan Tuhan nenek moyangmu yang terdahulu?\"",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
