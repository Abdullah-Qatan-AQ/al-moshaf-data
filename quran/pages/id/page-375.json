  "ayahs": [
    {
      "number": 3116,
      "text": "dan bertakwalah kepada Allah yang telah menciptakan kamu dan umat-umat yang terdahulu.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 184,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 325,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3117,
      "text": "Mereka berkata, \"Engkau tidak lain hanyalah orang-orang yang kena sihir,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 185,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 325,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3118,
      "text": "dan engkau hanyalah manusia seperti kami, dan sesungguhnya kami yakin engkau termasuk orang-orang yang berdusta.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 186,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 325,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3119,
      "text": "Maka jatuhkanlah kepada kami gumpalan dari langit, jika engkau termasuk orang-orang yang benar.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 187,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 325,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3120,
      "text": "Dia (Syu'aib) berkata, \"Tuhanku lebih mengetahui apa yang kamu kerjakan.\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 188,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 325,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3121,
      "text": "Kemudian mereka mendustakannya (Syu'aib), lalu mereka ditimpa azab pada hari yang gelap. Sungguh, itulah azab pada hari yang dahsyat.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 189,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 325,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3122,
      "text": "Sungguh, pada yang demikian itu benar-benar terdapat tanda (kekuasaan Allah), tetapi kebanyakan mereka tidak beriman.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 190,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 325,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3123,
      "text": "Dan sungguh, Tuhanmu, Dialah yang Mahaperkasa, Maha Penyayang.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 191,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 325,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3124,
      "text": "Dan sungguh, (Al-Qur`an) ini benar-benar diturunkan oleh Tuhan seluruh alam,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 192,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3125,
      "text": "Yang dibawa turun oleh Ar-Rūḥ Al-Amīn (Jibril),",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 193,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3126,
      "text": "ke dalam hatimu (Muhammad) agar engkau termasuk orang yang memberi peringatan,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 194,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3127,
      "text": "dengan bahasa Arab yang jelas.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 195,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3128,
      "text": "Dan sungguh, (Al-Qur`an) itu (disebut) dalam kitab-kitab orang yang terdahulu.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 196,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3129,
      "text": "Apakah tidak (cukup) menjadi bukti bagi mereka, bahwa para ulama Bani Israil mengetahuinya?",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 197,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3130,
      "text": "Dan seandainya (Al-Qur`an) itu Kami turunkan kepada sebagian dari golongan bukan Arab,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 198,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3131,
      "text": "lalu dia membacakannya kepada mereka (orang-orang kafir); niscaya mereka tidak juga akan beriman kepadanya.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 199,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3132,
      "text": "Demikianlah, Kami masukkan (sifat dusta dan ingkar) ke dalam hati orang-orang yang berdosa,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 200,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3133,
      "text": "mereka tidak akan beriman kepadanya, hingga mereka melihat azab yang pedih.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 201,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3134,
      "text": "Maka datang azab kepada mereka secara mendadak, ketika mereka tidak menyadarinya.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 202,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3135,
      "text": "l Lalu mereka berkata, \"Apakah kami diberi penangguhan waktu?\"",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 203,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3136,
      "text": "Bukankah mereka yang meminta agar azab Kami dipercepat?",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 204,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3137,
      "text": "Maka bagaimana pendapatmu jika kepada mereka Kami berikan kenikmatan hidup beberapa tahun,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 205,
      "juz": 19,
      "manzil": 5,
      "page": 375,
      "ruku": 326,
      "hizbQuarter": 150,
      "sajda": false
    },
    {
      "number": 3138,
      "text": "kemudian datang kepada mereka azab yang diancamkan kepada mereka,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
