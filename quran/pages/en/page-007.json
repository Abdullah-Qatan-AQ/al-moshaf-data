    },
    {
      "number": 47,
      "text": "O Children of Israel[23], remember My favor that I bestowed upon you, and fulfill My covenant; I will fulfill your covenant[24], and fear none but Me.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
