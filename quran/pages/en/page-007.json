      "hizbQuarter": 2,
      "sajda": false
    },
    {
      "number": 48,
      "text": "And believe in what I have sent down[25] which confirms that [Scripture] which is with you, and do not be the first to disbelieve in it, nor trade my verses for a small price, and fear Me alone.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
