  "ayahs": [
    {
      "number": 2601,
      "text": "That is because Allah is the Truth; He alone gives life to the dead, and He is the Most Capable of all things.",
      "surah": {
        "number": 22,
        "name": "سُورَةُ الحَجِّ",
        "englishName": "Al-Hajj",
        "englishNameTranslation": "The Pilgrimage",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
