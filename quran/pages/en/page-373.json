      "ruku": 323,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3084,
      "text": "those who spread corruption in the land and never do what is right.”",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 152,
