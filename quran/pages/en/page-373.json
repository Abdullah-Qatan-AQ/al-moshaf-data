      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3073,
      "text": "The people of Thamūd rejected the messengers",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 141,
      "juz": 19,
      "manzil": 5,
      "page": 373,
      "ruku": 323,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3074,
      "text": "when their brother Sālih said to them, “Will you not fear Allah?",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
