      "page": 373,
      "ruku": 323,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3089,
      "text": "But they hamstrung her, then they became regretful,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
