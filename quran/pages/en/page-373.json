      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3071,
      "text": "Thus they rejected him, so We destroyed them. Indeed, there is a sign in this, yet most of them would not believe,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
