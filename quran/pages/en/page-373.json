      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3072,
      "text": "Your Lord is indeed the All-Mighty, the Most Merciful.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
