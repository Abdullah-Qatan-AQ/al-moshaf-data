      "ruku": 323,
      "hizbQuarter": 149,
      "sajda": false
    },
    {
      "number": 3083,
      "text": "And do not obey the command of the transgressors,",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 151,
