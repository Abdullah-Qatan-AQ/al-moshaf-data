      "hizbQuarter": 103,
      "sajda": false
    },
    {
      "number": 1766,
      "text": "Hell awaits him, and he will be made to drink of oozing pus,",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
        "englishName": "Ibrahim",
        "englishNameTranslation": "Abraham",
