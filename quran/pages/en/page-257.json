      "hizbQuarter": 103,
      "sajda": false
    },
    {
      "number": 1765,
      "text": "[The messengers] sought victory, and every obstinate tyrant was doomed.",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
        "englishName": "Ibrahim",
        "englishNameTranslation": "Abraham",
