      "sajda": false
    },
    {
      "number": 1475,
      "text": "[Say O Prophet], “Worship none except Allah[3]. Indeed, I am sent to you from Him, as a warner and bearer of glad tidings.",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
