      "page": 221,
      "ruku": 183,
      "hizbQuarter": 88,
      "sajda": false
    },
    {
      "number": 1477,
      "text": "To Allah is your return, and He is Most Capable of all things.”",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
