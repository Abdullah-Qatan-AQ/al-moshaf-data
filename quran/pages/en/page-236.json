      "ruku": 194,
      "hizbQuarter": 95,
      "sajda": false
    },
    {
      "number": 1609,
      "text": "He said, “It truly saddens me that you should take him away, and I fear that a wolf may eat him when you are negligent of him.”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
