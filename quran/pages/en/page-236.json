    {
      "number": 1601,
      "text": "He said, “O my son, do not relate your vision to your brothers, lest they devise a plot against you, for Satan is a sworn enemy to mankind.",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
