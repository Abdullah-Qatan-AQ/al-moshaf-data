      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5423,
      "text": "He will forgive you some of your sins and grant you respite until an appointed term[1]. Indeed, when Allah’s appointed term comes, it cannot be delayed, if you only knew!”",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
