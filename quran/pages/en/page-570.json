      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5421,
      "text": "He said: “O my people, indeed I am a clear warner to you,",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
