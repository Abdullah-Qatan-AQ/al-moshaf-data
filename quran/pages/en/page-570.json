      "page": 570,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5422,
      "text": "that you worship Allah and fear Him, and obey me;",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
