  "ayahs": [
    {
      "number": 5200,
      "text": "All that is in the heavens and all that is in the earth glorifies Allah. To Him belongs the dominion, and to Him belongs all praise, and He is Most Capable of all things.",
      "surah": {
        "number": 64,
        "name": "سُورَةُ التَّغَابُنِ",
        "englishName": "At-Taghaabun",
        "englishNameTranslation": "Mutual Disillusion",
        "numberOfAyahs": 18,
        "revelationType": "Medinan"
      },
      "numberInSurah": 1,
      "juz": 28,
      "manzil": 7,
      "page": 556,
