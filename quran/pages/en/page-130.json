      "page": 130,
      "ruku": 104,
      "hizbQuarter": 52,
      "sajda": false
    },
    {
      "number": 814,
      "text": "There are some among them who listen to you[7], but We have placed covers on their hearts so that they do not understand it, and deafness in their ears. Even if they were to see every sign, they would still not believe in them. When they come to you arguing, the disbelievers say, “This is nothing but ancient fables.”",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 7,
      "manzil": 2,
      "page": 130,
      "ruku": 104,
      "hizbQuarter": 52,
      "sajda": false
    },
    {
      "number": 815,
      "text": "They prevent others from him, and they themselves keep away from him; they destroy none but themselves, but they do not realize.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
        "revelationType": "Meccan"
      },
      "numberInSurah": 26,
