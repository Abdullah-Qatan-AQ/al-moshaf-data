      "sajda": false
    },
    {
      "number": 809,
      "text": "Those to whom We gave the Scripture recognize [Muhammad][5] just as they recognize their own sons. Those who have ruined their own souls will not believe.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
