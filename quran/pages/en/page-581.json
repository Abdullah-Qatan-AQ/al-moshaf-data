      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5656,
      "text": "Woe on that Day to the deniers!",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5657,
      "text": "On that Day they won’t speak,",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 35,
      "juz": 29,
      "manzil": 7,
      "page": 581,
      "ruku": 516,
      "hizbQuarter": 232,
      "sajda": false
    },
    {
      "number": 5658,
      "text": "nor will they be allowed to make excuses.",
      "surah": {
        "number": 77,
        "name": "سُورَةُ المُرۡسَلَاتِ",
        "englishName": "Al-Mursalaat",
        "englishNameTranslation": "The Emissaries",
        "numberOfAyahs": 50,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 29,
