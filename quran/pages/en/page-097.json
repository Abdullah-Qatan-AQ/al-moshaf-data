      "hizbQuarter": 39,
      "sajda": false
    },
    {
      "number": 612,
      "text": "And I will surely mislead them and arouse in them false hopes, and will order them to slit the ears of livestock, and will order them to change Allah’s creation[87].” Whoever takes Satan as a protector instead of Allah has surely suffered a manifest loss.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
