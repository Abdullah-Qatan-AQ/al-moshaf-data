      "sajda": false
    },
    {
      "number": 608,
      "text": "But whoever opposes the Messenger after guidance has become clear to him, and follows other than the way of the believers, We will leave him to what he has chosen[83], and burn him in Hell[84]. What a terrible destination!",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
