      "hizbQuarter": 39,
      "sajda": false
    },
    {
      "number": 613,
      "text": "[Satan] makes promises to them and arouses in them false hopes, but Satan makes no promises to them except delusion[88].",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
