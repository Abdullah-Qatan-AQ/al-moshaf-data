      "page": 97,
      "ruku": 79,
      "hizbQuarter": 39,
      "sajda": false
    },
    {
      "number": 611,
      "text": "whom Allah cursed, who said, “I will surely take hold of a designated portion of Your slaves.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
