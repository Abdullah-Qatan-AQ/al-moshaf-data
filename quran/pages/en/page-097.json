      "hizbQuarter": 39,
      "sajda": false
    },
    {
      "number": 609,
      "text": "Allah does not forgive associating partners with Him, but forgives other than that to whom He wills; whoever associates partners with Allah has certainly gone far astray.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
        "revelationType": "Medinan"
      },
      "numberInSurah": 116,
      "juz": 5,
      "manzil": 1,
      "page": 97,
      "ruku": 79,
      "hizbQuarter": 39,
      "sajda": false
    },
    {
      "number": 610,
      "text": "They call upon none besides Him except female [idols][85]; they call upon none but a rebellious Satan[86]",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
        "revelationType": "Medinan"
      },
      "numberInSurah": 117,
