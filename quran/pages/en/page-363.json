  "ayahs": [
    {
      "number": 2888,
      "text": "Whenever they bring you an argument, We bring you the truth and the best explanation.",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
        "englishName": "Al-Furqaan",
        "englishNameTranslation": "The Criterion",
