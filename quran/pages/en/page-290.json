      "hizbQuarter": 116,
      "sajda": false
    },
    {
      "number": 2106,
      "text": "Such was Our way with the messengers We sent before you, and you will find no change in Our way.",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
