      "hizbQuarter": 116,
      "sajda": false
    },
    {
      "number": 2114,
      "text": "They ask you [O Prophet] about the spirit[76]. Say, “The soul is only known to my Lord, and you have not been given knowledge except a little.”",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
