      "page": 104,
      "ruku": 84,
      "hizbQuarter": 42,
      "sajda": false
    },
    {
      "number": 662,
      "text": "except the way of Hell, abiding therein forever. And that is easy for Allah.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
