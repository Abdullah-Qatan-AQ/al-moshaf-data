      "sajda": false
    },
    {
      "number": 657,
      "text": "There are messengers whose stories We have already mentioned to you and messengers We have not mentioned to you. And Allah spoke to Moses directly[109].",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
