      "hizbQuarter": 171,
      "sajda": false
    },
    {
      "number": 3612,
      "text": "Those who are blessed with knowledge can see that whatever has been sent down to you from your Lord is the truth and that it guides to the path of the All-Mighty, the Praiseworthy.",
      "surah": {
