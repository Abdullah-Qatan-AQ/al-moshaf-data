    {
      "number": 3607,
      "text": "All praise be to Allah, to Whom belongs all that is in the heavens and all that is on earth, and to Him is the praise in the Hereafter; He is the All-Wise, All-Aware.",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
