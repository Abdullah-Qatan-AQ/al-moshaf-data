      "sajda": false
    },
    {
      "number": 3608,
      "text": "He knows whatever goes into the earth and whatever comes out of it, and whatever descends from the heaven and whatever ascends to it, and He is the Most Merciful, All-Forgiving.",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
