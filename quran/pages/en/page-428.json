      "hizbQuarter": 171,
      "sajda": false
    },
    {
      "number": 3611,
      "text": "But those who strive against Our verses[3], seeking to discredit them, for such there will be a punishment of agonizing pain.",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
