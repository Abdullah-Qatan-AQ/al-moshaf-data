    {
      "number": 1562,
      "text": "O my people, do not let your opposition to me cause you to suffer a punishment similar to that of the people of Noah, the people of Hūd or the people of Sālih. And the people of Lot are not far away from you.",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
        "numberOfAyahs": 123,
