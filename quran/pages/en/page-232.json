      "hizbQuarter": 93,
      "sajda": false
    },
    {
      "number": 1563,
      "text": "Seek forgiveness of your Lord and turn to Him in repentance. Indeed, My Lord is Most Merciful, Most Affectionate.”",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
