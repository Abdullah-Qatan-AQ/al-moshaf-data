    {
      "number": 4348,
      "text": "Likewise, We never sent any warner to a town before you except that its affluent ones said, “We found our forefathers on a path, and we are following their footsteps.”",
      "surah": {
        "number": 43,
        "name": "سُورَةُ الزُّخۡرُفِ",
        "englishName": "Az-Zukhruf",
        "englishNameTranslation": "Ornaments of gold",
        "numberOfAyahs": 89,
        "revelationType": "Meccan"
      },
