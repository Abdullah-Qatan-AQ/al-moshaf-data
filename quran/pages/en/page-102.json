      "page": 102,
      "ruku": 82,
      "hizbQuarter": 41,
      "sajda": false
    },
    {
      "number": 644,
      "text": "It is they who are the true disbelievers, and We have prepared for the disbelievers a humiliating punishment.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
