      "hizbQuarter": 41,
      "sajda": false
    },
    {
      "number": 645,
      "text": "But those who believe in Allah and His messengers, and make no distinction between any of them, they will be given their rewards. For Allah is All-Forgiving, Most Merciful.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
