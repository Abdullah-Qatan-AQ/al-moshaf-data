      "ruku": 241,
      "hizbQuarter": 113,
      "sajda": false
    },
    {
      "number": 2043,
      "text": "[It will be said,] “Read your record; this Day you are sufficient to take account of yourself[12].”",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
