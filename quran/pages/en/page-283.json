      "hizbQuarter": 113,
      "sajda": false
    },
    {
      "number": 2040,
      "text": "Man prays for evil as he prays for good, for man is ever hasty[10].",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
