      "ruku": 276,
      "hizbQuarter": 128,
      "sajda": false
    },
    {
      "number": 2467,
      "text": "nor will you suffer from thirst or from scorching heat.”",
      "surah": {
        "number": 20,
        "name": "سُورَةُ طه",
        "englishName": "Taa-Haa",
        "englishNameTranslation": "Taa-Haa",
