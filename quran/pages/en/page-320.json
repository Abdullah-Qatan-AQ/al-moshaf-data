      "hizbQuarter": 128,
      "sajda": false
    },
    {
      "number": 2463,
      "text": "We had already given a command to Adam before, but he forgot, and We found him lacking a firm resolve[43].",
      "surah": {
        "number": 20,
        "name": "سُورَةُ طه",
        "englishName": "Taa-Haa",
