      "ruku": 275,
      "hizbQuarter": 128,
      "sajda": false
    },
    {
      "number": 2464,
      "text": "When We said to the angels, “Prostrate before Adam,” they all prostrated, except Iblīs[44], who refused.",
      "surah": {
        "number": 20,
        "name": "سُورَةُ طه",
        "englishName": "Taa-Haa",
        "englishNameTranslation": "Taa-Haa",
        "numberOfAyahs": 135,
