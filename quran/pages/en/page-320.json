      "page": 320,
      "ruku": 276,
      "hizbQuarter": 128,
      "sajda": false
    },
    {
      "number": 2470,
      "text": "Thereafter his Lord chose him, accepted his repentance, and guided him.",
      "surah": {
        "number": 20,
        "name": "سُورَةُ طه",
        "englishName": "Taa-Haa",
        "englishNameTranslation": "Taa-Haa",
        "numberOfAyahs": 135,
        "revelationType": "Meccan"
      },
      "numberInSurah": 122,
      "juz": 16,
