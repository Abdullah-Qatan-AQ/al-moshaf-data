      "hizbQuarter": 98,
      "sajda": false
    },
    {
      "number": 1679,
      "text": "He said, “No, but your souls have enticed you to commit something. But I will bear this with beautiful patience; perhaps Allah will bring them all[32] back to me, for He is the All-Knowing, the All-Wise.”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
