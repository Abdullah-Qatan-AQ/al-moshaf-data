      "hizbQuarter": 98,
      "sajda": false
    },
    {
      "number": 1677,
      "text": "Go back to your father and say, ‘O our father, your son has committed theft, and we did not tell you except what we saw, and we had no knowledge of the unseen[31].",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
