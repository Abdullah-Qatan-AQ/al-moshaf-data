      "hizbQuarter": 98,
      "sajda": false
    },
    {
      "number": 1678,
      "text": "Ask [the people of] the town where we were and the caravan we came with, and we are surely telling the truth.”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
