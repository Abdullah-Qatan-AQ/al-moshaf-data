      "sajda": false
    },
    {
      "number": 1288,
      "text": "Say, “Whether you spend willingly or unwillingly, it will never be accepted from you, for you have been a wicked people.”",
      "surah": {
        "number": 9,
        "name": "سُورَةُ التَّوۡبَةِ",
