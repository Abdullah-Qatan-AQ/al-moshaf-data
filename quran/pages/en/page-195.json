      "sajda": false
    },
    {
      "number": 1285,
      "text": "If something good happens to you, it grieves them, but if a disaster befalls you, they say, “We have taken our precautions beforehand[48],” and they turn away rejoicing.",
      "surah": {
        "number": 9,
        "name": "سُورَةُ التَّوۡبَةِ",
