      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6095,
      "text": "For indeed, with hardship comes ease[4],",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
