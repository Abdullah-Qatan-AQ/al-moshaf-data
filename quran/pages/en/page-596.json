      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6096,
      "text": "indeed, with hardship comes ease.",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
