      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6092,
      "text": "and relieved you of your burden[2]",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
