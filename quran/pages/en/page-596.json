      "page": 596,
      "ruku": 535,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6081,
      "text": "and by the night when it covers with darkness[1],",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
        "englishNameTranslation": "The Morning Hours",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
