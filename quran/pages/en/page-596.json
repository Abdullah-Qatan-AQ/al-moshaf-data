      "text": "Have We not reassured your heart for you [O Prophet][1],",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
