      "page": 596,
      "ruku": 536,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6093,
      "text": "that weighed down your back,",
      "surah": {
        "number": 94,
        "name": "سُورَةُ الشَّرۡحِ",
        "englishName": "Ash-Sharh",
        "englishNameTranslation": "The Consolation",
        "numberOfAyahs": 8,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
