      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6074,
      "text": "who denied and turned away.",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 16,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6075,
      "text": "But the most righteous will be saved from it,",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 17,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6076,
      "text": "who spends his wealth to purify himself,",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6077,
      "text": "not in return for someone’s favors[2],",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6078,
      "text": "but to seek the pleasure of his Lord, the Most High.",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6079,
      "text": "He will surely be well pleased.",
      "surah": {
        "number": 92,
        "name": "سُورَةُ اللَّيۡلِ",
        "englishName": "Al-Lail",
        "englishNameTranslation": "The Night",
        "numberOfAyahs": 21,
        "revelationType": "Meccan"
      },
      "numberInSurah": 21,
      "juz": 30,
      "manzil": 7,
      "page": 596,
      "ruku": 534,
      "hizbQuarter": 238,
      "sajda": false
    },
    {
      "number": 6080,
      "text": "By the morning sunlight,",
      "surah": {
        "number": 93,
        "name": "سُورَةُ الضُّحَىٰ",
        "englishName": "Ad-Dhuhaa",
