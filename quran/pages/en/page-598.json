      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6127,
      "text": "How do you know what the Night of Decree is?",
      "surah": {
        "number": 97,
        "name": "سُورَةُ القَدۡرِ",
        "englishName": "Al-Qadr",
        "englishNameTranslation": "The Power, Fate",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
