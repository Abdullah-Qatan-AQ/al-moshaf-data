      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6136,
      "text": "Those who disbelieve from the People of the Book and the polytheists will be in the fire of Hell, abiding therein forever. It is they who are the worst of creatures.",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
        "numberOfAyahs": 8,
        "revelationType": "Medinan"
      },
      "numberInSurah": 6,
