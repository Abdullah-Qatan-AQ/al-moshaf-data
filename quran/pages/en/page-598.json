      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6135,
      "text": "although they were commanded only to worship Allah with sincere devotion to Him, being inclined to the true faith, and to establish prayer and give zakah; that is the true religion.",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
