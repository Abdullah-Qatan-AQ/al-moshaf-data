      "ruku": 539,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6129,
      "text": "On that night the angels and the Spirit [i.e., Gabriel] descend by their Lord’s permission with all decrees[2].",
      "surah": {
        "number": 97,
        "name": "سُورَةُ القَدۡرِ",
        "englishName": "Al-Qadr",
        "englishNameTranslation": "The Power, Fate",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
      "manzil": 7,
      "page": 598,
      "ruku": 539,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6130,
      "text": "It is all peace[3] until the break of dawn.",
      "surah": {
        "number": 97,
        "name": "سُورَةُ القَدۡرِ",
        "englishName": "Al-Qadr",
        "englishNameTranslation": "The Power, Fate",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 30,
