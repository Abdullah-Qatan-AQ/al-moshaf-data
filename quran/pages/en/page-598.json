      "page": 598,
      "ruku": 539,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6128,
      "text": "The Night of Decree is better than a thousand months.",
      "surah": {
        "number": 97,
        "name": "سُورَةُ القَدۡرِ",
        "englishName": "Al-Qadr",
        "englishNameTranslation": "The Power, Fate",
        "numberOfAyahs": 5,
