  "ayahs": [
    {
      "number": 6126,
      "text": "Indeed, We sent this [Qur’an] down on the Night of Decree[1].",
      "surah": {
        "number": 97,
        "name": "سُورَةُ القَدۡرِ",
        "englishName": "Al-Qadr",
