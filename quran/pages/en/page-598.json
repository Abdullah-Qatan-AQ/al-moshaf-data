      "sajda": false
    },
    {
      "number": 6134,
      "text": "Yet those who were given the Scripture did not disagree[3] except after the clear proof came to them,",
      "surah": {
        "number": 98,
        "name": "سُورَةُ البَيِّنَةِ",
        "englishName": "Al-Bayyina",
        "englishNameTranslation": "The Evidence",
        "numberOfAyahs": 8,
