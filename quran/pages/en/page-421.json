    {
      "number": 3556,
      "text": "Among the believers there are men who have been true to their pledge to Allah. Some of them have fulfilled their pledge[22], and others are still waiting[23], and they have not changed in the least[24].",
      "surah": {
        "number": 33,
        "name": "سُورَةُ الأَحۡزَابِ",
        "englishName": "Al-Ahzaab",
        "englishNameTranslation": "The Clans",
