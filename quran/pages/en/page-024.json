      "hizbQuarter": 10,
      "sajda": false
    },
    {
      "number": 166,
      "text": "Those who conceal the clear proofs and guidance that We have sent down – after We explained it clearly to people in the Scripture – it is they who are cursed by Allah and will be cursed by those who curse[70].",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
        "numberOfAyahs": 286,
        "revelationType": "Medinan"
      },
      "numberInSurah": 159,
      "juz": 2,
      "manzil": 1,
      "page": 24,
      "ruku": 20,
      "hizbQuarter": 10,
      "sajda": false
    },
    {
      "number": 167,
      "text": "Except for those who repent, mend their deeds, and clarify the truth; I will surely accept their repentance, for I am the Accepter of Repentance, the Most Merciful.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
        "numberOfAyahs": 286,
        "revelationType": "Medinan"
      },
      "numberInSurah": 160,
      "juz": 2,
      "manzil": 1,
      "page": 24,
      "ruku": 20,
      "hizbQuarter": 10,
      "sajda": false
    },
    {
      "number": 168,
      "text": "Those who disbelieve and die as disbelievers are cursed by Allah and the angels, and by all people.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
