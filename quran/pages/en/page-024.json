      "sajda": false
    },
    {
      "number": 165,
      "text": "Indeed, Safa and Marwah [mounts] are among the symbols of Allah. So whoever performs the pilgrimage or ‘Umra, there is no blame upon him to go between them[69]. And whoever does good voluntarily, then Allah is All-Appreciative, All-Knowing.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
        "numberOfAyahs": 286,
