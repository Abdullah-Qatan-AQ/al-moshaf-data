      "hizbQuarter": 10,
      "sajda": false
    },
    {
      "number": 169,
      "text": "They will abide in [the curse] forever. Their punishment will not be lightened, nor will they be granted any respite.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
