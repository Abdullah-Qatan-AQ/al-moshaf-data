      "hizbQuarter": 173,
      "sajda": false
    },
    {
      "number": 3640,
      "text": "We never sent a warner to a town except that its affluent ones said, “We disbelieve in what you have been sent with.”",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
