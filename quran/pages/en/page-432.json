    {
      "number": 3638,
      "text": "Those who were arrogant will say to those who were oppressed, “Was it we who prevented you from guidance after it came to you? Rather, you yourselves were wicked.”",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
