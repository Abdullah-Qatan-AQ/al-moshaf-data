      "hizbQuarter": 173,
      "sajda": false
    },
    {
      "number": 3642,
      "text": "Say, “My Lord extends provision to whom He wills or restricts it, but most people do not know”.",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
        "numberOfAyahs": 54,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
