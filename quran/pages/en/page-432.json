      "hizbQuarter": 173,
      "sajda": false
    },
    {
      "number": 3641,
      "text": "They[20] said, “We have greater wealth and more children, and we will not be punished”.",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
