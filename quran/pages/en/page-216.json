      "hizbQuarter": 86,
      "sajda": false
    },
    {
      "number": 1428,
      "text": "For them are glad tidings in the life of this world[51] and in the Hereafter; there is no change in Allah’s words. That is the supreme triumph.",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 64,
