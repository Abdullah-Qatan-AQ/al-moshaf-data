    {
      "number": 5268,
      "text": "Then when they see it[7] approaching closer, the faces of the disbelievers will be distressed, and it will be said, “This is what you were asking for[8].”",
      "surah": {
        "number": 67,
        "name": "سُورَةُ المُلۡكِ",
        "englishName": "Al-Mulk",
        "englishNameTranslation": "The Sovereignty",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
