      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false
    },
    {
      "number": 5280,
      "text": "They wish that you would compromise so they would too compromise.",
      "surah": {
        "number": 68,
        "name": "سُورَةُ القَلَمِ",
        "englishName": "Al-Qalam",
        "englishNameTranslation": "The Pen",
