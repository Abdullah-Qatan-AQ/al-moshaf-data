      "hizbQuarter": 225,
      "sajda": false
    },
    {
      "number": 5269,
      "text": "Say, “What do you think[9], if Allah causes me and those who are with me to die or shows us mercy, who will save the disbelievers from a painful punishment?”",
      "surah": {
        "number": 67,
        "name": "سُورَةُ المُلۡكِ",
        "englishName": "Al-Mulk",
        "englishNameTranslation": "The Sovereignty",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 497,
      "hizbQuarter": 225,
      "sajda": false
    },
    {
      "number": 5270,
      "text": "Say, “He is the Most Compassionate; we believe in Him and put our trust in Him. You will come to know who is clearly misguided.”",
      "surah": {
        "number": 67,
        "name": "سُورَةُ المُلۡكِ",
        "englishName": "Al-Mulk",
        "englishNameTranslation": "The Sovereignty",
        "numberOfAyahs": 30,
        "revelationType": "Meccan"
      },
      "numberInSurah": 29,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 497,
      "hizbQuarter": 225,
      "sajda": false
    },
    {
      "number": 5271,
      "text": "Say, “What do you think, if your water were to sink deep into the earth, who can bring you flowing water?”",
      "surah": {
        "number": 67,
        "name": "سُورَةُ المُلۡكِ",
        "englishName": "Al-Mulk",
        "englishNameTranslation": "The Sovereignty",
        "numberOfAyahs": 30,
