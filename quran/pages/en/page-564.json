      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false
    },
    {
      "number": 5276,
      "text": "Soon you will see and they will see,",
      "surah": {
        "number": 68,
        "name": "سُورَةُ القَلَمِ",
        "englishName": "Al-Qalam",
        "englishNameTranslation": "The Pen",
