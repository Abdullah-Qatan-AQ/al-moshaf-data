      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false
    },
    {
      "number": 5278,
      "text": "Indeed, your Lord alone knows best who has strayed from His way and those who are rightly guided.",
      "surah": {
        "number": 68,
        "name": "سُورَةُ القَلَمِ",
        "englishName": "Al-Qalam",
        "englishNameTranslation": "The Pen",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 29,
      "manzil": 7,
      "page": 564,
      "ruku": 498,
      "hizbQuarter": 226,
      "sajda": false
    },
    {
      "number": 5279,
      "text": "So do not obey the deniers.",
      "surah": {
        "number": 68,
        "name": "سُورَةُ القَلَمِ",
        "englishName": "Al-Qalam",
        "englishNameTranslation": "The Pen",
        "numberOfAyahs": 52,
