      "hizbQuarter": 71,
      "sajda": false
    },
    {
      "number": 1166,
      "text": "They disputed with you concerning the truth[3] after it had become clear to them as if they were being driven towards death while they were looking on.",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
