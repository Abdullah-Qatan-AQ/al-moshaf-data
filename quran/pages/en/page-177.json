      "hizbQuarter": 71,
      "sajda": false
    },
    {
      "number": 1165,
      "text": "Just as your Lord brought you [O Prophet] out of your home for a just cause[2], even though a group of believers were averse to it.",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
