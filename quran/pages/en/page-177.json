      "sajda": false
    },
    {
      "number": 1164,
      "text": "Such are the true believers; they will have high ranks with their Lord, and forgiveness and honorable provision.",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
        "englishName": "Al-Anfaal",
