    {
      "number": 2425,
      "text": "We inspired Moses, “Travel by night with My slaves, and strike for them a dry path across the sea. Have no fear of being overtaken, nor be afraid [of drowning].”",
      "surah": {
        "number": 20,
        "name": "سُورَةُ طه",
