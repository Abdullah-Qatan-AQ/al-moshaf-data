      "page": 317,
      "ruku": 273,
      "hizbQuarter": 126,
      "sajda": false
    },
    {
      "number": 2431,
      "text": "[Allah asked], “What made you hasten from your people, O Moses?”[24]",
      "surah": {
        "number": 20,
        "name": "سُورَةُ طه",
        "englishName": "Taa-Haa",
        "englishNameTranslation": "Taa-Haa",
        "numberOfAyahs": 135,
        "revelationType": "Meccan"
      },
      "numberInSurah": 83,
      "juz": 16,
      "manzil": 4,
      "page": 317,
      "ruku": 273,
      "hizbQuarter": 127,
      "sajda": false
    },
    {
      "number": 2432,
      "text": "He said, “They are following my footsteps; I hastened to You, my Lord, to please You.”",
      "surah": {
        "number": 20,
        "name": "سُورَةُ طه",
        "englishName": "Taa-Haa",
        "englishNameTranslation": "Taa-Haa",
        "numberOfAyahs": 135,
        "revelationType": "Meccan"
      },
      "numberInSurah": 84,
