      "hizbQuarter": 126,
      "sajda": false
    },
    {
      "number": 2427,
      "text": "Thus Pharaoh led his people astray and did not guide them.",
      "surah": {
        "number": 20,
        "name": "سُورَةُ طه",
        "englishName": "Taa-Haa",
        "englishNameTranslation": "Taa-Haa",
