      "hizbQuarter": 126,
      "sajda": false
    },
    {
      "number": 2426,
      "text": "Then Pharaoh pursued them with his soldiers, but they were completely overwhelmed by the sea[21].",
      "surah": {
        "number": 20,
        "name": "سُورَةُ طه",
        "englishName": "Taa-Haa",
        "englishNameTranslation": "Taa-Haa",
