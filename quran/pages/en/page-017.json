      "hizbQuarter": 7,
      "sajda": false
    },
    {
      "number": 117,
      "text": "And establish prayer and give zakah. Whatever good you send forth for yourselves, you will find it with Allah, for Allah is All-Seeing of what you do.",
      "surah": {
        "number": 2,
