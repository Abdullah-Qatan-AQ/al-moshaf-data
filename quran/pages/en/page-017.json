      "hizbQuarter": 7,
      "sajda": false
    },
    {
      "number": 116,
      "text": "Many of the people of the Book wish they could turn you back to disbelief after you have believed, out of the envy in their hearts, after the truth has become evident to them. But pardon and overlook until Allah passes His decree[45], for Allah is Most Capable of all things.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
