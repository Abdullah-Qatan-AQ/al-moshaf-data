      "ruku": 446,
      "hizbQuarter": 204,
      "sajda": false
    },
    {
      "number": 4591,
      "text": "Indeed, We have sent you [O prophet] as a witness, a bearer of glad tidings, and a warner,",
      "surah": {
        "number": 48,
        "name": "سُورَةُ الفَتۡحِ",
        "englishName": "Al-Fath",
        "englishNameTranslation": "The Victory",
