      "page": 260,
      "ruku": 216,
      "hizbQuarter": 104,
      "sajda": false
    },
    {
      "number": 1790,
      "text": "My Lord, make me steadfast in prayer and those of my offspring. Our Lord, accept my supplication.",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
        "englishName": "Ibrahim",
        "englishNameTranslation": "Abraham",
        "numberOfAyahs": 52,
