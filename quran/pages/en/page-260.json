      "page": 260,
      "ruku": 216,
      "hizbQuarter": 104,
      "sajda": false
    },
    {
      "number": 1789,
      "text": "All praise be to Allah Who has granted me in old age Ishmael and Isaac[28]. Indeed, my Lord is the All-Hearing of prayers.",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
        "englishName": "Ibrahim",
        "englishNameTranslation": "Abraham",
