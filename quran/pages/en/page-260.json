      "sajda": false
    },
    {
      "number": 1786,
      "text": "My Lord, they[26] have led many people astray. So whoever follows me, he belongs to me; and whoever disobeys me, then You are All-Forgiving, Most Merciful.",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
