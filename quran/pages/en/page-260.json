      "hizbQuarter": 104,
      "sajda": false
    },
    {
      "number": 1788,
      "text": "Our Lord, You know what we conceal and what we reveal. Nothing is hidden from Allah on earth or in heaven.",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
        "englishName": "Ibrahim",
        "englishNameTranslation": "Abraham",
        "numberOfAyahs": 52,
