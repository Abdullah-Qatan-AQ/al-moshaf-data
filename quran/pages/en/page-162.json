      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1048,
      "text": "We have not sent any prophet to a town, but We seized its people with poverty and adversity, so that they may humble themselves.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
