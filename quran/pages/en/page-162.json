      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1047,
      "text": "So he turned away from them and said, “O my people, I did convey to you the messages of my Lord, and gave you sincere advice. Why should I grieve for a disbelieving people?”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
