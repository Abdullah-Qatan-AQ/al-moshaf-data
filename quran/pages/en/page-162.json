      "page": 162,
      "ruku": 132,
      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1045,
      "text": "Then they were seized by the earthquake and they fell lifeless in their homes.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
