      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1044,
      "text": "The disbelieving chiefs of his people said, “If you follow Shu‘ayb, you will certainly be losers[35].”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
