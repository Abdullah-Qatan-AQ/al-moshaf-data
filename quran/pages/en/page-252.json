      "hizbQuarter": 101,
      "sajda": false
    },
    {
      "number": 1732,
      "text": "As for those who break the covenant of Allah after it has been ratified, and sever the ties that Allah has commanded to be maintained, and spread corruption in the land – it is they who are cursed, and for them there will be the worst abode[24].",
      "surah": {
        "number": 13,
        "name": "سُورَةُ الرَّعۡدِ",
        "englishName": "Ar-Ra'd",
        "englishNameTranslation": "The Thunder",
