      "hizbQuarter": 101,
      "sajda": false
    },
    {
      "number": 1731,
      "text": "“Peace be on you, for what you have patiently endured. How excellent is the final abode!”",
      "surah": {
        "number": 13,
        "name": "سُورَةُ الرَّعۡدِ",
        "englishName": "Ar-Ra'd",
        "englishNameTranslation": "The Thunder",
