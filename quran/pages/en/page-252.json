      "hizbQuarter": 101,
      "sajda": false
    },
    {
      "number": 1733,
      "text": "Allah extends provision to whom He wills or restricts it. They rejoice in the life of this world, although the life of this world, compared to the Hereafter, is nothing but a fleeting pleasure.",
      "surah": {
