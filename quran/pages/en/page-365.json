      "ruku": 315,
      "hizbQuarter": 146,
      "sajda": false
    },
    {
      "number": 2919,
      "text": "and those who spend the night prostrating and standing before their Lord;",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
        "englishName": "Al-Furqaan",
        "englishNameTranslation": "The Criterion",
