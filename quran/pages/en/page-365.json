      "sajda": false
    },
    {
      "number": 2912,
      "text": "Say, “I do not ask you for any reward for it, except that anyone who wishes to take a path to his Lord[32].”",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
        "englishName": "Al-Furqaan",
        "englishNameTranslation": "The Criterion",
