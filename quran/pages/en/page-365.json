      "sajda": false
    },
    {
      "number": 2920,
      "text": "and those who say, “Our Lord, turn the punishment of Hell away from us, for its punishment is unrelenting[38].”",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
        "englishName": "Al-Furqaan",
        "englishNameTranslation": "The Criterion",
