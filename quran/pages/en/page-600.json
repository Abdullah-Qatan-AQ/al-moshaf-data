      "page": 600,
      "ruku": 544,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6170,
      "text": "until you come to your graves.",
      "surah": {
        "number": 102,
        "name": "سُورَةُ التَّكَاثُرِ",
        "englishName": "At-Takaathur",
        "englishNameTranslation": "Competition",
        "numberOfAyahs": 8,
