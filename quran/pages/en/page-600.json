      "page": 600,
      "ruku": 543,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6168,
      "text": "It is a Blazing Fire.",
      "surah": {
        "number": 101,
        "name": "سُورَةُ القَارِعَةِ",
        "englishName": "Al-Qaari'a",
        "englishNameTranslation": "The Calamity",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 30,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6169,
      "text": "Competition for worldly gains distracts you [from Allah],",
      "surah": {
        "number": 102,
        "name": "سُورَةُ التَّكَاثُرِ",
        "englishName": "At-Takaathur",
