      "page": 600,
      "ruku": 543,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6162,
      "text": "and the mountains will be like carded wool[2].",
      "surah": {
        "number": 101,
        "name": "سُورَةُ القَارِعَةِ",
        "englishName": "Al-Qaari'a",
        "englishNameTranslation": "The Calamity",
