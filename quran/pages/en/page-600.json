      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6167,
      "text": "And how do you know what it is?",
      "surah": {
        "number": 101,
        "name": "سُورَةُ القَارِعَةِ",
        "englishName": "Al-Qaari'a",
        "englishNameTranslation": "The Calamity",
        "numberOfAyahs": 11,
