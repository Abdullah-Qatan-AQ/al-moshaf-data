      "juz": 30,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6160,
      "text": "How do you know what the Striking Calamity is?",
      "surah": {
        "number": 101,
        "name": "سُورَةُ القَارِعَةِ",
        "englishName": "Al-Qaari'a",
        "englishNameTranslation": "The Calamity",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 600,
      "ruku": 543,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6161,
      "text": "On that Day people will be like scattered moths[1],",
      "surah": {
        "number": 101,
        "name": "سُورَةُ القَارِعَةِ",
        "englishName": "Al-Qaari'a",
        "englishNameTranslation": "The Calamity",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
      "juz": 30,
