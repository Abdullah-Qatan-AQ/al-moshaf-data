      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 600,
      "ruku": 544,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6171,
      "text": "No indeed! You will come to know.",
      "surah": {
        "number": 102,
        "name": "سُورَةُ التَّكَاثُرِ",
        "englishName": "At-Takaathur",
        "englishNameTranslation": "Competition",
        "numberOfAyahs": 8,
