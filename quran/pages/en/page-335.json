      "hizbQuarter": 134,
      "sajda": false
    },
    {
      "number": 2623,
      "text": "so that they may attain benefits[17], and pronounce Allah’s name during the appointed days over the sacrificial animals[18] that He has provided for them; then eat from it and feed the desperately poor.",
