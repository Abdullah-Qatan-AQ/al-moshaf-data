      "hizbQuarter": 72,
      "sajda": false
    },
    {
      "number": 1184,
      "text": "O you who believe, respond to Allah and the Messenger when He calls you to what gives you life[12], and know that Allah comes between a person and his heart[13], and it is to Him that you will all be gathered.",
      "surah": {
