    {
      "number": 2175,
      "text": "He entered his garden, having wronged himself[22], and said, “I do not think that this will ever perish,",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
