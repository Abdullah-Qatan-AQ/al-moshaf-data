      "hizbQuarter": 119,
      "sajda": false
    },
    {
      "number": 2176,
      "text": "nor do I think that the Hour will ever come. Even if I am brought back to my Lord, I will surely find something better than this[23].”",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
