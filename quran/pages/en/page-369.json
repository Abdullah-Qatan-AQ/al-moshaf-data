    {
      "number": 2973,
      "text": "When the magicians came, they said to Pharaoh, “Will there be a reward for us if we are victorious?”",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
