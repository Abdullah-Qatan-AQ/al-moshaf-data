      "sajda": false
    },
    {
      "number": 3968,
      "text": "Glory be to your Lord, the Lord of Might, far above what they ascribe [to Him],",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 180,
      "juz": 23,
      "manzil": 6,
      "page": 452,
      "ruku": 390,
      "hizbQuarter": 181,
      "sajda": false
    },
    {
      "number": 3969,
      "text": "and peace be upon the messengers,",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
        "numberOfAyahs": 182,
        "revelationType": "Meccan"
      },
      "numberInSurah": 181,
