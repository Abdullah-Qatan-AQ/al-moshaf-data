      }
    },
    {
      "number": 3186,
      "text": "Solomon said, “We will see whether you have told the truth or you are one of the liars.",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 27,
      "juz": 19,
      "manzil": 5,
      "page": 379,
      "ruku": 328,
      "hizbQuarter": 152,
      "sajda": false
    },
    {
      "number": 3187,
      "text": "Take this letter of mine and deliver it to them, then withdraw and see how they respond.”",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
      "juz": 19,
