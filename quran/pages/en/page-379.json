      "ruku": 328,
      "hizbQuarter": 151,
      "sajda": false
    },
    {
      "number": 3185,
      "text": "Allah; none has the right to be worshiped except Him, the Lord of the Mighty Throne.”",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
