  "ayahs": [
    {
      "number": 4359,
      "text": "and their houses having [silver] doors and couches on which they recline,",
      "surah": {
        "number": 43,
        "name": "سُورَةُ الزُّخۡرُفِ",
        "englishName": "Az-Zukhruf",
        "englishNameTranslation": "Ornaments of gold",
        "numberOfAyahs": 89,
        "revelationType": "Meccan"
      },
