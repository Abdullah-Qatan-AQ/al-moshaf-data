      "sajda": false
    },
    {
      "number": 5210,
      "text": "No calamity befalls except with Allah’s permission. Whoever believes in Allah, He will guide his heart. And Allah is All-Knowing of everything.",
      "surah": {
        "number": 64,
        "name": "سُورَةُ التَّغَابُنِ",
        "englishName": "At-Taghaabun",
        "englishNameTranslation": "Mutual Disillusion",
        "numberOfAyahs": 18,
