  "ayahs": [
    {
      "number": 5209,
      "text": "As for those who disbelieve and reject Our verses, they will be the people of the Fire, abiding therein forever. What a terrible destination!",
      "surah": {
        "number": 64,
        "name": "سُورَةُ التَّغَابُنِ",
        "englishName": "At-Taghaabun",
        "englishNameTranslation": "Mutual Disillusion",
