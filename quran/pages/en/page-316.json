    {
      "number": 2413,
      "text": "They said, “O Moses, either you throw or shall we be the first to throw!”",
      "surah": {
        "number": 20,
        "name": "سُورَةُ طه",
        "englishName": "Taa-Haa",
        "englishNameTranslation": "Taa-Haa",
