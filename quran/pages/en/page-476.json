      "sajda": false
    },
    {
      "number": 4214,
      "text": "And He shows you His signs; so which of the signs of Allah will you deny?",
      "surah": {
        "number": 40,
        "name": "سُورَةُ غَافِرٍ",
        "englishName": "Ghafir",
        "englishNameTranslation": "The Forgiver",
