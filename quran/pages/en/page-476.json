      "page": 476,
      "ruku": 412,
      "hizbQuarter": 190,
      "sajda": false
    },
    {
      "number": 4217,
      "text": "But when they saw Our punishment, they said, “We believe in Allah alone, and we reject what we used to associate with Him.”",
      "surah": {
        "number": 40,
        "name": "سُورَةُ غَافِرٍ",
