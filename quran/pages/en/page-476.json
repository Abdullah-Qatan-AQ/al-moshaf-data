      "page": 476,
      "ruku": 412,
      "hizbQuarter": 190,
      "sajda": false
    },
    {
      "number": 4216,
      "text": "When their messengers came to them with clear proofs, they exulted in whatever knowledge they had[20], and they were overwhelmed by what they used to ridicule.",
      "surah": {
        "number": 40,
        "name": "سُورَةُ غَافِرٍ",
        "englishName": "Ghafir",
        "englishNameTranslation": "The Forgiver",
