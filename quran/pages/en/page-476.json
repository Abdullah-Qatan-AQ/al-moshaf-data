      "hizbQuarter": 190,
      "sajda": false
    },
    {
      "number": 4215,
      "text": "Have they not traveled through the land to see what was the end of those who came before them? They were more in number and far superior in strength, and more impressive in marks that they left behind in the land, but all what they had earned was of no avail to them.",
      "surah": {
        "number": 40,
        "name": "سُورَةُ غَافِرٍ",
        "englishName": "Ghafir",
        "englishNameTranslation": "The Forgiver",
        "numberOfAyahs": 85,
