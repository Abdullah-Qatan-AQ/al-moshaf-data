      "text": "except the messenger whom He chooses, then He appoints angel-guards before him and behind him[12]",
      "surah": {
        "number": 72,
        "name": "سُورَةُ الجِنِّ",
        "englishName": "Al-Jinn",
        "englishNameTranslation": "The Jinn",
