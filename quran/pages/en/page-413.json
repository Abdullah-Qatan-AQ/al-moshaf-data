      },
      "numberInSurah": 23,
      "juz": 21,
      "manzil": 5,
      "page": 413,
      "ruku": 357,
      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3493,
      "text": "We let them enjoy for a little while, then We will drive them to a harsh punishment.",
      "surah": {
        "number": 31,
        "name": "سُورَةُ لُقۡمَانَ",
        "englishName": "Luqman",
        "englishNameTranslation": "Luqman",
