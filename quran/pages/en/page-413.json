      "hizbQuarter": 165,
      "sajda": false
    },
    {
      "number": 3494,
      "text": "If you ask them who created the heavens and earth, they will surely say, “Allah.” Say, “All praise is for Allah.” Yet most of them do not understand.",
      "surah": {
        "number": 31,
        "name": "سُورَةُ لُقۡمَانَ",
        "englishName": "Luqman",
