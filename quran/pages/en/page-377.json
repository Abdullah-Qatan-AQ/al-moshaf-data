      "ruku": 327,
      "hizbQuarter": 151,
      "sajda": false
    },
    {
      "number": 3170,
      "text": "except he who does wrong, then substitutes good for evil, then I am indeed All-Forgiving, Most Merciful.",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
