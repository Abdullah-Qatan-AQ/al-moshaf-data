    {
      "number": 3162,
      "text": "those who establish prayer and give zakah, and who firmly believe in the Hereafter.",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
