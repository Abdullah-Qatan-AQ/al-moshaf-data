      "hizbQuarter": 151,
      "sajda": false
    },
    {
      "number": 3171,
      "text": "Put your hand into your garment, it will come out shining white without blemish, as one of nine signs to Pharaoh and his people[4], for they are indeed a rebellious people.”",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
