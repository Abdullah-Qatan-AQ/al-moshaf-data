      "hizbQuarter": 117,
      "sajda": false
    },
    {
      "number": 2140,
      "text": "And say, “All praise is for Allah Who has not taken a son, nor does He have any partner in His dominion, nor does He need any protector out of weakness. And proclaim His greatness immensely.”",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
