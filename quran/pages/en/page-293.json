    },
    {
      "number": 2135,
      "text": "This is a Qur’an that We have revealed over stages so that you may recite it to people at a slower pace, and We have sent it down in a successive manner[85].",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
