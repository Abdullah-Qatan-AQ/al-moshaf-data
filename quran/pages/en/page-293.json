      "page": 293,
      "ruku": 251,
      "hizbQuarter": 117,
      "sajda": false
    },
    {
      "number": 2137,
      "text": "and they say, “Glory be to our Lord. The promise of our Lord is bound to be fulfilled.”",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
