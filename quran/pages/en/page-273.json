      "hizbQuarter": 109,
      "sajda": false
    },
    {
      "number": 1963,
      "text": "They attribute to Allah[36] what they dislike for themselves, and their tongues make false claim that they will have the best [reward][37]. Without a doubt for them there will be the Fire, and they will be neglected.",
      "surah": {
