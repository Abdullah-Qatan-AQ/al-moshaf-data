      "hizbQuarter": 109,
      "sajda": false
    },
    {
      "number": 1959,
      "text": "When one of them is given the good news of a female baby, his face darkens while suppressing his anguish.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
