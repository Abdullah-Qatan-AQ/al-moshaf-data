      "hizbQuarter": 28,
      "sajda": false
    },
    {
      "number": 463,
      "text": "rejoicing in what Allah has given them of His bounty, and delighted for those who have yet to join them, of those whom they left behind, that they will have no fear, nor will they grieve.",
