      "hizbQuarter": 28,
      "sajda": false
    },
    {
      "number": 461,
      "text": "Those who stayed behind said about their brothers, “If they had obeyed us, they would not have been killed [at ’Uhud].” Say, “Then avert death from yourselves, if you are truthful.”",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
