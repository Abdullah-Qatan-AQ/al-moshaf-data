    {
      "number": 459,
      "text": "What you suffered on the day [of ’Uhud] when the two armies met was by Allah’s permission, so that He may distinguish the [true] believers,",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
        "numberOfAyahs": 200,
        "revelationType": "Medinan"
      },
