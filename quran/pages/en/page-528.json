      "hizbQuarter": 211,
      "sajda": false
    },
    {
      "number": 4831,
      "text": "and it is upon Him to bring about the second creation.",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
