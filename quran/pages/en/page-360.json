      "hizbQuarter": 144,
      "sajda": false
    },
    {
      "number": 2864,
      "text": "See how they call you names[3]. Thus they have gone astray and cannot find a way.",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
        "englishName": "Al-Furqaan",
        "englishNameTranslation": "The Criterion",
