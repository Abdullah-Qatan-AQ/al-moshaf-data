      "hizbQuarter": 144,
      "sajda": false
    },
    {
      "number": 2861,
      "text": "Say, “It has been sent down by the One Who knows the secrets of the heavens and earth. He is All-Forgiving, Most Merciful.”",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
