      "hizbQuarter": 144,
      "sajda": false
    },
    {
      "number": 2860,
      "text": "And they say, “Ancient fables which he has written down; they are dictated to him morning and evening.”",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
        "englishName": "Al-Furqaan",
        "englishNameTranslation": "The Criterion",
