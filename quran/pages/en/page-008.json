      "hizbQuarter": 3,
      "sajda": false
    },
    {
      "number": 60,
      "text": "And [remember] when We gave Moses the Scripture and the criterion[30], so that you may be guided.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
