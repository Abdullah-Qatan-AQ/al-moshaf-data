      "page": 8,
      "ruku": 7,
      "hizbQuarter": 3,
      "sajda": false
    },
    {
      "number": 63,
      "text": "Then We raised you back to life after your death, so that you may be grateful.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
