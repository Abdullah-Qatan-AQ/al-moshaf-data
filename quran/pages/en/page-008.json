      "hizbQuarter": 3,
      "sajda": false
    },
    {
      "number": 62,
      "text": "And [remember] when you said, “O Moses, we will never believe you until we see Allah openly,” so a thunderbolt struck you while you were looking on.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
