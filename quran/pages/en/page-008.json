      "page": 8,
      "ruku": 7,
      "hizbQuarter": 3,
      "sajda": false
    },
    {
      "number": 59,
      "text": "Yet We pardoned you after that, so that you may be grateful.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
