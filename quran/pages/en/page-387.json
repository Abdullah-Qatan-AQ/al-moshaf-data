      "hizbQuarter": 155,
      "sajda": false
    },
    {
      "number": 3268,
      "text": "He said, “My Lord, I have wronged myself, so forgive me,” Then He forgave him, for He is indeed the All-Forgiving, the Most Merciful.",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
