      "hizbQuarter": 155,
      "sajda": false
    },
    {
      "number": 3269,
      "text": "He said, “My Lord, because of the blessings that You have bestowed upon me, I will never be a supporter of the wicked.”",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
        "englishName": "Al-Qasas",
        "englishNameTranslation": "The Stories",
