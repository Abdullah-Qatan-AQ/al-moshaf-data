      "hizbQuarter": 155,
      "sajda": false
    },
    {
      "number": 3270,
      "text": "Then he became fearful and vigilant in the city; suddenly the one who sought his help the day before cried out to him again for help. Moses said to him, “You are clearly a troublemaker.”",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
        "englishName": "Al-Qasas",
        "englishNameTranslation": "The Stories",
