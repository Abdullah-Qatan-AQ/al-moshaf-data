    {
      "number": 3451,
      "text": "Say, “Travel through the land and see how was the end of those who came before – most of them associated partners with Allah.”",
      "surah": {
        "number": 30,
        "name": "سُورَةُ الرُّومِ",
        "englishName": "Ar-Room",
        "englishNameTranslation": "The Romans",
        "numberOfAyahs": 60,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
      "juz": 21,
      "manzil": 5,
      "page": 409,
