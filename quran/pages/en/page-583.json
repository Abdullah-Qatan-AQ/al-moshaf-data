      "page": 583,
      "ruku": 519,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5705,
      "text": "and full-bosomed maidens of equal age,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
