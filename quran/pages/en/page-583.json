      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5718,
      "text": "on the Day when the earth convulses [by the first Blast],",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 583,
      "ruku": 520,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5719,
      "text": "followed by the second Blast,",
      "surah": {
        "number": 79,
        "name": "سُورَةُ النَّازِعَاتِ",
        "englishName": "An-Naazi'aat",
        "englishNameTranslation": "Those who drag forth",
        "numberOfAyahs": 46,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
