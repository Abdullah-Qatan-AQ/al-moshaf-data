      "page": 583,
      "ruku": 519,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5706,
      "text": "and a full cup [of wine][9].",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
        "revelationType": "Meccan"
      },
      "numberInSurah": 34,
      "juz": 30,
