      "page": 583,
      "ruku": 519,
      "hizbQuarter": 233,
      "sajda": false
    },
    {
      "number": 5704,
      "text": "gardens and vineyards,",
      "surah": {
        "number": 78,
        "name": "سُورَةُ النَّبَإِ",
        "englishName": "An-Naba",
        "englishNameTranslation": "The Announcement",
        "numberOfAyahs": 40,
