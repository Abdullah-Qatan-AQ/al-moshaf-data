    {
      "number": 599,
      "text": "And seek forgiveness of Allah[76], for Allah is All-Forgiving, Most Merciful.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
