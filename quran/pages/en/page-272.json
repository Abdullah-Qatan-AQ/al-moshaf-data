    {
      "number": 1944,
      "text": "We did not send before you except men to whom We sent revelation. Ask the people of knowledge[26], if you do not know.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 14,
      "manzil": 3,
