      "hizbQuarter": 171,
      "sajda": false
    },
    {
      "number": 3600,
      "text": "They will say, “Our Lord, we obeyed our chiefs and our elders[53], but they led us astray from the [right] way.",
      "surah": {
        "number": 33,
        "name": "سُورَةُ الأَحۡزَابِ",
        "englishName": "Al-Ahzaab",
        "englishNameTranslation": "The Clans",
        "numberOfAyahs": 73,
        "revelationType": "Medinan"
      },
      "numberInSurah": 67,
      "juz": 22,
      "manzil": 5,
      "page": 427,
      "ruku": 368,
      "hizbQuarter": 171,
      "sajda": false
    },
    {
      "number": 3601,
      "text": "Our Lord, give them a double punishment and curse them with a mighty curse.”",
      "surah": {
        "number": 33,
        "name": "سُورَةُ الأَحۡزَابِ",
        "englishName": "Al-Ahzaab",
        "englishNameTranslation": "The Clans",
        "numberOfAyahs": 73,
