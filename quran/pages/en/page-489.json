      "page": 489,
      "ruku": 424,
      "hizbQuarter": 196,
      "sajda": false
    },
    {
      "number": 4329,
      "text": "and it is in the Master Book[2] with us, highly esteemed, full of wisdom.",
      "surah": {
        "number": 43,
        "name": "سُورَةُ الزُّخۡرُفِ",
        "englishName": "Az-Zukhruf",
        "englishNameTranslation": "Ornaments of gold",
        "numberOfAyahs": 89,
