      "ruku": 424,
      "hizbQuarter": 196,
      "sajda": false
    },
    {
      "number": 4328,
      "text": "Indeed, We have made it an Arabic Qur’an so that you may understand,",
      "surah": {
        "number": 43,
        "name": "سُورَةُ الزُّخۡرُفِ",
        "englishName": "Az-Zukhruf",
        "englishNameTranslation": "Ornaments of gold",
        "numberOfAyahs": 89,
