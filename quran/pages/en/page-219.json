      "hizbQuarter": 88,
      "sajda": false
    },
    {
      "number": 1455,
      "text": "[He was told], “Now [you believe]? You had always been disobedient, and were one of the mischief-makers!",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
