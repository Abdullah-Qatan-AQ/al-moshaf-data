      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2273,
      "text": "The pains of labor drove her to the trunk of a palm tree. She said, “Oh, would that I had died before this and had been completely forgotten!”",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 23,
      "juz": 16,
