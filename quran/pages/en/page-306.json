      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2265,
      "text": "Peace be on him the day he was born, the day he will die, and the day he will be raised up to life again!",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
