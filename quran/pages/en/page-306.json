      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2274,
      "text": "Then he[6] called her from beneath her, “Do not grieve; your Lord has provided a stream beneath you.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
