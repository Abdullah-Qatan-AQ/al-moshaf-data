      "page": 306,
      "ruku": 265,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2272,
      "text": "So she conceived him and withdrew with him to a distant place.[5]",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
