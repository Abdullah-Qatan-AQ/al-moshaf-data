      "sajda": false
    },
    {
      "number": 1188,
      "text": "Know that your wealth and your children[16] are only a trial and that with Allah is an immense reward.",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
        "englishName": "Al-Anfaal",
