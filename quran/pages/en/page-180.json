      "hizbQuarter": 72,
      "sajda": false
    },
    {
      "number": 1190,
      "text": "And [remember] when the disbelievers plotted against you[18], to take you as captive, kill you or expel you. They plan, and Allah also plans, but Allah is the Best of those who plan.",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
        "englishName": "Al-Anfaal",
        "englishNameTranslation": "The Spoils of War",
