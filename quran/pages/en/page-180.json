      "hizbQuarter": 72,
      "sajda": false
    },
    {
      "number": 1189,
      "text": "O you who believe, if you fear Allah, He will provide you with an insight[17] to distinguish between right and wrong, absolve you of your sins and forgive you, for Allah is the Lord of great bounty.",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
        "englishName": "Al-Anfaal",
        "englishNameTranslation": "The Spoils of War",
