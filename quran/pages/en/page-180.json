      "hizbQuarter": 72,
      "sajda": false
    },
    {
      "number": 1191,
      "text": "When Our verses are recited to them, they say, “We have heard. If we wished, we could say something like this. This is nothing but ancient fables.”",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
        "englishName": "Al-Anfaal",
        "englishNameTranslation": "The Spoils of War",
