    {
      "number": 900,
      "text": "Even if We did send the angels down to them, and the dead spoke to them, and We gathered before them everything, they would still not believe, unless Allah so willed, but most of them are ignorant.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
