      "sajda": false
    },
    {
      "number": 901,
      "text": "Similarly did We make for every prophet enemies, devils from among men and jinn, whispering to one another alluring words of delusion. If Allah had willed, they would not have done so. So leave them to their fabrications,",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
        "revelationType": "Meccan"
      },
      "numberInSurah": 112,
      "juz": 8,
      "manzil": 2,
      "page": 142,
      "ruku": 115,
      "hizbQuarter": 57,
      "sajda": false
    },
    {
      "number": 902,
      "text": "so that the hearts of those who disbelieve in the Hereafter may incline towards it and be pleased with it, and may commit whatever sins they want.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
