      "hizbQuarter": 200,
      "sajda": false
    },
    {
      "number": 4489,
      "text": "Indeed, We gave the Children of Israel the Scripture, wisdom, and prophethood; provided them with good things; and favored them above all others[4].",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
