      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2676,
      "text": "and those who turn away from all that is vain,",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
