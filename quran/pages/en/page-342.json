      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2679,
      "text": "except with their wives or slave women they may own, for then they are free of blame.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
