      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2680,
      "text": "But whoever seeks anything beyond that, it is they who are the transgressors.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 18,
