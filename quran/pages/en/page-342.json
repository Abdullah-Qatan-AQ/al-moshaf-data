      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2678,
      "text": "and those who guard their sexual desires[2],",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
