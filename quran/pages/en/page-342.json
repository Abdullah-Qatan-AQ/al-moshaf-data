      "page": 342,
      "ruku": 295,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2677,
      "text": "and those who give zakah[1],",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
        "englishNameTranslation": "The Believers",
        "numberOfAyahs": 118,
        "revelationType": "Meccan"
      },
