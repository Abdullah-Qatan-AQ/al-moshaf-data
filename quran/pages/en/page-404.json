      "hizbQuarter": 161,
      "sajda": false
    },
    {
      "number": 3405,
      "text": "When they board a ship, they supplicate Allah, devoting their faith sincerely to Him. But as soon as He rescues them to the land, they associate partners with Him,",
      "surah": {
        "number": 29,
        "name": "سُورَةُ العَنكَبُوتِ",
        "englishName": "Al-Ankaboot",
        "englishNameTranslation": "The Spider",
        "numberOfAyahs": 69,
        "revelationType": "Meccan"
      },
