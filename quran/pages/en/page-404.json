  "ayahs": [
    {
      "number": 3404,
      "text": "The life of this world is nothing but amusement and play, and the Abode of the Hereafter is indeed the real life, if only they knew.",
      "surah": {
        "number": 29,
        "name": "سُورَةُ العَنكَبُوتِ",
        "englishName": "Al-Ankaboot",
        "englishNameTranslation": "The Spider",
