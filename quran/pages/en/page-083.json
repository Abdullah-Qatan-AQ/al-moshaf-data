      "ruku": 66,
      "hizbQuarter": 33,
      "sajda": false
    },
    {
      "number": 525,
      "text": "Do not wish for what Allah has bestowed upon some of you over others. Men will have the reward of their deeds and women will have the reward of their deeds. And ask Allah for His bounty[21]. Indeed, Allah is All-Knowing of everything.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
