      "page": 83,
      "ruku": 66,
      "hizbQuarter": 33,
      "sajda": false
    },
    {
      "number": 523,
      "text": "And whoever does that out of aggression and injustice, We will cast him into the Fire; that is easy for Allah.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
