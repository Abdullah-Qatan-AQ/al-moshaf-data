      "hizbQuarter": 33,
      "sajda": false
    },
    {
      "number": 526,
      "text": "For everyone We have appointed heirs to what parents and close relatives leave behind. As for those to whom you have made a pledge, give them their share[22]. Indeed, Allah is Witness over all things.",
