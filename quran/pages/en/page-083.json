    },
    {
      "number": 522,
      "text": "O you who believe, do not consume one another’s property unlawfully, unless it is trade conducted with your mutual consent. And do not kill yourselves[19] [or one another]. Indeed, Allah is Most Merciful to you.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
        "revelationType": "Medinan"
      },
      "numberInSurah": 29,
