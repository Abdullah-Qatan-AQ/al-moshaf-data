      "page": 83,
      "ruku": 66,
      "hizbQuarter": 33,
      "sajda": false
    },
    {
      "number": 524,
      "text": "If you avoid the major sins[20] which are forbidden to you, We will absolve your [minor] sins and admit you to a noble entrance.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
