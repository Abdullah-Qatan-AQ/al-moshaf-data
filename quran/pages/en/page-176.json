    {
      "number": 1150,
      "text": "My Protector is Allah Who has sent down the Book, for it is He Who protects the righteous.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
