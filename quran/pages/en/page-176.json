      "hizbQuarter": 70,
      "sajda": false
    },
    {
      "number": 1151,
      "text": "But those whom you supplicate besides Him cannot help you, nor can they help themselves.”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
