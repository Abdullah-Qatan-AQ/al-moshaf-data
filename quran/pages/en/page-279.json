      "hizbQuarter": 111,
      "sajda": false
    },
    {
      "number": 2009,
      "text": "These are the ones whose hearts, hearing and sight are sealed up by Allah[68]; it is they who are the heedless.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
