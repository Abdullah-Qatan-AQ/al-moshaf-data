      "hizbQuarter": 111,
      "sajda": false
    },
    {
      "number": 2008,
      "text": "That is because they prefer the life of this world to the Hereafter, and Allah does not guide the disbelieving people.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
