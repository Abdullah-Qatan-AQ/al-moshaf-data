      "page": 174,
      "ruku": 144,
      "hizbQuarter": 69,
      "sajda": false
    },
    {
      "number": 1137,
      "text": "I will give them respite, but My plan is firm.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 183,
