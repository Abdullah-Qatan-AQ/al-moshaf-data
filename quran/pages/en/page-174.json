      "hizbQuarter": 69,
      "sajda": false
    },
    {
      "number": 1135,
      "text": "And among those whom We created is a group[80] that guides others with the truth and establishes justice therewith.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
