      "hizbQuarter": 69,
      "sajda": false
    },
    {
      "number": 1136,
      "text": "As for those who reject Our signs, We will gradually lead them to destruction[81] without them realizing it.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
