      "page": 174,
      "ruku": 144,
      "hizbQuarter": 69,
      "sajda": false
    },
    {
      "number": 1140,
      "text": "Whoever Allah causes to stray, there is none to guide him; He will leave them to wander blindly in their transgression.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
