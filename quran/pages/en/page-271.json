      "hizbQuarter": 108,
      "sajda": false
    },
    {
      "number": 1942,
      "text": "Those who migrated for the sake of Allah after being oppressed[25], We will surely give them good in this world. But the reward of the Hereafter is greater, if only they knew,",
      "surah": {
