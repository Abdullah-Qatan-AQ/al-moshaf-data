      "page": 271,
      "ruku": 228,
      "hizbQuarter": 108,
      "sajda": false
    },
    {
      "number": 1941,
      "text": "When We intend something, We only say to it, “Be!”, and it is.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
