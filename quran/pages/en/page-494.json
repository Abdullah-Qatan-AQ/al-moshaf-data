      "page": 494,
      "ruku": 430,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4395,
      "text": "Enter Paradise, you and your companions[26], rejoicing in bliss.”",
      "surah": {
        "number": 43,
        "name": "سُورَةُ الزُّخۡرُفِ",
        "englishName": "Az-Zukhruf",
        "englishNameTranslation": "Ornaments of gold",
        "numberOfAyahs": 89,
        "revelationType": "Meccan"
      },
      "numberInSurah": 70,
