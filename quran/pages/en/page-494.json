      "page": 494,
      "ruku": 430,
      "hizbQuarter": 198,
      "sajda": false
    },
    {
      "number": 4397,
      "text": "That is Paradise which you will inherit for what you used to do.",
      "surah": {
        "number": 43,
        "name": "سُورَةُ الزُّخۡرُفِ",
        "englishName": "Az-Zukhruf",
