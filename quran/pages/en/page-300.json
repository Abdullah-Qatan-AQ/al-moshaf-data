    {
      "number": 2194,
      "text": "We have surely diversified in this Qur’an every kind of example for people[32], but man is the most quarrelsome of all beings[33].",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
