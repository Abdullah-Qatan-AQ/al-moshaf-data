      "sajda": false
    },
    {
      "number": 2195,
      "text": "Nothing prevents people from believing when guidance comes to them and from seeking forgiveness from their Lord except that the fate of the earlier nations should come to them, or that the punishment should come before their eyes.",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
