    {
      "number": 3337,
      "text": "Indeed, the One Who has ordained for you the Qur’an will bring you back home[36]. Say, “My Lord knows best who has come with guidance and who is clearly misguided.”",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
        "englishName": "Al-Qasas",
        "englishNameTranslation": "The Stories",
