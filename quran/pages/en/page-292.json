      "hizbQuarter": 117,
      "sajda": false
    },
    {
      "number": 2129,
      "text": "Say, “If you were to own the treasuries of my Lord’s mercy, you would surely hold them back for fear of spending, for man is ever miserly.”",
      "surah": {
        "number": 17,
