      "hizbQuarter": 117,
      "sajda": false
    },
    {
      "number": 2131,
      "text": "Moses said, “You already know that none sent down these [signs] except the Lord of the heavens and earth as clear proofs, and I certainly think that you, O Pharaoh, are doomed!”",
      "surah": {
