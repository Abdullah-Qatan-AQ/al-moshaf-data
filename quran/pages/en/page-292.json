      "sajda": false
    },
    {
      "number": 2130,
      "text": "We gave Moses nine clear signs. Ask the Children of Israel when he came to them, Pharaoh said to him, “O Moses, I certainly think that you are bewitched[82].”",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
