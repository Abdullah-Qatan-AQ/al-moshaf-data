    {
      "number": 402,
      "text": "To Allah belongs all that is in the heavens and all that is on earth, and to Allah will return all matters.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
