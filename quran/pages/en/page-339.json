      "hizbQuarter": 135,
      "sajda": false
    },
    {
      "number": 2652,
      "text": "But those who disbelieve and reject Our verses, for them there will be a humiliating punishment.",
      "surah": {
        "number": 22,
        "name": "سُورَةُ الحَجِّ",
        "englishName": "Al-Hajj",
        "englishNameTranslation": "The Pilgrimage",
