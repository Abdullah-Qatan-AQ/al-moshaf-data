    {
      "number": 2651,
      "text": "The sovereignty on that Day belongs to Allah[29]; He will judge between them, then those who believed and did righteous deeds will be in the Gardens of Bliss.",
      "surah": {
        "number": 22,
        "name": "سُورَةُ الحَجِّ",
        "englishName": "Al-Hajj",
