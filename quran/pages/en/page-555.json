      "hizbQuarter": 222,
      "sajda": false
    },
    {
      "number": 5195,
      "text": "They are those who say, “Do not spend on those who are with Allah’s Messenger so that they may desert him. But to Allah belong the treasures of the heavens and earth, but the hypocrites do not understand.",
      "surah": {
        "number": 63,
        "name": "سُورَةُ المُنَافِقُونَ",
        "englishName": "Al-Munaafiqoon",
        "englishNameTranslation": "The Hypocrites",
        "numberOfAyahs": 11,
        "revelationType": "Medinan"
      },
      "numberInSurah": 7,
      "juz": 28,
      "manzil": 7,
      "page": 555,
      "ruku": 488,
      "hizbQuarter": 222,
      "sajda": false
    },
    {
      "number": 5196,
      "text": "They[2] say, “When we return to Madinah, the mightier will surely expel the weaker therefrom.” In fact, all might belongs to Allah and to His Messenger, and to the believers, but the hypocrites do not know.",
      "surah": {
        "number": 63,
        "name": "سُورَةُ المُنَافِقُونَ",
        "englishName": "Al-Munaafiqoon",
        "englishNameTranslation": "The Hypocrites",
        "numberOfAyahs": 11,
