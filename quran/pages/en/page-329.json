      "page": 329,
      "ruku": 283,
      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2571,
      "text": "So We answered his prayer and rescued him from distress. This is how We rescue the believers.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
