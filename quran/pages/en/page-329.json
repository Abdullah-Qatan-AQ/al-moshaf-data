      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2569,
      "text": "And We admitted them to Our mercy, for they were truly righteous.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
