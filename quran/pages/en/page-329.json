    {
      "number": 2566,
      "text": "And [remember] Job, when he cried out to his Lord, “I have been struck by adversity[36], and You are the Most Merciful of those who show mercy.”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
