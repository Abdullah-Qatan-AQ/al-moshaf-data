      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2572,
      "text": "And [remember] Zachariah, when he cried out to his Lord, “My Lord, do not leave me childless, for You are the Best of Inheritors.”",
      "surah": {
        "number": 21,
