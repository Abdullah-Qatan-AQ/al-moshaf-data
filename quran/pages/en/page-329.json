      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2568,
      "text": "And [remember] Ishmael, Idrīs and Dhul-Kifl[37]; they were all steadfast.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
