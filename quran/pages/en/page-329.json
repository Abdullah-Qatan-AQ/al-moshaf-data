      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2567,
      "text": "So We responded to him and relieved his adversity, and We restored to him his family, twice as many, as a mercy from Us and as a reminder for Our worshipers.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
