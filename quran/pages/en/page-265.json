      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1856,
      "text": "He said, “Do you give me glad tidings despite my old age? What glad tidings are you giving me?”",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
