      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1864,
      "text": "he said, “You are unfamiliar people.”",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
