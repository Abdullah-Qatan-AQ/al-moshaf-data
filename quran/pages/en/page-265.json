      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1870,
      "text": "Lot said, “These are my guests, so do not bring shame on me.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
