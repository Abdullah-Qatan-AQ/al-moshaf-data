      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1857,
      "text": "They said, “We have given you glad tidings in truth, so do not be of those who despair[25].”",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
