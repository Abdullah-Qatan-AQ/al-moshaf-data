      "ruku": 222,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1865,
      "text": "They said, “We have come to you with that [punishment][30] which they have doubted.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
