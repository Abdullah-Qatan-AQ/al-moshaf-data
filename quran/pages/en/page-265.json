      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1855,
      "text": "They said, “Do not be afraid; We give you glad tidings of a knowledgeable boy[24].”",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
