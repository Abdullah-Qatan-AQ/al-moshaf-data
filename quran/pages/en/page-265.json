      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1858,
      "text": "He said, “Who would despair of his Lord’s mercy except those who are misguided[26]?”",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
