      "ruku": 221,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1859,
      "text": "He said, “So, what is your mission, O messengers?”",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
