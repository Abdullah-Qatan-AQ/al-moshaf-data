      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2248,
      "text": "abiding therein forever, never desiring to leave.",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
