      "page": 304,
      "ruku": 262,
      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2241,
      "text": "those whose eyes were blind to My signs[52] and they were unable to hear [the truth][53].",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 101,
      "juz": 16,
