      "sajda": false
    },
    {
      "number": 2249,
      "text": "Say, “If the ocean were ink for [writing] the Words of my Lord, the ocean would surely run dry before the Words of my Lord[58] are finished, even if We brought its like to resupply it.”",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
