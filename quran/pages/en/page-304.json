      "sajda": false
    },
    {
      "number": 2239,
      "text": "On that Day[50] We will let some of them surge like waves over others, and the Trumpet will be blown, then We will gather them all together.",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
