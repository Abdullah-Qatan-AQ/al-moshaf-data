      "hizbQuarter": 122,
      "sajda": false
    },
    {
      "number": 2240,
      "text": "On that Day We will show Hell to the disbelievers clearly[51],",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
        "revelationType": "Meccan"
      },
      "numberInSurah": 100,
      "juz": 16,
