      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2538,
      "text": "They said, “Have you come to us with the truth, or are you joking?”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
