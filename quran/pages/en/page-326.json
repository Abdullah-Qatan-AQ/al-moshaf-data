      "page": 326,
      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2537,
      "text": "He said, “Indeed, you and your forefathers were clearly misguided.”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
