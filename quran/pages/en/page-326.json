      "hizbQuarter": 130,
      "sajda": false
    },
    {
      "number": 2529,
      "text": "If a mere breath of your Lord’s torment were to touch them, they would surely say, “Woe to us! We were indeed wrongdoers.”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
