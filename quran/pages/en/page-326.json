      "hizbQuarter": 130,
      "sajda": false
    },
    {
      "number": 2530,
      "text": "We will place the scales of justice on the Day of Resurrection, and no soul will be wronged in the least. Even if a deed is the weight of a mustard seed[18], We will bring it forth. Sufficient are We as Reckoners.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 47,
      "juz": 17,
      "manzil": 4,
      "page": 326,
      "ruku": 281,
      "hizbQuarter": 130,
      "sajda": false
    },
    {
      "number": 2531,
      "text": "We certainly gave Moses and Aaron the Criterion, shining light and admonition[19] for the righteous,",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
