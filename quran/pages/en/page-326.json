      "ruku": 281,
      "hizbQuarter": 130,
      "sajda": false
    },
    {
      "number": 2532,
      "text": "those who fear their Lord without seeing Him[20], and are apprehensive of the Hour.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
