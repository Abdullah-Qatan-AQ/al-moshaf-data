      "hizbQuarter": 19,
      "sajda": false
    },
    {
      "number": 285,
      "text": "O you who believe, fear Allah and give up usury that is still due, if you are truly believers.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
