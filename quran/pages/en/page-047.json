      "hizbQuarter": 19,
      "sajda": false
    },
    {
      "number": 286,
      "text": "But if you do not do it, then beware of a declaration of war from Allah and His Messenger. However, if you repent, you may retain your capital – neither harming nor suffering harm[170].",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
