      "hizbQuarter": 19,
      "sajda": false
    },
    {
      "number": 287,
      "text": "If the debtor is in hardship, give him respite until it is easy for him to pay back. But if you waive it as charity[171], that is better for you, if only you knew.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
