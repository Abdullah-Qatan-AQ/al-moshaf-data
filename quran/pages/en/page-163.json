    {
      "number": 1050,
      "text": "If only the people of the towns had believed and feared Allah, We would have certainly opened for them blessings from the heaven and earth. But they disbelieved, so We seized them for what they earned.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 96,
      "juz": 9,
      "manzil": 2,
      "page": 163,
