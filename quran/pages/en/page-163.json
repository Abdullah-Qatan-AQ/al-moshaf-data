      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1051,
      "text": "Do the people of the towns feel secure that Our punishment will not befall them by night while they are asleep?",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
