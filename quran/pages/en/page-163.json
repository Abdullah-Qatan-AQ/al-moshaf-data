      "juz": 9,
      "manzil": 2,
      "page": 163,
      "ruku": 133,
      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1052,
      "text": "Or do the people of the towns feel secure that Our punishment will not befall them by day while they are at play?",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
