      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1053,
      "text": "Do they feel secure from the plan of Allah? None can feel secure from the plan of Allah[37] except the loser people.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
      "numberInSurah": 99,
      "juz": 9,
      "manzil": 2,
      "page": 163,
