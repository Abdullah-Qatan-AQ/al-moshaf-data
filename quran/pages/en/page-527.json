      "text": "and that He is the One Who makes people laugh and weep[16],",
      "surah": {
        "number": 53,
        "name": "سُورَةُ النَّجۡمِ",
        "englishName": "An-Najm",
        "englishNameTranslation": "The Star",
        "numberOfAyahs": 62,
        "revelationType": "Meccan"
      },
