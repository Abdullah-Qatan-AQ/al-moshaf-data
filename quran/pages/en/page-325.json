    {
      "number": 2519,
      "text": "When the disbelievers see you, they only take you in ridicule, [saying], “Is this the one who speaks ill of your gods?” while they reject even the mention of the Most Compassionate.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 36,
      "juz": 17,
      "manzil": 4,
      "page": 325,
