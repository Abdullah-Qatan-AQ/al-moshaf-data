    },
    {
      "number": 835,
      "text": "Say, “What do you think, if Allah were to take away your hearing and your sight, and seal up your hearts – which god other than Allah could restore them to you?” See how We diversify the signs, yet they still turn away.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
