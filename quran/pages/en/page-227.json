      "hizbQuarter": 91,
      "sajda": false
    },
    {
      "number": 1525,
      "text": "O my people, seek forgiveness of your Lord and turn to Him in repentance; He will send down upon you abundant rain from the sky and will add strength to your strength. So do not turn away in wickedness.”",
