    {
      "number": 1523,
      "text": "To the people of ‘Ād[24] We sent their brother Hūd. He said, “O my people, worship Allah; you have no god other than Him. You are but fabricators[25].",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
