      "hizbQuarter": 91,
      "sajda": false
    },
    {
      "number": 1524,
      "text": "O my people, I ask you no reward for it. My reward is only with the One Who created me. Do you not then understand?",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
