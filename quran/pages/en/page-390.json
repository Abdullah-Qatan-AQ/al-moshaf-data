    {
      "number": 3288,
      "text": "When Moses came to them with Our clear signs, they said, “This is nothing but fabricated magic; we have not heard of this from our earlier ancestors.”",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
        "englishName": "Al-Qasas",
        "englishNameTranslation": "The Stories",
