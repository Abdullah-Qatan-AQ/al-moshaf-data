      "page": 89,
      "ruku": 70,
      "hizbQuarter": 35,
      "sajda": false
    },
    {
      "number": 563,
      "text": "That grace is from Allah, and sufficient is Allah as Knower.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
