      "page": 89,
      "ruku": 70,
      "hizbQuarter": 35,
      "sajda": false
    },
    {
      "number": 564,
      "text": "O you who believe, take your precautions, then march out in groups or march out all together.",
      "surah": {
        "number": 4,
        "name": "سُورَةُ النِّسَاءِ",
        "englishName": "An-Nisaa",
        "englishNameTranslation": "The Women",
        "numberOfAyahs": 176,
