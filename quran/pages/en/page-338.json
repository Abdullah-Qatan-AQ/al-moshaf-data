  "ayahs": [
    {
      "number": 2642,
      "text": "They ask you to hasten the punishment, but Allah will not fail in His promise. A single day with your Lord is like one thousand years by your count.",
      "surah": {
        "number": 22,
        "name": "سُورَةُ الحَجِّ",
        "englishName": "Al-Hajj",
        "englishNameTranslation": "The Pilgrimage",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 47,
      "juz": 17,
      "manzil": 4,
      "page": 338,
