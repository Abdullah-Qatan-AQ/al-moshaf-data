      "page": 330,
      "ruku": 283,
      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2577,
      "text": "Whoever does righteous deeds while he is a believer, his efforts will not be denied[40], for We are recording them all.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 94,
      "juz": 17,
      "manzil": 4,
      "page": 330,
      "ruku": 284,
      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2578,
      "text": "It is not possible for any town that We have destroyed to ever come back [to this world][41],",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
