      "sajda": false
    },
    {
      "number": 2580,
      "text": "when the True Promise[42] draws near, the eyes of those who disbelieved will stare in horror, [saying], “Woe to us! We were indeed heedless of this; nay, we were wrongdoers.”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
      "numberInSurah": 97,
      "juz": 17,
