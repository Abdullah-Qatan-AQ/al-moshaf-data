      "page": 330,
      "ruku": 284,
      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2583,
      "text": "They will groan therein with anguish, and they will not be able to hear anything.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
