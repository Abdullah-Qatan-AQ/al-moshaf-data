      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2579,
      "text": "until when Gog and Magog are let loose, swarming swiftly from every mound,",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
