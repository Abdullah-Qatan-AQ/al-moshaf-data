      },
      "numberInSurah": 92,
      "juz": 17,
      "manzil": 4,
      "page": 330,
      "ruku": 283,
      "hizbQuarter": 132,
      "sajda": false
    },
    {
      "number": 2576,
      "text": "But people have divided themselves into sects, yet they will all return to Us.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
