      "sajda": false
    },
    {
      "number": 2575,
      "text": "Indeed, this religion of yours is one religion, and I am your Lord, so worship Me alone.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
