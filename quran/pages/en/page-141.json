      "ruku": 114,
      "hizbQuarter": 56,
      "sajda": false
    },
    {
      "number": 894,
      "text": "This is how We diversify the verses, so that they may say, “You have studied [previous scriptures][34]”, and so that We may make it clear for people who know.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
        "revelationType": "Meccan"
      },
      "numberInSurah": 105,
      "juz": 7,
      "manzil": 2,
      "page": 141,
