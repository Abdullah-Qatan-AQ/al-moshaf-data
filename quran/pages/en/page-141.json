      "hizbQuarter": 56,
      "sajda": false
    },
    {
      "number": 893,
      "text": "There have come to you insights from your Lord. Whoever chooses to see [the truth], it is for his own good. But whoever turns a blind eye, it is to his own loss. And [say], “I am not a keeper over you.”",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
