    },
    {
      "number": 892,
      "text": "No vision can encompass Him[33], but He encompasses all vision, and He is the Most Subtle, the All-Aware.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
