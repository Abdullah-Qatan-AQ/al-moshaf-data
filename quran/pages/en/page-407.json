      "page": 407,
      "ruku": 352,
      "hizbQuarter": 162,
      "sajda": false
    },
    {
      "number": 3440,
      "text": "Turn to Him [in repentance] and fear Him, and establish prayer, and do not be among those who associate partners with Allah,",
