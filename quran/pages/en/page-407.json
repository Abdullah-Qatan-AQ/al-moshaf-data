    {
      "number": 3434,
      "text": "And among His signs is that the sky and earth are maintained by His command. Then when He calls you out of the earth, you will immediately come forth.",
      "surah": {
        "number": 30,
        "name": "سُورَةُ الرُّومِ",
        "englishName": "Ar-Room",
        "englishNameTranslation": "The Romans",
