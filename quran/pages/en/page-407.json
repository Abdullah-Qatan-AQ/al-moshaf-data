      "sajda": false
    },
    {
      "number": 3435,
      "text": "To Him belong all those who are in the heavens and earth; all are devotedly obedient to Him.",
      "surah": {
        "number": 30,
        "name": "سُورَةُ الرُّومِ",
        "englishName": "Ar-Room",
        "englishNameTranslation": "The Romans",
        "numberOfAyahs": 60,
