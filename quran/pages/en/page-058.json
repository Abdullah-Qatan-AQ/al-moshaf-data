      "hizbQuarter": 23,
      "sajda": false
    },
    {
      "number": 359,
      "text": "Here you are! You are those who disputed about that of which you have some knowledge, then why do you dispute about that of which you have no knowledge[27]? Allah knows and you do not know.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
