      },
      "numberInSurah": 67,
      "juz": 3,
      "manzil": 1,
      "page": 58,
      "ruku": 48,
      "hizbQuarter": 23,
      "sajda": false
    },
    {
      "number": 361,
      "text": "The closest people to Abraham are those who followed him, and this Prophet and those who believe. And Allah is the Guardian of the believers.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
