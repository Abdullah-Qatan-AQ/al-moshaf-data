    },
    {
      "number": 358,
      "text": "O People of the Book, why do you dispute about Abraham[26], while the Torah and the Gospel were not sent down but after him? Do you not understand?",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
        "numberOfAyahs": 200,
