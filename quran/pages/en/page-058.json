      "hizbQuarter": 23,
      "sajda": false
    },
    {
      "number": 360,
      "text": "Abraham was neither a Jew nor a Christian, but he was a monotheist[28] Muslim, and he was not one of the polytheists.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
        "numberOfAyahs": 200,
