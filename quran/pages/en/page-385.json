      "hizbQuarter": 154,
      "sajda": false
    },
    {
      "number": 3250,
      "text": "Say, “I have been commanded only to worship the Lord of this city [of Makkah] Who made it sacred and to Whom belongs all things. And I am commanded to be one of those who submit to Allah [in Islam],",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
