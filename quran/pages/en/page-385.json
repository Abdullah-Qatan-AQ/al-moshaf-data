      "hizbQuarter": 154,
      "sajda": false
    },
    {
      "number": 3255,
      "text": "We recount to you part of the story of Moses and Pharaoh in truth for people who believe.",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
        "englishName": "Al-Qasas",
        "englishNameTranslation": "The Stories",
        "numberOfAyahs": 88,
