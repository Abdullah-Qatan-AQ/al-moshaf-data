      "juz": 20,
      "manzil": 5,
      "page": 385,
      "ruku": 333,
      "hizbQuarter": 154,
      "sajda": false
    },
    {
      "number": 3251,
      "text": "and to recite the Qur’an.” Then whoever chooses guidance, it is only for his own good; but whoever chooses to go astray, say [O Prophet], “I am only one of the warners.”",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
