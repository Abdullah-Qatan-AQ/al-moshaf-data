      "hizbQuarter": 154,
      "sajda": false
    },
    {
      "number": 3252,
      "text": "And say, “All praise is for Allah. He will show you His signs, then you will acknowledge them. Your Lord is not unaware of what you do.”",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
