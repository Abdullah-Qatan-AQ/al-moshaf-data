      "ruku": 296,
      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2699,
      "text": "Noah said, “My Lord, help me, for they have rejected me.”",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
