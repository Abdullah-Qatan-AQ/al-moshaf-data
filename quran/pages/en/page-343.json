      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2695,
      "text": "and on them and on boats you are carried.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
