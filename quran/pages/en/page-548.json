      "hizbQuarter": 219,
      "sajda": false
    },
    {
      "number": 5149,
      "text": "He is Allah; none has the right to be worshiped except Him, the Sovereign[15], the Most Holy[16], the Most Perfect[17], the Granter of Security[18], the Watcher over all, the All-Mighty, the Compeller[19], the Supreme[20]. Glory be to Allah far above what they associate with Him.",
      "surah": {
        "number": 59,
        "name": "سُورَةُ الحَشۡرِ",
        "englishName": "Al-Hashr",
        "englishNameTranslation": "The Exile",
