    {
      "number": 5144,
      "text": "O you who believe, fear Allah, and let every soul consider what it has sent forth for tomorrow[13]. And fear Allah. Indeed, Allah is All-Aware of what you do.",
      "surah": {
        "number": 59,
        "name": "سُورَةُ الحَشۡرِ",
        "englishName": "Al-Hashr",
        "englishNameTranslation": "The Exile",
