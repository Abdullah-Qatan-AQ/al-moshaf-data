      "ruku": 58,
      "hizbQuarter": 28,
      "sajda": false
    },
    {
      "number": 456,
      "text": "They are of various ranks with Allah, and Allah is All-Seeing of what they do.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
