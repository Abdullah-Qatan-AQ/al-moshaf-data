      "sajda": false
    },
    {
      "number": 453,
      "text": "If Allah helps you, none can overcome you; but if He forsakes you, who is there to help you after Him? In Allah let the believers put their trust.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
