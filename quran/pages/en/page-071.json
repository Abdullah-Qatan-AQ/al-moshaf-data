      "hizbQuarter": 28,
      "sajda": false
    },
    {
      "number": 455,
      "text": "Is the one who seeks Allah’s pleasure like someone who incurs Allah’s wrath, and whose abode is Hell? What a terrible destination!",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
