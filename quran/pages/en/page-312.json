  "ayahs": [
    {
      "number": 2346,
      "text": "Those who believe and do righteous deeds, the Most Compassionate will endear them [to His creation][26].",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
