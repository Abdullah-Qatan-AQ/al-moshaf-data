      "hizbQuarter": 124,
      "sajda": false
    },
    {
      "number": 2347,
      "text": "We have made this [Qur’an] easy in your language so that you may give thereby glad tidings to the righteous and warn people who are contentious.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 97,
      "juz": 16,
      "manzil": 4,
      "page": 312,
      "ruku": 269,
      "hizbQuarter": 124,
      "sajda": false
    },
    {
      "number": 2348,
      "text": "How many generations We have destroyed before them! Do you sense a single one of them or even hear from them a whisper?",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
        "numberOfAyahs": 98,
        "revelationType": "Meccan"
      },
      "numberInSurah": 98,
      "juz": 16,
      "manzil": 4,
      "page": 312,
