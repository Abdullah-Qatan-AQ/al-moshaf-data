      "sajda": false
    },
    {
      "number": 4117,
      "text": "[Allah will say,] “No indeed! My verses had already come to you, but you rejected them and acted arrogantly, and you were among the disbelievers.”",
      "surah": {
        "number": 39,
        "name": "سُورَةُ الزُّمَرِ",
        "englishName": "Az-Zumar",
        "englishNameTranslation": "The Groups",
        "numberOfAyahs": 75,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 24,
