    {
      "number": 4116,
      "text": "or says, upon seeing the punishment, “If only I had another chance[17], I could be among those who do good.”",
      "surah": {
        "number": 39,
        "name": "سُورَةُ الزُّمَرِ",
        "englishName": "Az-Zumar",
