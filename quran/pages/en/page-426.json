      "sajda": false
    },
    {
      "number": 3590,
      "text": "Those who offend Allah[47] and His Messenger[48] are cursed by Allah in this world and in the Hereafter, and He has prepared for them a humiliating punishment.",
      "surah": {
        "number": 33,
        "name": "سُورَةُ الأَحۡزَابِ",
        "englishName": "Al-Ahzaab",
        "englishNameTranslation": "The Clans",
        "numberOfAyahs": 73,
        "revelationType": "Medinan"
      },
      "numberInSurah": 57,
      "juz": 22,
      "manzil": 5,
      "page": 426,
      "ruku": 367,
      "hizbQuarter": 170,
      "sajda": false
    },
    {
      "number": 3591,
      "text": "Those who abuse believing men and women[49] for something they did not commit, will bear the burden of slander and flagrant sin.",
      "surah": {
        "number": 33,
        "name": "سُورَةُ الأَحۡزَابِ",
        "englishName": "Al-Ahzaab",
        "englishNameTranslation": "The Clans",
        "numberOfAyahs": 73,
