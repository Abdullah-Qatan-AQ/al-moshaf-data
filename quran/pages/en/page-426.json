      "page": 426,
      "ruku": 368,
      "hizbQuarter": 171,
      "sajda": false
    },
    {
      "number": 3594,
      "text": "They are cursed; wherever they are found they should be seized and killed outright[52].",
      "surah": {
        "number": 33,
        "name": "سُورَةُ الأَحۡزَابِ",
        "englishName": "Al-Ahzaab",
