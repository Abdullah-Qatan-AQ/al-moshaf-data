      "page": 426,
      "ruku": 367,
      "hizbQuarter": 170,
      "sajda": false
    },
    {
      "number": 3592,
      "text": "O Prophet, tell your wives and your daughters, and the believing women to draw their outer garments[50] over themselves; that is more likely that they will be known [as chaste women] and will not be harassed. And Allah is All-Forgiving, Most Merciful.",
      "surah": {
        "number": 33,
        "name": "سُورَةُ الأَحۡزَابِ",
        "englishName": "Al-Ahzaab",
        "englishNameTranslation": "The Clans",
        "numberOfAyahs": 73,
