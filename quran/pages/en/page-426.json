    {
      "number": 3589,
      "text": "Indeed, Allah sends His blessings upon the Prophet, and His angels pray for him. O you who believe, invoke Allah’s blessings upon him and send him greetings of peace.",
      "surah": {
        "number": 33,
        "name": "سُورَةُ الأَحۡزَابِ",
