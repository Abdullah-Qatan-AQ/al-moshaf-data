      "hizbQuarter": 107,
      "sajda": false
    },
    {
      "number": 1919,
      "text": "If you try to count Allah’s favors, you will not be able to enumerate them. Indeed, Allah is All-Forgiving, Most Merciful.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 18,
      "juz": 14,
