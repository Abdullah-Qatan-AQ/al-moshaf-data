      "sajda": false
    },
    {
      "number": 1918,
      "text": "Is then He Who creates equal to one who cannot create? Will you not then take heed?",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
