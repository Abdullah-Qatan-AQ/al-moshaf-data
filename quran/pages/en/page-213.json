      "page": 213,
      "ruku": 175,
      "hizbQuarter": 85,
      "sajda": false
    },
    {
      "number": 1404,
      "text": "There are some among them who will believe in it and others will not. And your Lord knows best those who spread corruption.",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
