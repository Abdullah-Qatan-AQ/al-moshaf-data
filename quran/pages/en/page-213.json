      "hizbQuarter": 85,
      "sajda": false
    },
    {
      "number": 1400,
      "text": "Most of them follow nothing but assumptions. However, assumptions are of no avail against the truth. Indeed, Allah is All-Knowing of what they do.",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
