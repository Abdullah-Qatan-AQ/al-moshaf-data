      "hizbQuarter": 85,
      "sajda": false
    },
    {
      "number": 1401,
      "text": "This Qur’an could not possibly have been produced by anyone other than Allah. It is a confirmation of what came before it and an explanation of the Scripture and is undoubtedly from the Lord of the worlds.",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
