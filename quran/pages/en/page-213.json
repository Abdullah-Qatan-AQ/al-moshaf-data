      "page": 213,
      "ruku": 175,
      "hizbQuarter": 85,
      "sajda": false
    },
    {
      "number": 1403,
      "text": "But they rejected that which they did not comprehend, and its warning has not yet been fulfilled against them. Similarly, those who came before them refused to believe. Then see how was the end of the wrongdoers!",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
