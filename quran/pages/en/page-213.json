      "hizbQuarter": 85,
      "sajda": false
    },
    {
      "number": 1402,
      "text": "Or do they say, “He fabricated it?” Say, “Produce then one chapter like it[37], and call upon whoever you can other than Allah, if you are truthful!”",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
        "numberOfAyahs": 109,
        "revelationType": "Meccan"
      },
      "numberInSurah": 38,
      "juz": 11,
