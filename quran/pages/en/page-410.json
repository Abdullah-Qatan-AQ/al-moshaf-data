    {
      "number": 3460,
      "text": "But if We send a [harmful] wind and they see [their crops] turning yellow, they become ungrateful thereafter[21].",
      "surah": {
        "number": 30,
        "name": "سُورَةُ الرُّومِ",
        "englishName": "Ar-Room",
