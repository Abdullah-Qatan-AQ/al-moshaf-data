      "hizbQuarter": 97,
      "sajda": false
    },
    {
      "number": 1651,
      "text": "Joseph said, “Put me in charge of the storehouses of the land[20]; I am indeed a good keeper and knowledgeable[21].”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
