      "hizbQuarter": 97,
      "sajda": false
    },
    {
      "number": 1657,
      "text": "They said, “We will persuade his father to send him[24], and we will surely do our best.”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
