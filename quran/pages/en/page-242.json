      "ruku": 199,
      "hizbQuarter": 97,
      "sajda": false
    },
    {
      "number": 1654,
      "text": "The brothers of Joseph came and presented themselves before him; he recognized them but they did not know him.",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
        "revelationType": "Meccan"
      },
      "numberInSurah": 58,
      "juz": 13,
