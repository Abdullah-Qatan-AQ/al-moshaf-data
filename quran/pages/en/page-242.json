      "page": 242,
      "ruku": 200,
      "hizbQuarter": 97,
      "sajda": false
    },
    {
      "number": 1656,
      "text": "If you do not bring him to me, you will never receive any measure [of grain] from me, nor will you even come close to me.”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
