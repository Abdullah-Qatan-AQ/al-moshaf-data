  "ayahs": [
    {
      "number": 3679,
      "text": "The blind and the seeing are not equal[7],",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
      "numberInSurah": 19,
      "juz": 22,
      "manzil": 5,
      "page": 437,
      "ruku": 378,
      "hizbQuarter": 175,
      "sajda": false
    },
    {
      "number": 3680,
      "text": "nor are the depths of darkness and the light[8],",
      "surah": {
        "number": 35,
        "name": "سُورَةُ فَاطِرٍ",
        "englishName": "Faatir",
        "englishNameTranslation": "The Originator",
        "numberOfAyahs": 45,
        "revelationType": "Meccan"
      },
