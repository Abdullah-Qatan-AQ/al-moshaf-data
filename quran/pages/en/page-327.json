      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2544,
      "text": "They said, “Bring him then before the eyes of the people, so that they may witness [his trial][23].”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
