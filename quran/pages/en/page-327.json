      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2546,
      "text": "He said, “Rather, it was this biggest one who did it. So ask them, if they can speak!”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
