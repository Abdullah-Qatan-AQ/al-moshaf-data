      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2549,
      "text": "Abraham said, “Do you then worship besides Allah that which can neither benefit nor harm you in the least?",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
        "revelationType": "Meccan"
      },
