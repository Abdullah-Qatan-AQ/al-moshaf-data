      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2545,
      "text": "They said, “Are you the one who did this to our gods, O Abraham?”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
