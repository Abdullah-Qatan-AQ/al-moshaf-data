      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2550,
      "text": "Fie upon you[25] and upon all that you worship besides Allah! Do you not have any sense?”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
