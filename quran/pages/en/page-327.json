      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2543,
      "text": "They said, “We heard a young man, speaking ill of them, who is called Abraham.”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
