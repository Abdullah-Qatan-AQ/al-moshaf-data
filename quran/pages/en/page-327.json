      "ruku": 282,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2548,
      "text": "Then they turned to their obstinacy[24], [saying], “You already know that they cannot speak.”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
