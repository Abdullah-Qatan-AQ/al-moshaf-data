      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2547,
      "text": "So they turned back to one another, and said, “Indeed, it is you who are the wrongdoers.”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
