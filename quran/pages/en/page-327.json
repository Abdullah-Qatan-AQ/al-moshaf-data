      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2551,
      "text": "They said, “Burn him and avenge your gods if you must do something.”",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
