      },
      "numberInSurah": 40,
      "juz": 13,
      "manzil": 3,
      "page": 254,
      "ruku": 210,
      "hizbQuarter": 102,
      "sajda": false
    },
    {
      "number": 1748,
      "text": "Do they not see that We advance to the land, diminishing it from its sides[33]? It is Allah Who decrees; there is none to reverse His decree, and He is swift in reckoning.",
      "surah": {
        "number": 13,
        "name": "سُورَةُ الرَّعۡدِ",
        "englishName": "Ar-Ra'd",
        "englishNameTranslation": "The Thunder",
        "numberOfAyahs": 43,
