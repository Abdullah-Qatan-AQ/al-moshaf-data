      "page": 244,
      "ruku": 201,
      "hizbQuarter": 97,
      "sajda": false
    },
    {
      "number": 1671,
      "text": "They said, “The punishment is that the one in whose saddlebag it is found should be enslaved in recompense. This is how we punish the wrongdoers.”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
