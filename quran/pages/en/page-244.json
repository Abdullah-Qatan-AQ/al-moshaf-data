      "sajda": false
    },
    {
      "number": 1667,
      "text": "They said as they turned back, “What are you missing?”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
