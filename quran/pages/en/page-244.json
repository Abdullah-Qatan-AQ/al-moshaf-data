      "hizbQuarter": 97,
      "sajda": false
    },
    {
      "number": 1668,
      "text": "They said, “We are missing the king’s measuring cup. Whoever brings it will have a camel-load [of grain]; and I guarantee it.”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
        "revelationType": "Meccan"
      },
      "numberInSurah": 72,
