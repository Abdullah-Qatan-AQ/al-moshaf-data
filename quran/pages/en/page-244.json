      "ruku": 201,
      "hizbQuarter": 97,
      "sajda": false
    },
    {
      "number": 1670,
      "text": "They said, “What should the punishment be[28], if you are liars?”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
        "revelationType": "Meccan"
      },
      "numberInSurah": 74,
      "juz": 13,
