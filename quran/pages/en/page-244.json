      "page": 244,
      "ruku": 201,
      "hizbQuarter": 97,
      "sajda": false
    },
    {
      "number": 1669,
      "text": "They said, “By Allah, you know well that we did not come to spread corruption in the land, nor are we thieves.”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
