      "page": 383,
      "ruku": 332,
      "hizbQuarter": 153,
      "sajda": false
    },
    {
      "number": 3231,
      "text": "Say, “Perhaps some of what you seek to hasten is quite near to you.”",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 72,
      "juz": 20,
      "manzil": 5,
      "page": 383,
      "ruku": 332,
      "hizbQuarter": 153,
      "sajda": false
    },
    {
      "number": 3232,
      "text": "Indeed, your Lord is graceful to mankind[22], but most of them are ungrateful.",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 73,
      "juz": 20,
