      "hizbQuarter": 153,
      "sajda": false
    },
    {
      "number": 3234,
      "text": "For there is nothing hidden in the heavens and earth except that it is [written] in a clear Record[24].",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
