      "page": 383,
      "ruku": 332,
      "hizbQuarter": 153,
      "sajda": false
    },
    {
      "number": 3233,
      "text": "Your Lord surely knows all that their hearts conceal and all that they reveal[23].",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
