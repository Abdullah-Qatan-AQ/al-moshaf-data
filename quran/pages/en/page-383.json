      "page": 383,
      "ruku": 332,
      "hizbQuarter": 153,
      "sajda": false
    },
    {
      "number": 3230,
      "text": "They say, “When will this warning come to pass, if you are truthful?”",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 71,
