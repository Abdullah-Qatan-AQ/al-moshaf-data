      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5431,
      "text": "and He will give you wealth and children, and bestow upon you gardens and rivers.",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
