      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5432,
      "text": "What is the matter with you that you do not fear the Majesty of Allah[3],",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
