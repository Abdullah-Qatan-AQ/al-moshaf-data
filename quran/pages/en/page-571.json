      "page": 571,
      "ruku": 504,
      "hizbQuarter": 228,
      "sajda": false
    },
    {
      "number": 5439,
      "text": "so that you may tread its spacious paths[6].’”",
      "surah": {
        "number": 71,
        "name": "سُورَةُ نُوحٍ",
        "englishName": "Nooh",
        "englishNameTranslation": "Noah",
        "numberOfAyahs": 28,
        "revelationType": "Meccan"
      },
      "numberInSurah": 20,
      "juz": 29,
