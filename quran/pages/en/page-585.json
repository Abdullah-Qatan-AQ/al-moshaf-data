        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
      "numberInSurah": 22,
      "juz": 30,
      "manzil": 7,
      "page": 585,
      "ruku": 522,
      "hizbQuarter": 234,
      "sajda": false
    },
