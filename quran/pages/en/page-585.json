      "text": "then He made the way easy for him[7];",
      "surah": {
        "number": 80,
        "name": "سُورَةُ عَبَسَ",
        "englishName": "Abasa",
        "englishNameTranslation": "He frowned",
        "numberOfAyahs": 42,
        "revelationType": "Meccan"
      },
