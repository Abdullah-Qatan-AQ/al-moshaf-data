      "ruku": 55,
      "hizbQuarter": 26,
      "sajda": false
    },
    {
      "number": 424,
      "text": "and fear the Fire prepared for the disbelievers.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
