      "sajda": false
    },
    {
      "number": 416,
      "text": "Allah had helped you at Badr when you were weak; then fear Allah so that you may be grateful.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
        "numberOfAyahs": 200,
