      "juz": 4,
      "manzil": 1,
      "page": 66,
      "ruku": 54,
      "hizbQuarter": 26,
      "sajda": false
    },
    {
      "number": 423,
      "text": "O you who believe, do not consume usury[58], doubled and multiplied. And fear Allah, so that you may succeed,",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
