      "hizbQuarter": 174,
      "sajda": false
    },
    {
      "number": 3660,
      "text": "A barrier will be placed between them and what they desire[28], as was done with the likes of them before, for they were indeed in a disquieting doubt.",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
        "numberOfAyahs": 54,
