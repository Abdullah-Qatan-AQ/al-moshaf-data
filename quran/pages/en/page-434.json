      "page": 434,
      "ruku": 375,
      "hizbQuarter": 174,
      "sajda": false
    },
    {
      "number": 3659,
      "text": "while they disbelieved in it before, making far-fetched conjectures about the unseen[27]?",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
        "numberOfAyahs": 54,
        "revelationType": "Meccan"
      },
      "numberInSurah": 53,
