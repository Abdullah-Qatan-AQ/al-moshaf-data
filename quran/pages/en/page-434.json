      "sajda": false
    },
    {
      "number": 3656,
      "text": "Say, “If I go astray, the detriment of my straying is only upon myself; but if I am guided, it is because of what my Lord reveals to me. He is indeed All-Hearing, Ever Near.”",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
