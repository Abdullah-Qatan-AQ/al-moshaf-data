      "page": 235,
      "ruku": 192,
      "hizbQuarter": 94,
      "sajda": false
    },
    {
      "number": 1597,
      "text": "Alif Lām Ra[1]. These are the verses of the clear Book.",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
        "numberOfAyahs": 111,
        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
