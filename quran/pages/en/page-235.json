    },
    {
      "number": 1592,
      "text": "except those whom Allah has given mercy[61], and for this He created them[62], and the word of your Lord will be fulfilled: “I will certainly fill Hell with jinn and humans all together.”",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
