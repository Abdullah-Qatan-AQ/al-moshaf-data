      "hizbQuarter": 94,
      "sajda": false
    },
    {
      "number": 1593,
      "text": "We relate to you [O Prophet] the stories of the messengers to strengthen your heart. And there has come to you in this the truth, an admonition and a reminder to the believers.",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
        "numberOfAyahs": 123,
