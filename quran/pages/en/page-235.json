      "ruku": 193,
      "hizbQuarter": 94,
      "sajda": false
    },
    {
      "number": 1598,
      "text": "We have sent it down as an Arabic Qur’an so that you may understand.",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
