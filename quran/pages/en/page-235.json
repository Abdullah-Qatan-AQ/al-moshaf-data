      "page": 235,
      "ruku": 192,
      "hizbQuarter": 94,
      "sajda": false
    },
    {
      "number": 1594,
      "text": "Say to those who do not believe, “Carry on in your ways; so will we do.",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
        "numberOfAyahs": 123,
        "revelationType": "Meccan"
      },
      "numberInSurah": 121,
      "juz": 12,
      "manzil": 3,
      "page": 235,
      "ruku": 192,
      "hizbQuarter": 94,
      "sajda": false
    },
    {
      "number": 1595,
      "text": "And wait; we too are waiting.”",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
        "numberOfAyahs": 123,
        "revelationType": "Meccan"
      },
      "numberInSurah": 122,
      "juz": 12,
      "manzil": 3,
      "page": 235,
