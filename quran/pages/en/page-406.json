    {
      "number": 3425,
      "text": "And as for those who disbelieved, and rejected Our signs and the meeting of the Hereafter, they will be arraigned for punishment.",
      "surah": {
        "number": 30,
        "name": "سُورَةُ الرُّومِ",
        "englishName": "Ar-Room",
        "englishNameTranslation": "The Romans",
