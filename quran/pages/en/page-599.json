      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6154,
      "text": "and he is truly extreme in his love of wealth.",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
