      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6151,
      "text": "plunging thereby into the midst of the enemy[4],",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
