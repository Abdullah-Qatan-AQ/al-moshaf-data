      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6148,
      "text": "striking sparks of fire [with their hooves][2],",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
