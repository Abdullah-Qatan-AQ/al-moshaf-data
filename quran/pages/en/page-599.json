      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6152,
      "text": "indeed, man is very ungrateful to his Lord[5] –",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 6,
      "juz": 30,
      "manzil": 7,
      "page": 599,
      "ruku": 542,
      "hizbQuarter": 239,
      "sajda": false
    },
    {
      "number": 6153,
      "text": "and he himself is a witness to that[6] –",
      "surah": {
        "number": 100,
        "name": "سُورَةُ العَادِيَاتِ",
        "englishName": "Al-Aadiyaat",
        "englishNameTranslation": "The Chargers",
        "numberOfAyahs": 11,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
