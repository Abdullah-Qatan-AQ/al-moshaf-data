      "sajda": false
    },
    {
      "number": 4137,
      "text": "None disputes against the signs of Allah except those who disbelieve, so do not be deceived by their movements in the land.",
      "surah": {
        "number": 40,
        "name": "سُورَةُ غَافِرٍ",
        "englishName": "Ghafir",
        "englishNameTranslation": "The Forgiver",
