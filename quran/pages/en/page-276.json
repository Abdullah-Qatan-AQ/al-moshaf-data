      "page": 276,
      "ruku": 234,
      "hizbQuarter": 110,
      "sajda": false
    },
    {
      "number": 1983,
      "text": "But if they turn away, your duty is only to convey the message clearly.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 82,
      "juz": 14,
      "manzil": 3,
      "page": 276,
      "ruku": 234,
      "hizbQuarter": 110,
      "sajda": false
    },
    {
      "number": 1984,
      "text": "They know Allah’s favors, yet they deny them, and most of them are ungrateful.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
