      "page": 276,
      "ruku": 234,
      "hizbQuarter": 110,
      "sajda": false
    },
    {
      "number": 1985,
      "text": "On the Day when We raise up a witness[54] from every community, no excuse will be accepted from the disbelievers, nor will they be allowed to make amends.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 84,
      "juz": 14,
