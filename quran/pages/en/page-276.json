      "page": 276,
      "ruku": 235,
      "hizbQuarter": 110,
      "sajda": false
    },
    {
      "number": 1986,
      "text": "When the wrongdoers face the punishment, it will not be lightened for them, nor will they be given any respite.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
