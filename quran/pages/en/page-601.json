      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6188,
      "text": "locked with towering columns[4].",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
