      "ruku": 547,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6192,
      "text": "pelting them with stones of baked clay,",
      "surah": {
        "number": 105,
        "name": "سُورَةُ الفِيلِ",
        "englishName": "Al-Fil",
        "englishNameTranslation": "The Elephant",
