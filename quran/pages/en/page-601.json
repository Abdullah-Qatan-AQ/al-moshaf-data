      "ruku": 546,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6186,
      "text": "which reaches the hearts[3].",
      "surah": {
        "number": 104,
        "name": "سُورَةُ الهُمَزَةِ",
        "englishName": "Al-Humaza",
        "englishNameTranslation": "The Traducer",
        "numberOfAyahs": 9,
