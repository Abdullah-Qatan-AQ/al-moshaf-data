      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6189,
      "text": "Have you not seen how your Lord dealt with the people of the Elephant[1]?",
      "surah": {
        "number": 105,
        "name": "سُورَةُ الفِيلِ",
        "englishName": "Al-Fil",
