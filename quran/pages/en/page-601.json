      "page": 601,
      "ruku": 547,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6191,
      "text": "He sent against them swarms of birds,",
      "surah": {
        "number": 105,
        "name": "سُورَةُ الفِيلِ",
        "englishName": "Al-Fil",
        "englishNameTranslation": "The Elephant",
        "numberOfAyahs": 5,
        "revelationType": "Meccan"
      },
      "numberInSurah": 3,
