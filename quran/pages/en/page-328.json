      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2559,
      "text": "And [remember] Noah, when he called out[29] to Us before, so We responded to him and saved him and his household[30] from the great distress.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
