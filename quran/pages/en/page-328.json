    {
      "number": 2557,
      "text": "To Lot We gave sound judgment and knowledge, and We saved him from the town that was engrossed in shameful practices. They were Indeed an evil and rebellious people.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
