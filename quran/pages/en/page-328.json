      "manzil": 4,
      "page": 328,
      "ruku": 283,
      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2561,
      "text": "And [remember] David and Solomon, when they passed judgment about the tillage into which some people’s sheep had strayed at night[31], and We were witnesses to their judgment.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
        "numberOfAyahs": 112,
