      "hizbQuarter": 131,
      "sajda": false
    },
    {
      "number": 2558,
      "text": "And We admitted him to Our mercy, for he was one of the righteous.",
      "surah": {
        "number": 21,
        "name": "سُورَةُ الأَنبِيَاءِ",
        "englishName": "Al-Anbiyaa",
        "englishNameTranslation": "The Prophets",
