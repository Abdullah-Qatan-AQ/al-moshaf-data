      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4738,
      "text": "on an unrolled parchment[3],",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
