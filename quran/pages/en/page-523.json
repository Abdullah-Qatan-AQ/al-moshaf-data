      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4740,
      "text": "and by the canopy raised high,",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
      "numberInSurah": 5,
      "juz": 27,
