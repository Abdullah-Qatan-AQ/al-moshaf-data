      "page": 523,
      "ruku": 458,
      "hizbQuarter": 209,
      "sajda": false
    },
    {
      "number": 4739,
      "text": "and by the much-frequented House[4],",
      "surah": {
        "number": 52,
        "name": "سُورَةُ الطُّورِ",
        "englishName": "At-Tur",
        "englishNameTranslation": "The Mount",
        "numberOfAyahs": 49,
        "revelationType": "Meccan"
      },
      "numberInSurah": 4,
