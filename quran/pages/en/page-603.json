      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6214,
      "text": "When there comes Allah’s help and the conquest[1],",
      "surah": {
        "number": 110,
        "name": "سُورَةُ النَّصۡرِ",
        "englishName": "An-Nasr",
