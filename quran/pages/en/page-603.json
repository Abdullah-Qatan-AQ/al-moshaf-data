      "ruku": 553,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6218,
      "text": "Neither his wealth nor his worldly gains will avail him.",
      "surah": {
        "number": 111,
        "name": "سُورَةُ المَسَدِ",
        "englishName": "Al-Masad",
        "englishNameTranslation": "The Palm Fibre",
        "numberOfAyahs": 5,
