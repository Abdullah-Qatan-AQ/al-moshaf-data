      "page": 603,
      "ruku": 552,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6216,
      "text": "then glorify the praise of your Lord, and ask His forgiveness. Indeed, He is ever Accepting of Repentance.",
      "surah": {
        "number": 110,
        "name": "سُورَةُ النَّصۡرِ",
        "englishName": "An-Nasr",
        "englishNameTranslation": "Divine Support",
        "numberOfAyahs": 3,
        "revelationType": "Medinan"
      },
      "numberInSurah": 3,
      "juz": 30,
      "manzil": 7,
      "page": 603,
      "ruku": 552,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6217,
      "text": "May the hands of Abu Lahab[1] perish, and may he perish!",
      "surah": {
        "number": 111,
        "name": "سُورَةُ المَسَدِ",
        "englishName": "Al-Masad",
        "englishNameTranslation": "The Palm Fibre",
