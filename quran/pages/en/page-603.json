      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6211,
      "text": "Never will I worship what you worship,",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
