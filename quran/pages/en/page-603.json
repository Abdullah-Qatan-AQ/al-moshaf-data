      "ruku": 551,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6210,
      "text": "nor do you worship what I worship.",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
