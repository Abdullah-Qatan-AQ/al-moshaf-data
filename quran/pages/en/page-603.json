      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6209,
      "text": "I do not worship what you worship,",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
