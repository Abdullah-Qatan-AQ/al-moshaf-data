      "ruku": 551,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6213,
      "text": "You have your religion and I have my religion.\"",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
        "englishNameTranslation": "The Disbelievers",
