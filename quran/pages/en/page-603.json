      "ruku": 553,
      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6219,
      "text": "He will burn in a Flaming Fire,",
      "surah": {
        "number": 111,
        "name": "سُورَةُ المَسَدِ",
        "englishName": "Al-Masad",
        "englishNameTranslation": "The Palm Fibre",
