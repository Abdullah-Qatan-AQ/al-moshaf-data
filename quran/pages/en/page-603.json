      "hizbQuarter": 240,
      "sajda": false
    },
    {
      "number": 6212,
      "text": "nor will you ever worship what I worship.",
      "surah": {
        "number": 109,
        "name": "سُورَةُ الكَافِرُونَ",
        "englishName": "Al-Kaafiroon",
        "englishNameTranslation": "The Disbelievers",
