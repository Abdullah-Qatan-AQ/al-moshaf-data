      "page": 4,
      "ruku": 4,
      "hizbQuarter": 1,
      "sajda": false
    },
    {
      "number": 30,
      "text": "If you are in doubt concerning that which We have sent down upon Our slave[15], then produce a chapter like it and call upon your helpers other than Allah, if you are truthful.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
