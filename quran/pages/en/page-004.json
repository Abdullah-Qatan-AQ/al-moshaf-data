      "hizbQuarter": 1,
      "sajda": false
    },
    {
      "number": 28,
      "text": "O people, worship your Lord, Who created you and those before you, so that you may become righteous;",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
