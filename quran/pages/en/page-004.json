      },
      "numberInSurah": 21,
      "juz": 1,
      "manzil": 1,
      "page": 4,
      "ruku": 4,
      "hizbQuarter": 1,
      "sajda": false
    },
    {
      "number": 29,
      "text": "He Who made the earth a resting place for you, and the sky a canopy; and sends down rain from the sky, and brings forth fruits thereby as a provision for you. So do not set up rivals to Allah while you know[14].",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
