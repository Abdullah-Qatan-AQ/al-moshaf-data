      "page": 224,
      "ruku": 184,
      "hizbQuarter": 90,
      "sajda": false
    },
    {
      "number": 1498,
      "text": "We sent Noah to his people [and he said], “I am indeed a clear warner to you,",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
        "numberOfAyahs": 123,
        "revelationType": "Meccan"
      },
      "numberInSurah": 25,
      "juz": 12,
      "manzil": 3,
      "page": 224,
      "ruku": 185,
      "hizbQuarter": 90,
      "sajda": false
    },
    {
      "number": 1499,
      "text": "that you worship none except Allah. I truly fear for you the punishment of a painful Day[14].”",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
        "numberOfAyahs": 123,
        "revelationType": "Meccan"
      },
