      "manzil": 3,
      "page": 224,
      "ruku": 185,
      "hizbQuarter": 90,
      "sajda": false
    },
    {
      "number": 1500,
      "text": "But the chiefs of his people who disbelieved said, “We only see you as a human being like ourselves, and we do not see those who follow you except the lowest among us apparently. We do not see you superior to us, rather, we think that you are liars.”",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
        "numberOfAyahs": 123,
        "revelationType": "Meccan"
      },
