      "hizbQuarter": 89,
      "sajda": false
    },
    {
      "number": 1497,
      "text": "The similitude of the two parties is that of the blind and deaf, compared to the seeing and hearing. Are they equal? Will you not then take heed?",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
        "numberOfAyahs": 123,
        "revelationType": "Meccan"
      },
      "numberInSurah": 24,
      "juz": 12,
