      "hizbQuarter": 71,
      "sajda": false
    },
    {
      "number": 1170,
      "text": "Allah granted this only as glad tidings and to reassure your hearts, for victory only comes from Allah. Indeed, Allah is All-Mighty, All-Wise.",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
        "englishName": "Al-Anfaal",
        "englishNameTranslation": "The Spoils of War",
        "numberOfAyahs": 75,
