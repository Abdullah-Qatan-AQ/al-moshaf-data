      "sajda": false
    },
    {
      "number": 4266,
      "text": "Whatever they used to supplicate before will vanish from them, and they will realize that they have no escape.",
      "surah": {
        "number": 41,
        "name": "سُورَةُ فُصِّلَتۡ",
        "englishName": "Fussilat",
        "englishNameTranslation": "Explained in detail",
