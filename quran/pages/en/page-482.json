      "hizbQuarter": 193,
      "sajda": false
    },
    {
      "number": 4270,
      "text": "Say, “Did you ever consider, if this [Qur’an] is really from Allah, but you reject it, who can be more astray than someone who is in extreme defiance?”",
      "surah": {
        "number": 41,
        "name": "سُورَةُ فُصِّلَتۡ",
        "englishName": "Fussilat",
        "englishNameTranslation": "Explained in detail",
