    {
      "number": 4512,
      "text": "The revelation of this Book is from Allah, the All-Mighty, the All-Wise.",
      "surah": {
        "number": 46,
        "name": "سُورَةُ الأَحۡقَافِ",
        "englishName": "Al-Ahqaf",
        "englishNameTranslation": "The Dunes",
