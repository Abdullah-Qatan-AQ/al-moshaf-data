      "hizbQuarter": 201,
      "sajda": false
    },
    {
      "number": 4514,
      "text": "Say, “Tell me about those whom you invoke besides Allah; show me what they have created on the earth, or do they have a share in the heavens? Bring me a scripture revealed before this, or some remnant of knowledge, if you are truthful.”",
      "surah": {
        "number": 46,
        "name": "سُورَةُ الأَحۡقَافِ",
