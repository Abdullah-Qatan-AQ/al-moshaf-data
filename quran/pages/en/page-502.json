      "hizbQuarter": 200,
      "sajda": false
    },
    {
      "number": 4508,
      "text": "That is because you took Allah’s verses in ridicule, and were deluded by the life of this world.” So Today they will not be taken out of it, nor will they be asked to make amends.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
