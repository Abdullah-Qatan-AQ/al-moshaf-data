    },
    {
      "number": 4507,
      "text": "It will be said, “Today We will forget you as you forgot the meeting of this Day of yours. Your abode will be the Fire, and you will have no helpers.",
      "surah": {
        "number": 45,
        "name": "سُورَةُ الجَاثِيَةِ",
        "englishName": "Al-Jaathiya",
        "englishNameTranslation": "Crouching",
        "numberOfAyahs": 37,
