      "sajda": false
    },
    {
      "number": 4252,
      "text": "Good and evil are not equal. Repel evil with what is good; the one whom you have enmity with will become as if he were a close friend.",
      "surah": {
        "number": 41,
        "name": "سُورَةُ فُصِّلَتۡ",
