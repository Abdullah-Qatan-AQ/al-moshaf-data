    {
      "number": 3303,
      "text": "And We have constantly conveyed the Word [of admonition] to them[23], so that they may take heed.",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
        "englishName": "Al-Qasas",
