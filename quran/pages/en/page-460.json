      "sajda": false
    },
    {
      "number": 4070,
      "text": "and I have been commanded to be the first of those who submit to Allah.”",
      "surah": {
        "number": 39,
        "name": "سُورَةُ الزُّمَرِ",
        "englishName": "Az-Zumar",
        "englishNameTranslation": "The Groups",
