      "manzil": 5,
      "page": 386,
      "ruku": 334,
      "hizbQuarter": 154,
      "sajda": false
    },
    {
      "number": 3261,
      "text": "Pharaoh’s wife said, “He is a source of joy for me and you. Do not kill him; he will probably benefit us, or we may adopt him as a son.” They were unaware [of the consequences].",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
        "englishName": "Al-Qasas",
        "englishNameTranslation": "The Stories",
        "numberOfAyahs": 88,
        "revelationType": "Meccan"
      },
      "numberInSurah": 9,
      "juz": 20,
      "manzil": 5,
      "page": 386,
      "ruku": 334,
      "hizbQuarter": 154,
      "sajda": false
    },
    {
      "number": 3262,
      "text": "The heart of Moses’ mother became restless; she was about to disclose it, had We not reassured her heart so that she would maintain her faith [in Allah’s promise].",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
        "englishName": "Al-Qasas",
        "englishNameTranslation": "The Stories",
