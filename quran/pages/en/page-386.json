      "ruku": 334,
      "hizbQuarter": 154,
      "sajda": false
    },
    {
      "number": 3263,
      "text": "She said to his sister, “Keep track of him.” So she watched him from a distance, without them noticing.",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
        "englishName": "Al-Qasas",
        "englishNameTranslation": "The Stories",
