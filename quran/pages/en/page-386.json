      "hizbQuarter": 154,
      "sajda": false
    },
    {
      "number": 3264,
      "text": "We had already forbidden for him all wet nurses[8], then she said, “Shall I direct you to a household who will nurse him for you and take good care of him?”",
      "surah": {
        "number": 28,
        "name": "سُورَةُ القَصَصِ",
