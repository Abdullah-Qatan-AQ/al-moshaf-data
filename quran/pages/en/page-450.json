      "page": 450,
      "ruku": 388,
      "hizbQuarter": 180,
      "sajda": false
    },
    {
      "number": 3893,
      "text": "You have fulfilled the dream.” This is how We reward those who do good.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
