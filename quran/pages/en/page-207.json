    {
      "number": 1358,
      "text": "O you who believe, fight those disbelievers who are around you[89], and let them find harshness in you; and know that Allah is with those who fear Him.",
      "surah": {
        "number": 9,
        "name": "سُورَةُ التَّوۡبَةِ",
