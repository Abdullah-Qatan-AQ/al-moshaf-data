    {
      "number": 13,
      "text": "Those who persist in disbelief, it is the same whether you warn them or not, they will not believe.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
        "numberOfAyahs": 286,
        "revelationType": "Medinan"
      },
