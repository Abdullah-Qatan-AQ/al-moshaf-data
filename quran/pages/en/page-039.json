      "page": 39,
      "ruku": 32,
      "hizbQuarter": 15,
      "sajda": false
    },
    {
      "number": 249,
      "text": "This is how Allah makes His verses clear to you, so that you may understand.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
