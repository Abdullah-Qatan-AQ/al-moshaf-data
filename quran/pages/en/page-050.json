      "hizbQuarter": 20,
      "sajda": false
    },
    {
      "number": 298,
      "text": "Indeed, there is nothing hidden from Allah on earth or in heaven.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
        "numberOfAyahs": 200,
