  "ayahs": [
    {
      "number": 4336,
      "text": "And it is He Who sends down rain from the sky in due measure, by which We revive dead land. This is how you will be brought forth [from the grave].",
      "surah": {
        "number": 43,
        "name": "سُورَةُ الزُّخۡرُفِ",
        "englishName": "Az-Zukhruf",
        "englishNameTranslation": "Ornaments of gold",
        "numberOfAyahs": 89,
        "revelationType": "Meccan"
      },
      "numberInSurah": 11,
      "juz": 25,
      "manzil": 6,
      "page": 490,
