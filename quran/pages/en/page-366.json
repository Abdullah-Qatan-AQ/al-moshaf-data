      "hizbQuarter": 146,
      "sajda": false
    },
    {
      "number": 2927,
      "text": "And those who do not witness falsehood[39], and when they pass by futility, they pass by with dignity;",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
