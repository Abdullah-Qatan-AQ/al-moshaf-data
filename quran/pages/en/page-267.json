      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1898,
      "text": "those who set up beside Allah another god; they will come to know.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 96,
