    },
    {
      "number": 1895,
      "text": "concerning what they used to do.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
