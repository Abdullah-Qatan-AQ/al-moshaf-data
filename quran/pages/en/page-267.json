      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1896,
      "text": "Then proclaim what you are commanded, and turn away from those who associate partners with Allah.",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
        "revelationType": "Meccan"
      },
      "numberInSurah": 94,
      "juz": 14,
      "manzil": 3,
      "page": 267,
      "ruku": 223,
      "hizbQuarter": 106,
      "sajda": false
    },
    {
      "number": 1897,
      "text": "We will surely suffice you against the mockers[50],",
      "surah": {
        "number": 15,
        "name": "سُورَةُ الحِجۡرِ",
        "englishName": "Al-Hijr",
        "englishNameTranslation": "The Rock",
        "numberOfAyahs": 99,
