      "hizbQuarter": 80,
      "sajda": false
    },
    {
      "number": 1324,
      "text": "Allah has prepared for them gardens under which rivers flow, abiding therein forever; that is the supreme triumph.",
      "surah": {
        "number": 9,
        "name": "سُورَةُ التَّوۡبَةِ",
        "englishName": "At-Tawba",
        "englishNameTranslation": "The Repentance",
