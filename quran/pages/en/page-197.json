      "hizbQuarter": 79,
      "sajda": false
    },
    {
      "number": 1302,
      "text": "The hypocrites, both men and women, are all alike; they enjoin what is evil and forbid what is good, and they withhold their hands [from giving][60]. They forgot Allah, so He forgot them. Indeed, the hypocrites are the rebellious.",
      "surah": {
        "number": 9,
        "name": "سُورَةُ التَّوۡبَةِ",
