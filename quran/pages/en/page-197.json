      "hizbQuarter": 79,
      "sajda": false
    },
    {
      "number": 1301,
      "text": "Make no excuses; you have disbelieved after having believed[59]. If We pardon some of you, We will punish others because they are wicked.",
      "surah": {
        "number": 9,
        "name": "سُورَةُ التَّوۡبَةِ",
        "englishName": "At-Tawba",
        "englishNameTranslation": "The Repentance",
