      "hizbQuarter": 79,
      "sajda": false
    },
    {
      "number": 1300,
      "text": "If you question them, they will surely say, “We were only indulging in idle talk and playing.” Say, “Was it Allah, His verses and His Messenger that you were mocking[58]?”",
      "surah": {
        "number": 9,
        "name": "سُورَةُ التَّوۡبَةِ",
        "englishName": "At-Tawba",
        "englishNameTranslation": "The Repentance",
