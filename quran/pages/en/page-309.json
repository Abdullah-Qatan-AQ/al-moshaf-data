      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2306,
      "text": "And mention in the Book [the story of] Idrīs[14]. He was a man of truth and a prophet.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
