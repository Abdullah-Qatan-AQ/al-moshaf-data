      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2303,
      "text": "And We granted him, by Our mercy, his brother Aaron, as a prophet.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
