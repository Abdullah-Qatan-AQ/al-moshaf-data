      "page": 309,
      "ruku": 267,
      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2305,
      "text": "He used to command his people to pray and give zakah, and his Lord was well pleased with him.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
