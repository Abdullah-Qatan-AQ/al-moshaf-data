      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2304,
      "text": "And mention in the Book [the story of] Ishmael. He was true to his promise and was a messenger and a prophet.",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
