      "hizbQuarter": 123,
      "sajda": false
    },
    {
      "number": 2307,
      "text": "And We raised him to a high status[15].",
      "surah": {
        "number": 19,
        "name": "سُورَةُ مَرۡيَمَ",
        "englishName": "Maryam",
        "englishNameTranslation": "Mary",
