        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 13,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4915,
      "text": "He created man from dry clay like pottery,",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
