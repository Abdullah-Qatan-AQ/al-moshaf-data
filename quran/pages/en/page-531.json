      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4903,
      "text": "has taught the Qur’an,",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 2,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4904,
      "text": "He created man,",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 3,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 466,
      "hizbQuarter": 213,
      "sajda": false
    },
    {
      "number": 4905,
      "text": "and taught him speech.",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
      "numberInSurah": 4,
      "juz": 27,
