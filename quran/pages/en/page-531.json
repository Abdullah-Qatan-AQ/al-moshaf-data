  "ayahs": [
    {
      "number": 4896,
      "text": "Our command is but a single word[20], which is fulfilled in the blink of an eye.",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
