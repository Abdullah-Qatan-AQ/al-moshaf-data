        "revelationType": "Meccan"
      },
      "numberInSurah": 50,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4897,
      "text": "We have destroyed many like you [O Makkans][21]; is there anyone to take heed?",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 51,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4898,
      "text": "Everything they did is in the written records,",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
