      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4899,
      "text": "and everything, small or big, is written down.",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 53,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4900,
      "text": "Indeed, the righteous will be in gardens and rivers[22],",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 54,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4901,
      "text": "seated in honor in the presence of the Most Powerful Sovereign.",
      "surah": {
        "number": 54,
        "name": "سُورَةُ القَمَرِ",
        "englishName": "Al-Qamar",
        "englishNameTranslation": "The Moon",
        "numberOfAyahs": 55,
        "revelationType": "Meccan"
      },
      "numberInSurah": 55,
      "juz": 27,
      "manzil": 7,
      "page": 531,
      "ruku": 465,
      "hizbQuarter": 212,
      "sajda": false
    },
    {
      "number": 4902,
      "text": "The Most Compassionate,",
      "surah": {
        "number": 55,
        "name": "سُورَةُ الرَّحۡمَٰن",
        "englishName": "Ar-Rahmaan",
        "englishNameTranslation": "The Beneficent",
        "numberOfAyahs": 78,
        "revelationType": "Medinan"
      },
