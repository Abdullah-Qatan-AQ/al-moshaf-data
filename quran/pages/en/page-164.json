      "ruku": 135,
      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1065,
      "text": "They said, “Let him and his brother wait for a while and send heralds to the cities",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
        "revelationType": "Meccan"
      },
