      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1070,
      "text": "He said, “You throw first.” So when they threw, they enchanted the eyes of the people and struck terror into them, and produced a powerful magic.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
