      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1061,
      "text": "So he threw his staff, and it suddenly became a real serpent[42].",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
