      "ruku": 134,
      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1062,
      "text": "And he drew out his hand, and it was shining white[43] to the beholders.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
