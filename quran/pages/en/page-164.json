      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1067,
      "text": "The magicians came to Pharaoh and said, “Will we have a reward if we prevail?”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
