      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1063,
      "text": "The chiefs among Pharaoh’s people said, “This is indeed a learned magician!",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
