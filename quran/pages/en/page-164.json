      "ruku": 135,
      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1068,
      "text": "He said, “Yes, and you will surely be of those who are close to me.”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
