      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1069,
      "text": "They said, “O Moses, will you throw first or will we be the first to throw?”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
