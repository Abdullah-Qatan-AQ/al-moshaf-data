      "page": 164,
      "ruku": 135,
      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1064,
      "text": "He seeks to drive you out of your land. [Pharaoh said], “So what do you advise?”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
