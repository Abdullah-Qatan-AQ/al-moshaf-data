      "ruku": 135,
      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1066,
      "text": "to bring you every learned magician.”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
        "numberOfAyahs": 206,
