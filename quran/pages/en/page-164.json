      "hizbQuarter": 65,
      "sajda": false
    },
    {
      "number": 1071,
      "text": "We inspired Moses, “Throw your staff,” and it suddenly swallowed up all their illusionary devices.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
