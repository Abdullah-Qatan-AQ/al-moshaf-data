      "hizbQuarter": 66,
      "sajda": false
    },
    {
      "number": 1072,
      "text": "Thus the truth prevailed, and all what they did was proven to be false.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
