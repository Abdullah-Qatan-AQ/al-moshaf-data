    },
    {
      "number": 2232,
      "text": "Then he pursued another course,",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
        "numberOfAyahs": 110,
