      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2230,
      "text": "until when he reached the far east, he found the sun rising on a people for whom We provided no shelter from it[45].",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
