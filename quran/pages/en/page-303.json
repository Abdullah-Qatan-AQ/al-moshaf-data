      "ruku": 262,
      "hizbQuarter": 121,
      "sajda": false
    },
    {
      "number": 2231,
      "text": "So it was, and We had full knowledge about him[46].",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
