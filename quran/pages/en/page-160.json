      "hizbQuarter": 64,
      "sajda": false
    },
    {
      "number": 1030,
      "text": "Those who were arrogant said, “As for us, we surely disbelieve in what you believe.”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
