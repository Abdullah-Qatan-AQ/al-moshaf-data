      "hizbQuarter": 64,
      "sajda": false
    },
    {
      "number": 1031,
      "text": "Then they killed the she-camel and defied their Lord’s command, and said, “O Sālih, bring us what you are threatening us if you are indeed one of the messengers.”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
