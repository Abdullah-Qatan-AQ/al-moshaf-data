      "page": 160,
      "ruku": 131,
      "hizbQuarter": 64,
      "sajda": false
    },
    {
      "number": 1032,
      "text": "Then an earthquake seized them, and they fell lifeless in their homes.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
