      "sajda": false
    },
    {
      "number": 818,
      "text": "They say, “There is nothing beyond our life in this world, and we will not be resurrected.”",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
