      },
      "numberInSurah": 33,
      "juz": 7,
      "manzil": 2,
      "page": 131,
      "ruku": 105,
      "hizbQuarter": 52,
      "sajda": false
    },
    {
      "number": 823,
      "text": "There were messengers rejected before you, but they endured patiently their rejection and persecution until Our help came to them. None can change the words of Allah. You have already received some accounts of those messengers[8].",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
