      "hizbQuarter": 104,
      "sajda": false
    },
    {
      "number": 1780,
      "text": "They set up rivals to Allah to mislead people from His way. Say, “Enjoy yourselves for a while! Your destination will be the Fire.”",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
        "englishName": "Ibrahim",
        "englishNameTranslation": "Abraham",
