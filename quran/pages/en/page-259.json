      "page": 259,
      "ruku": 215,
      "hizbQuarter": 104,
      "sajda": false
    },
    {
      "number": 1779,
      "text": "In Hell they will burn; what an evil place to settle in!",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
        "englishName": "Ibrahim",
        "englishNameTranslation": "Abraham",
        "numberOfAyahs": 52,
