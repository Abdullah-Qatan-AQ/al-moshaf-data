      "hizbQuarter": 104,
      "sajda": false
    },
    {
      "number": 1781,
      "text": "Tell My slaves who believe to establish prayer and spend from what We have provided for them, secretly and openly, before there comes a Day when there will be no bargaining or friendship[22].",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
