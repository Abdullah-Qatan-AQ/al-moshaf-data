      "hizbQuarter": 103,
      "sajda": false
    },
    {
      "number": 1778,
      "text": "Did you not see those who exchanged Allah’s blessings with disbelief[20], and led their people to the abode of ruin[21]?",
      "surah": {
        "number": 14,
        "name": "سُورَةُ إِبۡرَاهِيمَ",
        "englishName": "Ibrahim",
        "englishNameTranslation": "Abraham",
        "numberOfAyahs": 52,
        "revelationType": "Meccan"
      },
      "numberInSurah": 28,
