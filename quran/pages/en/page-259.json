      "hizbQuarter": 104,
      "sajda": false
    },
    {
      "number": 1782,
      "text": "It is Allah Who has created the heavens and earth and sent down rain from the sky, producing therewith fruits as provision for you. He has made the ships for your service to sail through the sea by His command and has made for you the rivers.",
