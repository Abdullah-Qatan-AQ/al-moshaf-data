      "hizbQuarter": 116,
      "sajda": false
    },
    {
      "number": 2124,
      "text": "Say, “If there had been angels walking on earth peacefully, We would have certainly sent down to them from the heaven an angel as a messenger.”",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
