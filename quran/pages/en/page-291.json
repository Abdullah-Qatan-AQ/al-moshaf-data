      "hizbQuarter": 116,
      "sajda": false
    },
    {
      "number": 2118,
      "text": "We have explained every kind of example[79] for mankind in this Qur’an, yet most people persist in disbelief.",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
        "numberOfAyahs": 111,
        "revelationType": "Meccan"
      },
      "numberInSurah": 89,
