      "hizbQuarter": 116,
      "sajda": false
    },
    {
      "number": 2121,
      "text": "or you make the sky to fall upon us in pieces – as you claim – or bring Allah and the angels before us face to face,",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
