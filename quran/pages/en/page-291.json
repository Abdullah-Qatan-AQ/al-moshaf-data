      "page": 291,
      "ruku": 249,
      "hizbQuarter": 116,
      "sajda": false
    },
    {
      "number": 2120,
      "text": "or until you have a garden of date palms and grapevines, and you cause rivers to flow abundantly in their midst,",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
