    {
      "number": 2117,
      "text": "Say, “If all humans and jinn were to come together to produce something similar to this Qur’an, they would not be able to produce the like of it, even if they collaborated with one another[78].”",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
