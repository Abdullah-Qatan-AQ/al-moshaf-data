      "page": 291,
      "ruku": 249,
      "hizbQuarter": 116,
      "sajda": false
    },
    {
      "number": 2119,
      "text": "They say, “We will never believe in you until you cause a spring to gush forth for us from the earth[80],",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
