    },
    {
      "number": 4059,
      "text": "The revelation of this Book is from Allah, the All-Mighty, the All-Wise.",
      "surah": {
        "number": 39,
        "name": "سُورَةُ الزُّمَرِ",
        "englishName": "Az-Zumar",
        "englishNameTranslation": "The Groups",
