      "page": 231,
      "ruku": 190,
      "hizbQuarter": 93,
      "sajda": false
    },
    {
      "number": 1560,
      "text": "They said, “O Shu‘ayb, does your prayer command you that we should forsake what our forefathers worshiped, or that we should give up dealing with our wealth as we please? Indeed, you are such a forbearing and right-minded man![51]”",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
        "numberOfAyahs": 123,
