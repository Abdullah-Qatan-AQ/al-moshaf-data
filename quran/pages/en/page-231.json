      "page": 231,
      "ruku": 190,
      "hizbQuarter": 93,
      "sajda": false
    },
    {
      "number": 1559,
      "text": "What remains from the provision of Allah is far better[50], if you are [true] believers; I am not a keeper over you.”",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
