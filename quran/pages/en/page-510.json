    {
      "number": 4576,
      "text": "We will certainly test you so as to reveal those of you who struggle [in Allah’s way] and remain patient, and We will test the sincerity of your assertions.",
      "surah": {
        "number": 47,
        "name": "سُورَةُ مُحَمَّدٍ",
        "englishName": "Muhammad",
        "englishNameTranslation": "Muhammad",
