    {
      "number": 4575,
      "text": "If We willed, We could show them to you [O Prophet], so you would recognize them by their faces, but you will surely recognize them by the manner of their speech. And Allah knows all what you do.",
      "surah": {
        "number": 47,
        "name": "سُورَةُ مُحَمَّدٍ",
        "englishName": "Muhammad",
