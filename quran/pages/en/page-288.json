      "hizbQuarter": 115,
      "sajda": false
    },
    {
      "number": 2092,
      "text": "Allah said, “Be gone[58]! Whoever among them follows you, Hell will be an ample recompense for you all.",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
        "numberOfAyahs": 111,
        "revelationType": "Meccan"
      },
      "numberInSurah": 63,
      "juz": 15,
      "manzil": 4,
      "page": 288,
      "ruku": 246,
      "hizbQuarter": 115,
      "sajda": false
    },
    {
      "number": 2093,
      "text": "Entice with your voice whoever of them you can; mobilize against them your cavalry and infantry; manipulate them in their wealth[59] and children[60], and make promises to them.” But Satan does not promise them except delusion[61].",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
