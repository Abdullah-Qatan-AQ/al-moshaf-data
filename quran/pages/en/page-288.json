      "page": 288,
      "ruku": 246,
      "hizbQuarter": 115,
      "sajda": false
    },
    {
      "number": 2094,
      "text": "“You will have no authority over My slaves.” And sufficient is your Lord as a Guardian.",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
