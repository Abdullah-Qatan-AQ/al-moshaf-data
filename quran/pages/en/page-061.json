      "page": 61,
      "ruku": 50,
      "hizbQuarter": 24,
      "sajda": false
    },
    {
      "number": 382,
      "text": "except those who repent after that and mend their ways[38], for Allah is All-Forgiving, Most Merciful.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
