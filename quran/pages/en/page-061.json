      "page": 61,
      "ruku": 50,
      "hizbQuarter": 24,
      "sajda": false
    },
    {
      "number": 383,
      "text": "But those who disbelieve after having believed then increase in disbelief, never will their repentance be accepted; it is they who have gone astray.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
