    {
      "number": 378,
      "text": "Anyone who seeks a religion other than Islam, never will it be accepted from him; and in the Hereafter he will be among the losers.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
