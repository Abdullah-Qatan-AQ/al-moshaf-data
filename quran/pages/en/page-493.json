    {
      "number": 4373,
      "text": "Every sign We showed them was greater than the one before it[16], and We seized them with punishment[17] so that they may turn in repentance.",
      "surah": {
        "number": 43,
        "name": "سُورَةُ الزُّخۡرُفِ",
        "englishName": "Az-Zukhruf",
        "englishNameTranslation": "Ornaments of gold",
        "numberOfAyahs": 89,
        "revelationType": "Meccan"
      },
      "numberInSurah": 48,
      "juz": 25,
