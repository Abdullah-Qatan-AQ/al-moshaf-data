      "hizbQuarter": 72,
      "sajda": false
    },
    {
      "number": 1199,
      "text": "Fight them until there is no more persecution[22] and the religion is entirely for Allah; but if they desist, then Allah is All-Seeing of what they do.",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
