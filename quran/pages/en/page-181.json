      "hizbQuarter": 72,
      "sajda": false
    },
    {
      "number": 1195,
      "text": "Their prayer at the Sacred House was nothing but whistling and clapping. So taste the punishment[20] for your disbelief.",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
        "englishName": "Al-Anfaal",
        "englishNameTranslation": "The Spoils of War",
        "numberOfAyahs": 75,
