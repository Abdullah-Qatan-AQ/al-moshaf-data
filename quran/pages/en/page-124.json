      "hizbQuarter": 50,
      "sajda": false
    },
    {
      "number": 769,
      "text": "Say, “Evil and good are not equal, even if the abundance of evil may impress you. So fear Allah, O people of understanding, so that you may be successful.”",
      "surah": {
        "number": 5,
        "name": "سُورَةُ المَائـِدَةِ",
        "englishName": "Al-Maaida",
        "englishNameTranslation": "The Table",
