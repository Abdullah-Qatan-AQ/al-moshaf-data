      "page": 124,
      "ruku": 98,
      "hizbQuarter": 50,
      "sajda": false
    },
    {
      "number": 768,
      "text": "The Messenger’s duty is only to convey the message; Allah knows what you reveal and what you conceal.",
      "surah": {
        "number": 5,
        "name": "سُورَةُ المَائـِدَةِ",
        "englishName": "Al-Maaida",
        "englishNameTranslation": "The Table",
