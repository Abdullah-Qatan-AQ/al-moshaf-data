    {
      "number": 766,
      "text": "Allah has made the Ka‘bah, the Sacred House, a source of stability for people, and also the sacred month, the sacrificial animals and the garlands [by which they are identified]. This is so that you may know that Allah knows all that is in the heavens and all that is on earth, and that Allah is All-Knowing of everything.",
      "surah": {
        "number": 5,
        "name": "سُورَةُ المَائـِدَةِ",
        "englishName": "Al-Maaida",
        "englishNameTranslation": "The Table",
        "numberOfAyahs": 120,
        "revelationType": "Medinan"
      },
