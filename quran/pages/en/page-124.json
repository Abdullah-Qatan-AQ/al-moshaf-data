      "page": 124,
      "ruku": 98,
      "hizbQuarter": 50,
      "sajda": false
    },
    {
      "number": 767,
      "text": "Know that Allah is severe in punishment and that Allah is All-Forgiving, Most Merciful.",
      "surah": {
        "number": 5,
        "name": "سُورَةُ المَائـِدَةِ",
        "englishName": "Al-Maaida",
        "englishNameTranslation": "The Table",
