      "hizbQuarter": 23,
      "sajda": false
    },
    {
      "number": 349,
      "text": "As for those who disbelieve, I will punish them severely in this world and the Hereafter, and they will have no helpers.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
        "numberOfAyahs": 200,
        "revelationType": "Medinan"
      },
      "numberInSurah": 56,
      "juz": 3,
