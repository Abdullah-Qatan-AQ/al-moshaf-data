      "page": 57,
      "ruku": 47,
      "hizbQuarter": 23,
      "sajda": false
    },
    {
      "number": 350,
      "text": "As for those who believe and do righteous deeds, He will give them their rewards in full, and Allah does not like the wrongdoers.”",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
