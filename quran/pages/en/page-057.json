      "sajda": false
    },
    {
      "number": 348,
      "text": "And [remember] when Allah said, “O Jesus, I will take you and raise you up to Myself[23] and deliver you from those who disbelieve, and make those who follow you above[24] those who disbelieve until the Day of Resurrection. Then you will all return to Me, and I will judge between you concerning that over which you differed.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
        "englishNameTranslation": "The Family of Imraan",
        "numberOfAyahs": 200,
        "revelationType": "Medinan"
      },
