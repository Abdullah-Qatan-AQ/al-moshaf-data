      "hizbQuarter": 23,
      "sajda": false
    },
    {
      "number": 352,
      "text": "The similitude of Jesus before Allah[25] is like that of Adam; He created him from dust, then said to him, “Be,” and he was.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
