    {
      "number": 1407,
      "text": "And among them are some who look at you, but can you guide the blind even though they have no sight[39]?",
      "surah": {
        "number": 10,
        "name": "سُورَةُ يُونُسَ",
        "englishName": "Yunus",
        "englishNameTranslation": "Jonas",
