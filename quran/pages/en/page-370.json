  "ayahs": [
    {
      "number": 2993,
      "text": "When the two groups saw each other, the companions of Moses said, “We are surely overtaken!”",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 61,
      "juz": 19,
      "manzil": 5,
      "page": 370,
      "ruku": 319,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 2994,
      "text": "Moses said, “Certainly not! My Lord is with me; He will guide me.”",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
