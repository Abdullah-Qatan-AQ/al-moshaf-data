      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3010,
      "text": "Who created me, so He guides me;",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
      "numberInSurah": 78,
