      "ruku": 320,
      "hizbQuarter": 148,
      "sajda": false
    },
    {
      "number": 3009,
      "text": "Indeed, they are my enemies, except the Lord of the worlds[12],",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
