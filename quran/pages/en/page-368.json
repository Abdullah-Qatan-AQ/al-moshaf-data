      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2958,
      "text": "Moses said, “Your Lord and the Lord of your forefathers.”",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
