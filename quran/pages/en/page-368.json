      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2959,
      "text": "Pharaoh said, “Your messenger who has been sent to you is truly insane!”",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
