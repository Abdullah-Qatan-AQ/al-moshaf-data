      "sajda": false
    },
    {
      "number": 2953,
      "text": "So I fled from you in fear. Then my Lord gave me wisdom and made me one of the messengers.",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
