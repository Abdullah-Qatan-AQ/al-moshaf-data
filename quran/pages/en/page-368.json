      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2956,
      "text": "Moses said, “The Lord of the heavens and earth and all that is between them, if only you had sure faith.”",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
