      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2966,
      "text": "Pharaoh said to the chiefs around him, “This is indeed a learned magician!",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
