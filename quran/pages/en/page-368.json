      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2955,
      "text": "Pharaoh said, “What is ‘the Lord of the worlds’?”",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
        "englishNameTranslation": "The Poets",
        "numberOfAyahs": 227,
        "revelationType": "Meccan"
      },
