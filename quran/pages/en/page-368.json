      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2957,
      "text": "Pharaoh said to those around him, “Did you hear [what he just said]?”",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
