      "page": 368,
      "ruku": 317,
      "hizbQuarter": 147,
      "sajda": false
    },
    {
      "number": 2954,
      "text": "Is this a favor that you remind me with, that you have enslaved the Children of Israel?[8]",
      "surah": {
        "number": 26,
        "name": "سُورَةُ الشُّعَرَاءِ",
        "englishName": "Ash-Shu'araa",
