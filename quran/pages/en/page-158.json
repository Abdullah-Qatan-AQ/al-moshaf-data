    {
      "number": 1013,
      "text": "Indeed, We sent Noah to his people. He said, “O my people, worship Allah; you have no god other than Him. I fear for you the punishment of a momentous Day.”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
