      "ruku": 129,
      "hizbQuarter": 63,
      "sajda": false
    },
    {
      "number": 1016,
      "text": "I convey to you the messages of my Lord and give you sincere advice, and I know from Allah what you do not know.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
