      "hizbQuarter": 63,
      "sajda": false
    },
    {
      "number": 1014,
      "text": "The chiefs of his people said, “We certainly see that you are clearly misguided.”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
        "englishNameTranslation": "The Heights",
