      "page": 158,
      "ruku": 129,
      "hizbQuarter": 63,
      "sajda": false
    },
    {
      "number": 1017,
      "text": "Are you surprised that a reminder should come to you from your Lord through a man from among yourselves, so that he may warn you and you may fear Allah, and so that you may be shown mercy?”",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
