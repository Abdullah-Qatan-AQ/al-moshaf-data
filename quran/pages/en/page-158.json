      "hizbQuarter": 63,
      "sajda": false
    },
    {
      "number": 1015,
      "text": "He said, “O my people, I am not misguided, but I am a messenger from the Lord of the worlds.",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
        "englishName": "Al-A'raaf",
