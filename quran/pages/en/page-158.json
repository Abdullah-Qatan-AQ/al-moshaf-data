      "hizbQuarter": 63,
      "sajda": false
    },
    {
      "number": 1018,
      "text": "But they rejected him, so We delivered him and those who were with him in the Ark, and We drowned those who rejected Our signs[22]. They were indeed people who were blind [to the truth].",
      "surah": {
        "number": 7,
        "name": "سُورَةُ الأَعۡرَافِ",
