      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5973,
      "text": "and they will have no food except bitter thorny plants,",
      "surah": {
        "number": 88,
        "name": "سُورَةُ الغَاشِيَةِ",
        "englishName": "Al-Ghaashiya",
        "englishNameTranslation": "The Overwhelming",
        "numberOfAyahs": 26,
        "revelationType": "Meccan"
      },
