        "revelationType": "Meccan"
      },
      "numberInSurah": 1,
      "juz": 30,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5969,
      "text": "On that Day, some faces will be humiliated,",
      "surah": {
        "number": 88,
        "name": "سُورَةُ الغَاشِيَةِ",
        "englishName": "Al-Ghaashiya",
        "englishNameTranslation": "The Overwhelming",
        "numberOfAyahs": 26,
        "revelationType": "Meccan"
      },
      "numberInSurah": 2,
      "juz": 30,
      "manzil": 7,
      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5970,
      "text": "overburdened and weary[1],",
      "surah": {
        "number": 88,
        "name": "سُورَةُ الغَاشِيَةِ",
        "englishName": "Al-Ghaashiya",
        "englishNameTranslation": "The Overwhelming",
        "numberOfAyahs": 26,
        "revelationType": "Meccan"
      },
