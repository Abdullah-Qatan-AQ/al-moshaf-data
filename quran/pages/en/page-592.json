      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5972,
      "text": "They will be made to drink from a boiling spring,",
      "surah": {
        "number": 88,
        "name": "سُورَةُ الغَاشِيَةِ",
        "englishName": "Al-Ghaashiya",
        "englishNameTranslation": "The Overwhelming",
        "numberOfAyahs": 26,
