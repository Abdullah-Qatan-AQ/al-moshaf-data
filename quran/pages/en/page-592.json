      "page": 592,
      "ruku": 530,
      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5971,
      "text": "as they burn in a scorching Fire.",
      "surah": {
        "number": 88,
        "name": "سُورَةُ الغَاشِيَةِ",
        "englishName": "Al-Ghaashiya",
        "englishNameTranslation": "The Overwhelming",
        "numberOfAyahs": 26,
        "revelationType": "Meccan"
      },
