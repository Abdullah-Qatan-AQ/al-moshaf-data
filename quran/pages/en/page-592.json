      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5965,
      "text": "even though the Hereafter is better and more lasting.",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
