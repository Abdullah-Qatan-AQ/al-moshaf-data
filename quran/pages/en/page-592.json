      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5966,
      "text": "Indeed, this was in the earlier Scriptures,",
      "surah": {
        "number": 87,
        "name": "سُورَةُ الأَعۡلَىٰ",
        "englishName": "Al-A'laa",
