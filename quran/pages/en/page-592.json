      "hizbQuarter": 237,
      "sajda": false
    },
    {
      "number": 5968,
      "text": "Has there come to you the story of the Overwhelming Event?",
      "surah": {
        "number": 88,
        "name": "سُورَةُ الغَاشِيَةِ",
        "englishName": "Al-Ghaashiya",
        "englishNameTranslation": "The Overwhelming",
