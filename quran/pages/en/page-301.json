      "hizbQuarter": 120,
      "sajda": false
    },
    {
      "number": 2207,
      "text": "He said, “You will never be able to have patience with me.”",
      "surah": {
        "number": 18,
        "name": "سُورَةُ الكَهۡفِ",
        "englishName": "Al-Kahf",
        "englishNameTranslation": "The Cave",
