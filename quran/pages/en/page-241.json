      "page": 241,
      "ruku": 198,
      "hizbQuarter": 96,
      "sajda": false
    },
    {
      "number": 1645,
      "text": "Then after that will come a year in which people will have abundant rain, and in which they will press [grapes and olives].”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
