      "sajda": false
    },
    {
      "number": 1643,
      "text": "Joseph said, “You will grow crops for seven consecutive years. But whatever you harvest, leave it in its ear, except for a little that you may eat.",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
