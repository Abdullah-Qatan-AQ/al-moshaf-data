      "page": 12,
      "ruku": 10,
      "hizbQuarter": 5,
      "sajda": false
    },
    {
      "number": 86,
      "text": "So woe to those who write the Scripture with their own hands, and then say, “This is from Allah,” in order to trade it for a small price. Woe to them for what their hands have written, and woe to them for what they earn.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
        "numberOfAyahs": 286,
        "revelationType": "Medinan"
      },
      "numberInSurah": 79,
      "juz": 1,
