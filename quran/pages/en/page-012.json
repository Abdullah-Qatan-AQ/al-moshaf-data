    },
    {
      "number": 85,
      "text": "And among them, there are illiterate people, who know nothing of the Scripture except wishful thinking, and they do nothing but guesswork.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
        "numberOfAyahs": 286,
