  "ayahs": [
    {
      "number": 4516,
      "text": "When such people are gathered, they will become their enemies and will reject their worship.",
      "surah": {
        "number": 46,
        "name": "سُورَةُ الأَحۡقَافِ",
        "englishName": "Al-Ahqaf",
        "englishNameTranslation": "The Dunes",
        "numberOfAyahs": 35,
