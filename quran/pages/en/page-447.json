      "hizbQuarter": 179,
      "sajda": false
    },
    {
      "number": 3834,
      "text": "white and delicious for those who drink.",
      "surah": {
        "number": 37,
        "name": "سُورَةُ الصَّافَّاتِ",
        "englishName": "As-Saaffaat",
        "englishNameTranslation": "Those drawn up in Ranks",
