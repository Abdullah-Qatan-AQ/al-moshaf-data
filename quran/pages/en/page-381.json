      "hizbQuarter": 152,
      "sajda": false
    },
    {
      "number": 3213,
      "text": "And [remember] Lot, when he said to his people, “Do you commit this shameful act[16] while seeing [one another][17]?",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
        "englishName": "An-Naml",
        "englishNameTranslation": "The Ant",
        "numberOfAyahs": 93,
        "revelationType": "Meccan"
      },
      "numberInSurah": 54,
