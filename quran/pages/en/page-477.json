      "hizbQuarter": 190,
      "sajda": false
    },
    {
      "number": 4221,
      "text": "a Book whose verses are well explained; an Arabic Qur’an[2] for people who understand,",
      "surah": {
        "number": 41,
        "name": "سُورَةُ فُصِّلَتۡ",
        "englishName": "Fussilat",
