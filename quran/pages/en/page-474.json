  "ayahs": [
    {
      "number": 4192,
      "text": "Indeed, the Hour is coming; there is no doubt about it, but most people do not believe.",
      "surah": {
        "number": 40,
        "name": "سُورَةُ غَافِرٍ",
        "englishName": "Ghafir",
        "englishNameTranslation": "The Forgiver",
        "numberOfAyahs": 85,
        "revelationType": "Meccan"
      },
      "numberInSurah": 59,
      "juz": 24,
      "manzil": 6,
      "page": 474,
