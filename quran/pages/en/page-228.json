      "sajda": false
    },
    {
      "number": 1531,
      "text": "When Our command came, We saved Hūd and those who believed with him by Our mercy, and We saved them from a harsh punishment.",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
