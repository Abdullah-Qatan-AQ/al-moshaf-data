    {
      "number": 1529,
      "text": "I put my trust in Allah, my Lord and your Lord. There is no moving creature but He holds it by its forelock[27]. My Lord is on a straight path[28].",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
