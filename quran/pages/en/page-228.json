      "hizbQuarter": 91,
      "sajda": false
    },
    {
      "number": 1532,
      "text": "Such were the people of ‘Ād, who denied the signs of their Lord, disobeyed His Messengers and followed the command of every obstinate oppressor.",
      "surah": {
        "number": 11,
        "name": "سُورَةُ هُودٍ",
        "englishName": "Hud",
        "englishNameTranslation": "Hud",
        "numberOfAyahs": 123,
