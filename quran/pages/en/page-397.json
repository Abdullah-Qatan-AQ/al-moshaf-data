      "hizbQuarter": 159,
      "sajda": false
    },
    {
      "number": 3352,
      "text": "Those who disbelieve say to those who believe, “Follow our way, and we will bear the burden of your sins.” But they will never bear any of their sins. They are indeed liars.",
      "surah": {
        "number": 29,
        "name": "سُورَةُ العَنكَبُوتِ",
        "englishName": "Al-Ankaboot",
        "englishNameTranslation": "The Spider",
