      "hizbQuarter": 159,
      "sajda": false
    },
    {
      "number": 3351,
      "text": "Allah will certainly make known those who truly believe and those who are hypocrites.",
      "surah": {
        "number": 29,
        "name": "سُورَةُ العَنكَبُوتِ",
        "englishName": "Al-Ankaboot",
        "englishNameTranslation": "The Spider",
