      "ruku": 342,
      "hizbQuarter": 159,
      "sajda": false
    },
    {
      "number": 3353,
      "text": "They will certainly bear their own burdens, as well as other burdens along with their own burdens[3], and on the Day of Resurrection they will certainly be questioned concerning what they used to fabricate.",
      "surah": {
        "number": 29,
