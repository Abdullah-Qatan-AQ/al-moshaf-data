    {
      "number": 4141,
      "text": "Our Lord, admit them to the Gardens of Eternity which You have promised them, and the righteous from among their parents, their spouses and their offspring. Indeed, it is You Who are the All-Mighty, the All-Wise.",
      "surah": {
        "number": 40,
        "name": "سُورَةُ غَافِرٍ",
        "englishName": "Ghafir",
        "englishNameTranslation": "The Forgiver",
        "numberOfAyahs": 85,
        "revelationType": "Meccan"
      },
      "numberInSurah": 8,
      "juz": 24,
      "manzil": 6,
      "page": 468,
