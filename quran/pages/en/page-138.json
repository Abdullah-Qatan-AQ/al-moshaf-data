    },
    {
      "number": 872,
      "text": "That was Our argument which We gave Abraham against his people. We elevate in ranks whom We will. Your Lord is All-Wise, All-Knowing.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
