    {
      "number": 1908,
      "text": "And they carry your heavy loads to lands that you could not reach without great hardship. Indeed, your Lord is Most Gracious, Most Merciful.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
        "numberOfAyahs": 128,
        "revelationType": "Meccan"
      },
      "numberInSurah": 7,
      "juz": 14,
      "manzil": 3,
      "page": 268,
