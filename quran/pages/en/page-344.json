      "hizbQuarter": 137,
      "sajda": false
    },
    {
      "number": 2702,
      "text": "And say: “My Lord, make my landing a blessed landing, for You provide the best landing’”.",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
