      "ruku": 297,
      "hizbQuarter": 138,
      "sajda": false
    },
    {
      "number": 2714,
      "text": "So the huge blast[12] overtook them in all justice, and We swept them away like scum[13]. So away with the wrongdoing people!",
      "surah": {
        "number": 23,
        "name": "سُورَةُ المُؤۡمِنُونَ",
        "englishName": "Al-Muminoon",
