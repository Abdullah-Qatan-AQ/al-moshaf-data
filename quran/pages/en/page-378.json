      "hizbQuarter": 151,
      "sajda": false
    },
    {
      "number": 3178,
      "text": "So he smiled in amusement at its words and said, “My Lord, inspire me to be grateful for Your favor which You have bestowed upon me and my parents, and to do righteous deeds that please you. And admit me, by Your mercy, among Your righteous slaves.”",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
