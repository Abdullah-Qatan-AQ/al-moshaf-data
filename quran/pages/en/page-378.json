      "hizbQuarter": 151,
      "sajda": false
    },
    {
      "number": 3176,
      "text": "Solomon’s armies of jinn, men and birds were assembled before him, marching in organized ranks,",
      "surah": {
        "number": 27,
        "name": "سُورَةُ النَّمۡلِ",
