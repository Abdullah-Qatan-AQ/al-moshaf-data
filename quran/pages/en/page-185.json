      "sajda": false
    },
    {
      "number": 1224,
      "text": "O Prophet, Allah is sufficient for you[40] and for the believers who follow you.",
      "surah": {
        "number": 8,
        "name": "سُورَةُ الأَنفَالِ",
        "englishName": "Al-Anfaal",
        "englishNameTranslation": "The Spoils of War",
