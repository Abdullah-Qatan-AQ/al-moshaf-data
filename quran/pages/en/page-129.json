      "hizbQuarter": 51,
      "sajda": false
    },
    {
      "number": 800,
      "text": "Say, “Travel through the land, then see how was the end of the deniers.”",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
