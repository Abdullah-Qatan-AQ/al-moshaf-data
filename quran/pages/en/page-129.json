      "hizbQuarter": 51,
      "sajda": false
    },
    {
      "number": 801,
      "text": "Say, “To whom belongs all that is in the heavens and earth?” Say, “To Allah.” He has taken it upon Himself to be Merciful. He will surely gather you for the Day of Resurrection about which there is no doubt. Those who have ruined themselves will not believe.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
