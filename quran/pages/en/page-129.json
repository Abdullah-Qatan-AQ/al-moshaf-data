      "page": 129,
      "ruku": 103,
      "hizbQuarter": 51,
      "sajda": false
    },
    {
      "number": 802,
      "text": "To Him belongs all that rests in the night and in the day, and He is the All-Hearing, the All-Knowing.",
      "surah": {
        "number": 6,
        "name": "سُورَةُ الأَنۡعَامِ",
        "englishName": "Al-An'aam",
        "englishNameTranslation": "The Cattle",
        "numberOfAyahs": 165,
