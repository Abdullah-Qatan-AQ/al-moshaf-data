      "page": 225,
      "ruku": 186,
      "hizbQuarter": 90,
      "sajda": false
    },
    {
      "number": 1510,
      "text": "Construct the Ark under Our [watchful] Eyes[17] and Our direction, and do not plead with Me for those who did wrong, for they will surely be drowned.”",
