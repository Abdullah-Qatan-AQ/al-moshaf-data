      "hizbQuarter": 182,
      "sajda": false
    },
    {
      "number": 3993,
      "text": "This is my brother[12]. He has ninety-nine ewes while I have only one. He said, ‘Give her into my charge,’ and he overpowered me in speech.”",
      "surah": {
        "number": 38,
        "name": "سُورَةُ صٓ",
        "englishName": "Saad",
        "englishNameTranslation": "The letter Saad",
        "numberOfAyahs": 88,
