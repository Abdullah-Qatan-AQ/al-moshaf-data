      "manzil": 6,
      "page": 498,
      "ruku": 432,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4457,
      "text": "Indeed, the tree of Zaqqūm",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 43,
      "juz": 25,
      "manzil": 6,
      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4458,
      "text": "will be the food of the sinful,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
