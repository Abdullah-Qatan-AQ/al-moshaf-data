      "page": 498,
      "ruku": 433,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4459,
      "text": "like molten metal that will boil in their bellies",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
