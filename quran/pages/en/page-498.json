      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4455,
      "text": "the Day when no patron[11] will avail another in the least, nor will they be helped,",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
