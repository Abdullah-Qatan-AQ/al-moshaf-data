      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4472,
      "text": "We have made this [Qur’an] easy in your own language, so that they may take heed.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
