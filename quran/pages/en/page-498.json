      "ruku": 432,
      "hizbQuarter": 199,
      "sajda": false
    },
    {
      "number": 4456,
      "text": "except those to whom Allah shows mercy. He is indeed the All-Mighty, the Most Merciful.",
      "surah": {
        "number": 44,
        "name": "سُورَةُ الدُّخَانِ",
        "englishName": "Ad-Dukhaan",
        "englishNameTranslation": "The Smoke",
        "numberOfAyahs": 59,
        "revelationType": "Meccan"
      },
      "numberInSurah": 42,
