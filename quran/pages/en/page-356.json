    {
      "number": 2835,
      "text": "Allah alternates the night and day. Indeed, there is a lesson in this for people of insight.",
      "surah": {
        "number": 24,
        "name": "سُورَةُ النُّورِ",
        "englishName": "An-Noor",
        "englishNameTranslation": "The Light",
