      "page": 520,
      "ruku": 455,
      "hizbQuarter": 208,
      "sajda": false
    },
    {
      "number": 4677,
      "text": "and by the clouds carrying loads of water,",
      "surah": {
        "number": 51,
        "name": "سُورَةُ الذَّارِيَاتِ",
        "englishName": "Adh-Dhaariyat",
        "englishNameTranslation": "The Winnowing Winds",
