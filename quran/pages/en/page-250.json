      },
      "numberInSurah": 10,
      "juz": 13,
      "manzil": 3,
      "page": 250,
      "ruku": 206,
      "hizbQuarter": 100,
      "sajda": false
    },
    {
      "number": 1718,
      "text": "For each person there are successive angels[7] in front of him and behind him, guarding him by the command of Allah. Allah does not change the condition of a people until they change their own attitude and conduct[8]. But if Allah intends punishment for a people[9], then it cannot be averted, nor will there be any protector for them besides Him.",
      "surah": {
        "number": 13,
        "name": "سُورَةُ الرَّعۡدِ",
        "englishName": "Ar-Ra'd",
        "englishNameTranslation": "The Thunder",
        "numberOfAyahs": 43,
        "revelationType": "Medinan"
      },
      "numberInSurah": 11,
      "juz": 13,
      "manzil": 3,
      "page": 250,
      "ruku": 206,
      "hizbQuarter": 100,
      "sajda": false
    },
    {
      "number": 1719,
      "text": "It is He Who shows you lightening [causing] fear and hope[10] and forms heavy clouds[11].",
      "surah": {
        "number": 13,
        "name": "سُورَةُ الرَّعۡدِ",
        "englishName": "Ar-Ra'd",
        "englishNameTranslation": "The Thunder",
