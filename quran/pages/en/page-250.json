      "page": 250,
      "ruku": 206,
      "hizbQuarter": 100,
      "sajda": false
    },
    {
      "number": 1716,
      "text": "He is the Knower of the unseen and the seen, the All-Great, the Most Exalted.",
      "surah": {
        "number": 13,
        "name": "سُورَةُ الرَّعۡدِ",
        "englishName": "Ar-Ra'd",
        "englishNameTranslation": "The Thunder",
        "numberOfAyahs": 43,
