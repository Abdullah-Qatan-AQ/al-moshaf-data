      "page": 250,
      "ruku": 206,
      "hizbQuarter": 100,
      "sajda": false
    },
    {
      "number": 1717,
      "text": "It is the same [to Him] whether one of you speaks secretly or in public, and whether one is hidden in the darkness of the night or walks about openly in the daylight.",
      "surah": {
        "number": 13,
        "name": "سُورَةُ الرَّعۡدِ",
        "englishName": "Ar-Ra'd",
        "englishNameTranslation": "The Thunder",
        "numberOfAyahs": 43,
