      "hizbQuarter": 25,
      "sajda": false
    },
    {
      "number": 398,
      "text": "Do not be like those who became divided and differed after the clear proofs had come to them; and for them there will be a great punishment.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
