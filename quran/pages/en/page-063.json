      "hizbQuarter": 25,
      "sajda": false
    },
    {
      "number": 397,
      "text": "Let there be a group from among you who call to goodness: enjoining what is right, and forbidding what is wrong[50]. It is they who are successful.",
      "surah": {
        "number": 3,
        "name": "سُورَةُ آلِ عِمۡرَانَ",
        "englishName": "Aal-i-Imraan",
