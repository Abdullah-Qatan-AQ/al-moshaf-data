  "ayahs": [
    {
      "number": 2899,
      "text": "Do you think that most of them hear or understand?[22] They are just like cattle[23], rather they are further astray from the right way.",
      "surah": {
        "number": 25,
        "name": "سُورَةُ الفُرۡقَانِ",
        "englishName": "Al-Furqaan",
        "englishNameTranslation": "The Criterion",
        "numberOfAyahs": 77,
        "revelationType": "Meccan"
      },
      "numberInSurah": 44,
      "juz": 19,
      "manzil": 4,
      "page": 364,
