      "hizbQuarter": 95,
      "sajda": false
    },
    {
      "number": 1623,
      "text": "But if his shirt is torn from the back, then she is lying and he is truthful.”",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
