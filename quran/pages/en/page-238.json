      "hizbQuarter": 95,
      "sajda": false
    },
    {
      "number": 1624,
      "text": "When he saw that his shirt was torn from the back, he said, “This is your guile [O women]; your guile is great indeed!",
      "surah": {
        "number": 12,
        "name": "سُورَةُ يُوسُفَ",
        "englishName": "Yusuf",
        "englishNameTranslation": "Joseph",
