      "hizbQuarter": 111,
      "sajda": false
    },
    {
      "number": 2000,
      "text": "Indeed, he has no power over those who believe[63] and put their trust in their Lord.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
