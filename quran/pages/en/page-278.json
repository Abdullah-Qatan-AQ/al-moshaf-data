      "sajda": false
    },
    {
      "number": 1999,
      "text": "When you recite the Qur’an, seek refuge with Allah from the accursed Satan.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
