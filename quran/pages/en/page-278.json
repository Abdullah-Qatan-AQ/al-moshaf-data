      "hizbQuarter": 111,
      "sajda": false
    },
    {
      "number": 2001,
      "text": "He only has power over those who take him as their patron[64], and who - under his influence - associate partners with Allah.",
      "surah": {
        "number": 16,
        "name": "سُورَةُ النَّحۡلِ",
        "englishName": "An-Nahl",
        "englishNameTranslation": "The Bee",
