      "sajda": false
    },
    {
      "number": 3647,
      "text": "They will say, “Glory be to You! You are our Protector, not they. Rather they used to worship the jinn[22]; most of them believed in them.”",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
        "numberOfAyahs": 54,
