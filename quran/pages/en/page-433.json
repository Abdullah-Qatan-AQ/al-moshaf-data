      "hizbQuarter": 174,
      "sajda": false
    },
    {
      "number": 3653,
      "text": "Say, “If I had ever asked you for a reward, it is yours. My reward is only with Allah, and He is Witness over all things.”",
      "surah": {
        "number": 34,
        "name": "سُورَةُ سَبَإٍ",
        "englishName": "Saba",
        "englishNameTranslation": "Sheba",
