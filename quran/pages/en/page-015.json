      "page": 15,
      "ruku": 12,
      "hizbQuarter": 6,
      "sajda": false
    },
    {
      "number": 102,
      "text": "But they will never wish for that because of what their hands have sent forth. And Allah is All-Knowing of the wrongdoers.",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
        "numberOfAyahs": 286,
