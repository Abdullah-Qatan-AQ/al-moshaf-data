    {
      "number": 101,
      "text": "Say, “If the Home of the Hereafter with Allah is only for you [O Israelites] among all humans, then wish for death, if you are truthful.”",
      "surah": {
        "number": 2,
        "name": "سُورَةُ البَقَرَةِ",
        "englishName": "Al-Baqara",
        "englishNameTranslation": "The Cow",
        "numberOfAyahs": 286,
