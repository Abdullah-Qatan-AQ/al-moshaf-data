      "page": 284,
      "ruku": 242,
      "hizbQuarter": 114,
      "sajda": false
    },
    {
      "number": 2053,
      "text": "and lower to them the wing of humility[22] out of mercy, and say, “My Lord, have mercy upon them as they raised me when I was small[23].”",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
