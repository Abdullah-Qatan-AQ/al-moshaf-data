      "hizbQuarter": 113,
      "sajda": false
    },
    {
      "number": 2048,
      "text": "But whoever desires the Hereafter and strives for it as he should, being a believer – it is those whose efforts will be appreciated[17].",
      "surah": {
        "number": 17,
        "name": "سُورَةُ الإِسۡرَاءِ",
        "englishName": "Al-Israa",
        "englishNameTranslation": "The Night Journey",
        "numberOfAyahs": 111,
        "revelationType": "Meccan"
      },
